

---
export interface Props {
  scripture?: string;
  scriptureRef?: string;
  pageLinks?: { label: string; href: string }[];
}
const {
  scripture = 'Here are they that keep the commandments of God, and the faith of Jesus.',
  scriptureRef = 'Revelation 14:12 (KJV)',
  pageLinks = []
} = Astro.props;
---

<footer class="sf-footer">
  <!-- Scripture banner -->
  <div class="sf-banner">
    <p class="sf-banner-verse">&ldquo;{scripture}&rdquo;</p>
    <cite class="sf-banner-ref">&mdash; {scriptureRef}</cite>
  </div>

  <!-- Footer grid -->
  <div class="sf-main">
    <!-- Brand / Mission -->
    <div class="sf-col sf-col-brand">
      <div class="sf-brand-name">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#d4a537" stroke-width="2" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        <span>Sunday<em>Law</em>.com</span>
      </div>
      <p>Proclaiming the Three Angels&rsquo; Messages &mdash; the commandments of God and the faith of Jesus &mdash; to every nation, kindred, tongue, and people. The final warning before the close of probation.</p>
      <p class="sf-small">The pioneers saw the image of the beast being formed. Their books, tracts, charts, and sermons are available here &mdash; free &mdash; for all who have ears to hear.</p>
    </div>

    <!-- Navigate -->
    <div class="sf-col">
      <h4>Navigate</h4>
      <ul>
        <li><a href="/">Home &mdash; The Final Choice</a></li>
        <li><a href="/divine-romance">The Bridegroom's Call: Enter the Most Holy Place!</a></li>
        <li><a href="/#seal-vs-mark">Seal vs. Mark of the Beast</a></li>
        <li><a href="/#three-angels">Three Angels' Messages</a></li>
        <li><a href="/#second-beast">Second Beast - USA</a></li>
        <li><a href="/prophecy-explained">The Great Eternal Test</a></li>
        <li><a href="/loud-cry">The Loud Cry - Rev. 18</a></li>
        <li><a href="/midnight-cry">The Midnight Cry</a></li>
        <li><a href="/religious-liberty">Religious Liberty</a></li>
        <li><a href="/members">Members</a></li>
      </ul>
    </div>

    <!-- Pioneer Books -->
    <div class="sf-col">
      <h4>Pioneer Books &amp; Documents</h4>
      <ul>
        <li><a href="/pioneer-books">Featured Pioneer Books</a></li>
        <li><a href="/books/ellen-white-great-controversy">The Great Controversy — Ellen White</a></li>
        <li><a href="/books/john-nevins-andrews-history-of-the-sabbath-and-first-day-of-the-week">History of the Sabbath — J.N. Andrews</a></li>
        <li><a href="/books/joseph-bates-seal">Seal of the Living God — Bates</a></li>
        <li><a href="/books/captain-joseph-bates-autobiography-1868">Bates Autobiography — 1868</a></li>
        <li><a href="/books/charles-fitch">Come Out of Her — Fitch 1843</a></li>
        <li><a href="/prophecy-charts">1843 & 1850 Prophecy Charts</a></li>
        <li><a href="/april-15-1904-new-organization">April 15, 1904 — The Record</a></li>
        <li><a href="/1860-name-selection">1860 Name Selection</a></li>
        <li><a href="/library">All Pioneer Books</a></li>
        <li><a href="/pioneers">All Pioneer Biographies</a></li>
      </ul>
    </div>

    <!-- Resources -->
    <div class="sf-col">
      <h4>Resources &amp; Contact</h4>
      <ul>
        <li><a href="/contact">Contact Us</a></li>
        <li><a href="/contact">Prayer Request</a></li>
        <li><a href="/donate">Support the Work</a></li>
        <li><a href="/1904-signers">The Five 1904 Signers</a></li>
        <li><a href="/april-15-1904-new-organization">#april-15-1904</a></li>
        <li><a href="/#take-stand">Take Your Stand</a></li>
        {pageLinks.map(l => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </div>
  </div>

  <!-- Bottom bar -->
  <div class="sf-bottom">
    <div class="sf-flags" aria-hidden="true">
      <div class="sf-flag-r"></div><div class="sf-flag-w"></div><div class="sf-flag-b"></div>
    </div>
    <p>&copy; 2026 SundayLaw.com &mdash; Stand in the old paths. Keep the commandments of God and the faith of Jesus. &mdash; Revelation 14:12</p>
    <p class="sf-small">Proclaiming the Three Angels&rsquo; Messages to Every Nation, Kindred, Tongue, and People</p>
  </div>
  <div class="sf-stripe" aria-hidden="true"></div>

</footer>



<style>
  .sf-footer {
    background: #050518;
    border-top: 1px solid rgba(180,130,50,0.2);
    font-family: 'Inter', sans-serif;
  }
  .sf-banner {
    background: linear-gradient(to right, rgba(212,165,55,0.08), rgba(212,165,55,0.05), rgba(212,165,55,0.08));
    padding: 22px 20px;
    text-align: center;
    border-bottom: 1px solid rgba(212,165,55,0.12);
  }
  .sf-banner-verse {
    font-family: 'Crimson Text', 'Cormorant Garamond', Georgia, serif;
    color: #fde68a;
    font-size: 1.1rem;
    font-style: italic;
    margin: 0 0 6px;
  }
  .sf-banner-ref {
    color: #d4a537;
    font-size: 0.85rem;
    font-weight: 600;
    font-style: normal;
    display: block;
  }
  .sf-main {
    max-width: 1280px;
    margin: 0 auto;
    padding: 50px 22px;
    display: grid;
    gap: 2.5rem;
    grid-template-columns: 2fr 1fr 1fr 1fr;
  }
  @media (max-width: 900px) {
    .sf-main { grid-template-columns: 1fr 1fr; }
    .sf-col-brand { grid-column: 1 / -1; }
  }
  @media (max-width: 500px) {
    .sf-main { grid-template-columns: 1fr; }
  }
  .sf-brand-name {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 12px;
    font-weight: 700;
    font-size: 1.05rem;
    color: #fff;
    font-family: 'Inter', sans-serif;
  }
  .sf-brand-name em { color: #d4a537; font-style: normal; }
  .sf-col h4 {
    color: #fcd34d;
    font-size: 0.73rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    margin: 0 0 14px;
  }
  .sf-col p {
    color: #9ca3af;
    font-size: 0.875rem;
    line-height: 1.75;
    margin: 0 0 10px;
  }
  .sf-small { font-size: 0.8rem !important; }
  .sf-col ul { list-style: none; margin: 0; padding: 0; }
  .sf-col li { padding: 3px 0; }
  .sf-col li a {
    color: #9ca3af;
    font-size: 0.875rem;
    text-decoration: none;
    transition: color 0.18s;
  }
  .sf-col li a:hover { color: #fcd34d; }
  .sf-bottom {
    border-top: 1px solid rgba(180,130,50,0.1);
    padding: 18px 22px;
    text-align: center;
  }
  .sf-bottom p {
    color: #6b7280;
    font-size: 0.78rem;
    margin: 4px 0;
  }
  .sf-flags {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 4px;
    margin: 8px 0;
  }
  .sf-flags div { width: 32px; height: 4px; border-radius: 2px; }
  .sf-flag-r { background: #b91c1c; }
  .sf-flag-w { background: #fff; }
  .sf-flag-b { background: #1d4ed8; }
  .sf-stripe { height: 4px; background: linear-gradient(to right, #b91c1c, #fff, #1d4ed8); }
</style>
