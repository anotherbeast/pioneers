---
// SiteSearch.astro — Pagefind-powered site search modal
// showTrigger (default true): set false when used inside SiteNav (trigger is there instead)
interface Props { showTrigger?: boolean; }
const { showTrigger = true } = Astro.props;
---

<!-- ===== SEARCH TRIGGER BUTTON (fixed-position, used on pages without SiteNav) ===== -->
{showTrigger && (
<button id="ss-open" class="ss-trigger" aria-label="Search site" title="Search (/)">
  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none"
    stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
  </svg>
  <span class="ss-trigger-text">Search</span>
  <kbd class="ss-kbd">/</kbd>
</button>
)}

<!-- ===== SEARCH MODAL ===== -->
<div id="ss-modal" class="ss-modal" role="dialog" aria-modal="true" aria-label="Site search" hidden>
  <div class="ss-overlay" id="ss-overlay"></div>
  <div class="ss-inner">
    <button id="ss-close" class="ss-close" aria-label="Close search">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none"
        stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
      </svg>
    </button>
    <div id="ss-pagefind"></div>
    <p class="ss-hint">Press <kbd>Esc</kbd> to close &middot; <kbd>/</kbd> or <kbd>Ctrl+K</kbd> to open</p>
  </div>
</div>

<link rel="stylesheet" href="/pagefind/pagefind-ui.css">

<style>
  /* ===== TRIGGER BUTTON ===== */
  .ss-trigger {
    position: fixed;
    top: 14px;
    right: 72px;
    z-index: 200;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    height: 38px;
    padding: 0 14px;
    border-radius: 8px;
    border: 1px solid rgba(212, 165, 55, 0.35);
    background: rgba(10, 10, 46, 0.88);
    color: rgba(254, 243, 199, 0.75);
    font-family: 'Inter', sans-serif;
    font-size: 0.84rem;
    font-weight: 500;
    cursor: pointer;
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    transition: background 0.18s, border-color 0.18s, color 0.18s;
    white-space: nowrap;
  }

  .ss-trigger:hover {
    background: rgba(20, 20, 60, 0.95);
    border-color: rgba(212, 165, 55, 0.65);
    color: #fef3c7;
  }

  .ss-trigger svg { flex-shrink: 0; opacity: 0.8; }

  .ss-kbd {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 20px;
    min-width: 20px;
    padding: 0 4px;
    border-radius: 4px;
    border: 1px solid rgba(212, 165, 55, 0.3);
    background: rgba(212, 165, 55, 0.08);
    color: rgba(212, 165, 55, 0.7);
    font-size: 0.72rem;
    font-family: 'Inter', sans-serif;
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  @media (max-width: 540px) {
    .ss-trigger-text { display: none; }
    .ss-kbd { display: none; }
    .ss-trigger { padding: 0 11px; right: 60px; }
  }

  /* ===== MODAL ===== */
  .ss-modal {
    position: fixed;
    inset: 0;
    z-index: 9000;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding-top: clamp(48px, 10vh, 100px);
  }

  .ss-modal[hidden] { display: none; }

  .ss-overlay {
    position: absolute;
    inset: 0;
    background: rgba(4, 4, 20, 0.82);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    cursor: pointer;
  }

  .ss-inner {
    position: relative;
    z-index: 1;
    width: min(680px, calc(100vw - 32px));
    max-height: calc(100vh - 120px);
    background: #0d0d3a;
    border: 1px solid rgba(212, 165, 55, 0.28);
    border-radius: 14px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    box-shadow: 0 24px 80px rgba(0, 0, 0, 0.7);
  }

  .ss-close {
    position: absolute;
    top: 10px;
    right: 10px;
    z-index: 2;
    width: 34px;
    height: 34px;
    border: 1px solid rgba(212, 165, 55, 0.2);
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.04);
    color: rgba(254, 243, 199, 0.6);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.15s, color 0.15s;
  }

  .ss-close:hover {
    background: rgba(212, 165, 55, 0.12);
    color: #fef3c7;
  }

  #ss-pagefind {
    flex: 1;
    overflow-y: auto;
    padding: 18px 18px 0;
  }

  .ss-hint {
    padding: 10px 18px;
    font-size: 0.75rem;
    color: rgba(156, 163, 175, 0.55);
    font-family: 'Inter', sans-serif;
    border-top: 1px solid rgba(212, 165, 55, 0.08);
    flex-shrink: 0;
  }

  .ss-hint kbd {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 17px;
    min-width: 17px;
    padding: 0 4px;
    border-radius: 3px;
    border: 1px solid rgba(212, 165, 55, 0.25);
    background: rgba(212, 165, 55, 0.06);
    color: rgba(212, 165, 55, 0.6);
    font-size: 0.68rem;
    font-family: 'Inter', sans-serif;
    font-weight: 600;
  }

  /* ===== PAGEFIND UI OVERRIDES ===== */
  :root {
    --pagefind-ui-scale: 0.95;
    --pagefind-ui-primary: #d4a537;
    --pagefind-ui-text: #fef3c7;
    --pagefind-ui-background: #0d0d3a;
    --pagefind-ui-border: rgba(212, 165, 55, 0.25);
    --pagefind-ui-tag: #0a0a2e;
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-border-radius: 8px;
    --pagefind-ui-image-border-radius: 6px;
    --pagefind-ui-image-box-ratio: 3 / 2;
    --pagefind-ui-font: 'Inter', sans-serif;
  }

  .pagefind-ui__search-input {
    background: rgba(255, 255, 255, 0.04) !important;
    color: #fef3c7 !important;
  }

  .pagefind-ui__search-input::placeholder {
    color: rgba(156, 163, 175, 0.5) !important;
  }

  .pagefind-ui__result-link {
    color: #d4a537 !important;
  }

  .pagefind-ui__result-excerpt mark {
    background: rgba(212, 165, 55, 0.25) !important;
    color: #fef3c7 !important;
  }

  .pagefind-ui__result {
    border-color: rgba(212, 165, 55, 0.1) !important;
  }
</style>

<script>
  (function () {
    const modal = document.getElementById('ss-modal');
    const overlay = document.getElementById('ss-overlay');
    const openBtn = document.getElementById('ss-open');
    const closeBtn = document.getElementById('ss-close');
    let uiLoaded = false;

    function loadPagefindUI() {
      if (uiLoaded) return;
      uiLoaded = true;
      const cssLink = document.querySelector('link[href="/pagefind/pagefind-ui.css"]');
      if (!cssLink || !cssLink.sheet) {
        // pagefind not built yet (dev mode) — show a message
        const el = document.getElementById('ss-pagefind');
        if (el) el.innerHTML = '<p style="color:rgba(156,163,175,0.7);padding:24px 0;font-size:0.9rem;font-family:Inter,sans-serif;">Search index is built after running <code style="color:#d4a537">npm run build</code>.</p>';
        return;
      }
      const script = document.createElement('script');
      script.src = '/pagefind/pagefind-ui.js';
      script.onload = function () {
        // @ts-ignore
        new window.PagefindUI({
          element: '#ss-pagefind',
          showSubResults: true,
          showImages: false,
          excerptLength: 18,
          resetStyles: false,
        });
        // Auto-focus the input
        const input = document.querySelector('.pagefind-ui__search-input');
        if (input) (input as HTMLInputElement).focus();
      };
      script.onerror = function () {
        const el = document.getElementById('ss-pagefind');
        if (el) el.innerHTML = '<p style="color:rgba(156,163,175,0.7);padding:24px 0;font-size:0.9rem;font-family:Inter,sans-serif;">Search unavailable — run <code style="color:#d4a537">npm run build</code> to generate the index.</p>';
      };
      document.head.appendChild(script);
    }

    function openModal() {
      if (!modal) return;
      modal.removeAttribute('hidden');
      document.body.style.overflow = 'hidden';
      loadPagefindUI();
      // Focus the search input (may already be focused from loadPagefindUI)
      setTimeout(() => {
        const input = document.querySelector('.pagefind-ui__search-input');
        if (input) (input as HTMLInputElement).focus();
      }, 80);
    }

    function closeModal() {
      if (!modal) return;
      modal.setAttribute('hidden', '');
      document.body.style.overflow = '';
      if (openBtn) openBtn.focus();
    }

    openBtn?.addEventListener('click', openModal);
    closeBtn?.addEventListener('click', closeModal);
    overlay?.addEventListener('click', closeModal);

    document.addEventListener('keydown', function (e) {
      const isModalOpen = modal && !modal.hasAttribute('hidden');
      // Open: "/" (not in input) or Ctrl/Cmd+K
      if (!isModalOpen) {
        if (e.key === '/' && !['INPUT', 'TEXTAREA', 'SELECT'].includes((e.target as Element)?.tagName)) {
          e.preventDefault();
          openModal();
          return;
        }
        if (e.key === 'k' && (e.ctrlKey || e.metaKey)) {
          e.preventDefault();
          openModal();
          return;
        }
      }
      // Close: Escape
      if (isModalOpen && e.key === 'Escape') {
        e.preventDefault();
        closeModal();
      }
    });
  })();
</script>
