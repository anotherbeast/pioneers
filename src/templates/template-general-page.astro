      </div>
    </div>
    <div class="mobile-nav" id="mobile-nav">
      <a href="/#final-choice">The Final Choice</a>
      <a href="/#seal-vs-mark">Seal vs. Mark</a>
      <a href="/#three-angels">Three Angels' Messages</a>
      <a href="/#second-beast">Second Beast</a>
      <a href="/#pioneer-library">Pioneer Library</a>
      <a href="/library">Full Pioneer Gateway</a>
      <a href="/religious-liberty">Religious Liberty</a>
      <a href="/loud-cry">The Loud Cry</a>
      <a href="/midnight-cry">The Midnight Cry</a>
      <a href="/contact">Contact</a>
      <a href="/donate">Donate</a>
      <a href="/#take-stand">Take Your Stand &rarr;</a>
    </div>
  </nav>

  <!-- ══ MAIN ═══════════════════════════════════════════════ -->
  <div class="page">

    <!-- breadcrumb: update path to match your page location -->
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="/">Home</a><span>›</span>
      <!-- <a href="/library">Pioneer Library</a><span>›</span> -->
      <span>PAGE_TITLE</span>
    </nav>

    <!-- hero -->
    <div class="page-hero">
      <div class="eyebrow">EYEBROW_LABEL</div>
      <h1>PAGE_H1_TITLE</h1>
      <p>PAGE_SUBTITLE_PARAGRAPH</p>
      <div class="hero-cta-row">
        <a href="#content" class="btn-gold">START HERE LABEL &darr;</a>
        <a href="/library" class="btn-outline">Pioneer Library</a>
      </div>
    </div>

    <!-- ══ SCRIPTURE PULL QUOTE (optional) ══════════════════ -->
    <div class="pull-scripture">
      <div class="ref">BOOK CHAPTER:VERSE (KJV)</div>
      <blockquote>&ldquo;SCRIPTURE TEXT HERE.&rdquo;</blockquote>
      <cite>&mdash; BOOK CHAPTER:VERSE (KJV) &mdash; Brief context note</cite>
    </div>

    <!-- ══ SECTION 1: MAIN CONTENT ═══════════════════════════ -->
    <section class="section" id="content">
      <div class="section-header">
        <div class="sh-eyebrow">SECTION_1_EYEBROW</div>
        <h2>SECTION_1_H2</h2>
        <p>SECTION_1_SUBHEAD</p>
      </div>

      <!-- Option A: prose article -->
      <div class="prose">
        <p>PARAGRAPH_ONE</p>
        <p>PARAGRAPH_TWO</p>
        <blockquote>
          &ldquo;QUOTE_TEXT&rdquo;
          <cite>&mdash; SOURCE</cite>
        </blockquote>
        <p>PARAGRAPH_THREE</p>
      </div>

      <!-- Option B: card grid (uncomment to use instead) -->
      <!--
      <div class="card-grid">
        <div class="card">
          <h3>Card Title</h3>
          <p>Card body text.</p>
        </div>
        <div class="card">
          <h3>Card Title</h3>
          <p>Card body text.</p>
        </div>
