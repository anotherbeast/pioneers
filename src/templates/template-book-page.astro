---
// ============================================================
// TEMPLATE: BOOK FEATURE PAGE
// Use for: charles-fitch, joseph-bates-seal, john-nevins-andrews, etc.
//
// COLOR THEMES — pick ONE block, delete the others:
//   1. NAVY      — #0a0a2e  (general / default)
//   2. TEAL      — #011a18  (Joseph Bates / Sabbath books)
//   3. CRIMSON   — #0f0508  (judgment / second-angel / Fitch)
//   4. FOREST    — #020f06  (reform / law of God)
//   5. AMBER     — #100a00  (prophecy / Daniel / timeline)
//
// BEFORE USING:
//  1. Copy to src/pages/books/YOUR-BOOK-SLUG.astro
//  2. Choose a color theme below, delete the rest
//  3. Replace every ALL_CAPS placeholder
//  4. Fill in the PDF path, book grid, bio section, timeline
// ============================================================
import Analytics from '../../components/Analytics.astro';
import ShareBar from '../../components/ShareBar.astro';
import SiteSearch from '../../components/SiteSearch.astro';
import SiteFooter from '../../components/SiteFooter.astro';
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <!-- ══ SEO ════════════════════════════════════════════════ -->
  <title>PIONEER_NAME — BOOK_TITLE (YEAR) | SundayLaw.com</title>
  <meta name="description" content="PAGE_META_DESCRIPTION">
  <link rel="canonical" href="https://sundaylaw.com/books/BOOK-SLUG">

  <!-- ══ OPEN GRAPH ════════════════════════════════════════ -->
  <meta property="og:title" content="PIONEER_NAME — BOOK_TITLE (YEAR)">
  <meta property="og:description" content="PAGE_OG_DESCRIPTION">
  <meta property="og:image" content="/pioneers/images/PIONEER-SLUG.jpg">
  <meta property="og:type" content="book">
  <meta property="og:url" content="https://sundaylaw.com/books/BOOK-SLUG">
  <meta property="og:site_name" content="SundayLaw.com">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="PIONEER_NAME — BOOK_TITLE (YEAR)">
  <meta name="twitter:description" content="PAGE_OG_DESCRIPTION">
  <meta name="twitter:image" content="/pioneers/images/PIONEER-SLUG.jpg">

  <!-- ══ SCHEMA.ORG Book (voice AI + Google rich results) ══ -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Book",
    "name": "BOOK_TITLE",
    "author": {
      "@type": "Person",
      "name": "PIONEER_NAME",
      "birthDate": "BIRTH_YEAR",
      "deathDate": "DEATH_YEAR"
    },
    "datePublished": "YEAR",
    "description": "PAGE_META_DESCRIPTION",
    "publisher": { "@type": "Organization", "name": "SundayLaw.com" },
    "url": "https://sundaylaw.com/books/BOOK-SLUG",
    "inLanguage": "en"
  }
  </script>

  <Analytics />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Crimson+Text:ital,wght@0,400;0,600;1,400&display=swap" rel="stylesheet">

  <style>
    /* ══════════════════════════════════════════════════════
       COLOR THEME — uncomment ONE block, delete the others
       ══════════════════════════════════════════════════════ */

    /* THEME 1: NAVY (default — general pioneer books) */
    :root {
      --bg: #0a0a2e; --bg-soft: #0d0d3a; --bg-card: rgba(13,13,58,0.85);
      --ink: #fef3c7; --muted: #9ca3af; --gold: #d4a537; --gold-soft: #fcd34d;
      --accent: #d4a537; --accent-soft: #fcd34d; --accent-glow: rgba(212,165,55,0.18);
      --line: rgba(212,165,55,0.22); --line-soft: rgba(212,165,55,0.12); --line-accent: rgba(212,165,55,0.3);
      --badge-bg: rgba(212,165,55,0.12); --badge-border: rgba(212,165,55,0.35); --badge-text: #fcd34d;
      --hero-grad: linear-gradient(135deg, rgba(26,26,78,0.9), rgba(13,13,53,0.95));
      --eyebrow-bg: rgba(212,165,55,0.10); --eyebrow-border: rgba(212,165,55,0.28); --eyebrow-text: #fcd34d;
      --cta-bg: linear-gradient(to right, #b45309, #d97706);
      --cta-bg-hover: linear-gradient(to right, #d97706, #f59e0b);
    }

    /* THEME 2: TEAL (Sabbath / Joseph Bates)
    :root {
      --bg: #011a18; --bg-soft: #012220; --bg-card: rgba(1,26,24,0.9);
      --ink: #f0fdf4; --muted: #86efac; --gold: #2dd4bf; --gold-soft: #5eead4;
      --accent: #14b8a6; --accent-soft: #5eead4; --accent-glow: rgba(20,184,166,0.18);
      --line: rgba(20,184,166,0.22); --line-soft: rgba(20,184,166,0.12); --line-accent: rgba(20,184,166,0.35);
      --badge-bg: rgba(20,184,166,0.12); --badge-border: rgba(20,184,166,0.35); --badge-text: #5eead4;
      --hero-grad: linear-gradient(135deg, rgba(1,40,36,0.9), rgba(2,16,14,0.95));
      --eyebrow-bg: rgba(20,184,166,0.10); --eyebrow-border: rgba(20,184,166,0.28); --eyebrow-text: #5eead4;
      --cta-bg: linear-gradient(to right, #0d9488, #14b8a6);
      --cta-bg-hover: linear-gradient(to right, #14b8a6, #2dd4bf);
    } */

    /* THEME 3: CRIMSON (Second Angel / judgment / come out)
    :root {
      --bg: #0f0508; --bg-soft: #180710; --bg-card: rgba(20,5,14,0.9);
      --ink: #fff1f2; --muted: #fca5a5; --gold: #f87171; --gold-soft: #fca5a5;
      --accent: #ef4444; --accent-soft: #fca5a5; --accent-glow: rgba(239,68,68,0.18);
      --line: rgba(239,68,68,0.22); --line-soft: rgba(239,68,68,0.12); --line-accent: rgba(239,68,68,0.35);
      --badge-bg: rgba(239,68,68,0.12); --badge-border: rgba(239,68,68,0.35); --badge-text: #fca5a5;
      --hero-grad: linear-gradient(135deg, rgba(40,5,10,0.9), rgba(15,5,8,0.95));
      --eyebrow-bg: rgba(239,68,68,0.10); --eyebrow-border: rgba(239,68,68,0.28); --eyebrow-text: #fca5a5;
      --cta-bg: linear-gradient(to right, #9f1239, #be123c);
      --cta-bg-hover: linear-gradient(to right, #be123c, #e11d48);
    } */

    /* THEME 4: FOREST (reform / law of God / commandments)
    :root {
      --bg: #020f06; --bg-soft: #031608; --bg-card: rgba(3,20,8,0.9);
      --ink: #f0fdf4; --muted: #86efac; --gold: #4ade80; --gold-soft: #86efac;
      --accent: #16a34a; --accent-soft: #4ade80; --accent-glow: rgba(22,163,74,0.18);
      --line: rgba(22,163,74,0.22); --line-soft: rgba(22,163,74,0.12); --line-accent: rgba(22,163,74,0.35);
      --badge-bg: rgba(22,163,74,0.12); --badge-border: rgba(22,163,74,0.35); --badge-text: #4ade80;
      --hero-grad: linear-gradient(135deg, rgba(5,30,10,0.9), rgba(2,12,5,0.95));
      --eyebrow-bg: rgba(22,163,74,0.10); --eyebrow-border: rgba(22,163,74,0.28); --eyebrow-text: #4ade80;
      --cta-bg: linear-gradient(to right, #14532d, #16a34a);
      --cta-bg-hover: linear-gradient(to right, #16a34a, #22c55e);
    } */

    /* THEME 5: AMBER (prophecy / Daniel / 2300 days / charts)
    :root {
      --bg: #100a00; --bg-soft: #180f00; --bg-card: rgba(18,10,0,0.9);
      --ink: #fffbeb; --muted: #fcd34d; --gold: #f59e0b; --gold-soft: #fbbf24;
      --accent: #d97706; --accent-soft: #fcd34d; --accent-glow: rgba(217,119,6,0.18);
      --line: rgba(217,119,6,0.22); --line-soft: rgba(217,119,6,0.12); --line-accent: rgba(217,119,6,0.35);
      --badge-bg: rgba(217,119,6,0.12); --badge-border: rgba(217,119,6,0.35); --badge-text: #fcd34d;
      --hero-grad: linear-gradient(135deg, rgba(30,18,0,0.9), rgba(12,8,0,0.95));
      --eyebrow-bg: rgba(217,119,6,0.10); --eyebrow-border: rgba(217,119,6,0.28); --eyebrow-text: #fbbf24;
      --cta-bg: linear-gradient(to right, #92400e, #b45309);
      --cta-bg-hover: linear-gradient(to right, #b45309, #d97706);
    } */

    /* ══ BASE ════════════════════════════════════════════════ */
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }
    body { font-family: 'Inter', sans-serif; color: var(--ink); background: var(--bg); overflow-x: hidden; }
    a { color: var(--accent); text-decoration: none; transition: color 0.2s; }
    a:hover { color: var(--accent-soft); }

    /* ══ NAV ═════════════════════════════════════════════════ */
    .nav { position: sticky; top: 0; z-index: 100; background: rgba(5,5,30,0.94); backdrop-filter: blur(12px); border-bottom: 1px solid var(--line); }
    .nav-wrap { max-width: 1280px; margin: 0 auto; }
    .nav-row { display: flex; align-items: center; padding: 0 22px; }
    .nav-row-top { gap: 28px; height: 62px; border-bottom: 1px solid rgba(212,165,55,0.10); }
    .nav-row-bottom { gap: 22px; height: 42px; font-size: 0.82rem; overflow-x: auto; scrollbar-width: none; }
    .nav-brand { text-decoration: none; color: var(--ink); font-weight: 700; flex-shrink: 0; display: flex; align-items: center; margin-right: auto; }
    .nav-brand img { height: 38px; width: auto; display: block; border-radius: 4px; }
    .nav-link { color: var(--muted); text-decoration: none; font-weight: 600; font-size: 0.9rem; white-space: nowrap; transition: color 0.18s; }
    .nav-link:hover { color: var(--accent-soft); }
    .nav-cta { display: inline-flex; align-items: center; height: 38px; padding: 0 18px; border-radius: 8px; background: var(--accent); color: #111; font-weight: 700; font-size: 0.88rem; text-decoration: none; flex-shrink: 0; transition: background 0.18s; }
    .nav-cta:hover { opacity: 0.88; }
    .nav-bottom-link { color: rgba(156,163,175,0.8); text-decoration: none; font-weight: 500; white-space: nowrap; transition: color 0.18s; flex-shrink: 0; }
    .nav-bottom-link:hover { color: var(--accent-soft); }
    .menu-btn { display: none; width: 40px; height: 40px; border: 1px solid var(--line); border-radius: 8px; background: rgba(255,255,255,0.03); color: var(--ink); font-size: 1.2rem; cursor: pointer; flex-shrink: 0; align-items: center; justify-content: center; }
    .mobile-nav { display: none; border-top: 1px solid var(--line); padding: 14px 22px 18px; background: rgba(5,5,30,0.97); }
    .mobile-nav.open { display: grid; gap: 6px; }
    .mobile-nav a { color: var(--muted); text-decoration: none; font-weight: 600; padding: 8px 0; border-bottom: 1px solid rgba(255,255,255,0.05); }
    @media (max-width: 860px) { .nav-row-bottom { display: none; } .menu-btn { display: inline-flex; } .nav-link { display: none; } }

    /* ══ PAGE ════════════════════════════════════════════════ */
    .page { max-width: 1100px; margin: 0 auto; padding: 0 22px 100px; }
    .breadcrumb { padding: 22px 0 0; font-size: 0.8rem; color: var(--muted); }
    .breadcrumb a { color: var(--muted); }
    .breadcrumb a:hover { color: var(--accent); }
    .breadcrumb span { margin: 0 6px; }

    /* ══ HERO: PIONEER + BOOK CARD ═══════════════════════════ */
    .hero { padding: 44px 0 36px; }
    .hero-card { background: var(--hero-grad); border: 1px solid var(--line-accent); border-radius: 24px; padding: 44px 40px; display: grid; grid-template-columns: 260px 1fr; gap: 48px; align-items: start; }
    @media (max-width: 768px) { .hero-card { grid-template-columns: 1fr; gap: 28px; padding: 28px 22px; } }

    .pioneer-col { display: flex; flex-direction: column; align-items: center; gap: 14px; }
    .pioneer-portrait { width: 200px; height: 200px; border-radius: 50%; object-fit: cover; object-position: top center; border: 3px solid var(--accent); box-shadow: 0 0 40px var(--accent-glow); }
    .pioneer-name { font-family: 'Crimson Text', serif; font-size: 1.6rem; font-weight: 600; text-align: center; color: var(--ink); }
    .pioneer-dates { font-size: 0.82rem; color: var(--muted); text-align: center; }
    .pioneer-role { font-size: 0.78rem; color: var(--accent-soft); text-align: center; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; padding: 4px 12px; border: 1px solid var(--line-accent); border-radius: 999px; }
    .pioneer-bio-link { display: inline-flex; align-items: center; gap: 6px; padding: 10px 20px; border-radius: 10px; background: var(--badge-bg); border: 1px solid var(--badge-border); color: var(--badge-text); font-weight: 600; font-size: 0.85rem; text-decoration: none; transition: all 0.2s; }
    .pioneer-bio-link:hover { background: var(--accent-glow); color: #fff; }

    .book-col { }
    .eyebrow { display: inline-flex; align-items: center; gap: 6px; padding: 5px 14px; border-radius: 999px; background: var(--eyebrow-bg); border: 1px solid var(--eyebrow-border); color: var(--eyebrow-text); font-size: 0.74rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 14px; }
    .book-col h1 { font-family: 'Crimson Text', serif; font-size: clamp(2rem, 4vw, 3rem); font-weight: 600; line-height: 1.1; color: var(--ink); margin-bottom: 8px; }
    .book-col h1 em { font-style: italic; color: var(--accent-soft); }
    .book-meta { display: flex; align-items: center; gap: 14px; margin-bottom: 18px; flex-wrap: wrap; }
    .book-meta-item { font-size: 0.82rem; color: var(--muted); }
    .book-meta-item strong { color: var(--accent); margin-right: 4px; }
    .book-excerpt { font-size: 1rem; color: rgba(254,243,199,0.85); line-height: 1.85; margin-bottom: 22px; }

    .pull-scripture { background: var(--badge-bg); border: 1px solid var(--line-soft); border-left: 4px solid var(--accent); border-radius: 0 12px 12px 0; padding: 18px 20px; margin-bottom: 22px; }
    .pull-scripture .ref { font-size: 0.75rem; color: var(--accent-soft); font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 8px; }
    .pull-scripture blockquote { font-family: 'Crimson Text', serif; font-size: 1.2rem; font-style: italic; color: var(--accent-soft); line-height: 1.6; }
    .pull-scripture cite { display: block; margin-top: 8px; font-size: 0.78rem; color: var(--muted); font-style: normal; }

    .btn-row { display: flex; gap: 12px; flex-wrap: wrap; }
    .btn-gold { display: inline-flex; align-items: center; gap: 8px; padding: 14px 24px; border-radius: 12px; background: var(--cta-bg); color: #fff; font-weight: 700; font-size: 0.95rem; text-decoration: none; transition: all 0.2s; }
    .btn-gold:hover { background: var(--cta-bg-hover); color: #fff; }
    .btn-outline { display: inline-flex; align-items: center; gap: 8px; padding: 14px 24px; border-radius: 12px; background: transparent; border: 1px solid var(--line); color: var(--muted); font-weight: 600; font-size: 0.95rem; text-decoration: none; transition: all 0.2s; }
    .btn-outline:hover { border-color: var(--accent); color: var(--accent-soft); }

    /* ══ SECTIONS ════════════════════════════════════════════ */
    .section { padding: 52px 0; border-top: 1px solid var(--line-soft); }
    .section-header { text-align: center; margin-bottom: 36px; }
    .section-header .sh-eyebrow { display: inline-block; padding: 5px 16px; border-radius: 999px; border: 1px solid var(--line); color: var(--accent-soft); letter-spacing: 0.1em; text-transform: uppercase; font-size: 0.73rem; font-weight: 700; margin-bottom: 12px; }
    .section-header h2 { font-family: 'Crimson Text', serif; font-size: clamp(1.8rem, 3.5vw, 2.6rem); font-weight: 600; color: var(--ink); margin-bottom: 8px; }
    .section-header p { color: var(--muted); font-size: 0.97rem; line-height: 1.8; max-width: 640px; margin: 0 auto; }

    /* ══ PDF EMBED ════════════════════════════════════════════ */
    .pdf-embed-wrap { background: var(--bg-card); border: 1px solid var(--line); border-radius: 16px; overflow: hidden; }
    .pdf-embed-toolbar { display: flex; align-items: center; justify-content: space-between; padding: 12px 18px; background: rgba(13,13,53,0.8); border-bottom: 1px solid var(--line); flex-wrap: wrap; gap: 10px; }
    .pdf-embed-toolbar-title { font-size: 0.875rem; font-weight: 600; color: var(--muted); }
    .pdf-embed-toolbar-title strong { color: var(--accent-soft); }
    .pdf-embed-toolbar a { display: inline-flex; align-items: center; gap: 6px; padding: 8px 16px; border-radius: 8px; background: var(--badge-bg); border: 1px solid var(--line-accent); color: var(--accent-soft); font-size: 0.82rem; font-weight: 600; text-decoration: none; transition: all 0.2s; }
    .pdf-embed-toolbar a:hover { background: var(--accent-glow); }
    .pdf-frame { width: 100%; height: 800px; display: block; border: none; background: #fff; }
    @media (max-width: 600px) { .pdf-frame { height: 500px; } }

    /* ══ BOOKS GRID ══════════════════════════════════════════ */
    .books-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 18px; }
    .book-card { background: var(--hero-grad); border: 1px solid var(--line-soft); border-radius: 16px; padding: 24px 22px; transition: all 0.2s; display: flex; flex-direction: column; }
    .book-card:hover { border-color: var(--line-accent); transform: translateY(-2px); box-shadow: 0 8px 32px rgba(0,0,0,0.4); }
    .book-card.featured { border-color: var(--line-accent); }
    .book-card-badge { display: inline-flex; align-items: center; gap: 5px; padding: 4px 10px; border-radius: 999px; background: var(--badge-bg); border: 1px solid var(--badge-border); color: var(--badge-text); font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.07em; margin-bottom: 12px; width: fit-content; }
    .book-card h3 { font-family: 'Crimson Text', serif; font-size: 1.25rem; font-weight: 600; color: var(--ink); margin-bottom: 6px; line-height: 1.3; }
    .book-card .book-year { font-size: 0.8rem; color: var(--accent); font-weight: 600; margin-bottom: 8px; }
    .book-card p { font-size: 0.875rem; color: var(--muted); line-height: 1.7; flex: 1; margin-bottom: 16px; }
    .book-card-link { display: inline-flex; align-items: center; gap: 6px; padding: 10px 18px; border-radius: 9px; background: var(--cta-bg); color: #fff; font-weight: 700; font-size: 0.85rem; text-decoration: none; transition: all 0.2s; margin-top: auto; }
    .book-card-link:hover { background: var(--cta-bg-hover); color: #fff; }

    /* ══ BIO SECTION ═════════════════════════════════════════ */
    .bio-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 32px; align-items: start; }
    @media (max-width: 768px) { .bio-grid { grid-template-columns: 1fr; } }
    .bio-portrait { width: 100%; max-width: 340px; border-radius: 16px; object-fit: cover; display: block; border: 1px solid var(--line); }
    .bio-caption { margin-top: 12px; font-size: 0.8rem; color: var(--muted); text-align: center; font-style: italic; }
    .bio-facts { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin: 18px 0; }
    .bio-fact { background: var(--bg-card); border: 1px solid var(--line-soft); border-radius: 10px; padding: 12px 14px; }
    .bio-fact .fact-label { font-size: 0.72rem; color: var(--muted); text-transform: uppercase; letter-spacing: 0.08em; font-weight: 600; margin-bottom: 4px; }
    .bio-fact .fact-value { font-size: 0.9rem; color: var(--accent-soft); font-weight: 600; }
    .bio-content h3 { font-family: 'Crimson Text', serif; font-size: 1.85rem; font-weight: 600; color: var(--ink); margin-bottom: 14px; }
    .bio-content p { font-size: 0.95rem; color: rgba(254,243,199,0.82); line-height: 1.9; margin-bottom: 14px; }

    /* ══ TIMELINE ════════════════════════════════════════════ */
    .timeline-strip { display: flex; overflow: hidden; border-radius: 16px; border: 1px solid var(--line); margin-top: 28px; }
    @media (max-width: 600px) { .timeline-strip { flex-direction: column; } }
    .tl-item { flex: 1; padding: 18px; background: var(--bg-card); border-right: 1px solid var(--line); }
    .tl-item:last-child { border-right: none; }
    .tl-year { font-size: 1.4rem; font-weight: 800; color: var(--accent); display: block; margin-bottom: 4px; }
    .tl-title { font-size: 0.875rem; font-weight: 700; color: var(--ink); margin-bottom: 4px; }
    .tl-desc { font-size: 0.8rem; color: var(--muted); line-height: 1.6; }

    /* ══ RELATED RESOURCES ═══════════════════════════════════ */
    .related-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 14px; }
    .related-card { background: var(--bg-card); border: 1px solid var(--line-soft); border-radius: 14px; padding: 20px 18px; transition: all 0.2s; text-decoration: none; display: block; }
    .related-card:hover { border-color: var(--accent); transform: translateY(-2px); }
    .related-card .r-label { font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.1em; font-weight: 700; color: var(--accent); margin-bottom: 6px; }
    .related-card h4 { font-size: 0.95rem; color: var(--ink); font-weight: 600; margin-bottom: 4px; line-height: 1.3; }
    .related-card p { font-size: 0.8rem; color: var(--muted); line-height: 1.5; }

    /* ══ BACK TO TOP ══════════════════════════════════════════ */
    .btt { position: fixed; bottom: 2rem; right: 2rem; width: 44px; height: 44px; background: var(--badge-bg); border: 1px solid var(--line-accent); border-radius: 50%; color: var(--ink); display: none; align-items: center; justify-content: center; cursor: pointer; z-index: 40; transition: all 0.2s; }
