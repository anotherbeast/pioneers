  <style>
    /* ══ COLOR TOKENS (navy — matches index.astro) ══════════ */
    :root {
      --bg: #0a0a2e; --bg-soft: #0d0d3a; --bg-card: rgba(13,13,58,0.85);
      --ink: #fef3c7; --muted: #9ca3af; --gold: #d4a537; --gold-soft: #fcd34d;
      --line: rgba(212,165,55,0.22); --line-soft: rgba(212,165,55,0.12); --line-accent: rgba(212,165,55,0.35);
    }
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }
    body { font-family: 'Inter', sans-serif; color: var(--ink); background: var(--bg); overflow-x: hidden; }
    a { color: var(--gold); text-decoration: none; transition: color 0.2s; }
    a:hover { color: var(--gold-soft); }

    /* ══ NAV ═════════════════════════════════════════════════ */
    .nav { position: sticky; top: 0; z-index: 100; background: rgba(5,5,30,0.94); backdrop-filter: blur(12px); border-bottom: 1px solid var(--line); }
    .nav-wrap { max-width: 1280px; margin: 0 auto; }
    .nav-row { display: flex; align-items: center; padding: 0 22px; }
    .nav-row-top { gap: 28px; height: 62px; border-bottom: 1px solid rgba(212,165,55,0.10); }
    .nav-row-bottom { gap: 22px; height: 42px; font-size: 0.82rem; overflow-x: auto; scrollbar-width: none; }
    .nav-brand { text-decoration: none; color: var(--ink); font-weight: 700; flex-shrink: 0; display: flex; align-items: center; margin-right: auto; }
    .nav-brand img { height: 38px; width: auto; display: block; border-radius: 4px; }
    .nav-link { color: var(--muted); text-decoration: none; font-weight: 600; font-size: 0.9rem; white-space: nowrap; transition: color 0.18s; }
    .nav-link:hover, .nav-link.active { color: var(--gold-soft); }
    .nav-cta { display: inline-flex; align-items: center; height: 38px; padding: 0 18px; border-radius: 8px; background: var(--gold); color: #111; font-weight: 700; font-size: 0.88rem; text-decoration: none; flex-shrink: 0; transition: background 0.18s; }
    .nav-cta:hover { background: var(--gold-soft); }
    .nav-bottom-link { color: rgba(156,163,175,0.8); text-decoration: none; font-weight: 500; white-space: nowrap; transition: color 0.18s; flex-shrink: 0; }
    .nav-bottom-link:hover { color: var(--gold-soft); }
    .menu-btn { display: none; width: 40px; height: 40px; border: 1px solid var(--line); border-radius: 8px; background: rgba(255,255,255,0.03); color: var(--ink); font-size: 1.2rem; cursor: pointer; flex-shrink: 0; align-items: center; justify-content: center; }
    .mobile-nav { display: none; border-top: 1px solid var(--line); padding: 14px 22px 18px; background: rgba(5,5,30,0.97); }
    .mobile-nav.open { display: grid; gap: 6px; }
    .mobile-nav a { color: var(--muted); text-decoration: none; font-weight: 600; padding: 8px 0; border-bottom: 1px solid rgba(255,255,255,0.05); }
    .mobile-nav a:hover { color: var(--gold-soft); }
    @media (max-width: 860px) { .nav-row-bottom { display: none; } .menu-btn { display: inline-flex; } .nav-link { display: none; } }

    /* ══ PAGE ════════════════════════════════════════════════ */
    .page { max-width: 1100px; margin: 0 auto; padding: 0 22px 100px; }
    .breadcrumb { padding: 22px 0 0; font-size: 0.8rem; color: var(--muted); }
    .breadcrumb a { color: var(--muted); }
    .breadcrumb a:hover { color: var(--gold); }
    .breadcrumb span { margin: 0 6px; }

    /* ══ PIONEER HERO ════════════════════════════════════════ */
    .pioneer-hero { padding: 44px 0 36px; }
    .pioneer-hero-card { background: linear-gradient(135deg, rgba(26,26,78,0.9), rgba(13,13,53,0.95)); border: 1px solid var(--line-accent); border-radius: 24px; padding: 44px 40px; display: grid; grid-template-columns: 280px 1fr; gap: 52px; align-items: start; }
    @media (max-width: 768px) { .pioneer-hero-card { grid-template-columns: 1fr; gap: 28px; padding: 28px 22px; } }

    /* Portrait column */
    .portrait-col { display: flex; flex-direction: column; align-items: center; gap: 16px; }
    .pioneer-portrait { width: 220px; height: 220px; border-radius: 50%; object-fit: cover; object-position: center 45%; border: 3px solid var(--gold); box-shadow: 0 0 48px rgba(212,165,55,0.22); }
    .pioneer-name-lg { font-family: 'Crimson Text', serif; font-size: 1.75rem; font-weight: 600; text-align: center; color: var(--ink); line-height: 1.2; }
    .pioneer-dates { font-size: 0.85rem; color: var(--muted); text-align: center; }
    .pioneer-role-badge { font-size: 0.78rem; color: var(--gold-soft); font-weight: 700; text-transform: uppercase; letter-spacing: 0.09em; padding: 5px 14px; border: 1px solid var(--line-accent); border-radius: 999px; text-align: center; }
    .portrait-links { display: flex; flex-direction: column; gap: 8px; width: 100%; }
    .portrait-link { display: inline-flex; align-items: center; justify-content: center; gap: 6px; padding: 10px 18px; border-radius: 10px; font-weight: 600; font-size: 0.85rem; text-decoration: none; transition: all 0.2s; border: 1px solid var(--line-accent); background: rgba(212,165,55,0.08); color: var(--gold-soft); }
    .portrait-link:hover { background: rgba(212,165,55,0.18); color: #fff; }

    /* Bio column */
    .bio-col { }
    .eyebrow { display: inline-flex; align-items: center; gap: 6px; padding: 5px 14px; border-radius: 999px; background: rgba(212,165,55,0.10); border: 1px solid rgba(212,165,55,0.28); color: var(--gold-soft); font-size: 0.74rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 14px; }
    .bio-col h1 { font-family: 'Crimson Text', serif; font-size: clamp(2rem, 3.5vw, 2.8rem); font-weight: 600; line-height: 1.1; color: var(--ink); margin-bottom: 10px; }
    .bio-col h1 em { font-style: italic; color: var(--gold-soft); }
    .bio-tagline { font-size: 1.05rem; color: rgba(254,243,199,0.8); line-height: 1.85; margin-bottom: 22px; }

    /* Key facts strip */
    .key-facts { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 10px; margin-bottom: 22px; }
    .key-fact { background: var(--bg-card); border: 1px solid var(--line-soft); border-radius: 10px; padding: 12px 14px; }
    .key-fact .kf-label { font-size: 0.7rem; color: var(--muted); text-transform: uppercase; letter-spacing: 0.09em; font-weight: 600; margin-bottom: 4px; }
    .key-fact .kf-value { font-size: 0.88rem; color: var(--gold-soft); font-weight: 600; }

    .btn-row { display: flex; gap: 12px; flex-wrap: wrap; }
    .btn-gold { display: inline-flex; align-items: center; gap: 8px; padding: 13px 24px; border-radius: 12px; background: linear-gradient(to right, #b45309, #d97706); color: #fff; font-weight: 700; font-size: 0.95rem; text-decoration: none; transition: all 0.2s; }
    .btn-gold:hover { background: linear-gradient(to right, #d97706, #f59e0b); color: #fff; }
    .btn-outline { display: inline-flex; align-items: center; gap: 8px; padding: 13px 24px; border-radius: 12px; background: transparent; border: 1px solid var(--line); color: var(--muted); font-weight: 600; font-size: 0.95rem; text-decoration: none; transition: all 0.2s; }
    .btn-outline:hover { border-color: var(--gold); color: var(--gold-soft); }

    /* ══ SECTIONS ════════════════════════════════════════════ */
    .section { padding: 52px 0; border-top: 1px solid var(--line-soft); }
    .section-header { text-align: center; margin-bottom: 36px; }
    .section-header .sh-eyebrow { display: inline-block; padding: 5px 16px; border-radius: 999px; border: 1px solid var(--line); color: var(--gold-soft); letter-spacing: 0.1em; text-transform: uppercase; font-size: 0.73rem; font-weight: 700; margin-bottom: 12px; }
    .section-header h2 { font-family: 'Crimson Text', serif; font-size: clamp(1.8rem, 3.5vw, 2.6rem); font-weight: 600; color: var(--ink); margin-bottom: 8px; }
    .section-header p { color: var(--muted); font-size: 0.97rem; line-height: 1.8; max-width: 640px; margin: 0 auto; }

    /* ══ FULL BIO ════════════════════════════════════════════ */
    .bio-layout { display: grid; grid-template-columns: 1fr 1fr; gap: 40px; align-items: start; }
    @media (max-width: 768px) { .bio-layout { grid-template-columns: 1fr; } }
    .bio-portrait-lg { width: 100%; max-width: 360px; border-radius: 18px; object-fit: cover; display: block; border: 1px solid var(--line); }
    .bio-caption { margin-top: 12px; font-size: 0.8rem; color: var(--muted); font-style: italic; text-align: center; }
    .full-facts { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-top: 18px; }
    .bio-fact { background: var(--bg-card); border: 1px solid var(--line-soft); border-radius: 10px; padding: 12px 14px; }
    .bio-fact .fact-label { font-size: 0.7rem; color: var(--muted); text-transform: uppercase; letter-spacing: 0.09em; font-weight: 600; margin-bottom: 4px; }
    .bio-fact .fact-value { font-size: 0.88rem; color: var(--gold-soft); font-weight: 600; line-height: 1.4; }
    .bio-text h3 { font-family: 'Crimson Text', serif; font-size: 1.85rem; color: var(--ink); margin-bottom: 14px; }
    .bio-text p { font-size: 0.97rem; color: rgba(254,243,199,0.82); line-height: 1.92; margin-bottom: 16px; }
    .bio-text strong { color: var(--gold-soft); }

    /* ══ SCRIPTURE PULL QUOTE ════════════════════════════════ */
    .pull-scripture { background: rgba(212,165,55,0.06); border: 1px solid rgba(212,165,55,0.18); border-left: 4px solid var(--gold); border-radius: 0 14px 14px 0; padding: 20px 24px; margin: 24px 0; }
    .pull-scripture .ref { font-size: 0.75rem; color: var(--gold-soft); font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 8px; }
    .pull-scripture blockquote { font-family: 'Crimson Text', serif; font-size: 1.2rem; font-style: italic; color: #fde68a; line-height: 1.65; }
    .pull-scripture cite { display: block; margin-top: 8px; font-size: 0.8rem; color: rgba(253,230,138,0.6); font-style: normal; }

    /* ══ TIMELINE ════════════════════════════════════════════ */
    .timeline { margin-top: 28px; position: relative; padding-left: 28px; }
    .timeline::before { content: ''; position: absolute; left: 8px; top: 4px; bottom: 4px; width: 2px; background: var(--line); border-radius: 2px; }
    .tl-event { position: relative; margin-bottom: 28px; }
    .tl-event::before { content: ''; position: absolute; left: -24px; top: 6px; width: 10px; height: 10px; border-radius: 50%; background: var(--gold); border: 2px solid var(--bg); box-shadow: 0 0 0 2px var(--gold); }
    .tl-event .tl-year { font-size: 0.8rem; font-weight: 800; color: var(--gold); text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 3px; }
    .tl-event h4 { font-size: 1rem; font-weight: 700; color: var(--ink); margin-bottom: 4px; }
    .tl-event p { font-size: 0.875rem; color: var(--muted); line-height: 1.65; }

    /* ══ BOOKS BY THIS PIONEER ═══════════════════════════════ */
    .books-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 18px; }
    .book-card { background: linear-gradient(135deg, rgba(22,22,68,0.8), rgba(13,13,45,0.9)); border: 1px solid rgba(180,130,50,0.25); border-radius: 16px; padding: 24px 22px; transition: all 0.2s; display: flex; flex-direction: column; }
    .book-card:hover { border-color: rgba(212,165,55,0.5); transform: translateY(-2px); box-shadow: 0 8px 32px rgba(0,0,0,0.4); }
    .book-card h3 { font-family: 'Crimson Text', serif; font-size: 1.2rem; font-weight: 600; color: var(--ink); margin-bottom: 6px; line-height: 1.3; }
    .book-card .book-year { font-size: 0.8rem; color: var(--gold); font-weight: 600; margin-bottom: 8px; }
    .book-card p { font-size: 0.875rem; color: var(--muted); line-height: 1.7; flex: 1; margin-bottom: 16px; }
    .book-card-link { display: inline-flex; align-items: center; gap: 6px; padding: 10px 18px; border-radius: 9px; background: linear-gradient(to right, #b45309, #d97706); color: #fff; font-weight: 700; font-size: 0.85rem; text-decoration: none; transition: all 0.2s; margin-top: auto; }
    .book-card-link:hover { background: linear-gradient(to right, #d97706, #f59e0b); color: #fff; }

    /* ══ RELATED PIONEERS ════════════════════════════════════ */
    .related-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 14px; }
    .related-card { background: rgba(13,13,53,0.7); border: 1px solid var(--line-soft); border-radius: 14px; padding: 20px 18px; transition: all 0.2s; text-decoration: none; display: block; }
    .related-card:hover { border-color: var(--gold); transform: translateY(-2px); }
    .related-card .r-label { font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.1em; font-weight: 700; color: var(--gold); margin-bottom: 6px; }
    .related-card h4 { font-size: 0.95rem; color: var(--ink); font-weight: 600; margin-bottom: 4px; line-height: 1.3; }
    .related-card p { font-size: 0.8rem; color: var(--muted); line-height: 1.5; }

    /* ══ BACK TO TOP ══════════════════════════════════════════ */
    .btt { position: fixed; bottom: 2rem; right: 2rem; width: 44px; height: 44px; background: rgba(212,165,55,0.15); border: 1px solid rgba(212,165,55,0.3); border-radius: 50%; color: var(--ink); display: none; align-items: center; justify-content: center; cursor: pointer; z-index: 40; transition: all 0.2s; }
    .btt.visible { display: flex; }
    .btt:hover { background: rgba(212,165,55,0.28); }
  </style>
</head>
