---
import Analytics from '../components/Analytics.astro';
import SiteFooter from '../components/SiteFooter.astro';
import ShareBar from '../components/ShareBar.astro';
import SiteNav from '../components/SiteNav.astro';
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Babylon Antichrist Library — Books of a New Order &amp; The Testimonicide Exposed | SundayLaw.com</title>
    <meta name="description" content="Ellen White's nightmare dream: she saw a company of Adventist brethren transform into a Catholic procession. The prophecy of 1SM 204 fulfilled in 1904: 'Books of a new order would be written. Our religion would be changed.' The Spirit of Prophecy silenced — this is Testimonicide.">
    <link rel="canonical" href="https://sundaylaw.com/babylon-antichrist-library">
    <meta property="og:title" content="Babylon Antichrist Library — Books of a New Order &amp; The Testimonicide Exposed">
    <meta property="og:description" content="Ellen White's nightmare: a Catholic procession in place of Adventist brethren. 1SM 204 prophecy fulfilled April 15, 1904. 'Our religion would be changed. Books of a new order would be written.'">
    <meta property="og:image" content="https://sundaylaw.com/images/pioneers/ellen-white.jpg">
    <meta property="og:type" content="article">
    <meta property="og:url" content="https://sundaylaw.com/babylon-antichrist-library">
    <meta name="twitter:card" content="summary_large_image">
    <Analytics />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Crimson+Text:ital,wght@0,400;0,600;1,400&display=swap" rel="stylesheet">
    <style>
      :root {
        --bg: #0d0505;
        --bg-soft: #120808;
        --ink: #fef3c7;
        --ink-muted: #9ca3af;
        --gold: #d4a537;
        --gold-soft: #fcd34d;
        --red: #dc2626;
        --red-soft: #ef4444;
        --red-muted: #fca5a5;
        --crimson: #9f1239;
        --line: rgba(220,38,38,0.22);
        --line-gold: rgba(212,165,55,0.22);
        --line-soft: rgba(220,38,38,0.12);
      }
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
      html { scroll-behavior: smooth; }
      body { margin: 0; font-family: 'Inter', sans-serif; color: var(--ink); background: var(--bg); overflow-x: hidden; }
      a { color: var(--red-muted); text-decoration: none; transition: color 0.2s; }
      a:hover { color: #fff; }

      /* ===== NAV ===== */
      .nav { position: sticky; top: 0; z-index: 100; background: rgba(10,2,2,0.96); backdrop-filter: blur(12px); border-bottom: 1px solid var(--line); }
      .nav-wrap { max-width: 1280px; margin: 0 auto; }
      .nav-row { display: flex; align-items: center; padding: 0 22px; }
      .nav-row-top { gap: 28px; height: 62px; border-bottom: 1px solid rgba(220,38,38,0.10); }
      .nav-row-bottom { gap: 22px; height: 42px; font-size: 0.82rem; overflow-x: auto; scrollbar-width: none; }
      .nav-brand { text-decoration: none; color: var(--ink); font-weight: 700; font-size: 1.05rem; flex-shrink: 0; display: flex; align-items: center; margin-right: auto; }
      .nav-brand img { height: 38px; width: auto; display: block; border-radius: 4px; }
      .nav-link { color: var(--ink-muted); text-decoration: none; font-weight: 600; font-size: 0.9rem; white-space: nowrap; transition: color 0.18s; }
      .nav-link:hover { color: var(--red-muted); }
      .nav-cta { display: inline-flex; align-items: center; height: 38px; padding: 0 18px; border-radius: 8px; background: var(--crimson); color: #fff; font-weight: 700; font-size: 0.88rem; text-decoration: none; flex-shrink: 0; transition: background 0.18s; }
      .nav-cta:hover { background: var(--red-soft); color: #fff; }
      .nav-bottom-link { color: rgba(156,163,175,0.8); text-decoration: none; font-weight: 500; white-space: nowrap; transition: color 0.18s; flex-shrink: 0; }
      .nav-bottom-link:hover, .nav-bottom-link.active { color: var(--red-muted); }
      .menu-btn { display: none; width: 40px; height: 40px; border: 1px solid var(--line); border-radius: 8px; background: rgba(255,255,255,0.03); color: var(--ink); font-size: 1.2rem; cursor: pointer; flex-shrink: 0; align-items: center; justify-content: center; }
      .mobile-nav { display: none; border-top: 1px solid var(--line); padding: 14px 22px 18px; background: rgba(10,2,2,0.97); }
      .mobile-nav.open { display: grid; gap: 6px; }
      .mobile-nav a { color: var(--ink-muted); text-decoration: none; font-weight: 600; padding: 8px 0; border-bottom: 1px solid rgba(255,255,255,0.05); }
      .mobile-nav a:hover { color: var(--red-muted); }
      @media (max-width: 860px) { .nav-row-bottom { display: none; } .menu-btn { display: inline-flex; } .nav-link { display: none; } }

      /* ===== PAGE LAYOUT ===== */
      .page { max-width: 1100px; margin: 0 auto; padding: 0 22px 80px; }

      /* ===== HERO ===== */
      .hero { padding: 52px 0 48px; }
      .hero-breadcrumb { font-size: 0.8rem; color: var(--ink-muted); margin-bottom: 18px; }
      .hero-breadcrumb a { color: var(--ink-muted); }
      .hero-breadcrumb a:hover { color: var(--red-muted); }
      .hero-breadcrumb span { margin: 0 6px; }

      /* Alert banner */
      .alert-banner { background: linear-gradient(135deg, rgba(127,0,0,0.35), rgba(80,0,0,0.4)); border: 1px solid rgba(220,38,38,0.5); border-radius: 14px; padding: 20px 24px; margin-bottom: 36px; display: flex; align-items: flex-start; gap: 14px; }
      .alert-icon { font-size: 1.6rem; flex-shrink: 0; line-height: 1; margin-top: 2px; }
      .alert-body h2 { font-family: 'Crimson Text', serif; font-size: 1.4rem; font-weight: 600; color: var(--red-muted); margin-bottom: 6px; }
      .alert-body p { font-size: 0.9rem; color: rgba(254,243,199,0.8); line-height: 1.75; }
      .alert-body strong { color: var(--red-muted); }

      /* Page header */
      .page-header { margin-bottom: 48px; }
      .page-eyebrow { display: inline-flex; align-items: center; gap: 6px; padding: 5px 14px; border-radius: 999px; background: rgba(159,18,57,0.15); border: 1px solid rgba(159,18,57,0.4); color: var(--red-muted); font-size: 0.74rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 16px; }
      .page-header h1 { font-family: 'Crimson Text', serif; font-size: clamp(2.2rem, 5vw, 3.5rem); font-weight: 600; line-height: 1.1; color: var(--ink); margin-bottom: 12px; }
      .page-header h1 em { font-style: italic; color: var(--red-muted); }
      .page-header .subtitle { font-size: 1.05rem; color: rgba(254,243,199,0.75); line-height: 1.85; max-width: 720px; }

      /* ===== SECTIONS ===== */
      .section { padding: 48px 0; border-top: 1px solid var(--line-soft); }
      .section-header { margin-bottom: 28px; }
      .sh-eyebrow { display: inline-block; padding: 4px 14px; border-radius: 999px; border: 1px solid var(--line); color: var(--red-muted); letter-spacing: 0.1em; text-transform: uppercase; font-size: 0.72rem; font-weight: 700; margin-bottom: 10px; }
      .section-header h2 { font-family: 'Crimson Text', serif; font-size: clamp(1.7rem, 3.5vw, 2.4rem); font-weight: 600; color: var(--ink); margin-bottom: 8px; line-height: 1.2; }
      .section-header p { color: var(--ink-muted); font-size: 0.97rem; line-height: 1.8; }
      .section-header h2 em { color: var(--red-muted); font-style: italic; }

      /* ===== DREAM CARD (centerpiece) ===== */
      .dream-card { background: linear-gradient(135deg, rgba(60,0,0,0.6), rgba(15,5,5,0.95)); border: 1px solid rgba(220,38,38,0.4); border-radius: 24px; overflow: hidden; }
      .dream-card-top { background: linear-gradient(to right, rgba(159,18,57,0.3), rgba(80,0,0,0.4)); padding: 22px 28px 20px; border-bottom: 1px solid rgba(220,38,38,0.25); display: flex; align-items: center; gap: 14px; }
      .dream-card-top .source-badge { display: inline-flex; padding: 4px 12px; border-radius: 999px; background: rgba(159,18,57,0.25); border: 1px solid rgba(220,38,38,0.4); font-size: 0.75rem; font-weight: 700; color: var(--red-muted); letter-spacing: 0.08em; text-transform: uppercase; }
      .dream-card-top h3 { font-family: 'Crimson Text', serif; font-size: 1.35rem; color: var(--red-muted); font-weight: 600; }
      .dream-body { padding: 28px 32px 32px; }
      @media (max-width: 600px) { .dream-body { padding: 22px 18px 24px; } }
      .dream-preface { font-size: 0.92rem; color: rgba(254,243,199,0.7); line-height: 1.8; margin-bottom: 22px; font-style: italic; border-left: 3px solid rgba(220,38,38,0.4); padding-left: 16px; }
      .dream-quote { font-family: 'Crimson Text', serif; font-size: 1.2rem; color: rgba(254,243,199,0.95); line-height: 1.9; margin-bottom: 12px; }
      .dream-quote strong { color: #fca5a5; }
      .dream-citation { display: flex; align-items: center; gap: 10px; margin-top: 20px; padding-top: 16px; border-top: 1px solid rgba(220,38,38,0.2); }
      .dream-citation .cite-icon { font-size: 1.2rem; }
      .dream-citation cite { font-family: 'Crimson Text', serif; font-size: 0.95rem; color: var(--gold); font-style: italic; }

      /* ===== PROPHECY CARD (1SM 204) ===== */
      .prophecy-card { background: linear-gradient(135deg, rgba(40,20,0,0.7), rgba(15,10,5,0.95)); border: 1px solid rgba(212,165,55,0.3); border-radius: 20px; padding: 32px 30px; margin-bottom: 28px; }
      @media (max-width: 600px) { .prophecy-card { padding: 22px 18px; } }
      .prophecy-card .p-eyebrow { font-size: 0.72rem; color: var(--gold); text-transform: uppercase; letter-spacing: 0.1em; font-weight: 700; margin-bottom: 10px; }
      .prophecy-card .p-source { font-size: 0.78rem; color: rgba(212,165,55,0.7); margin-bottom: 14px; }
      .prophecy-quote { font-family: 'Crimson Text', serif; font-size: 1.2rem; color: rgba(254,243,199,0.95); line-height: 1.9; }
      .prophecy-quote .highlight { color: var(--gold-soft); font-weight: 600; }
      .prophecy-quote .danger { color: var(--red-muted); font-weight: 600; }

      /* ===== BOOKS OF A NEW ORDER LIST ===== */
      .books-new-order { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 16px; }
      .new-order-book { background: linear-gradient(135deg, rgba(20,5,5,0.9), rgba(30,10,10,0.95)); border: 1px solid rgba(220,38,38,0.25); border-radius: 14px; padding: 22px 20px; transition: all 0.2s; display: flex; flex-direction: column; gap: 8px; }
      .new-order-book:hover { border-color: rgba(220,38,38,0.5); transform: translateY(-2px); box-shadow: 0 8px 28px rgba(0,0,0,0.5); }
      .nob-badge { display: inline-flex; align-items: center; gap: 5px; padding: 3px 10px; border-radius: 999px; font-size: 0.7rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.07em; width: fit-content; background: rgba(159,18,57,0.15); border: 1px solid rgba(159,18,57,0.35); color: #fca5a5; }
      .nob-title { font-family: 'Crimson Text', serif; font-size: 1.15rem; font-weight: 600; color: var(--ink); line-height: 1.3; }
      .nob-author { font-size: 0.82rem; color: var(--gold); font-weight: 600; }
      .nob-desc { font-size: 0.85rem; color: var(--ink-muted); line-height: 1.65; flex: 1; }

      /* ===== PIONEERS VS NEW ORDER TABLE ===== */
      .compare-table { width: 100%; border-collapse: collapse; border-radius: 16px; overflow: hidden; font-size: 0.9rem; }
      .compare-table thead { background: rgba(20,10,10,0.9); }
      .compare-table thead th { padding: 14px 20px; text-align: left; font-size: 0.78rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; }
      .compare-table thead th:first-child { color: var(--gold-soft); border-bottom: 1px solid rgba(212,165,55,0.3); }
      .compare-table thead th:last-child { color: var(--red-muted); border-bottom: 1px solid rgba(220,38,38,0.3); }
      .compare-table thead th:nth-child(2) { color: var(--ink-muted); font-size: 0.72rem; border-bottom: 1px solid rgba(255,255,255,0.1); width: 32px; }
      .compare-table tbody tr { border-bottom: 1px solid rgba(255,255,255,0.06); transition: background 0.15s; }
      .compare-table tbody tr:hover { background: rgba(220,38,38,0.05); }
      .compare-table td { padding: 14px 20px; vertical-align: top; line-height: 1.7; }
      .compare-table td:first-child { color: rgba(254,243,199,0.9); background: rgba(15,10,5,0.5); }
      .compare-table td:last-child { color: rgba(252,165,165,0.85); background: rgba(15,5,5,0.5); }
      .compare-table td:nth-child(2) { text-align: center; color: var(--ink-muted); font-weight: 700; }
      .compare-label { font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.08em; font-weight: 700; margin-bottom: 4px; }
      .compare-table td:first-child .compare-label { color: var(--gold); }
      .compare-table td:last-child .compare-label { color: var(--red-muted); }

      /* ===== SIGNATORIES ===== */
      .signatories-card { background: linear-gradient(135deg, rgba(40,0,0,0.6), rgba(12,5,5,0.95)); border: 2px solid rgba(220,38,38,0.4); border-radius: 20px; overflow: hidden; }
      .signatories-header { background: linear-gradient(to right, rgba(120,0,0,0.5), rgba(60,0,0,0.4)); padding: 20px 28px; border-bottom: 1px solid rgba(220,38,38,0.3); }
      .signatories-header h3 { font-family: 'Crimson Text', serif; font-size: 1.5rem; color: var(--red-muted); font-weight: 600; margin-bottom: 4px; }
      .signatories-header p { font-size: 0.85rem; color: rgba(252,165,165,0.7); }
      .signatories-list { padding: 22px 28px; display: grid; gap: 12px; }
      .signatory-row { display: flex; align-items: center; gap: 14px; padding: 14px 18px; background: rgba(30,5,5,0.6); border: 1px solid rgba(220,38,38,0.15); border-radius: 12px; }
      .sig-num { width: 32px; height: 32px; border-radius: 50%; background: rgba(159,18,57,0.25); border: 1px solid rgba(159,18,57,0.4); display: flex; align-items: center; justify-content: center; font-size: 0.8rem; font-weight: 800; color: var(--red-muted); flex-shrink: 0; }
      .sig-info { flex: 1; }
      .sig-name { font-weight: 700; color: var(--ink); font-size: 0.95rem; }
      .sig-location { font-size: 0.8rem; color: var(--ink-muted); margin-top: 2px; }
      .sig-role { font-size: 0.75rem; color: var(--red-muted); font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em; }

      /* ===== TESTIMONY PULL QUOTES ===== */
      .pull-quote-box { background: linear-gradient(135deg, rgba(30,5,5,0.7), rgba(10,5,5,0.9)); border: 1px solid rgba(220,38,38,0.25); border-left: 5px solid var(--red-soft); border-radius: 0 16px 16px 0; padding: 24px 26px; margin-bottom: 20px; }
      .pull-quote-box blockquote { font-family: 'Crimson Text', serif; font-size: 1.15rem; font-style: italic; color: rgba(254,243,199,0.9); line-height: 1.85; }
      .pull-quote-box cite { display: block; margin-top: 12px; font-size: 0.82rem; color: var(--gold); font-style: normal; font-weight: 600; }
      .pull-quote-box .case-ref { display: block; margin-top: 4px; font-size: 0.75rem; color: rgba(156,163,175,0.7); font-style: normal; }

      /* ===== TESTIMONICIDE DEFINITION ===== */
      .definition-card { background: linear-gradient(135deg, rgba(10,5,20,0.9), rgba(20,5,5,0.95)); border: 1px solid rgba(180,130,50,0.2); border-radius: 20px; padding: 36px 32px; margin-bottom: 24px; }
      @media (max-width: 600px) { .definition-card { padding: 22px 18px; } }
      .def-word { font-family: 'Crimson Text', serif; font-size: 2.2rem; font-weight: 600; color: var(--red-muted); margin-bottom: 4px; }
      .def-pronunciation { font-size: 0.85rem; color: var(--ink-muted); margin-bottom: 14px; font-style: italic; }
      .def-meaning { font-size: 1rem; color: rgba(254,243,199,0.85); line-height: 1.85; margin-bottom: 16px; }
      .def-egw { font-family: 'Crimson Text', serif; font-size: 1.1rem; font-style: italic; color: var(--gold-soft); line-height: 1.8; border-top: 1px solid rgba(212,165,55,0.2); padding-top: 16px; }
      .def-egw cite { display: block; margin-top: 8px; font-size: 0.82rem; color: var(--gold); font-style: normal; }

      /* ===== CTA FLEE CARD ===== */
      .flee-card { background: linear-gradient(135deg, rgba(60,0,0,0.5), rgba(20,5,5,0.9)); border: 2px solid rgba(220,38,38,0.5); border-radius: 20px; padding: 40px 36px; text-align: center; }
      @media (max-width: 600px) { .flee-card { padding: 28px 20px; } }
      .flee-card h3 { font-family: 'Crimson Text', serif; font-size: clamp(1.7rem, 4vw, 2.5rem); color: var(--red-muted); margin-bottom: 14px; font-weight: 600; }
      .flee-card p { font-size: 0.97rem; color: rgba(254,243,199,0.8); line-height: 1.85; max-width: 640px; margin: 0 auto 24px; }
      .flee-btn-row { display: flex; gap: 14px; justify-content: center; flex-wrap: wrap; }
      .btn-crimson { display: inline-flex; align-items: center; gap: 8px; padding: 14px 28px; border-radius: 12px; background: linear-gradient(to right, #7f1d1d, #b91c1c); color: #fff; font-weight: 700; font-size: 0.95rem; text-decoration: none; transition: all 0.2s; }
      .btn-crimson:hover { background: linear-gradient(to right, #b91c1c, #dc2626); color: #fff; transform: translateY(-1px); }
      .btn-gold { display: inline-flex; align-items: center; gap: 8px; padding: 14px 28px; border-radius: 12px; background: linear-gradient(to right, #b45309, #d97706); color: #fff; font-weight: 700; font-size: 0.95rem; text-decoration: none; transition: all 0.2s; }
      .btn-gold:hover { background: linear-gradient(to right, #d97706, #f59e0b); color: #fff; transform: translateY(-1px); }
      .btn-outline { display: inline-flex; align-items: center; gap: 8px; padding: 14px 24px; border-radius: 12px; background: transparent; border: 1px solid rgba(220,38,38,0.4); color: var(--red-muted); font-weight: 600; font-size: 0.95rem; text-decoration: none; transition: all 0.2s; }
      .btn-outline:hover { border-color: var(--red-soft); color: #fff; }

      /* ===== RELATED GRID ===== */
      .related-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 14px; }
      .related-card { background: rgba(20,5,5,0.7); border: 1px solid var(--line-soft); border-radius: 14px; padding: 20px 18px; transition: all 0.2s; text-decoration: none; display: block; }
      .related-card:hover { border-color: var(--red-soft); transform: translateY(-2px); }
      .related-card .r-label { font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.1em; font-weight: 700; color: var(--red-muted); margin-bottom: 6px; }
      .related-card h4 { font-size: 0.95rem; color: var(--ink); font-weight: 600; margin-bottom: 4px; line-height: 1.3; }
      .related-card p { font-size: 0.8rem; color: var(--ink-muted); line-height: 1.5; }

      /* ===== TIMELINE ===== */
      .timeline { display: flex; flex-direction: column; gap: 0; position: relative; padding-left: 32px; }
      .timeline::before { content: ''; position: absolute; left: 11px; top: 8px; bottom: 8px; width: 2px; background: linear-gradient(to bottom, rgba(220,38,38,0.6), rgba(220,38,38,0.1)); }
      .tl-event { position: relative; padding: 0 0 28px 24px; }
      .tl-event::before { content: ''; position: absolute; left: -21px; top: 5px; width: 12px; height: 12px; border-radius: 50%; background: var(--red); border: 2px solid rgba(220,38,38,0.5); }
      .tl-event-year { font-size: 0.82rem; color: var(--red-muted); font-weight: 800; text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 4px; }
      .tl-event-title { font-weight: 700; color: var(--ink); font-size: 0.97rem; margin-bottom: 4px; }
      .tl-event-desc { font-size: 0.86rem; color: var(--ink-muted); line-height: 1.65; }

      /* ===== FOOTER ===== */
      .site-footer { background: #050108; border-top: 1px solid rgba(220,38,38,0.2); }
      .footer-banner { background: linear-gradient(to right, rgba(120,0,0,0.2), rgba(80,0,0,0.1), rgba(120,0,0,0.2)); padding: 24px; text-align: center; }
      .footer-banner p { font-family: 'Crimson Text', serif; color: #fde68a; font-size: 1.1rem; font-style: italic; }
      .footer-banner cite { color: var(--gold); font-size: 0.875rem; font-weight: 600; font-style: normal; display: block; margin-top: 6px; }
      .footer-main { max-width: 1280px; margin: 0 auto; padding: 56px 22px; display: grid; gap: 2.5rem; }
      @media (min-width: 768px) { .footer-main { grid-template-columns: 2fr 1fr 1fr 1fr; } }
      .footer-col h4 { color: var(--red-muted); font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.15em; margin-bottom: 16px; }
      .footer-col p { color: var(--ink-muted); font-size: 0.875rem; line-height: 1.7; }
      .footer-col ul { list-style: none; }
      .footer-col li { padding: 4px 0; }
      .footer-col li a { color: var(--ink-muted); font-size: 0.875rem; transition: color 0.2s; text-decoration: none; }
      .footer-col li a:hover { color: var(--red-muted); }
      .footer-brand-name { display: flex; align-items: center; gap: 8px; margin-bottom: 12px; font-weight: 700; font-size: 1.1rem; color: #fff; }
      .footer-brand-name em { color: var(--gold); font-style: normal; }
      .footer-bottom { border-top: 1px solid rgba(220,38,38,0.1); padding: 20px 22px; text-align: center; }
      .footer-bottom p { color: #6b7280; font-size: 0.78rem; }
      .footer-stripe { height: 4px; background: linear-gradient(to right, #7f1d1d, #dc2626, #7f1d1d); }

      /* ===== BACK TO TOP ===== */
