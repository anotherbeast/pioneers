---
import Analytics from '../components/Analytics.astro';
import SiteFooter from '../components/SiteFooter.astro';
import ShareBar from '../components/ShareBar.astro';
import SiteNav from '../components/SiteNav.astro';
const title = "Religious Liberty in America | Constitution, Sunday Law, Revelation 13, Church and State";
const description = "A Protestant Adventist case for religious liberty in America: the First Amendment, the old Protestant path, the danger of church and state union, the Sunday law issue, Revelation 13, the 1904 Washington incorporation, Charles Fitch, A. T. Jones, the 1843 and 1850 charts, the law of God, and William Tyndale.";
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <Analytics />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="keywords" content="religious liberty america, constitution sunday law, revelation 13 church and state, first amendment religion, 1904 incorporation washington dc, general conference corporation, charles fitch come out of her my people, AT Jones sunday law, william tyndale, 1843 chart, 1850 chart, ten commandments" />
  <meta property="og:title" content="Religious Liberty in America | Constitution, Sunday Law, Revelation 13">
  <meta property="og:description" content={description} />
  <meta property="og:image" content="https://sundaylaw.com/images/religious_liberty_america_constitution_sunday_law_hero.jpg">
  <meta property="og:type" content="article">
  <meta property="og:url" content="https://sundaylaw.com/religious-liberty">
  <link rel="canonical" href="/religious-liberty" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,500;1,600&family=Source+Sans+3:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <style>
    :root {
      --bg: #060b17;
      --ink: #f8f1dd;
      --muted: #d3c39d;
      --line: rgba(214,167,69,0.28);
      --gold: #d6a745;
      --amber: #f0be5c;
      --gold-soft: #f5d98a;
    }
    *, *::before, *::after { box-sizing: border-box; }
    body {
      margin: 0; padding: 0;
      font-family: 'Source Sans 3', sans-serif;
      color: var(--ink);
      background:
        radial-gradient(circle at 78% 14%, rgba(214,167,69,0.13), transparent 36%),
        radial-gradient(circle at 18% 80%, rgba(92,111,160,0.15), transparent 40%),
        linear-gradient(160deg, #050914 0%, #091125 52%, #060b16 100%);
      min-height: 100vh;
    }
    .serif { font-family: 'Cormorant Garamond', serif; }
    img { max-width: 100%; height: auto; display: block; }
    a { color: var(--amber); text-decoration: none; }
    a:hover { text-decoration: underline; }

    /* ===== TOPBAR ===== */
    .topbar {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      z-index: 70;
      background: rgba(7,10,16,0.82);
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
      border-bottom: 1px solid rgba(214,167,69,0.18);
    }
    .topbar-wrap {
      max-width: 1280px;
      margin: 0 auto;
      padding: 0 16px;
    }
    .topbar-row {
      display: flex;
      align-items: center;
      gap: 16px;
    }
    .topbar-row-top {
      min-height: 74px;
    }
    .topbar-row-bottom {
      min-height: 44px;
      border-top: 1px solid rgba(255,255,255,0.06);
      padding-bottom: 6px;
    }
    .brand {
      display: flex;
      align-items: center;
      gap: 10px;
      color: var(--ink);
      font-weight: 700;
      font-size: 1.1rem;
      text-decoration: none;
      flex: 0 0 auto;
    }
    .brand strong {
      color: var(--gold);
    }
    .nav-links {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 10px;
    }
    .nav-links-top {
      margin-left: 10px;
      flex: 1 1 auto;
    }
    .nav-links-bottom {
      width: 100%;
      justify-content: center;
      gap: 16px;
    }
    .nav-link {
      padding: 6px 11px;
      border-radius: 8px;
      font-size: 0.88rem;
      font-weight: 600;
      color: rgba(255,255,255,0.92);
      border: 1px solid transparent;
      transition: all .2s;
      white-space: nowrap;
    }
    .nav-link-small {
      font-size: 0.82rem;
      font-weight: 500;
      color: rgba(255,255,255,0.84);
    }
    .nav-link:hover {
      color: var(--amber);
      border-color: var(--line);
      background: rgba(214,167,69,0.07);
      text-decoration: none;
    }
    .nav-cta {
      margin-left: auto;
      flex: 0 0 auto;
      background: linear-gradient(135deg, #b45309, #d97706);
      color: #fff;
      text-decoration: none;
      font-weight: 700;
      font-size: 0.84rem;
      padding: 0.78rem 0.98rem;
      border-radius: 0 0 14px 14px;
      box-shadow: 0 10px 24px rgba(0,0,0,0.22);
      white-space: nowrap;
    }
    .nav-cta:hover {
      filter: brightness(1.05);
      text-decoration: none;
      color: #fff;
    }
    .nav-mobile-btn {
      display: none;
      margin-left: auto;
      background: none;
      border: none;
      color: #fff;
      cursor: pointer;
      padding: 8px;
      border-radius: 8px;
    }
    .nav-mobile-btn:hover {
      background: rgba(255,255,255,0.08);
    }
    .nav-mobile {
      display: none;
      padding: 0 20px 18px;
      background: rgba(7,10,16,0.97);
      border-top: 1px solid rgba(214,167,69,0.12);
    }
    .nav-mobile a {
      display: block;
      color: #fff;
      text-decoration: none;
      padding: 0.9rem 0;
      border-bottom: 1px solid rgba(255,255,255,0.08);
      font-weight: 500;
      font-size: 0.92rem;
    }
    .nav-mobile .mobile-cta {
      margin-top: 10px;
      padding: 0.95rem 1rem;
      text-align: center;
      border: none;
      border-radius: 0.7rem;
      background: linear-gradient(135deg, #b45309, #d97706);
      font-weight: 700;
    }
    .nav-mobile.open {
      display: block;
    }
    @media (max-width: 1180px) {
      .topbar-row-bottom {
        display: none;
      }
      .nav-link {
        font-size: 0.84rem;
      }
    }
    @media (max-width: 980px) {
      .nav-links-top,
      .topbar-row-bottom,
      .nav-cta {
        display: none;
      }
      .nav-mobile-btn {
        display: inline-flex;
      }
      .topbar-row-top {
        min-height: 76px;
      }
    }

    /* ===== HERO ===== */
    .hero {
      position: relative; overflow: hidden;
      padding: 188px 24px 82px;
      text-align: center;
      background: linear-gradient(160deg, #07101f 0%, #0b1830 55%, #071020 100%);
      border-bottom: 1px solid var(--line);
    }
    .hero-bg {
      position: absolute;
      inset: 0;
      z-index: 0;
    }
    .hero-bg img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: 54% center;
      filter: saturate(1.12) contrast(1.08) brightness(1.04);
    }
    .hero-overlay {
      position: absolute;
      inset: 0;
      background: linear-gradient(to bottom, rgba(0,0,0,0.36) 0%, rgba(0,0,0,0.2) 20%, rgba(0,0,0,0.24) 48%, rgba(0,0,0,0.42) 100%);
    }
    .hero-overlay2 {
      position: absolute;
      inset: 0;
      background: radial-gradient(circle at 50% 42%, rgba(0,0,0,0.03) 0%, rgba(0,0,0,0.14) 42%, rgba(0,0,0,0.28) 100%);
    }
    .hero-stripe {
      position: absolute;
      inset: 0;
      z-index: 1;
      pointer-events: none;
      background: linear-gradient(to bottom, rgba(0,0,0,0.22), rgba(0,0,0,0.03) 24%, rgba(0,0,0,0.3));
    }
    .hero::before {
      content: '';
      position: absolute; inset: 0;
      background: radial-gradient(ellipse at 50% 0%, rgba(214,167,69,0.16), transparent 65%);
      pointer-events: none;
      z-index: 1;
    }
    .hero-inner { position: relative; z-index: 2; max-width: 860px; margin: 0 auto; }
    .hero-inner::before {
      content: '';
      position: absolute;
      inset: -20px -24px;
      z-index: -1;
      border-radius: 24px;
      background: linear-gradient(180deg, rgba(5,10,24,0.32), rgba(5,10,24,0.44));
      border: 1px solid rgba(255,255,255,0.08);
      backdrop-filter: blur(6px);
      -webkit-backdrop-filter: blur(6px);
    }
    .eyebrow {
      display: inline-block; margin-bottom: 18px;
      padding: 5px 14px; border-radius: 999px;
      background: rgba(214,167,69,0.12); border: 1px solid rgba(214,167,69,0.35);
      color: var(--amber); font-size: 0.78rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em;
    }
    .hero h1 { font-size: clamp(2.4rem, 6vw, 4.9rem); font-weight: 700; margin: 0 0 20px; line-height: 1.08; color: #fff; text-shadow: 0 2px 10px rgba(0,0,0,0.58), 0 1px 2px rgba(0,0,0,0.45); }
    .hero h1 span { color: #f0c36d; text-shadow: 0 2px 10px rgba(0,0,0,0.58), 0 1px 2px rgba(0,0,0,0.45); }
    .hero-sub { font-size: clamp(1.25rem, 3vw, 1.85rem); color: #f3dfad; line-height: 1.35; max-width: 780px; margin: 0 auto 14px; font-style: italic; text-shadow: 0 1px 8px rgba(0,0,0,0.52), 0 1px 2px rgba(0,0,0,0.4); }
    .hero-desc { font-size: 1.04rem; color: rgba(255,255,255,0.96); line-height: 1.85; max-width: 820px; margin: 0 auto 28px; text-shadow: 0 1px 8px rgba(0,0,0,0.52), 0 1px 2px rgba(0,0,0,0.4); }
    .hero-btns { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; margin-bottom: 40px; }
    .btn-gold {
      display: inline-block; padding: 13px 26px; border-radius: 10px;
      background: var(--gold); color: #111; font-weight: 700; font-size: 0.95rem;
      border: none; cursor: pointer; transition: all .2s;
    }
    .btn-gold:hover { background: var(--amber); transform: translateY(-2px); text-decoration: none; color: #111; }
    .btn-outline {
      display: inline-block; padding: 12px 24px; border-radius: 10px;
      border: 1px solid rgba(214,167,69,0.45); color: var(--amber); font-weight: 700; font-size: 0.95rem;
      background: transparent; cursor: pointer; transition: all .2s;
    }
    .btn-outline:hover { background: rgba(214,167,69,0.1); transform: translateY(-2px); text-decoration: none; }
    .hero-stats { display: flex; gap: 32px; justify-content: center; flex-wrap: wrap; }
    .hero-stat { text-align: center; }
    .hero-stat .num { font-size: 2.2rem; font-weight: 700; color: var(--gold); font-family: 'Cormorant Garamond', serif; }
    .hero-stat .lbl { font-size: 0.78rem; color: var(--muted); text-transform: uppercase; letter-spacing: 0.07em; line-height: 1.4; margin-top: 4px; }

    /* ===== SECTION ===== */
    .section { padding: 72px 24px; }
    .section-dark { background: rgba(4,8,20,0.65); }
    .section-warm { background: linear-gradient(160deg, rgba(25,18,4,0.85), rgba(8,12,28,0.9)); }
    .section-red { background: linear-gradient(160deg, rgba(40,5,5,0.85), rgba(8,12,28,0.9)); }
    .section-inner { max-width: 1100px; margin: 0 auto; }
    .section-narrow { max-width: 820px; margin: 0 auto; }

    /* ===== SECTION HEADING ===== */
    .sh { text-align: center; margin-bottom: 44px; }
    .sh-deco { display: flex; align-items: center; justify-content: center; gap: 12px; margin-bottom: 16px; }
    .sh-line { width: 48px; height: 2px; background: linear-gradient(to right, transparent, var(--gold)); }
    .sh-line:last-child { background: linear-gradient(to left, transparent, var(--gold)); }
    .sh-star { width: 18px; height: 18px; color: var(--gold); }
    .sh h2 { font-size: clamp(1.7rem, 3.5vw, 2.6rem); font-weight: 700; color: var(--gold-soft); margin: 0 0 14px; }
    .sh p { color: var(--muted); line-height: 1.85; max-width: 760px; margin: 0 auto; }

    /* ===== GRID ===== */
    .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 28px; }
    @media (max-width: 820px) { .grid-2 { grid-template-columns: 1fr; } }
    .grid-3 { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 20px; }

    /* ===== QUOTE CARDS ===== */
    .sq {
      border-radius: 16px; padding: 22px 26px; margin-bottom: 20px;
      border: 1px solid var(--line);
    }
    .sq-gold { background: linear-gradient(135deg, rgba(20,14,2,0.8), rgba(8,12,28,0.9)); border-color: rgba(214,167,69,0.4); }
    .sq-dark { background: rgba(4,8,20,0.6); border-color: rgba(214,167,69,0.2); }
    .sq p { color: var(--ink); line-height: 1.85; margin: 0 0 10px; font-size: 1.05rem; }
    .sq cite { color: var(--muted); font-size: 0.85rem; font-style: italic; }
    .sq h3 { color: var(--gold-soft); font-size: 1.3rem; margin-bottom: 12px; }
    .sq ul { margin: 0; padding-left: 1.2rem; color: var(--muted); line-height: 1.9; }

    /* ===== EGW QUOTE ===== */
    .egw {
      position: relative; border-radius: 14px; padding: 22px 22px 22px 28px;
      background: linear-gradient(135deg, rgba(10,18,5,0.8), rgba(4,10,22,0.9));
      border: 1px solid rgba(100,160,80,0.28); margin-bottom: 20px;
    }
    .egw::before { content: '\201C'; position: absolute; top: -8px; left: 16px; font-size: 4rem; color: rgba(100,180,80,0.25); font-family: serif; line-height: 1; }
    .egw p { color: var(--ink); font-style: italic; line-height: 1.85; margin: 0 0 10px; font-size: 1.05rem; }
    .egw cite { color: var(--muted); font-size: 0.85rem; }

    /* ===== CARD ===== */
    .card {
      background: linear-gradient(180deg, rgba(14,18,44,0.92), rgba(7,12,30,0.95));
      border: 1px solid rgba(214,167,69,0.2); border-radius: 16px; padding: 24px;
      box-shadow: 0 16px 40px rgba(0,0,0,0.22);
    }
    .card h3 { color: var(--gold-soft); margin: 0 0 12px; font-size: 1.35rem; }
    .card p { color: var(--muted); line-height: 1.85; margin: 0; }

    /* ===== CALLOUT ===== */
    .callout {
      border-radius: 16px; padding: 22px 26px; margin: 24px 0;
      border: 1px solid rgba(220,60,60,0.35);
      background: rgba(40,5,5,0.4);
    }
    .callout-gold { border-color: rgba(214,167,69,0.45); background: rgba(20,14,2,0.5); }
    .callout h4 { color: var(--amber); margin: 0 0 12px; font-size: 1.1rem; font-family: 'Cormorant Garamond', serif; }
    .callout p { color: var(--muted); line-height: 1.85; margin: 0 0 10px; }

    /* ===== PROOF FRAME (embed) ===== */
    .proof-frame {
      margin-top: 20px; border: 1px solid rgba(214,167,69,0.28);
      border-radius: 16px; overflow: hidden;
      background: rgba(255,255,255,0.02);
      box-shadow: 0 18px 40px rgba(0,0,0,0.25);
    }
    .proof-frame .embed-label {
      padding: 12px 18px; color: var(--gold); font-weight: 700;
      letter-spacing: 0.04em; text-transform: uppercase; font-size: 0.82rem;
      border-bottom: 1px solid rgba(214,167,69,0.15);
    }
    .proof-frame iframe { width: 100%; min-height: 780px; border: none; background: #fff; }

    /* ===== DOC CARD ===== */
    .doc-card {
      background: linear-gradient(135deg, rgba(20,18,50,0.88), rgba(8,10,32,0.92));
      border: 1px solid rgba(180,140,50,0.28); border-radius: 20px; overflow: hidden;
      box-shadow: 0 20px 50px rgba(0,0,0,0.3);
    }
    .doc-card-top {
      display: flex; align-items: center; justify-content: space-between; gap: 12px;
      padding: 14px 18px; border-bottom: 1px solid rgba(180,140,50,0.18);
      background: linear-gradient(to right, rgba(180,83,9,0.12), rgba(214,167,69,0.05));
      flex-wrap: wrap;
    }
    .doc-kicker { color: var(--amber); font-size: 0.8rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; }
    .doc-actions { display: flex; gap: 8px; flex-wrap: wrap; }
    .doc-btn {
      display: inline-flex; align-items: center; justify-content: center;
      min-height: 36px; padding: 0 12px; border-radius: 9px;
      border: 1px solid rgba(214,167,69,0.3); background: rgba(255,255,255,0.05);
      color: var(--ink); font-size: 0.8rem; font-weight: 700; cursor: pointer;
      transition: all .2s; text-decoration: none;
    }
    .doc-btn:hover { color: #111; background: var(--amber); border-color: var(--amber); text-decoration: none; }
    .doc-frame-wrap { position: relative; padding: 16px; background: rgba(2,6,23,0.9); }
    .doc-frame { width: 100%; height: 700px; border: 1px solid rgba(180,140,50,0.2); border-radius: 16px; background: #fff; }
    .exhibit-stamp {
      position: absolute; top: 30px; right: 30px; z-index: 3;
      padding: 8px 14px; border: 2px solid rgba(239,68,68,0.6);
      color: rgba(248,113,113,0.9); background: rgba(127,29,29,0.1);
      border-radius: 10px; font-weight: 800; letter-spacing: 0.12em; text-transform: uppercase;
      transform: rotate(-8deg); pointer-events: none;
    }
    .doc-note { padding: 0 18px 16px; color: var(--muted); font-size: 0.88rem; line-height: 1.6; }

    /* ===== MODAL ===== */
    .doc-modal { position: fixed; inset: 0; z-index: 2000; display: none; }
    .doc-modal.open { display: block; }
    .doc-modal-backdrop { position: absolute; inset: 0; background: rgba(2,6,23,0.8); backdrop-filter: blur(5px); }
    .doc-modal-panel {
      position: relative; z-index: 2;
      width: min(1280px, 96vw); height: min(90vh, 920px);
      margin: 4vh auto 0;
      background: linear-gradient(180deg, #0a0a2e, #0d0d35);
      border: 1px solid rgba(180,140,50,0.28); border-radius: 20px;
      box-shadow: 0 34px 80px rgba(0,0,0,0.5); overflow: hidden;
    }
    .doc-modal-top {
      display: flex; align-items: center; justify-content: space-between; gap: 12px;
      padding: 14px 16px; border-bottom: 1px solid rgba(180,140,50,0.2);
      background: rgba(255,255,255,0.02); flex-wrap: wrap;
    }
    .doc-modal-title { color: var(--gold-soft); font-size: 1.1rem; font-weight: 700; font-family: 'Cormorant Garamond', serif; }
    .doc-modal-frame { width: 100%; height: calc(100% - 66px); border: 0; background: #fff; }

    /* ===== VIDEO ===== */
    .video-frame { border-radius: 16px; overflow: hidden; background: #000; box-shadow: 0 20px 50px rgba(0,0,0,0.4); }
    .video-frame video { width: 100%; display: block; min-height: 360px; }
    .video-label { padding: 12px 18px; color: var(--gold); font-weight: 700; text-transform: uppercase; font-size: 0.82rem; letter-spacing: 0.04em; border-bottom: 1px solid rgba(214,167,69,0.15); background: rgba(4,8,20,0.7); }

    /* ===== SHARE ===== */
    .share-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 12px; margin-top: 20px; }
    .share-btn {
      display: flex; align-items: center; justify-content: center;
      padding: 14px; border-radius: 10px; font-weight: 700; font-size: 0.92rem;
      background: linear-gradient(180deg, rgba(22,30,58,0.95), rgba(12,18,40,0.95));
      border: 1px solid rgba(255,255,255,0.08); color: var(--ink); cursor: pointer;
      transition: all .2s;
    }
    .share-btn:hover { border-color: rgba(214,167,69,0.4); transform: translateY(-2px); }

    /* ===== RESOURCE CARD ===== */
    .resource-card {
      background: linear-gradient(180deg, rgba(14,18,44,0.92), rgba(7,12,30,0.95));
      border: 1px solid rgba(214,167,69,0.2); border-radius: 14px; padding: 22px;
    }
    .resource-card h3 { color: var(--gold-soft); margin: 0 0 10px; font-size: 1.3rem; }
    .resource-card p { color: var(--muted); line-height: 1.8; margin: 0 0 14px; }
    .resource-card-actions { display: flex; gap: 10px; flex-wrap: wrap; }

    /* ===== INLINE NOTE ===== */
    .inline-note { color: var(--muted); line-height: 1.85; text-align: center; margin-top: 28px; max-width: 820px; margin-left: auto; margin-right: auto; }

    /* ===== FOOTER ===== */
    footer {
      border-top: 1px solid var(--line);
      background: rgba(4,8,20,0.85); padding: 0;
    }
    .footer-banner {
      text-align: center; padding: 28px 24px;
      border-bottom: 1px solid var(--line);
      background: linear-gradient(180deg, rgba(214,167,69,0.06), transparent);
    }
    .footer-banner p { font-size: 1.15rem; color: var(--ink); font-style: italic; font-family: 'Cormorant Garamond', serif; margin: 0 0 6px; }
    .footer-banner cite { color: var(--muted); font-size: 0.85rem; }
    .footer-main { max-width: 1200px; margin: 0 auto; padding: 44px 24px 24px; display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 32px; }
    .footer-col h4 { color: var(--amber); font-size: 0.9rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; margin: 0 0 14px; }
    .footer-col p { color: var(--muted); font-size: 0.88rem; line-height: 1.75; margin: 0 0 8px; }
    .footer-col ul { list-style: none; margin: 0; padding: 0; }
    .footer-col ul li { margin-bottom: 7px; }
    .footer-col ul li a { color: var(--muted); font-size: 0.88rem; transition: color .2s; }
    .footer-col ul li a:hover { color: var(--amber); text-decoration: none; }
    .footer-bottom { text-align: center; padding: 20px 24px; border-top: 1px solid var(--line); color: var(--muted); font-size: 0.82rem; }

    /* ===== RESPONSIVE ===== */
    @media (max-width: 640px) {
      .hero { padding: 145px 20px 62px; }
      .section { padding: 52px 20px; }
      .doc-frame { height: 460px; }
