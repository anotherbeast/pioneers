    <style>
      :root {
        --bg: #0d0505; --bg-soft: #120808; --bg-card: #160a0a;
        --ink: #fef3c7; --ink-muted: #9ca3af;
        --gold: #d4a537; --gold-soft: #fcd34d;
        --red: #dc2626; --red-soft: #ef4444; --red-muted: #fca5a5;
        --crimson: #9f1239; --violet: #7c3aed;
        --line: rgba(220,38,38,0.22); --line-soft: rgba(220,38,38,0.12);
      }
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
      html { scroll-behavior: smooth; }
      body { margin: 0; font-family: 'Inter', sans-serif; color: var(--ink); background: var(--bg); overflow-x: hidden; }
      a { color: var(--red-muted); text-decoration: none; transition: color 0.2s; }
      a:hover { color: #fff; }

      .nav { position: sticky; top: 0; z-index: 100; background: rgba(10,2,2,0.96); backdrop-filter: blur(12px); border-bottom: 1px solid var(--line); }
      .nav-wrap { max-width: 1280px; margin: 0 auto; }
      .nav-row { display: flex; align-items: center; padding: 0 22px; }
      .nav-row-top { gap: 28px; height: 62px; border-bottom: 1px solid rgba(220,38,38,0.10); }
      .nav-row-bottom { gap: 22px; height: 42px; font-size: 0.82rem; overflow-x: auto; scrollbar-width: none; }
      .nav-brand { text-decoration: none; color: var(--ink); font-weight: 700; font-size: 1.05rem; flex-shrink: 0; margin-right: auto; }
      .nav-link { color: var(--ink-muted); text-decoration: none; font-weight: 600; font-size: 0.9rem; white-space: nowrap; }
      .nav-link:hover { color: var(--red-muted); }
      .nav-cta { display: inline-flex; align-items: center; height: 38px; padding: 0 18px; border-radius: 8px; background: var(--crimson); color: #fff; font-weight: 700; font-size: 0.88rem; text-decoration: none; flex-shrink: 0; }
      .nav-cta:hover { background: var(--red-soft); color: #fff; }
      .nav-bottom-link { color: rgba(156,163,175,0.8); text-decoration: none; font-weight: 500; white-space: nowrap; flex-shrink: 0; }
      .nav-bottom-link:hover, .nav-bottom-link.active { color: var(--red-muted); }
      .menu-btn { display: none; width: 40px; height: 40px; border: 1px solid var(--line); border-radius: 8px; background: rgba(255,255,255,0.03); color: var(--ink); cursor: pointer; flex-shrink: 0; align-items: center; justify-content: center; }
      .mobile-nav { display: none; border-top: 1px solid var(--line); padding: 14px 22px 18px; background: rgba(10,2,2,0.97); }
      .mobile-nav.open { display: grid; gap: 6px; }
      .mobile-nav a { color: var(--ink-muted); text-decoration: none; font-weight: 600; padding: 8px 0; border-bottom: 1px solid rgba(255,255,255,0.05); }
      @media (max-width: 860px) { .nav-row-bottom { display: none; } .menu-btn { display: inline-flex; } .nav-link { display: none; } }

      .page { max-width: 1200px; margin: 0 auto; padding: 0 22px 80px; }

      .hero { padding: 52px 0 44px; }
      .breadcrumb { font-size: 0.8rem; color: var(--ink-muted); margin-bottom: 18px; }
      .breadcrumb a { color: var(--ink-muted); }
      .breadcrumb a:hover { color: var(--red-muted); }
      .breadcrumb span { margin: 0 6px; opacity: 0.5; }

      .page-eyebrow { display: inline-flex; align-items: center; gap: 6px; padding: 5px 14px; border-radius: 999px; background: rgba(124,58,237,0.12); border: 1px solid rgba(124,58,237,0.35); color: #c4b5fd; font-size: 0.74rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 16px; }
      .page-header h1 { font-family: 'Crimson Text', serif; font-size: clamp(2rem, 5vw, 3.2rem); font-weight: 600; line-height: 1.1; color: var(--ink); margin-bottom: 12px; }
      .page-header h1 em { font-style: italic; color: #c4b5fd; }
      .page-header .subtitle { font-size: 1rem; color: rgba(254,243,199,0.75); line-height: 1.85; max-width: 760px; margin-bottom: 28px; }

      .section { padding: 44px 0; border-top: 1px solid var(--line-soft); }
      .section-header { margin-bottom: 26px; }
      .sh-eyebrow { display: inline-block; padding: 4px 14px; border-radius: 999px; border: 1px solid var(--line); color: var(--red-muted); letter-spacing: 0.1em; text-transform: uppercase; font-size: 0.72rem; font-weight: 700; margin-bottom: 10px; }
      .section-header h2 { font-family: 'Crimson Text', serif; font-size: clamp(1.6rem, 3vw, 2.2rem); font-weight: 600; color: var(--ink); margin-bottom: 8px; }
      .section-header h2 em { color: #c4b5fd; font-style: italic; }
      .section-header p { color: var(--ink-muted); font-size: 0.92rem; line-height: 1.8; max-width: 780px; }

      /* VIDEO GRID */
      .video-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 20px; }
      .video-card { background: var(--bg-card); border: 1px solid rgba(124,58,237,0.2); border-radius: 16px; overflow: hidden; transition: all 0.25s; }
      .video-card:hover { border-color: rgba(124,58,237,0.45); transform: translateY(-3px); box-shadow: 0 12px 32px rgba(60,0,80,0.35); }
      .video-thumb { position: relative; aspect-ratio: 16/9; background: var(--bg-soft); overflow: hidden; cursor: pointer; }
      .video-thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
      .video-thumb-placeholder { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; background: linear-gradient(135deg, #1a0a1a, #0d0505); font-size: 2.5rem; }
      .play-btn { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; background: rgba(0,0,0,0.4); transition: background 0.2s; }
      .play-btn:hover { background: rgba(124,58,237,0.35); }
      .play-icon { width: 56px; height: 56px; background: rgba(255,255,255,0.9); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 1.4rem; padding-left: 4px; }
      .video-duration { position: absolute; bottom: 8px; right: 8px; background: rgba(0,0,0,0.82); color: #fff; font-size: 0.7rem; font-weight: 700; padding: 2px 7px; border-radius: 5px; font-family: 'Courier New', monospace; }
      .video-body { padding: 16px 16px 18px; }
      .video-cat { display: inline-flex; align-items: center; gap: 4px; padding: 2px 8px; border-radius: 4px; font-size: 0.66rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.07em; background: rgba(124,58,237,0.12); border: 1px solid rgba(124,58,237,0.25); color: #c4b5fd; margin-bottom: 8px; }
      .video-title { font-family: 'Crimson Text', serif; font-size: 1.1rem; font-weight: 600; color: var(--ink); line-height: 1.35; margin-bottom: 6px; }
      .video-title a { color: var(--ink); }
      .video-title a:hover { color: #c4b5fd; }
      .video-desc { font-size: 0.8rem; color: var(--ink-muted); line-height: 1.65; margin-bottom: 10px; }
      .video-meta { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; }
      .video-source { font-size: 0.7rem; color: var(--gold); font-weight: 700; }
      .video-tag { font-size: 0.67rem; padding: 2px 7px; border-radius: 4px; background: rgba(255,255,255,0.05); color: rgba(156,163,175,0.7); border: 1px solid rgba(255,255,255,0.07); }

      /* FEATURED VIDEO */
      .featured-video { background: var(--bg-card); border: 1px solid rgba(124,58,237,0.35); border-radius: 18px; overflow: hidden; margin-bottom: 36px; }
      .featured-video .video-embed-wrap { position: relative; aspect-ratio: 16/9; background: #000; }
      .featured-video iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: none; }
      .featured-video-body { padding: 24px 26px; }
      .featured-video-body .video-label { display: inline-flex; align-items: center; gap: 4px; padding: 3px 10px; border-radius: 999px; background: rgba(124,58,237,0.15); border: 1px solid rgba(124,58,237,0.4); color: #c4b5fd; font-size: 0.7rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 10px; }
      .featured-video-body h2 { font-family: 'Crimson Text', serif; font-size: 1.7rem; color: var(--ink); margin-bottom: 8px; line-height: 1.25; }
      .featured-video-body h2 em { color: #c4b5fd; }
      .featured-video-body p { font-size: 0.88rem; color: var(--ink-muted); line-height: 1.8; }

      /* PROPAGANDA SECTION */
      .propaganda-box { background: linear-gradient(135deg, rgba(50,0,0,0.5), rgba(12,5,5,0.9)); border: 1px solid rgba(220,38,38,0.35); border-radius: 16px; padding: 26px 28px; }
      .propaganda-box h3 { font-family: 'Crimson Text', serif; font-size: 1.4rem; color: var(--red-muted); margin-bottom: 14px; }
      .propaganda-box p { font-size: 0.87rem; color: rgba(254,243,199,0.8); line-height: 1.8; margin-bottom: 12px; }
      .propaganda-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 14px; margin-top: 16px; }
      .prop-card { background: rgba(220,38,38,0.08); border: 1px solid rgba(220,38,38,0.2); border-radius: 12px; padding: 14px 14px; }
      .prop-card h4 { font-size: 0.85rem; color: var(--red-muted); font-weight: 700; margin-bottom: 6px; }
      .prop-card p { font-size: 0.77rem; color: var(--ink-muted); line-height: 1.65; }
      .prop-card .ein-badge { display: inline-block; font-size: 0.68rem; color: var(--gold); font-family: 'Courier New', monospace; font-weight: 700; margin-top: 4px; }

      /* CTA */
      .cta-bar { background: linear-gradient(135deg, rgba(60,0,0,0.5), rgba(12,5,5,0.9)); border: 1px solid rgba(220,38,38,0.35); border-radius: 18px; padding: 30px; text-align: center; margin-top: 50px; }
      .cta-bar h2 { font-family: 'Crimson Text', serif; font-size: 1.8rem; color: var(--ink); margin-bottom: 8px; }
      .cta-bar p { font-size: 0.9rem; color: var(--ink-muted); line-height: 1.8; max-width: 560px; margin: 0 auto 20px; }
      .cta-buttons { display: flex; flex-wrap: wrap; gap: 12px; justify-content: center; }
      .cta-btn { display: inline-flex; align-items: center; gap: 6px; padding: 11px 20px; border-radius: 10px; font-weight: 700; font-size: 0.87rem; text-decoration: none; transition: all 0.2s; }
      .cta-btn-primary { background: var(--crimson); color: #fff; border: 1px solid rgba(220,38,38,0.5); }
      .cta-btn-primary:hover { background: var(--red); color: #fff; }
      .cta-btn-secondary { background: transparent; color: var(--gold); border: 1px solid rgba(212,165,55,0.4); }
      .cta-btn-secondary:hover { background: rgba(212,165,55,0.1); color: #fcd34d; }
      .cta-btn-violet { background: transparent; color: #c4b5fd; border: 1px solid rgba(124,58,237,0.4); }
      .cta-btn-violet:hover { background: rgba(124,58,237,0.12); }

      .footer { border-top: 1px solid var(--line-soft); padding: 26px 22px; text-align: center; font-size: 0.78rem; color: var(--ink-muted); }
      .footer a { color: var(--red-muted); }

      @media (max-width: 640px) { .video-grid { grid-template-columns: 1fr; } }
    </style>
  </head>
