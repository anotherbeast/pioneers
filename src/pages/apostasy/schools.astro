    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Crimson+Text:ital,wght@0,400;0,600;1,400&display=swap" rel="stylesheet">
    <style>
      :root {
        --bg: #0d0505; --bg-soft: #120808; --bg-card: #160a0a;
        --ink: #fef3c7; --ink-muted: #9ca3af;
        --gold: #d4a537; --gold-soft: #fcd34d;
        --red: #dc2626; --red-soft: #ef4444; --red-muted: #fca5a5;
        --crimson: #9f1239;
        --line: rgba(220,38,38,0.22); --line-soft: rgba(220,38,38,0.12);
      }
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
      html { scroll-behavior: smooth; }
      body { margin: 0; font-family: 'Inter', sans-serif; color: var(--ink); background: var(--bg); overflow-x: hidden; }
      a { color: var(--red-muted); text-decoration: none; transition: color 0.2s; }
      a:hover { color: #fff; }

      .nav { position: sticky; top: 0; z-index: 100; background: rgba(10,2,2,0.96); backdrop-filter: blur(12px); border-bottom: 1px solid var(--line); }
      .nav-wrap { max-width: 1280px; margin: 0 auto; }
      .nav-row { display: flex; align-items: center; padding: 0 22px; }
      .nav-row-top { gap: 28px; height: 62px; border-bottom: 1px solid rgba(220,38,38,0.10); }
      .nav-row-bottom { gap: 22px; height: 42px; font-size: 0.82rem; overflow-x: auto; scrollbar-width: none; }
      .nav-brand { text-decoration: none; color: var(--ink); font-weight: 700; font-size: 1.05rem; flex-shrink: 0; margin-right: auto; }
      .nav-link { color: var(--ink-muted); text-decoration: none; font-weight: 600; font-size: 0.9rem; white-space: nowrap; transition: color 0.18s; }
      .nav-link:hover { color: var(--red-muted); }
      .nav-cta { display: inline-flex; align-items: center; height: 38px; padding: 0 18px; border-radius: 8px; background: var(--crimson); color: #fff; font-weight: 700; font-size: 0.88rem; text-decoration: none; flex-shrink: 0; }
      .nav-cta:hover { background: var(--red-soft); color: #fff; }
      .nav-bottom-link { color: rgba(156,163,175,0.8); text-decoration: none; font-weight: 500; white-space: nowrap; transition: color 0.18s; flex-shrink: 0; }
      .nav-bottom-link:hover, .nav-bottom-link.active { color: var(--red-muted); }
      .menu-btn { display: none; width: 40px; height: 40px; border: 1px solid var(--line); border-radius: 8px; background: rgba(255,255,255,0.03); color: var(--ink); cursor: pointer; flex-shrink: 0; align-items: center; justify-content: center; }
      .mobile-nav { display: none; border-top: 1px solid var(--line); padding: 14px 22px 18px; background: rgba(10,2,2,0.97); }
      .mobile-nav.open { display: grid; gap: 6px; }
      .mobile-nav a { color: var(--ink-muted); text-decoration: none; font-weight: 600; padding: 8px 0; border-bottom: 1px solid rgba(255,255,255,0.05); }
      @media (max-width: 860px) { .nav-row-bottom { display: none; } .menu-btn { display: inline-flex; } .nav-link { display: none; } }

      .page { max-width: 1100px; margin: 0 auto; padding: 0 22px 80px; }

      /* HERO */
      .hero { padding: 52px 0 44px; }
      .breadcrumb { font-size: 0.8rem; color: var(--ink-muted); margin-bottom: 18px; }
      .breadcrumb a { color: var(--ink-muted); }
      .breadcrumb a:hover { color: var(--red-muted); }
      .breadcrumb span { margin: 0 6px; opacity: 0.5; }

      .alert-banner { background: linear-gradient(135deg, rgba(127,0,0,0.35), rgba(80,0,0,0.4)); border: 1px solid rgba(220,38,38,0.5); border-radius: 14px; padding: 20px 24px; margin-bottom: 36px; display: flex; align-items: flex-start; gap: 14px; }
      .alert-icon { font-size: 1.5rem; flex-shrink: 0; margin-top: 2px; }
      .alert-body h2 { font-family: 'Crimson Text', serif; font-size: 1.3rem; font-weight: 600; color: var(--red-muted); margin-bottom: 6px; }
      .alert-body p { font-size: 0.88rem; color: rgba(254,243,199,0.8); line-height: 1.75; }
      .alert-body strong { color: var(--red-muted); }

      .page-eyebrow { display: inline-flex; align-items: center; gap: 6px; padding: 5px 14px; border-radius: 999px; background: rgba(159,18,57,0.15); border: 1px solid rgba(159,18,57,0.4); color: var(--red-muted); font-size: 0.74rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 16px; }
      .page-header h1 { font-family: 'Crimson Text', serif; font-size: clamp(2rem, 5vw, 3.2rem); font-weight: 600; line-height: 1.1; color: var(--ink); margin-bottom: 12px; }
      .page-header h1 em { font-style: italic; color: var(--red-muted); }
      .page-header .subtitle { font-size: 1rem; color: rgba(254,243,199,0.75); line-height: 1.85; max-width: 760px; margin-bottom: 28px; }

      .stats-bar { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 14px; background: rgba(20,8,8,0.8); border: 1px solid var(--line); border-radius: 16px; padding: 22px 26px; margin-bottom: 40px; }
      .stat-item { text-align: center; }
      .stat-num { font-family: 'Crimson Text', serif; font-size: 2rem; font-weight: 600; color: var(--red-muted); line-height: 1; margin-bottom: 4px; }
      .stat-label { font-size: 0.72rem; color: var(--ink-muted); text-transform: uppercase; letter-spacing: 0.08em; font-weight: 600; }

      .section { padding: 44px 0; border-top: 1px solid var(--line-soft); }
      .section-header { margin-bottom: 26px; }
      .sh-eyebrow { display: inline-block; padding: 4px 14px; border-radius: 999px; border: 1px solid var(--line); color: var(--red-muted); letter-spacing: 0.1em; text-transform: uppercase; font-size: 0.72rem; font-weight: 700; margin-bottom: 10px; }
      .section-header h2 { font-family: 'Crimson Text', serif; font-size: clamp(1.6rem, 3vw, 2.2rem); font-weight: 600; color: var(--ink); margin-bottom: 8px; }
      .section-header h2 em { color: var(--red-muted); font-style: italic; }
      .section-header p { color: var(--ink-muted); font-size: 0.92rem; line-height: 1.8; max-width: 780px; }

      /* SUNNYDALE FEATURE */
      .sunnydale-card { background: linear-gradient(135deg, rgba(60,0,0,0.6), rgba(12,5,5,0.98)); border: 2px solid rgba(220,38,38,0.5); border-radius: 22px; overflow: hidden; margin-bottom: 32px; }
      .sc-header { background: linear-gradient(to right, rgba(159,18,57,0.4), rgba(80,0,0,0.3)); padding: 22px 28px; border-bottom: 1px solid rgba(220,38,38,0.3); display: flex; align-items: center; gap: 14px; flex-wrap: wrap; }
      .sc-badge { display: inline-flex; padding: 5px 14px; border-radius: 999px; background: rgba(220,38,38,0.2); border: 1px solid rgba(220,38,38,0.5); color: var(--red-muted); font-size: 0.75rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.08em; }
      .sc-header h3 { font-family: 'Crimson Text', serif; font-size: 1.5rem; color: var(--ink); font-weight: 600; flex: 1; }
      .sc-body { padding: 26px 28px; display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }
      @media (max-width: 640px) { .sc-body { grid-template-columns: 1fr; } }
      .sc-section h4 { font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.08em; font-weight: 700; margin-bottom: 10px; padding-bottom: 8px; border-bottom: 1px solid rgba(255,255,255,0.08); }
      .sc-section.protestant h4 { color: var(--gold); }
      .sc-section.catholic h4 { color: var(--red-muted); }
      .sc-list li { font-size: 0.87rem; color: rgba(254,243,199,0.8); line-height: 1.75; margin-bottom: 6px; padding-left: 16px; position: relative; list-style: none; }
      .sc-list li::before { content: '►'; position: absolute; left: 0; font-size: 0.6rem; top: 5px; }
      .sc-section.protestant .sc-list li::before { color: var(--gold); }
      .sc-section.catholic .sc-list li::before { color: var(--red-muted); }
      .sc-footer { padding: 18px 28px; border-top: 1px solid rgba(220,38,38,0.15); display: flex; flex-wrap: wrap; gap: 12px; align-items: center; }
      .sc-meta { font-size: 0.82rem; color: var(--ink-muted); }
      .sc-meta strong { color: rgba(254,243,199,0.9); }

      /* SCHOOL TABLE */
      .school-table-wrap { overflow-x: auto; }
      .school-table { width: 100%; border-collapse: collapse; font-size: 0.85rem; }
      .school-table thead { background: rgba(20,8,8,0.9); }
      .school-table thead th { padding: 12px 16px; text-align: left; font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--gold); border-bottom: 1px solid rgba(212,165,55,0.25); white-space: nowrap; }
      .school-table tbody tr { border-bottom: 1px solid rgba(255,255,255,0.05); transition: background 0.15s; }
      .school-table tbody tr:hover { background: rgba(220,38,38,0.05); }
      .school-table td { padding: 12px 16px; vertical-align: top; line-height: 1.6; }
      .school-table td:first-child { color: rgba(254,243,199,0.92); font-weight: 600; }
      .school-table td:nth-child(2) { color: var(--gold); font-family: monospace; font-size: 0.78rem; }
      .school-table td:nth-child(3) { color: var(--ink-muted); }
      .school-table td:last-child { color: var(--red-muted); font-size: 0.8rem; }

      /* CRIME CARDS */
      .crime-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 16px; }
      .crime-card { background: var(--bg-card); border: 1px solid rgba(220,38,38,0.2); border-radius: 14px; padding: 20px 18px; }
      .crime-icon { font-size: 1.6rem; margin-bottom: 10px; }
      .crime-title { font-family: 'Crimson Text', serif; font-size: 1.1rem; font-weight: 600; color: var(--red-muted); margin-bottom: 8px; }
      .crime-desc { font-size: 0.85rem; color: var(--ink-muted); line-height: 1.7; }

      /* DANIELLS CONNECTION */
      .daniells-box { background: linear-gradient(135deg, rgba(40,20,0,0.6), rgba(12,10,5,0.95)); border: 1px solid rgba(212,165,55,0.3); border-radius: 18px; padding: 28px; }
      .daniells-box h3 { font-family: 'Crimson Text', serif; font-size: 1.6rem; font-weight: 600; color: var(--gold); margin-bottom: 14px; }
      .daniells-box p { font-size: 0.9rem; color: rgba(254,243,199,0.8); line-height: 1.85; margin-bottom: 14px; }
      .daniells-link { display: inline-flex; align-items: center; gap: 6px; padding: 10px 20px; border-radius: 10px; background: rgba(212,165,55,0.12); border: 1px solid rgba(212,165,55,0.35); color: var(--gold); font-weight: 700; font-size: 0.86rem; transition: all 0.2s; }
      .daniells-link:hover { background: rgba(212,165,55,0.2); color: var(--gold-soft); }

      /* QUOTE */
      .quote-block { background: linear-gradient(135deg, rgba(50,0,0,0.5), rgba(12,5,5,0.9)); border: 1px solid rgba(220,38,38,0.3); border-left: 4px solid var(--red); border-radius: 0 14px 14px 0; padding: 20px 22px; margin-bottom: 20px; }
      .quote-block blockquote { font-family: 'Crimson Text', serif; font-size: 1.1rem; color: rgba(254,243,199,0.92); line-height: 1.85; margin-bottom: 6px; }
      .quote-block cite { font-size: 0.78rem; color: var(--gold); font-style: italic; }

      /* CTA */
      .cta-bar { background: linear-gradient(135deg, rgba(60,0,0,0.5), rgba(12,5,5,0.9)); border: 1px solid rgba(220,38,38,0.35); border-radius: 18px; padding: 30px; text-align: center; margin-top: 50px; }
      .cta-bar h2 { font-family: 'Crimson Text', serif; font-size: 1.8rem; color: var(--ink); margin-bottom: 8px; }
      .cta-bar p { font-size: 0.9rem; color: var(--ink-muted); line-height: 1.8; max-width: 560px; margin: 0 auto 20px; }
      .cta-buttons { display: flex; flex-wrap: wrap; gap: 12px; justify-content: center; }
      .cta-btn { display: inline-flex; align-items: center; gap: 6px; padding: 11px 20px; border-radius: 10px; font-weight: 700; font-size: 0.87rem; text-decoration: none; transition: all 0.2s; }
      .cta-btn-primary { background: var(--crimson); color: #fff; border: 1px solid rgba(220,38,38,0.5); }
      .cta-btn-primary:hover { background: var(--red); color: #fff; }
      .cta-btn-secondary { background: transparent; color: var(--gold); border: 1px solid rgba(212,165,55,0.4); }
      .cta-btn-secondary:hover { background: rgba(212,165,55,0.1); color: var(--gold-soft); }

      .footer { border-top: 1px solid var(--line-soft); padding: 26px 22px; text-align: center; font-size: 0.78rem; color: var(--ink-muted); }
      .footer a { color: var(--red-muted); }

      @media (max-width: 640px) { .stats-bar { grid-template-columns: repeat(2, 1fr); } }
    </style>
  </head>
