    <style>
      :root {
        --bg: #0d0505; --bg-soft: #120808; --bg-card: #160a0a;
        --ink: #fef3c7; --ink-muted: #9ca3af;
        --gold: #d4a537; --gold-soft: #fcd34d;
        --red: #dc2626; --red-soft: #ef4444; --red-muted: #fca5a5;
        --crimson: #9f1239; --green: #059669; --green-soft: #10b981;
        --line: rgba(220,38,38,0.22); --line-soft: rgba(220,38,38,0.12);
      }
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
      html { scroll-behavior: smooth; }
      body { margin: 0; font-family: 'Inter', sans-serif; color: var(--ink); background: var(--bg); overflow-x: hidden; }
      a { color: var(--red-muted); text-decoration: none; transition: color 0.2s; }
      a:hover { color: #fff; }

      .nav { position: sticky; top: 0; z-index: 100; background: rgba(10,2,2,0.96); backdrop-filter: blur(12px); border-bottom: 1px solid var(--line); }
      .nav-wrap { max-width: 1280px; margin: 0 auto; }
      .nav-row { display: flex; align-items: center; padding: 0 22px; }
      .nav-row-top { gap: 28px; height: 62px; border-bottom: 1px solid rgba(220,38,38,0.10); }
      .nav-row-bottom { gap: 22px; height: 42px; font-size: 0.82rem; overflow-x: auto; scrollbar-width: none; }
      .nav-brand { text-decoration: none; color: var(--ink); font-weight: 700; font-size: 1.05rem; flex-shrink: 0; margin-right: auto; }
      .nav-link { color: var(--ink-muted); text-decoration: none; font-weight: 600; font-size: 0.9rem; white-space: nowrap; }
      .nav-link:hover { color: var(--red-muted); }
      .nav-cta { display: inline-flex; align-items: center; height: 38px; padding: 0 18px; border-radius: 8px; background: var(--crimson); color: #fff; font-weight: 700; font-size: 0.88rem; text-decoration: none; flex-shrink: 0; }
      .nav-cta:hover { background: var(--red-soft); color: #fff; }
      .nav-bottom-link { color: rgba(156,163,175,0.8); text-decoration: none; font-weight: 500; white-space: nowrap; flex-shrink: 0; }
      .nav-bottom-link:hover, .nav-bottom-link.active { color: var(--red-muted); }
      .menu-btn { display: none; width: 40px; height: 40px; border: 1px solid var(--line); border-radius: 8px; background: rgba(255,255,255,0.03); color: var(--ink); cursor: pointer; flex-shrink: 0; align-items: center; justify-content: center; }
      .mobile-nav { display: none; border-top: 1px solid var(--line); padding: 14px 22px 18px; background: rgba(10,2,2,0.97); }
      .mobile-nav.open { display: grid; gap: 6px; }
      .mobile-nav a { color: var(--ink-muted); text-decoration: none; font-weight: 600; padding: 8px 0; border-bottom: 1px solid rgba(255,255,255,0.05); }
      @media (max-width: 860px) { .nav-row-bottom { display: none; } .menu-btn { display: inline-flex; } .nav-link { display: none; } }

      .page { max-width: 1200px; margin: 0 auto; padding: 0 22px 80px; }

      .hero { padding: 52px 0 44px; }
      .breadcrumb { font-size: 0.8rem; color: var(--ink-muted); margin-bottom: 18px; }
      .breadcrumb a { color: var(--ink-muted); }
      .breadcrumb a:hover { color: var(--red-muted); }
      .breadcrumb span { margin: 0 6px; opacity: 0.5; }

      .alert-banner { background: linear-gradient(135deg, rgba(2,70,40,0.3), rgba(5,30,15,0.5)); border: 1px solid rgba(5,150,105,0.4); border-radius: 14px; padding: 20px 24px; margin-bottom: 36px; display: flex; align-items: flex-start; gap: 14px; }
      .alert-icon { font-size: 1.5rem; flex-shrink: 0; margin-top: 2px; }
      .alert-body h2 { font-family: 'Crimson Text', serif; font-size: 1.3rem; font-weight: 600; color: #6ee7b7; margin-bottom: 6px; }
      .alert-body p { font-size: 0.88rem; color: rgba(254,243,199,0.8); line-height: 1.75; }
      .alert-body strong { color: #6ee7b7; }

      .page-eyebrow { display: inline-flex; align-items: center; gap: 6px; padding: 5px 14px; border-radius: 999px; background: rgba(5,150,105,0.12); border: 1px solid rgba(5,150,105,0.35); color: #6ee7b7; font-size: 0.74rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 16px; }
      .page-header h1 { font-family: 'Crimson Text', serif; font-size: clamp(2rem, 5vw, 3.2rem); font-weight: 600; line-height: 1.1; color: var(--ink); margin-bottom: 12px; }
      .page-header h1 em { font-style: italic; color: #6ee7b7; }
      .page-header .subtitle { font-size: 1rem; color: rgba(254,243,199,0.75); line-height: 1.85; max-width: 760px; margin-bottom: 28px; }

      .stats-bar { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 14px; background: rgba(5,30,15,0.6); border: 1px solid rgba(5,150,105,0.25); border-radius: 16px; padding: 22px 26px; margin-bottom: 40px; }
      .stat-item { text-align: center; }
      .stat-num { font-family: 'Crimson Text', serif; font-size: 2rem; font-weight: 600; color: #6ee7b7; line-height: 1; margin-bottom: 4px; }
      .stat-label { font-size: 0.72rem; color: var(--ink-muted); text-transform: uppercase; letter-spacing: 0.08em; font-weight: 600; }

      .section { padding: 44px 0; border-top: 1px solid var(--line-soft); }
      .section-header { margin-bottom: 26px; }
      .sh-eyebrow { display: inline-block; padding: 4px 14px; border-radius: 999px; border: 1px solid var(--line); color: var(--red-muted); letter-spacing: 0.1em; text-transform: uppercase; font-size: 0.72rem; font-weight: 700; margin-bottom: 10px; }
      .section-header h2 { font-family: 'Crimson Text', serif; font-size: clamp(1.6rem, 3vw, 2.2rem); font-weight: 600; color: var(--ink); margin-bottom: 8px; }
      .section-header h2 em { color: #6ee7b7; font-style: italic; }
      .section-header p { color: var(--ink-muted); font-size: 0.92rem; line-height: 1.8; max-width: 780px; }

      /* HOSPITAL CARDS */
      .hosp-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(340px, 1fr)); gap: 18px; }
      .hosp-card { background: var(--bg-card); border: 1px solid rgba(5,150,105,0.2); border-radius: 16px; padding: 22px 20px; display: flex; flex-direction: column; gap: 10px; transition: all 0.2s; }
      .hosp-card:hover { border-color: rgba(5,150,105,0.4); transform: translateY(-2px); box-shadow: 0 8px 28px rgba(0,80,40,0.3); }
      .hosp-cat { display: inline-flex; align-items: center; gap: 5px; padding: 3px 10px; border-radius: 999px; font-size: 0.68rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.07em; width: fit-content; background: rgba(5,150,105,0.12); border: 1px solid rgba(5,150,105,0.3); color: #6ee7b7; }
      .hosp-name { font-family: 'Crimson Text', serif; font-size: 1.2rem; font-weight: 600; color: var(--ink); line-height: 1.3; }
      .hosp-ein { font-size: 0.75rem; color: var(--gold); font-weight: 700; font-family: 'Courier New', monospace; display: flex; align-items: center; gap: 5px; }
      .hosp-ein::before { content: 'EIN'; font-size: 0.62rem; padding: 1px 5px; border-radius: 4px; background: rgba(212,165,55,0.12); border: 1px solid rgba(212,165,55,0.3); font-family: 'Inter', sans-serif; letter-spacing: 0.06em; }
      .hosp-desc { font-size: 0.83rem; color: var(--ink-muted); line-height: 1.65; flex: 1; }
      .hosp-meta { display: flex; flex-wrap: wrap; gap: 6px; padding-top: 8px; border-top: 1px solid rgba(255,255,255,0.06); }
      .hosp-tag { font-size: 0.68rem; padding: 2px 8px; border-radius: 4px; background: rgba(255,255,255,0.05); color: rgba(156,163,175,0.8); border: 1px solid rgba(255,255,255,0.07); }
      .hosp-revenue { font-size: 0.75rem; color: #6ee7b7; font-weight: 700; }
      .hosp-link { display: inline-flex; align-items: center; gap: 4px; font-size: 0.76rem; color: rgba(156,163,175,0.6); transition: color 0.15s; margin-top: 2px; }
      .hosp-link:hover { color: var(--gold); }

      /* QUOTE */
      .quote-block { background: linear-gradient(135deg, rgba(50,0,0,0.5), rgba(12,5,5,0.9)); border: 1px solid rgba(220,38,38,0.3); border-left: 4px solid var(--red); border-radius: 0 14px 14px 0; padding: 20px 22px; margin-bottom: 20px; }
      .quote-block blockquote { font-family: 'Crimson Text', serif; font-size: 1.1rem; color: rgba(254,243,199,0.92); line-height: 1.85; margin-bottom: 6px; }
      .quote-block cite { font-size: 0.78rem; color: var(--gold); font-style: italic; }

      /* EGW WARNING */
      .egw-box { background: linear-gradient(135deg, rgba(40,20,0,0.6), rgba(12,10,5,0.95)); border: 1px solid rgba(212,165,55,0.3); border-radius: 16px; padding: 26px 28px; }
      .egw-box h3 { font-family: 'Crimson Text', serif; font-size: 1.4rem; color: var(--gold); margin-bottom: 14px; }
      .egw-box p { font-size: 0.9rem; color: rgba(254,243,199,0.8); line-height: 1.85; margin-bottom: 12px; }

      /* CTA */
      .cta-bar { background: linear-gradient(135deg, rgba(60,0,0,0.5), rgba(12,5,5,0.9)); border: 1px solid rgba(220,38,38,0.35); border-radius: 18px; padding: 30px; text-align: center; margin-top: 50px; }
      .cta-bar h2 { font-family: 'Crimson Text', serif; font-size: 1.8rem; color: var(--ink); margin-bottom: 8px; }
      .cta-bar p { font-size: 0.9rem; color: var(--ink-muted); line-height: 1.8; max-width: 560px; margin: 0 auto 20px; }
      .cta-buttons { display: flex; flex-wrap: wrap; gap: 12px; justify-content: center; }
      .cta-btn { display: inline-flex; align-items: center; gap: 6px; padding: 11px 20px; border-radius: 10px; font-weight: 700; font-size: 0.87rem; text-decoration: none; transition: all 0.2s; }
      .cta-btn-primary { background: var(--crimson); color: #fff; border: 1px solid rgba(220,38,38,0.5); }
      .cta-btn-primary:hover { background: var(--red); color: #fff; }
      .cta-btn-secondary { background: transparent; color: var(--gold); border: 1px solid rgba(212,165,55,0.4); }
      .cta-btn-secondary:hover { background: rgba(212,165,55,0.1); color: var(--gold-soft); }

      .footer { border-top: 1px solid var(--line-soft); padding: 26px 22px; text-align: center; font-size: 0.78rem; color: var(--ink-muted); }
      .footer a { color: var(--red-muted); }

      @media (max-width: 640px) { .hosp-grid { grid-template-columns: 1fr; } .stats-bar { grid-template-columns: repeat(2, 1fr); } }
    </style>
  </head>
