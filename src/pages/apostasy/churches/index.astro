    <meta property="og:title" content="SDA Church Directory — 501(c)(3) Corporate Franchises | SundayLaw.com">
    <meta property="og:description" content="Every SDA church operates under GC Group Exemption GEN 1071. Browse the directory. Understand the corporate structure. Heed Revelation 18:4.">
    <meta property="og:url" content="https://sundaylaw.com/apostasy/churches">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="robots" content="index, follow">
    <Analytics />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Crimson+Text:ital,wght@0,400;0,600;1,400&display=swap" rel="stylesheet">
    <!-- Leaflet.js for map support (no API key needed) -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="">
    <style>
      :root {
        --bg: #0d0505; --bg-soft: #120808; --bg-card: #160a0a;
        --ink: #fef3c7; --ink-muted: #9ca3af;
        --gold: #d4a537; --gold-soft: #fcd34d;
        --red: #dc2626; --red-soft: #ef4444; --red-muted: #fca5a5;
        --crimson: #9f1239; --indigo: #4f46e5; --green: #16a34a;
        --line: rgba(220,38,38,0.22); --line-soft: rgba(220,38,38,0.12);
      }
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
      html { scroll-behavior: smooth; }
      body { margin: 0; font-family: 'Inter', sans-serif; color: var(--ink); background: var(--bg); overflow-x: hidden; }
      a { color: var(--red-muted); text-decoration: none; transition: color 0.2s; }
      a:hover { color: #fff; }

      /* ── NAV ── */
      .nav { position: sticky; top: 0; z-index: 100; background: rgba(10,2,2,0.97); backdrop-filter: blur(12px); border-bottom: 1px solid var(--line); }
      .nav-wrap { max-width: 1280px; margin: 0 auto; }
      .nav-row { display: flex; align-items: center; padding: 0 22px; }
      .nav-row-top { gap: 28px; height: 62px; border-bottom: 1px solid rgba(220,38,38,0.10); }
      .nav-row-bottom { gap: 22px; height: 42px; font-size: 0.82rem; overflow-x: auto; scrollbar-width: none; }
      .nav-brand { text-decoration: none; color: var(--ink); font-weight: 700; font-size: 1.05rem; flex-shrink: 0; margin-right: auto; }
      .nav-link { color: var(--ink-muted); text-decoration: none; font-weight: 600; font-size: 0.9rem; white-space: nowrap; }
      .nav-link:hover { color: var(--red-muted); }
      .nav-cta { display: inline-flex; align-items: center; height: 38px; padding: 0 18px; border-radius: 8px; background: var(--crimson); color: #fff; font-weight: 700; font-size: 0.88rem; text-decoration: none; flex-shrink: 0; margin-right: 80px; }
      .nav-cta:hover { background: var(--red-soft); color: #fff; }
      .nav-bottom-link { color: rgba(156,163,175,0.8); text-decoration: none; font-weight: 500; white-space: nowrap; flex-shrink: 0; }
      .nav-bottom-link:hover, .nav-bottom-link.active { color: var(--red-muted); }
      .menu-btn { display: none; width: 40px; height: 40px; border: 1px solid var(--line); border-radius: 8px; background: rgba(255,255,255,0.03); color: var(--ink); cursor: pointer; flex-shrink: 0; align-items: center; justify-content: center; margin-right: 80px; }
      .mobile-nav { display: none; border-top: 1px solid var(--line); padding: 14px 22px 18px; background: rgba(10,2,2,0.98); }
      .mobile-nav.open { display: grid; gap: 6px; }
      .mobile-nav a { color: var(--ink-muted); text-decoration: none; font-weight: 600; padding: 8px 0; border-bottom: 1px solid rgba(255,255,255,0.05); }
      @media (max-width: 860px) { .nav-row-bottom { display: none; } .menu-btn { display: inline-flex; } .nav-link { display: none; } }

      /* ── PAGE LAYOUT ── */
      .page { max-width: 1200px; margin: 0 auto; padding: 0 22px 80px; }

      /* ── HERO ── */
      .hero { padding: 48px 0 36px; }
      .breadcrumb { font-size: 0.8rem; color: var(--ink-muted); margin-bottom: 18px; }
      .breadcrumb a { color: var(--ink-muted); }
      .breadcrumb a:hover { color: var(--red-muted); }
      .breadcrumb span { margin: 0 6px; opacity: 0.5; }
      .page-eyebrow { display: inline-flex; align-items: center; gap: 6px; padding: 5px 14px; border-radius: 999px; background: rgba(79,70,229,0.12); border: 1px solid rgba(79,70,229,0.35); color: #a5b4fc; font-size: 0.74rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 16px; }
      .hero h1 { font-family: 'Crimson Text', serif; font-size: clamp(2rem, 5vw, 3.2rem); font-weight: 600; line-height: 1.1; margin-bottom: 14px; }
      .hero h1 em { color: #a5b4fc; font-style: italic; }
      .hero-subtitle { font-size: 1rem; color: rgba(254,243,199,0.75); line-height: 1.85; max-width: 820px; margin-bottom: 28px; }
      .hero-stats { display: flex; flex-wrap: wrap; gap: 14px; margin-bottom: 32px; }
      .stat-pill { display: inline-flex; align-items: center; gap: 7px; padding: 8px 16px; border-radius: 999px; border: 1px solid var(--line); background: rgba(220,38,38,0.06); font-size: 0.8rem; color: var(--ink); }
      .stat-pill strong { color: var(--red-muted); }

      /* ── APOSTASY ALERT BANNER ── */
      .apostasy-banner { background: linear-gradient(135deg, rgba(50,0,0,0.65), rgba(12,5,5,0.92)); border: 1px solid rgba(220,38,38,0.4); border-left: 5px solid var(--red); border-radius: 0 16px 16px 0; padding: 22px 26px; margin-bottom: 40px; }
      .apostasy-banner h2 { font-family: 'Crimson Text', serif; font-size: 1.35rem; color: var(--red-muted); margin-bottom: 10px; }
      .apostasy-banner p { font-size: 0.87rem; color: rgba(254,243,199,0.82); line-height: 1.8; margin-bottom: 8px; }
      .apostasy-banner p:last-child { margin-bottom: 0; }
      .apostasy-banner strong { color: var(--gold-soft); }
      .apostasy-banner a { color: var(--gold); text-decoration: underline; text-underline-offset: 3px; }
      .apostasy-banner a:hover { color: #fcd34d; }

      /* ── SEARCH + FILTER BAR ── */
      .search-bar { display: flex; flex-wrap: wrap; gap: 12px; padding: 20px 22px; background: var(--bg-card); border: 1px solid var(--line-soft); border-radius: 16px; margin-bottom: 32px; }
      .search-input-wrap { flex: 1; min-width: 220px; position: relative; }
      .search-input-wrap svg { position: absolute; left: 12px; top: 50%; transform: translateY(-50%); width: 16px; height: 16px; color: var(--ink-muted); pointer-events: none; }
      .search-input { width: 100%; height: 44px; padding: 0 12px 0 38px; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); border-radius: 10px; color: var(--ink); font-size: 0.9rem; font-family: 'Inter', sans-serif; outline: none; }
      .search-input::placeholder { color: var(--ink-muted); }
      .search-input:focus { border-color: rgba(220,38,38,0.5); background: rgba(220,38,38,0.04); }
      .filter-select { height: 44px; padding: 0 14px; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); border-radius: 10px; color: var(--ink); font-size: 0.88rem; font-family: 'Inter', sans-serif; cursor: pointer; outline: none; min-width: 160px; }
      .filter-select option { background: #1a0808; color: var(--ink); }
      .filter-select:focus { border-color: rgba(220,38,38,0.5); }
      .view-toggle { display: flex; gap: 4px; }
      .view-btn { width: 44px; height: 44px; border: 1px solid rgba(255,255,255,0.1); border-radius: 10px; background: rgba(255,255,255,0.04); color: var(--ink-muted); cursor: pointer; display: flex; align-items: center; justify-content: center; transition: all 0.18s; }
      .view-btn.active { background: rgba(220,38,38,0.12); border-color: rgba(220,38,38,0.4); color: var(--red-muted); }
      .results-count { align-self: center; font-size: 0.82rem; color: var(--ink-muted); white-space: nowrap; }

      /* ── MAP ── */
      .map-section { margin-bottom: 36px; }
      .map-section h2 { font-family: 'Crimson Text', serif; font-size: 1.5rem; color: var(--ink); margin-bottom: 14px; }
      #church-map { width: 100%; height: 440px; border-radius: 14px; border: 1px solid var(--line-soft); background: #1a0808; }

      /* ── CHURCH GRID ── */
      .church-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 20px; }
      .church-grid.list-view { grid-template-columns: 1fr; }

      .church-card { background: var(--bg-card); border: 1px solid var(--line-soft); border-radius: 14px; padding: 20px 22px; transition: border-color 0.18s, transform 0.18s; display: flex; flex-direction: column; gap: 10px; }
      .church-card:hover { border-color: rgba(220,38,38,0.4); transform: translateY(-2px); }
      .church-card.hidden { display: none; }

      .church-card-top { display: flex; align-items: flex-start; gap: 12px; }
      .church-icon { width: 42px; height: 42px; border-radius: 10px; background: rgba(159,18,57,0.15); border: 1px solid rgba(159,18,57,0.3); display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
      .church-icon svg { width: 20px; height: 20px; color: var(--red-muted); }
      .church-name-wrap { flex: 1; }
      .church-name { font-size: 0.96rem; font-weight: 700; color: var(--ink); line-height: 1.3; margin-bottom: 3px; }
      .church-location { font-size: 0.78rem; color: var(--ink-muted); }

      .ein-badge { display: inline-flex; align-items: center; gap: 5px; padding: 3px 9px; border-radius: 6px; background: rgba(212,165,55,0.1); border: 1px solid rgba(212,165,55,0.25); font-size: 0.72rem; color: var(--gold); font-family: 'Courier New', monospace; font-weight: 700; }
      .verified-badge { display: inline-flex; align-items: center; gap: 4px; padding: 2px 8px; border-radius: 6px; background: rgba(22,163,74,0.1); border: 1px solid rgba(22,163,74,0.25); font-size: 0.68rem; color: #4ade80; font-weight: 700; }

      .church-meta { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; }
      .state-badge { display: inline-block; padding: 2px 8px; border-radius: 4px; background: rgba(79,70,229,0.1); border: 1px solid rgba(79,70,229,0.22); color: #a5b4fc; font-size: 0.68rem; font-weight: 700; }
      .conference-tag { font-size: 0.73rem; color: var(--ink-muted); }

      .church-phone { font-size: 0.8rem; color: var(--gold-soft); font-family: 'Courier New', monospace; }
      .church-desc { font-size: 0.78rem; color: var(--ink-muted); line-height: 1.6; }

      .church-card-foot { display: flex; justify-content: space-between; align-items: center; margin-top: auto; padding-top: 10px; border-top: 1px solid rgba(255,255,255,0.05); }
      .church-links { display: flex; gap: 8px; }
      .church-link { display: inline-flex; align-items: center; justify-content: center; width: 30px; height: 30px; border-radius: 6px; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.08); color: var(--ink-muted); transition: all 0.18s; }
      .church-link:hover { background: rgba(220,38,38,0.1); border-color: rgba(220,38,38,0.3); color: var(--red-muted); }
      .church-link svg { width: 14px; height: 14px; }
      .church-cta { display: inline-flex; align-items: center; gap: 5px; padding: 6px 14px; border-radius: 8px; background: rgba(159,18,57,0.18); border: 1px solid rgba(159,18,57,0.35); color: var(--red-muted); font-size: 0.78rem; font-weight: 700; text-decoration: none; transition: all 0.18s; }
      .church-cta:hover { background: rgba(159,18,57,0.3); color: #fff; }

      /* ── LIST VIEW OVERRIDES ── */
      .list-view .church-card { flex-direction: row; align-items: center; gap: 18px; padding: 14px 20px; }
      .list-view .church-card-top { flex: 1; }
      .list-view .church-desc { display: none; }
      .list-view .church-card-foot { margin-top: 0; padding-top: 0; border-top: none; }

      /* ── EMPTY STATE ── */
      .no-results { display: none; text-align: center; padding: 60px 20px; color: var(--ink-muted); }
      .no-results svg { width: 48px; height: 48px; margin: 0 auto 16px; color: rgba(220,38,38,0.3); display: block; }
      .no-results h3 { font-family: 'Crimson Text', serif; font-size: 1.5rem; color: var(--ink); margin-bottom: 8px; }

      /* ── STATE SECTIONS ── */
      .state-section { margin-bottom: 50px; }
      .state-header { display: flex; align-items: baseline; gap: 14px; padding-bottom: 12px; border-bottom: 1px solid var(--line-soft); margin-bottom: 20px; }
      .state-header h2 { font-family: 'Crimson Text', serif; font-size: 1.6rem; color: var(--ink); }
      .state-church-count { font-size: 0.8rem; color: var(--ink-muted); }

      /* ── CTA ── */
      .cta-bar { background: linear-gradient(135deg, rgba(60,0,0,0.55), rgba(12,5,5,0.95)); border: 1px solid rgba(220,38,38,0.35); border-radius: 18px; padding: 32px 28px; text-align: center; margin-top: 60px; }
      .cta-bar h2 { font-family: 'Crimson Text', serif; font-size: 1.9rem; color: var(--ink); margin-bottom: 10px; }
      .cta-bar p { font-size: 0.9rem; color: var(--ink-muted); line-height: 1.8; max-width: 580px; margin: 0 auto 22px; }
      .cta-buttons { display: flex; flex-wrap: wrap; gap: 12px; justify-content: center; }
      .cta-btn { display: inline-flex; align-items: center; gap: 6px; padding: 11px 22px; border-radius: 10px; font-weight: 700; font-size: 0.88rem; text-decoration: none; transition: all 0.2s; }
      .cta-btn-primary { background: var(--crimson); color: #fff; border: 1px solid rgba(220,38,38,0.5); }
      .cta-btn-primary:hover { background: var(--red); color: #fff; }
      .cta-btn-secondary { background: transparent; color: var(--gold); border: 1px solid rgba(212,165,55,0.4); }
      .cta-btn-secondary:hover { background: rgba(212,165,55,0.1); color: #fcd34d; }

      @media (max-width: 640px) {
        .view-toggle { display: none; }
        .church-grid { grid-template-columns: 1fr; }
        .search-bar { flex-direction: column; }
      }
    </style>
  </head>
  <body>

