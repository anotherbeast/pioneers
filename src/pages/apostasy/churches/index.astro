    </nav>

    <main class="page">
      <div class="hero">
        <div class="breadcrumb">
          <a href="/">Home</a><span>›</span>
          <a href="/apostasy">Apostasy</a><span>›</span>
          Churches
        </div>
        <div class="page-eyebrow">IRS Group Exemption GEN 1071 · EIN 52-0643036</div>
        <h1>SDA Church Directory — <em>Corporate Franchises</em></h1>
        <p class="hero-subtitle">Every local Seventh-day Adventist church in America operates as a corporate franchise under the General Conference corporation (EIN 52-0643036, GEN 1071). These are not independent congregations — they are subsidiaries of a multinational 501(c)(3) that files as Protestant with the IRS while its president declared it "truly a Catholic organization." Search by name, state, or city. Click any church for its corporate profile and apostasy context.</p>
        <div class="hero-stats">
          <div class="stat-pill"><strong>{totalCount}</strong> churches indexed</div>
          <div class="stat-pill"><strong>{verifiedCount}</strong> EINs verified</div>
          <div class="stat-pill">Parent EIN: <strong>52-0643036</strong></div>
          <div class="stat-pill">Group Exemption: <strong>GEN 1071</strong></div>
          <div class="stat-pill">NTEE Code: <strong>X21 (Protestant)</strong></div>
          <div class="stat-pill"><strong>GC declared "truly Catholic"</strong> — 1981</div>
        </div>
      </div>

      <!-- APOSTASY ALERT BANNER -->
      <div class="apostasy-banner">
        <h2>What Every Visitor Must Know Before Attending an SDA Church</h2>
        <p>
          The General Conference Corporation of Seventh-day Adventists (EIN <strong>52-0643036</strong>) operates under
          IRS <strong>Group Exemption Number GEN 1071</strong> — meaning every local SDA church's tax exemption flows from
          this single parent corporation. Each local church is not an independent religious body; it is a corporate
          <strong>franchise</strong> subject to GC working policy, Conference licensing, and federal 501(c)(3) speech restrictions.
        </p>
        <p>
          The IRS lists the parent GC corporation's primary business activity as <strong>underwriting municipal insurance</strong> —
          not gospel ministry. The GC files its NTEE classification as <strong>X21 (Protestant)</strong> while GC President
          Neal C. Wilson stated in the <em>Adventist Review</em> (March 5, 1981): <strong>"I want to say this carefully — there is
          something very Catholic about the Seventh-day Adventist Church."</strong> In 1974, Wilson called the pioneer church
          a "trash heap" (trial transcript, Merikay McLeod case). The local church sitting on this page is a subsidiary of
          that corporate structure. <a href="/apostasy/corporations">See full corporate empire →</a>
        </p>
        <p>
          <strong>Revelation 18:4:</strong> "Come out of her, my people, that ye be not partakers of her sins,
          and that ye receive not of her plagues." — This is not a suggestion. It is a commandment.
        </p>
      </div>

      <!-- SEARCH AND FILTER BAR -->
      <div class="search-bar" id="search-bar">
        <div class="search-input-wrap">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
          <input class="search-input" id="church-search" type="search" placeholder="Search church name, city, state, or EIN…" autocomplete="off" aria-label="Search churches">
        </div>
        <select class="filter-select" id="state-filter" aria-label="Filter by state">
          <option value="">All States / Countries</option>
          {states.map(s => (
            <option value={s}>{s}</option>
          ))}
        </select>
        <select class="filter-select" id="ein-filter" aria-label="Filter by EIN status">
          <option value="">All EIN Status</option>
          <option value="verified">EIN Verified</option>
          <option value="unverified">EIN Not Yet Documented</option>
        </select>
        <div class="view-toggle">
          <button class="view-btn active" id="grid-btn" title="Grid view" aria-label="Grid view">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/></svg>
          </button>
          <button class="view-btn" id="list-btn" title="List view" aria-label="List view">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/></svg>
          </button>
        </div>
        <span class="results-count" id="results-count">{totalCount} churches</span>
      </div>

      <!-- MAP -->
      <div class="map-section">
        <h2>Church Map — GPS-Ready</h2>
        <div id="church-map" role="img" aria-label="Map of SDA churches"></div>
      </div>

      <!-- CHURCH GRID -->
      <div class="church-grid" id="church-grid">
        {churches.map(church => (
          <div
            class="church-card"
            data-name={(church.name || '').toLowerCase()}
            data-city={(church.city || '').toLowerCase()}
            data-state={(church.stateCode || church.state || '').toLowerCase()}
            data-country={(church.country || '').toLowerCase()}
            data-ein={(church.ein || '').toLowerCase()}
            data-verified={church.verified ? 'verified' : 'unverified'}
            data-lat={church.latitude ?? ''}
            data-lng={church.longitude ?? ''}
          >
            <div class="church-card-top">
              <div class="church-icon">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8h1a4 4 0 010 8h-1"/><path d="M2 8h16v9a4 4 0 01-4 4H6a4 4 0 01-4-4V8z"/><line x1="6" y1="1" x2="6" y2="4"/><line x1="10" y1="1" x2="10" y2="4"/><line x1="14" y1="1" x2="14" y2="4"/></svg>
              </div>
              <div class="church-name-wrap">
                <div class="church-name">{church.name}</div>
                <div class="church-location">
                  {[church.city, church.stateCode || church.state, church.country !== 'USA' ? church.country : ''].filter(Boolean).join(', ')}
                </div>
              </div>
            </div>

            <div class="church-meta">
              {(church.stateCode || church.state) && (
                <span class="state-badge">{church.stateCode || church.state}</span>
              )}
              {church.ein && (
                <span class="ein-badge">EIN {church.ein}</span>
              )}
              {church.verified && (
                <span class="verified-badge">✓ IRS Verified</span>
              )}
            </div>

            {church.conference && (
              <div class="conference-tag">{church.conference}</div>
            )}

            {church.phone && (
              <div class="church-phone">📞 {church.phone}</div>
            )}

            {church.description && (
              <div class="church-desc">{church.description}</div>
            )}

            <div class="church-card-foot">
              <div class="church-links">
                {church.website && (
                  <a class="church-link" href={church.website} target="_blank" rel="noopener noreferrer" title="Website" aria-label={`${church.name} website`}>
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 014 10 15.3 15.3 0 01-4 10 15.3 15.3 0 01-4-10 15.3 15.3 0 014-10z"/></svg>
                  </a>
                )}
                {church.facebook && (
                  <a class="church-link" href={church.facebook} target="_blank" rel="noopener noreferrer" title="Facebook" aria-label={`${church.name} on Facebook`}>
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3z"/></svg>
                  </a>
                )}
                {church.latitude && church.longitude && (
                  <a class="church-link" href={`https://www.google.com/maps/search/?api=1&query=${church.latitude},${church.longitude}`} target="_blank" rel="noopener noreferrer" title="Google Maps" aria-label={`${church.name} on Google Maps`}>
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>
                  </a>
                )}
              </div>
              <a class="church-cta" href={`/apostasy/churches/${church.slug}`}>
                View Profile <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="width:12px;height:12px"><polyline points="9 18 15 12 9 6"/></svg>
              </a>
            </div>
          </div>
        ))}
      </div>

      <div class="no-results" id="no-results">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        <h3>No Churches Found</h3>
        <p>Try a different search term, or broaden your state filter.</p>
      </div>

      <!-- CTA -->
      <div class="cta-bar">
        <h2>Come Out of Her — Revelation 18:4</h2>
        <p>The local SDA church is not an independent congregation. It is a corporate franchise of a multinational 501(c)(3) that calls itself Catholic, restricts its pastors from preaching truth, and lists its primary business as underwriting municipal insurance. The pioneers would not recognize it.</p>
        <div class="cta-buttons">
          <a class="cta-btn cta-btn-primary" href="/apostasy/corporations">Full Corporate Empire →</a>
          <a class="cta-btn cta-btn-primary" href="/501c3">The 501(c)(3) Trap →</a>
          <a class="cta-btn cta-btn-secondary" href="/apostasy">Apostate Shepherds →</a>
          <a class="cta-btn cta-btn-secondary" href="/library">Pioneer Library →</a>
        </div>
      </div>
    </main>

    <SiteFooter
      scripture="Come out of her, my people, that ye be not partakers of her sins, and that ye receive not of her plagues."
      scriptureRef="Revelation 18:4 (KJV)"
      pageLinks={[
        { label: "Corporate Empire", href: "/apostasy/corporations" },
        { label: "Schools (7,500+)", href: "/apostasy/schools" },
        { label: "Hospitals (173)", href: "/apostasy/hospitals" },
        { label: "Lawyers", href: "/apostasy/lawyers" },
        { label: "501(c)(3) Trap", href: "/501c3" },
        { label: "Apostate Shepherds", href: "/apostasy" },
      ]}
    />
    <ShareBar />
    <SiteSearch />

    <!-- Embed church data for JS search -->
    <script id="church-data" type="application/json" set:html={JSON.stringify(churches.map(c => ({
      slug: c.slug,
      name: c.name,
      city: c.city,
      stateCode: c.stateCode || c.state,
      country: c.country,
      ein: c.ein,
      verified: c.verified,
      lat: c.latitude,
      lng: c.longitude,
    })))} />

    <!-- Leaflet map -->
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV/XN/WLs=" crossorigin=""></script>

    <script>
      // Leaflet loaded via CDN — access through window to avoid TS errors
      declare const L: any; // eslint-disable-line no-var

      // ── Mobile nav ────────────────────────────────────────────────────────
      document.querySelectorAll('.menu-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          const wrap = btn.closest('.nav-wrap');
          if (!wrap) return;
          wrap.querySelector('.mobile-nav')?.classList.toggle('open');
        });
      });

      // ── Map init ──────────────────────────────────────────────────────────
      let _leafletMap: any = null;
      let _markers: any = null;

      function initMap(): void {
        const mapEl = document.getElementById('church-map');
        if (!mapEl) return;
        if (typeof L === 'undefined') return;
        _leafletMap = L.map('church-map', { center: [38.5, -96], zoom: 4, scrollWheelZoom: false });
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
          attribution: '\u00a9 <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
          maxZoom: 18,
        }).addTo(_leafletMap);
        _markers = L.layerGroup().addTo(_leafletMap);
        renderMapMarkers(document.querySelectorAll<HTMLElement>('.church-card:not(.hidden)'));
      }

      function renderMapMarkers(cards: NodeListOf<HTMLElement>): void {
        if (!_markers) return;
        _markers.clearLayers();
        cards.forEach(el => {
          const lat = parseFloat(el.dataset.lat || '');
          const lng = parseFloat(el.dataset.lng || '');
          if (isNaN(lat) || isNaN(lng)) return;
          const name = el.querySelector('.church-name')?.textContent || '';
          const href = el.querySelector('.church-cta')?.getAttribute('href') || '';
          L.circleMarker([lat, lng], {
            radius: 7, fillColor: '#dc2626', color: '#9f1239',
            weight: 1.5, opacity: 1, fillOpacity: 0.75,
          })
            .bindPopup(`<strong>${name}</strong><br><a href="${href}" style="color:#dc2626">View Profile &rarr;</a>`)
            .addTo(_markers);
        });
      }

      if (document.readyState === 'complete') { initMap(); }
      else { window.addEventListener('load', initMap); }

      // ── Search / filter ───────────────────────────────────────────────────
      const searchInput = document.getElementById('church-search') as HTMLInputElement | null;
      const stateFilter = document.getElementById('state-filter') as HTMLSelectElement | null;
      const einFilter   = document.getElementById('ein-filter') as HTMLSelectElement | null;
      const grid        = document.getElementById('church-grid');
      const noResults   = document.getElementById('no-results') as HTMLElement | null;
      const resultsCount = document.getElementById('results-count');
      const gridBtn     = document.getElementById('grid-btn');
      const listBtn     = document.getElementById('list-btn');

      function filterChurches(): void {
        const query    = (searchInput?.value ?? '').toLowerCase().trim();
        const stateVal = (stateFilter?.value ?? '').toLowerCase();
        const einVal   = einFilter?.value ?? '';
        const cards    = document.querySelectorAll<HTMLElement>('.church-card');
        let visible    = 0;

        cards.forEach(el => {
          const name     = el.dataset.name    ?? '';
          const city     = el.dataset.city    ?? '';
          const state    = el.dataset.state   ?? '';
          const country  = el.dataset.country ?? '';
          const ein      = el.dataset.ein     ?? '';
          const verified = el.dataset.verified ?? '';

          const matchQuery = !query ||
            name.includes(query) || city.includes(query) ||
            state.includes(query) || country.includes(query) || ein.includes(query);
          const matchState = !stateVal || state.startsWith(stateVal);
          const matchEin   = !einVal   || verified === einVal;

          if (matchQuery && matchState && matchEin) {
            el.classList.remove('hidden'); visible++;
          } else {
            el.classList.add('hidden');
          }
        });

        if (resultsCount) resultsCount.textContent = `${visible} church${visible !== 1 ? 'es' : ''}`;
        if (noResults) noResults.style.display = visible === 0 ? 'block' : 'none';
        if (_markers) renderMapMarkers(document.querySelectorAll<HTMLElement>('.church-card:not(.hidden)'));
      }

      searchInput?.addEventListener('input', filterChurches);
      stateFilter?.addEventListener('change', filterChurches);
      einFilter?.addEventListener('change', filterChurches);

      // ── View toggle ───────────────────────────────────────────────────────
      gridBtn?.addEventListener('click', () => {
        grid?.classList.remove('list-view');
        gridBtn.classList.add('active');
        listBtn?.classList.remove('active');
      });
      listBtn?.addEventListener('click', () => {
        grid?.classList.add('list-view');
        listBtn.classList.add('active');
        gridBtn?.classList.remove('active');
      });
    </script>
  </body>
</html>
