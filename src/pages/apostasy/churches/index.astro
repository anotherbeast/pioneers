---
import Analytics from '../../../components/Analytics.astro';
import ShareBar from '../../../components/ShareBar.astro';
import SiteSearch from '../../../components/SiteSearch.astro';
import SiteFooter from '../../../components/SiteFooter.astro';
import churchData from '../../../data/churches.json';

// Sort alphabetically by state then city
const churches = [...churchData].sort((a, b) => {
  const s = (a.stateCode || a.state || 'ZZ').localeCompare(b.stateCode || b.state || 'ZZ');
  if (s !== 0) return s;
  return (a.city || '').localeCompare(b.city || '');
});

// Unique states for filter dropdown
const states = [...new Set(churches.map(c => c.stateCode || c.state).filter(Boolean))].sort();

const totalCount = churches.length;
const verifiedCount = churches.filter(c => c.verified).length;
