    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Crimson+Text:ital,wght@0,400;0,600;1,400&display=swap" rel="stylesheet">
    <style>
      :root {
        --bg: #0d0505;
        --bg-soft: #120808;
        --bg-card: #160a0a;
        --ink: #fef3c7;
        --ink-muted: #9ca3af;
        --gold: #d4a537;
        --gold-soft: #fcd34d;
        --red: #dc2626;
        --red-soft: #ef4444;
        --red-muted: #fca5a5;
        --crimson: #9f1239;
        --line: rgba(220,38,38,0.22);
        --line-soft: rgba(220,38,38,0.12);
        --line-gold: rgba(212,165,55,0.22);
      }
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
      html { scroll-behavior: smooth; }
      body { margin: 0; font-family: 'Inter', sans-serif; color: var(--ink); background: var(--bg); overflow-x: hidden; }
      a { color: var(--red-muted); text-decoration: none; transition: color 0.2s; }
      a:hover { color: #fff; }

      /* NAV */
      .nav { position: sticky; top: 0; z-index: 100; background: rgba(10,2,2,0.96); backdrop-filter: blur(12px); border-bottom: 1px solid var(--line); }
      .nav-wrap { max-width: 1280px; margin: 0 auto; }
      .nav-row { display: flex; align-items: center; padding: 0 22px; }
      .nav-row-top { gap: 28px; height: 62px; border-bottom: 1px solid rgba(220,38,38,0.10); }
      .nav-row-bottom { gap: 22px; height: 42px; font-size: 0.82rem; overflow-x: auto; scrollbar-width: none; }
      .nav-brand { text-decoration: none; color: var(--ink); font-weight: 700; font-size: 1.05rem; flex-shrink: 0; margin-right: auto; }
      .nav-link { color: var(--ink-muted); text-decoration: none; font-weight: 600; font-size: 0.9rem; white-space: nowrap; transition: color 0.18s; }
      .nav-link:hover { color: var(--red-muted); }
      .nav-cta { display: inline-flex; align-items: center; height: 38px; padding: 0 18px; border-radius: 8px; background: var(--crimson); color: #fff; font-weight: 700; font-size: 0.88rem; text-decoration: none; flex-shrink: 0; transition: background 0.18s; }
      .nav-cta:hover { background: var(--red-soft); color: #fff; }
      .nav-bottom-link { color: rgba(156,163,175,0.8); text-decoration: none; font-weight: 500; white-space: nowrap; transition: color 0.18s; flex-shrink: 0; }
      .nav-bottom-link:hover, .nav-bottom-link.active { color: var(--red-muted); }
      .menu-btn { display: none; width: 40px; height: 40px; border: 1px solid var(--line); border-radius: 8px; background: rgba(255,255,255,0.03); color: var(--ink); font-size: 1.2rem; cursor: pointer; flex-shrink: 0; align-items: center; justify-content: center; }
      .mobile-nav { display: none; border-top: 1px solid var(--line); padding: 14px 22px 18px; background: rgba(10,2,2,0.97); }
      .mobile-nav.open { display: grid; gap: 6px; }
      .mobile-nav a { color: var(--ink-muted); text-decoration: none; font-weight: 600; padding: 8px 0; border-bottom: 1px solid rgba(255,255,255,0.05); }
      .mobile-nav a:hover { color: var(--red-muted); }
      @media (max-width: 860px) { .nav-row-bottom { display: none; } .menu-btn { display: inline-flex; } .nav-link { display: none; } }

      /* LAYOUT */
      .page { max-width: 1200px; margin: 0 auto; padding: 0 22px 80px; }

      /* HERO */
      .hero { padding: 52px 0 44px; }
      .breadcrumb { font-size: 0.8rem; color: var(--ink-muted); margin-bottom: 18px; }
      .breadcrumb a { color: var(--ink-muted); }
      .breadcrumb a:hover { color: var(--red-muted); }
      .breadcrumb span { margin: 0 6px; opacity: 0.5; }

      .alert-banner { background: linear-gradient(135deg, rgba(127,0,0,0.35), rgba(80,0,0,0.4)); border: 1px solid rgba(220,38,38,0.5); border-radius: 14px; padding: 20px 24px; margin-bottom: 36px; display: flex; align-items: flex-start; gap: 14px; }
      .alert-icon { font-size: 1.5rem; flex-shrink: 0; line-height: 1; margin-top: 2px; }
      .alert-body h2 { font-family: 'Crimson Text', serif; font-size: 1.3rem; font-weight: 600; color: var(--red-muted); margin-bottom: 6px; }
      .alert-body p { font-size: 0.88rem; color: rgba(254,243,199,0.8); line-height: 1.75; }
      .alert-body strong { color: var(--red-muted); }
      .alert-body a { color: var(--gold); text-decoration: underline; }

      .page-eyebrow { display: inline-flex; align-items: center; gap: 6px; padding: 5px 14px; border-radius: 999px; background: rgba(159,18,57,0.15); border: 1px solid rgba(159,18,57,0.4); color: var(--red-muted); font-size: 0.74rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 16px; }
      .page-header h1 { font-family: 'Crimson Text', serif; font-size: clamp(2.2rem, 5vw, 3.4rem); font-weight: 600; line-height: 1.1; color: var(--ink); margin-bottom: 12px; }
      .page-header h1 em { font-style: italic; color: var(--red-muted); }
      .page-header .subtitle { font-size: 1.02rem; color: rgba(254,243,199,0.75); line-height: 1.85; max-width: 760px; margin-bottom: 28px; }

      /* PARENT ORG BOX */
      .parent-box { background: linear-gradient(135deg, rgba(60,0,0,0.7), rgba(12,5,5,0.95)); border: 2px solid rgba(220,38,38,0.5); border-radius: 22px; padding: 28px 32px; margin-bottom: 40px; display: flex; flex-wrap: wrap; gap: 24px; align-items: flex-start; }
      .parent-seal { width: 80px; height: 80px; border-radius: 50%; background: rgba(159,18,57,0.2); border: 2px solid rgba(220,38,38,0.5); display: flex; align-items: center; justify-content: center; font-size: 2rem; flex-shrink: 0; }
      .parent-info { flex: 1; min-width: 260px; }
      .parent-info h2 { font-family: 'Crimson Text', serif; font-size: 1.6rem; font-weight: 600; color: var(--ink); margin-bottom: 6px; }
      .parent-info .ein-badge { display: inline-flex; align-items: center; gap: 6px; padding: 4px 12px; border-radius: 999px; background: rgba(212,165,55,0.12); border: 1px solid rgba(212,165,55,0.4); color: var(--gold); font-size: 0.78rem; font-weight: 700; letter-spacing: 0.06em; margin-bottom: 10px; }
      .parent-info p { font-size: 0.88rem; color: rgba(254,243,199,0.75); line-height: 1.75; }
      .parent-stats { display: flex; flex-direction: column; gap: 8px; min-width: 200px; }
      .p-stat { background: rgba(30,10,10,0.7); border: 1px solid var(--line-soft); border-radius: 10px; padding: 10px 16px; }
      .p-stat-label { font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--ink-muted); font-weight: 700; margin-bottom: 2px; }
      .p-stat-value { font-size: 0.9rem; color: var(--red-muted); font-weight: 700; }

      /* SECTION */
      .section { padding: 48px 0; border-top: 1px solid var(--line-soft); }
      .section-header { margin-bottom: 28px; }
      .sh-eyebrow { display: inline-block; padding: 4px 14px; border-radius: 999px; border: 1px solid var(--line); color: var(--red-muted); letter-spacing: 0.1em; text-transform: uppercase; font-size: 0.72rem; font-weight: 700; margin-bottom: 10px; }
      .section-header h2 { font-family: 'Crimson Text', serif; font-size: clamp(1.6rem, 3vw, 2.2rem); font-weight: 600; color: var(--ink); margin-bottom: 8px; }
      .section-header h2 em { color: var(--red-muted); font-style: italic; }
      .section-header p { color: var(--ink-muted); font-size: 0.92rem; line-height: 1.8; max-width: 780px; }

      /* CORP CARDS GRID */
      .corp-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 18px; }
      .corp-card { background: var(--bg-card); border: 1px solid var(--line-soft); border-radius: 16px; padding: 22px 20px; display: flex; flex-direction: column; gap: 10px; transition: all 0.2s; position: relative; overflow: hidden; }
      .corp-card::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 3px; }
      .corp-card.cat-media::before { background: linear-gradient(to right, #7c3aed, #4f46e5); }
      .corp-card.cat-health::before { background: linear-gradient(to right, #059669, #10b981); }
      .corp-card.cat-education::before { background: linear-gradient(to right, #f59e0b, #d97706); }
      .corp-card.cat-publishing::before { background: linear-gradient(to right, #0284c7, #0369a1); }
      .corp-card.cat-relief::before { background: linear-gradient(to right, #dc2626, #b91c1c); }
      .corp-card.cat-insurance::before { background: linear-gradient(to right, #374151, #111827); }
      .corp-card.cat-parent::before { background: linear-gradient(to right, #9f1239, #7f1d1d); }
      .corp-card.cat-conference::before { background: linear-gradient(to right, #92400e, #78350f); }
      .corp-card:hover { border-color: rgba(220,38,38,0.35); transform: translateY(-2px); box-shadow: 0 8px 28px rgba(0,0,0,0.5); }

      .card-cat { display: inline-flex; align-items: center; gap: 5px; padding: 3px 10px; border-radius: 999px; font-size: 0.68rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.07em; width: fit-content; }
      .cat-media .card-cat { background: rgba(124,58,237,0.15); border: 1px solid rgba(124,58,237,0.35); color: #c4b5fd; }
      .cat-health .card-cat { background: rgba(5,150,105,0.15); border: 1px solid rgba(5,150,105,0.35); color: #6ee7b7; }
      .cat-education .card-cat { background: rgba(245,158,11,0.15); border: 1px solid rgba(245,158,11,0.35); color: #fcd34d; }
      .cat-publishing .card-cat { background: rgba(2,132,199,0.15); border: 1px solid rgba(2,132,199,0.35); color: #7dd3fc; }
      .cat-relief .card-cat { background: rgba(220,38,38,0.15); border: 1px solid rgba(220,38,38,0.35); color: var(--red-muted); }
      .cat-insurance .card-cat { background: rgba(55,65,81,0.3); border: 1px solid rgba(107,114,128,0.35); color: #d1d5db; }
      .cat-parent .card-cat { background: rgba(159,18,57,0.2); border: 1px solid rgba(159,18,57,0.4); color: var(--red-muted); }
      .cat-conference .card-cat { background: rgba(146,64,14,0.2); border: 1px solid rgba(146,64,14,0.4); color: #fcd34d; }

      .card-name { font-family: 'Crimson Text', serif; font-size: 1.2rem; font-weight: 600; color: var(--ink); line-height: 1.3; }
      .card-ein { font-size: 0.75rem; color: var(--gold); font-weight: 700; font-family: 'Courier New', monospace; display: flex; align-items: center; gap: 5px; }
      .card-ein::before { content: 'EIN'; font-size: 0.62rem; padding: 1px 5px; border-radius: 4px; background: rgba(212,165,55,0.12); border: 1px solid rgba(212,165,55,0.3); font-family: 'Inter', sans-serif; letter-spacing: 0.06em; }
      .card-desc { font-size: 0.83rem; color: var(--ink-muted); line-height: 1.65; flex: 1; }
      .card-meta { display: flex; flex-wrap: wrap; gap: 6px; padding-top: 8px; border-top: 1px solid rgba(255,255,255,0.06); }
      .card-tag { font-size: 0.68rem; padding: 2px 8px; border-radius: 4px; background: rgba(255,255,255,0.05); color: rgba(156,163,175,0.8); border: 1px solid rgba(255,255,255,0.07); }
      .card-revenue { font-size: 0.75rem; color: var(--red-muted); font-weight: 700; }
      .card-link { display: inline-flex; align-items: center; gap: 4px; font-size: 0.76rem; color: rgba(156,163,175,0.6); transition: color 0.15s; margin-top: 2px; }
      .card-link:hover { color: var(--gold); }

      /* STATS BAR */
      .stats-bar { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 14px; background: rgba(20,8,8,0.8); border: 1px solid var(--line); border-radius: 16px; padding: 24px 28px; margin-bottom: 36px; }
      .stat-item { text-align: center; }
      .stat-num { font-family: 'Crimson Text', serif; font-size: 2rem; font-weight: 600; color: var(--red-muted); line-height: 1; margin-bottom: 4px; }
      .stat-label { font-size: 0.73rem; color: var(--ink-muted); text-transform: uppercase; letter-spacing: 0.08em; font-weight: 600; }

      /* QUOTE BLOCK */
      .quote-block { background: linear-gradient(135deg, rgba(50,0,0,0.5), rgba(12,5,5,0.9)); border: 1px solid rgba(220,38,38,0.3); border-left: 4px solid var(--red); border-radius: 0 14px 14px 0; padding: 22px 24px; margin-bottom: 22px; }
      .quote-block blockquote { font-family: 'Crimson Text', serif; font-size: 1.15rem; color: rgba(254,243,199,0.92); line-height: 1.85; margin-bottom: 8px; }
      .quote-block cite { font-size: 0.8rem; color: var(--gold); font-style: italic; }

      /* ORG CHART TREE */
      .org-tree { background: rgba(15,5,5,0.8); border: 1px solid var(--line); border-radius: 16px; padding: 28px; font-size: 0.88rem; }
      .org-root { display: flex; align-items: center; gap: 12px; padding: 14px 18px; background: linear-gradient(to right, rgba(159,18,57,0.3), rgba(80,0,0,0.2)); border: 2px solid rgba(220,38,38,0.5); border-radius: 12px; margin-bottom: 20px; }
      .org-root-name { font-family: 'Crimson Text', serif; font-size: 1.2rem; font-weight: 600; color: var(--red-muted); }
      .org-root-ein { font-size: 0.75rem; color: var(--gold); font-family: monospace; }
      .org-branches { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 10px; padding-left: 20px; border-left: 2px solid rgba(220,38,38,0.25); }
      .org-branch { padding: 10px 14px; background: rgba(25,10,10,0.7); border: 1px solid var(--line-soft); border-radius: 10px; }
      .ob-cat { font-size: 0.68rem; text-transform: uppercase; letter-spacing: 0.07em; color: var(--ink-muted); font-weight: 700; margin-bottom: 3px; }
      .ob-name { font-weight: 600; color: rgba(254,243,199,0.9); font-size: 0.88rem; line-height: 1.3; }
      .ob-ein { font-size: 0.72rem; color: rgba(212,165,55,0.7); font-family: monospace; }

      /* FRAUD SECTION */
      .fraud-box { background: linear-gradient(135deg, rgba(80,0,0,0.4), rgba(12,5,5,0.9)); border: 1px solid rgba(220,38,38,0.4); border-radius: 16px; padding: 26px 28px; }
      .fraud-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 22px; }
      @media (max-width: 640px) { .fraud-grid { grid-template-columns: 1fr; } }
      .fraud-col h3 { font-family: 'Crimson Text', serif; font-size: 1.15rem; font-weight: 600; margin-bottom: 12px; padding-bottom: 10px; border-bottom: 1px solid rgba(255,255,255,0.1); }
      .fraud-col.protestant h3 { color: var(--gold); }
      .fraud-col.catholic h3 { color: var(--red-muted); }
      .fraud-col li { font-size: 0.87rem; color: rgba(254,243,199,0.8); line-height: 1.75; margin-bottom: 6px; padding-left: 16px; position: relative; }
      .fraud-col li::before { content: '►'; position: absolute; left: 0; font-size: 0.6rem; top: 5px; }
      .fraud-col.protestant li::before { color: var(--gold); }
      .fraud-col.catholic li::before { color: var(--red-muted); }

      /* CTA */
      .cta-bar { background: linear-gradient(135deg, rgba(60,0,0,0.5), rgba(12,5,5,0.9)); border: 1px solid rgba(220,38,38,0.35); border-radius: 18px; padding: 32px; text-align: center; margin-top: 52px; }
      .cta-bar h2 { font-family: 'Crimson Text', serif; font-size: 1.9rem; color: var(--ink); margin-bottom: 10px; }
      .cta-bar p { font-size: 0.92rem; color: var(--ink-muted); line-height: 1.8; max-width: 580px; margin: 0 auto 22px; }
      .cta-buttons { display: flex; flex-wrap: wrap; gap: 12px; justify-content: center; }
      .cta-btn { display: inline-flex; align-items: center; gap: 6px; padding: 12px 22px; border-radius: 10px; font-weight: 700; font-size: 0.88rem; text-decoration: none; transition: all 0.2s; }
      .cta-btn-primary { background: var(--crimson); color: #fff; border: 1px solid rgba(220,38,38,0.5); }
      .cta-btn-primary:hover { background: var(--red); color: #fff; }
      .cta-btn-secondary { background: transparent; color: var(--gold); border: 1px solid rgba(212,165,55,0.4); }
      .cta-btn-secondary:hover { background: rgba(212,165,55,0.1); color: var(--gold-soft); }

      /* FOOTER */
      .footer { border-top: 1px solid var(--line-soft); padding: 28px 22px; text-align: center; font-size: 0.78rem; color: var(--ink-muted); }
      .footer a { color: var(--red-muted); }

      @media (max-width: 640px) { .corp-grid { grid-template-columns: 1fr; } .parent-box { flex-direction: column; } .stats-bar { grid-template-columns: repeat(2, 1fr); } }
    </style>
  </head>
