---
import Analytics from '../../components/Analytics.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import ShareBar from '../../components/ShareBar.astro';
import SiteSearch from '../../components/SiteSearch.astro';
const pageUrl = "https://adventpioneerlibrary.com/pioneers/1850-prophecy-chart";
const pageTitle = "The 1850 Prophecy Chart | Seventh-day Adventist Pioneers — Sanctuary, Sabbath & Three Angels";
const pageDesc = "The 1850 Adventist Prophetic Chart — produced after the Great Disappointment of 1844 to present the heavenly sanctuary, the seventh-day Sabbath, the Three Angels' Messages, and the Seal of God to a scattered people.";
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <Analytics />
  <title>{pageTitle}</title>
  <meta name="description" content={pageDesc} />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={pageDesc} />
  <meta property="og:image" content="/pioneers/images/1850-prophecy-chart.jpg" />
  <meta property="og:url" content={pageUrl} />
  <meta property="og:type" content="article" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={pageTitle} />
  <meta name="twitter:description" content={pageDesc} />
  <meta name="twitter:image" content="/pioneers/images/1850-prophecy-chart.jpg" />
  <link rel="canonical" href={pageUrl} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,500;1,600&family=Source+Sans+3:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <style>
    :root {
      --bg: #060b17;
      --ink: #f8f1dd;
      --muted: #d3c39d;
      --line: rgba(214,167,69,0.28);
      --gold: #d6a745;
      --amber: #f0be5c;
      --gold-soft: #f5d98a;
    }
    *, *::before, *::after { box-sizing: border-box; }
    body {
      margin: 0; padding: 0;
      font-family: 'Source Sans 3', sans-serif;
      color: var(--ink);
      background:
        radial-gradient(circle at 72% 12%, rgba(214,167,69,0.13), transparent 36%),
        radial-gradient(circle at 22% 78%, rgba(92,111,160,0.15), transparent 40%),
        linear-gradient(160deg, #050914 0%, #091125 52%, #060b16 100%);
      min-height: 100vh;
    }
    .serif { font-family: 'Cormorant Garamond', serif; }
    img { max-width: 100%; height: auto; display: block; }
    a { color: var(--amber); text-decoration: none; }
    a:hover { text-decoration: underline; }

    .topbar {
      position: sticky; top: 0; z-index: 40;
      backdrop-filter: blur(10px);
      background: rgba(6,11,23,0.84);
      border-bottom: 1px solid var(--line);
    }
    .topbar-inner {
      max-width: 1200px; margin: 0 auto; padding: 13px 24px;
      display: flex; align-items: center; gap: 16px; flex-wrap: wrap;
    }
    .brand { display: flex; align-items: center; gap: 9px; color: var(--ink); font-weight: 700; font-size: 1rem; }
    .brand strong { color: var(--gold); }
    .nav-links { display: flex; gap: 4px; flex-wrap: wrap; margin-left: auto; }
    .nav-link {
      padding: 5px 12px; border-radius: 7px; font-size: 0.82rem; font-weight: 600;
      color: var(--muted); border: 1px solid transparent; transition: all .2s;
    }
    .nav-link:hover { color: var(--amber); border-color: var(--line); text-decoration: none; }

    .hero {
      padding: 64px 24px 52px;
      background: linear-gradient(160deg, #07101f 0%, #0b1830 55%, #071020 100%);
      border-bottom: 1px solid var(--line); position: relative; overflow: hidden;
    }
    .hero::before {
      content: ''; position: absolute; inset: 0;
      background: radial-gradient(ellipse at 50% 0%, rgba(214,167,69,0.16), transparent 65%);
      pointer-events: none;
    }
    .hero-inner { position: relative; max-width: 1100px; margin: 0 auto; display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: center; }
    @media (max-width: 860px) { .hero-inner { grid-template-columns: 1fr; } }
    .eyebrow {
      display: inline-block; margin-bottom: 16px;
      padding: 5px 14px; border-radius: 999px;
      background: rgba(214,167,69,0.12); border: 1px solid rgba(214,167,69,0.35);
      color: var(--amber); font-size: 0.78rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em;
    }
    .hero h1 { font-size: clamp(2rem, 5vw, 3.6rem); margin: 0 0 16px; line-height: 1.1; }
    .hero h1 span { color: var(--gold); }
    .hero-sub { color: var(--muted); line-height: 1.85; font-size: 1.05rem; margin-bottom: 24px; }
    .hero-meta { display: flex; gap: 20px; flex-wrap: wrap; margin-bottom: 28px; }
    .hero-meta-item { color: var(--muted); font-size: 0.88rem; }
    .hero-meta-item strong { color: var(--amber); }
    .btn-gold {
      display: inline-block; padding: 12px 24px; border-radius: 10px;
      background: var(--gold); color: #111; font-weight: 700; font-size: 0.95rem; transition: all .2s;
    }
    .btn-gold:hover { background: var(--amber); transform: translateY(-2px); text-decoration: none; color: #111; }
    .btn-outline {
      display: inline-block; padding: 11px 22px; border-radius: 10px;
      border: 1px solid rgba(214,167,69,0.45); color: var(--amber); font-weight: 700; font-size: 0.95rem; transition: all .2s;
    }
    .btn-outline:hover { background: rgba(214,167,69,0.1); transform: translateY(-2px); text-decoration: none; }
    .hero-btns { display: flex; gap: 12px; flex-wrap: wrap; }
    .hero-img-wrap {
      border-radius: 20px; overflow: hidden;
      border: 2px solid rgba(214,167,69,0.35);
      box-shadow: 0 30px 80px rgba(0,0,0,0.5);
      cursor: zoom-in; position: relative;
    }
    .hero-img-wrap img { width: 100%; display: block; transition: transform .4s ease; }
    .hero-img-wrap:hover img { transform: scale(1.03); }
    .hero-img-caption { padding: 12px 18px; background: rgba(4,8,20,0.7); border-top: 1px solid var(--line); color: var(--muted); font-size: 0.82rem; text-align: center; }

    .section { padding: 64px 24px; }
    .section-dark { background: rgba(4,8,20,0.55); }
    .section-warm { background: linear-gradient(160deg, rgba(25,18,4,0.8), rgba(8,12,28,0.88)); }
    .section-inner { max-width: 1100px; margin: 0 auto; }
    .section-narrow { max-width: 820px; margin: 0 auto; }

    .sh { text-align: center; margin-bottom: 40px; }
    .sh-deco { display: flex; align-items: center; justify-content: center; gap: 12px; margin-bottom: 14px; }
    .sh-line { width: 48px; height: 2px; background: linear-gradient(to right, transparent, var(--gold)); }
    .sh-line:last-child { background: linear-gradient(to left, transparent, var(--gold)); }
    .sh-star { width: 18px; height: 18px; color: var(--gold); }
    .sh h2 { font-size: clamp(1.7rem, 3.5vw, 2.5rem); font-weight: 700; color: var(--gold-soft); margin: 0 0 12px; }
    .sh p { color: var(--muted); line-height: 1.85; max-width: 740px; margin: 0 auto; }

    .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }
    @media (max-width: 760px) { .grid-2 { grid-template-columns: 1fr; } }
    .grid-3 { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 20px; }

    .sq { border-radius: 16px; padding: 22px 24px; margin-bottom: 18px; border: 1px solid var(--line); }
    .sq-gold { background: linear-gradient(135deg, rgba(20,14,2,0.8), rgba(8,12,28,0.9)); border-color: rgba(214,167,69,0.4); }
    .sq-dark { background: rgba(4,8,20,0.6); border-color: rgba(214,167,69,0.2); }
    .sq p { color: var(--ink); line-height: 1.85; margin: 0 0 10px; }
    .sq cite { color: var(--muted); font-size: 0.85rem; font-style: italic; }
    .sq h3 { color: var(--gold-soft); font-size: 1.25rem; margin: 0 0 10px; }
    .card { background: linear-gradient(180deg,rgba(14,18,44,0.92),rgba(7,12,30,0.95)); border:1px solid rgba(214,167,69,0.2); border-radius:16px; padding:22px; }
    .card h3 { color: var(--gold-soft); margin: 0 0 10px; font-size: 1.2rem; }
    .card p { color: var(--muted); line-height: 1.8; margin: 0; }

    .egw { position: relative; border-radius: 14px; padding: 20px 22px 20px 26px; background: linear-gradient(135deg,rgba(10,18,5,0.8),rgba(4,10,22,0.9)); border: 1px solid rgba(100,160,80,0.28); margin-bottom: 18px; }
    .egw::before { content: '\201C'; position: absolute; top: -8px; left: 14px; font-size: 3.8rem; color: rgba(100,180,80,0.22); font-family: serif; line-height: 1; }
    .egw p { color: var(--ink); font-style: italic; line-height: 1.85; margin: 0 0 8px; }
    .egw cite { color: var(--muted); font-size: 0.84rem; }

    .pillar-row { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 16px; margin-bottom: 20px; }
    .pillar { background: linear-gradient(180deg,rgba(18,14,4,0.9),rgba(8,12,28,0.95)); border: 1px solid rgba(214,167,69,0.3); border-radius: 14px; padding: 18px; text-align: center; }
    .pillar-num { font-family: 'Cormorant Garamond', serif; font-size: 2.2rem; font-weight: 700; color: var(--gold); line-height: 1; margin-bottom: 8px; }
    .pillar-label { color: var(--amber); font-weight: 700; font-size: 0.92rem; margin-bottom: 6px; }
    .pillar-sub { color: var(--muted); font-size: 0.82rem; }

    .pdf-frame { border: 1px solid rgba(214,167,69,0.28); border-radius: 16px; overflow: hidden; box-shadow: 0 16px 40px rgba(0,0,0,0.25); }
    .pdf-label { padding: 12px 18px; color: var(--gold); font-weight: 700; text-transform: uppercase; font-size: 0.8rem; letter-spacing: 0.05em; border-bottom: 1px solid rgba(214,167,69,0.15); background: rgba(4,8,20,0.7); display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 8px; }
    .pdf-label a { font-size: 0.8rem; color: var(--amber); font-weight: 700; }
    .pdf-frame iframe { width: 100%; height: 820px; border: none; background: #fff; display: block; }
    @media (max-width: 640px) { .pdf-frame iframe { height: 520px; } }

    .lightbox { position: fixed; inset: 0; z-index: 3000; background: rgba(2,6,23,0.92); backdrop-filter: blur(8px); display: none; align-items: center; justify-content: center; padding: 20px; }
    .lightbox.open { display: flex; }
    .lightbox-inner { position: relative; max-width: min(1200px, 95vw); max-height: 90vh; }
    .lightbox-inner img { max-width: 100%; max-height: 88vh; border-radius: 12px; object-fit: contain; box-shadow: 0 40px 100px rgba(0,0,0,0.6); }
    .lightbox-close { position: absolute; top: -14px; right: -14px; width: 40px; height: 40px; border-radius: 999px; background: var(--gold); color: #111; font-weight: 900; font-size: 1.1rem; border: none; cursor: pointer; display: flex; align-items: center; justify-content: center; }

    .share-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 10px; margin-top: 18px; }
    .share-btn { display: flex; align-items: center; justify-content: center; gap: 8px; padding: 13px; border-radius: 10px; font-weight: 700; font-size: 0.9rem; background: linear-gradient(180deg,rgba(22,30,58,0.95),rgba(12,18,40,0.95)); border: 1px solid rgba(255,255,255,0.08); color: var(--ink); cursor: pointer; transition: all .2s; }
    .share-btn:hover { border-color: rgba(214,167,69,0.4); transform: translateY(-2px); }

    footer { border-top: 1px solid var(--line); background: rgba(4,8,20,0.85); }
    .footer-banner { text-align: center; padding: 26px 24px; border-bottom: 1px solid var(--line); background: linear-gradient(180deg,rgba(214,167,69,0.06),transparent); }
    .footer-banner p { font-family: 'Cormorant Garamond', serif; font-size: 1.1rem; color: var(--ink); font-style: italic; margin: 0 0 6px; }
    .footer-banner cite { color: var(--muted); font-size: 0.84rem; }
    .footer-main { max-width: 1100px; margin: 0 auto; padding: 40px 24px 20px; display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 28px; }
    .footer-col h4 { color: var(--amber); font-size: 0.88rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; margin: 0 0 12px; }
    .footer-col ul { list-style: none; margin: 0; padding: 0; }
    .footer-col ul li { margin-bottom: 7px; }
    .footer-col ul li a { color: var(--muted); font-size: 0.86rem; }
    .footer-col ul li a:hover { color: var(--amber); text-decoration: none; }
    .footer-bottom { text-align: center; padding: 18px 24px; border-top: 1px solid var(--line); color: var(--muted); font-size: 0.82rem; }
  </style>
</head>
<body>

<!-- LIGHTBOX -->
<div class="lightbox" id="lightbox" role="dialog" aria-modal="true" aria-label="Chart full view">
  <div class="lightbox-inner">
    <button class="lightbox-close" onclick="closeLightbox()" aria-label="Close">✕</button>
    <img src="/images/pioneers/1850-prophecy-chart.jpg" alt="1850 Adventist Prophecy Chart — full size" loading="lazy" />
  </div>
</div>

<!-- TOPBAR -->
<nav class="topbar" aria-label="Site navigation">
  <div class="topbar-inner">
    <a class="brand serif" href="/"><span>Advent</span> <strong>Pioneer Library</strong></a>
    <div class="nav-links">
      <a href="/" class="nav-link">Home</a>
      <a href="/pioneers" class="nav-link">Pioneers</a>
      <a href="/prophecy-charts" class="nav-link">Prophecy Charts</a>
      <a href="/books/3angels" class="nav-link">Three Angels</a>
      <a href="/religious-liberty" class="nav-link">Religious Liberty</a>
      <a href="/april-15-1904-new-organization" class="nav-link">1904 Record</a>
      <a href="/midnight-cry" class="nav-link">Midnight Cry Movie</a>
    </div>
  </div>
</nav>

<!-- HERO -->
<section class="hero">
  <div class="hero-inner">
    <div>
      <span class="eyebrow">Prophetic Chart · 1850</span>
      <h1 class="serif">The 1850 <span>Prophetic</span> Chart</h1>
      <p class="hero-sub">Produced after the Great Disappointment of October 22, 1844 — this chart presented the full light of the pioneers: the heavenly sanctuary, the seventh-day Sabbath, the Three Angels' Messages, the Seal of God, and the Mark of the Beast. The prophetic platform of the Seventh-day Adventist movement.</p>
      <div class="hero-meta">
        <div class="hero-meta-item"><strong>Year:</strong> 1850</div>
        <div class="hero-meta-item"><strong>Movement:</strong> Advent / Sabbatarian pioneers</div>
        <div class="hero-meta-item"><strong>Key texts:</strong> Rev. 14:6–12; Daniel 8:14; Rev. 7</div>
      </div>
      <div class="hero-btns">
        <a href="/books/1850-prophecy-chart/1850-chart.pdf" target="_blank" rel="noopener" class="btn-gold">Download PDF →</a>
        <button class="btn-outline" onclick="openLightbox()">View Full Chart Image</button>
        <a href="/books/1850-prophecy-chart/1850ChartExplanation.pdf" target="_blank" rel="noopener" class="btn-outline">Chart Explanation PDF</a>
      </div>
    </div>
    <div>
      <div class="hero-img-wrap" onclick="openLightbox()" title="Click to enlarge">
        <img src="/images/pioneers/1850-prophecy-chart.jpg" alt="The 1850 Adventist Prophetic Chart" loading="lazy" />
        <div class="hero-img-caption">
          🔍 Click to enlarge · The 1850 Advent Prophetic Chart
        </div>
      </div>
    </div>
  </div>
</section>

<!-- THE GREAT DISAPPOINTMENT CONTEXT -->
<section class="section section-dark">
  <div class="section-inner">
    <div class="sh">
      <div class="sh-deco"><div class="sh-line"></div><svg class="sh-star" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z"/></svg><div class="sh-line"></div></div>
      <h2 class="serif">After the Great Disappointment</h2>
      <p>October 22, 1844 came and went. The movement was scattered. But the light was not extinguished — it was clarified. The pioneers searched the Scriptures and were led into deeper truth.</p>
    </div>

    <div class="grid-2">
      <div>
        <div class="egw">
          <p class="serif">"It was not the will of God that the coming of Christ should be thus delayed, and that His people should not be prepared to receive Him. Not then did the world receive the warning to prepare for that day. The disappointment of those who believed in the soon coming of Christ was indeed bitter to those who had expected to see their Lord."</p>
          <cite>— Ellen G. White, <em>The Great Controversy</em></cite>
        </div>
        <div class="sq sq-gold">
          <h3 class="serif" style="margin-bottom:8px;">The Sealing — Opening of the 1850 Chart</h3>
          <p>Joseph Bates had proclaimed the seventh-day Sabbath since 1846. By 1849–1850, James and Ellen White joined Bates. The scattered remnant began keeping the Sabbath and studying the sealing message of Revelation 7. The 1850 chart was the visual platform of this new truth.</p>
        </div>
      </div>
      <div>
        <div class="sq sq-dark">
          <h3 class="serif">The Cornfield Vision — Hiram Edson</h3>
          <p>On the morning after October 22, 1844, Hiram Edson walked through a cornfield in tears. There the light broke upon him: the sanctuary to be cleansed was not on earth but in heaven. Christ had entered the Most Holy Place — not to come to earth, but to begin the investigative judgment. This was the key that unlocked the 1850 chart.</p>
          <a href="/pioneers/hiram-edson" style="color:var(--amber);font-size:0.88rem;font-weight:700;display:block;margin-top:10px;">Read Hiram Edson's biography →</a>
        </div>
        <div class="sq sq-dark" style="margin-top:0">
          <h3 class="serif">Otis Nichols & The Chart</h3>
          <p>Otis Nichols was the devoted Adventist who hosted Ellen White in her early years of ministry. His home in Dorchester, Massachusetts was a center of the early Advent movement. He played a key role in producing and distributing the prophetic charts and supported the pioneers' publishing work.</p>
          <a href="/pioneers/otis-nichols" style="color:var(--amber);font-size:0.88rem;font-weight:700;display:block;margin-top:10px;">Read Otis Nichols' biography →</a>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- WHAT THE 1850 CHART CONTAINS -->
<section class="section section-warm">
  <div class="section-inner">
    <div class="sh">
      <div class="sh-deco"><div class="sh-line"></div><svg class="sh-star" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z"/></svg><div class="sh-line"></div></div>
      <h2 class="serif">The Seven Pillars of the 1850 Chart</h2>
      <p>The 1850 chart expanded and corrected the 1843 chart — presenting the complete prophetic platform of the Sabbatarian Adventist pioneers.</p>
    </div>

    <div class="pillar-row">
      <div class="pillar">
        <div class="pillar-num">I</div>
        <div class="pillar-label">The Heavenly Sanctuary</div>
        <div class="pillar-sub">Daniel 8:14 — Most Holy Place opened in 1844; Christ as High Priest (Heb. 8–9)</div>
      </div>
      <div class="pillar">
        <div class="pillar-num">II</div>
        <div class="pillar-label">The Seventh-day Sabbath</div>
        <div class="pillar-sub">Fourth commandment — Seal of God. Ex. 20:8–11; Rev. 14:12</div>
      </div>
      <div class="pillar">
        <div class="pillar-num">III</div>
        <div class="pillar-label">Three Angels' Messages</div>
        <div class="pillar-sub">Revelation 14:6–12 — The everlasting gospel to every nation</div>
      </div>
      <div class="pillar">
        <div class="pillar-num">IV</div>
        <div class="pillar-label">Seal of God</div>
        <div class="pillar-sub">Revelation 7:1–4 — 144,000 sealed before the four winds of strife</div>
      </div>
      <div class="pillar">
        <div class="pillar-num">V</div>
        <div class="pillar-label">Mark of the Beast</div>
        <div class="pillar-sub">Revelation 13:16–17; 14:9 — Counterfeit day of worship vs. Sabbath</div>
      </div>
      <div class="pillar">
        <div class="pillar-num">VI</div>
        <div class="pillar-label">2300-Day Prophecy</div>
        <div class="pillar-sub">Daniel 8:14 — 457 BC to 1844. Continued from 1843 chart with heavenly correction</div>
      </div>
      <div class="pillar">
        <div class="pillar-num">VII</div>
        <div class="pillar-label">Spirit of Prophecy</div>
        <div class="pillar-sub">Rev. 12:17; 19:10 — Gift of prophecy to the remnant church. Ellen White visions 1844+</div>
      </div>
    </div>

    <div class="egw" style="margin-top:28px;">
      <p class="serif">"I was shown that the 1843 chart was directed by the hand of the Lord, and that it should not be altered; that the figures were as He wanted them; that His hand was over and hid a mistake in some of the figures, and that it would not be seen until His hand was removed. Then I was shown that the 1850 chart was directed by His hand, and that the figures were correct."</p>
      <cite>— Ellen G. White, <em>Early Writings</em>, p. 74 (1851)</cite>
    </div>
  </div>
</section>

<!-- CHART IMAGE FULL WIDTH -->
<section class="section section-dark">
  <div class="section-inner">
    <div class="sh">
      <div class="sh-deco"><div class="sh-line"></div><svg class="sh-star" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z"/></svg><div class="sh-line"></div></div>
      <h2 class="serif">The Chart — Full View</h2>
      <p>Click to open in the full-size lightbox. Download the PDF for print quality.</p>
    </div>

    <div style="border:2px solid rgba(214,167,69,0.4);border-radius:20px;overflow:hidden;box-shadow:0 30px 80px rgba(0,0,0,0.5);cursor:zoom-in;position:relative;" onclick="openLightbox()">
      <img src="/images/pioneers/1850-prophecy-chart.jpg" alt="1850 Adventist Prophecy Chart — full view" loading="lazy" style="width:100%;height:auto;display:block;transition:transform .4s;" onmouseover="this.style.transform='scale(1.01)'" onmouseout="this.style.transform='scale(1)'" />
      <div style="position:absolute;bottom:0;left:0;right:0;padding:14px 20px;background:linear-gradient(0deg,rgba(4,8,20,0.85),transparent);display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:8px;">
