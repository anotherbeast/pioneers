---
import { getCollection } from 'astro:content';
import Analytics from '../../components/Analytics.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import ShareBar from '../../components/ShareBar.astro';
import SiteSearch from '../../components/SiteSearch.astro';

function formatDate(value: string | undefined) {
  if (!value) return '';
  const match = value.match(/^(\d{4})-(\d{2})-(\d{2})$/);
  const date = match
    ? new Date(Date.UTC(Number(match[1]), Number(match[2]) - 1, Number(match[3])))
    : new Date(value);
  if (isNaN(date.valueOf())) return value;
  return new Intl.DateTimeFormat('en-US', {
    timeZone: 'UTC',
    year: 'numeric',
    month: 'long',
    day: 'numeric'
  }).format(date);
}

function normalizeImageSrc(value: string | undefined) {
  if (!value) return '';
  if (/^(https?:)?\/\//.test(value)) return value;
  return value.startsWith('/') ? value : `/${value}`;
}

const pioneers = await getCollection('pioneers');

const topPinnedIds = [
  'william-miller',
  'captain-joseph-bates',
  'charles-fitch',
  'apollos-hale',
  'james-white',
  'ellen-white',
  'otis-nichols',
  'john-nevins-andrews',
  'hiram-edson',
  'john-byington',
  'david-hewitt',
  'joshua-vaughan-himes',
  'josiah-litch',
  'rachel-oakes-preston',
  'stephen-nelson-haskell',
  'alonzo-trevier-jones',
  'ellet-joseph-waggoner',
  'james-nevins-waggoner',
  'frederick-wheeler',
  'mary-bird-nichols',
  'john-harvey-waggoner',
  'william-ward-simpson'
];

const pioneersById = new Map(pioneers.map((p) => [p.id, p]));
const pinnedIdSet = new Set<string>(topPinnedIds);

const pinnedPioneers = topPinnedIds
  .map((id) => pioneersById.get(id))
  .filter((p): p is (typeof pioneers)[number] => Boolean(p));

const remainingPioneers = pioneers
  .filter((p) => !pinnedIdSet.has(p.id))
  .sort((a, b) => a.data.name.localeCompare(b.data.name));

const orderedPioneers = [...pinnedPioneers, ...remainingPioneers];
const featuredCount = Math.min(50, orderedPioneers.length);
const featuredPioneers = orderedPioneers.slice(0, featuredCount);
const allOtherPioneers = orderedPioneers.slice(featuredCount);
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Advent Pioneer Library</title>
    <meta name="description" content="Biographies of the original Seventh-day Adventist pioneers — the men and women who built the Advent movement before the 1904 incorporation.">
    <meta property="og:title" content="Advent Pioneer Library | Pioneer Biographies">
    <meta property="og:description" content="Biographies of the original Seventh-day Adventist pioneers — the men and women who built the Advent movement before the 1904 incorporation.">
    <meta property="og:image" content="https://sundaylaw.com/images/shield_sundaylaw.com_the_final_warning_logo.jpg">
    <meta property="og:type" content="website">
    <meta property="og:url" content="https://sundaylaw.com/pioneers">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&family=Source+Sans+3:wght@400;500;600;700&display=swap" rel="stylesheet">
    <Analytics />
    <style>
      :root {
        --bg: #070a16;
        --bg2: #11162a;
        --ink: #f4f0de;
        --ink-muted: #c6bc97;
        --line: rgba(212, 165, 55, 0.26);
        --gold: #d4a537;
        --gold-soft: #f0cf7b;
      }

      * { box-sizing: border-box; }
      body {
        margin: 0;
        font-family: 'Source Sans 3', sans-serif;
        color: var(--ink);
        min-height: 100vh;
        background:
          radial-gradient(circle at 12% 8%, rgba(212, 165, 55, 0.14), transparent 40%),
          radial-gradient(circle at 86% 78%, rgba(63, 93, 138, 0.2), transparent 48%),
          linear-gradient(160deg, #04060f 0%, #090d1d 55%, #070810 100%);
      }

      .serif { font-family: 'Cormorant Garamond', serif; }

      .nav {
        position: sticky;
        top: 0;
        z-index: 40;
        border-bottom: 1px solid var(--line);
        background: rgba(7, 10, 22, 0.78);
        backdrop-filter: blur(10px);
      }

      .nav-inner {
        max-width: 1320px;
        margin: 0 auto;
        padding: 14px 22px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 16px;
      }

      .menu-btn {
        display: none;
        width: 40px;
        height: 40px;
        border: 1px solid var(--line);
        border-radius: 10px;
        background: rgba(255, 255, 255, 0.03);
        color: var(--ink);
        font-size: 1.2rem;
      }

      .brand {
        color: var(--ink);
        text-decoration: none;
        text-transform: uppercase;
        letter-spacing: 0.09em;
        font-size: 0.86rem;
      }

      .brand strong { color: var(--gold-soft); }
      .nav-link { color: var(--ink-muted); text-decoration: none; font-weight: 600; }
      .nav-link:hover { color: var(--gold-soft); }

      .nav-links {
        display: flex;
        gap: 14px;
        margin-left: auto;
      }

      .nav-tools {
        display: flex;
        align-items: center;
        gap: 10px;
      }

      .nav-links a {
        color: var(--ink-muted);
        text-decoration: none;
        font-weight: 600;
      }

      .nav-links a:hover { color: var(--gold-soft); }

      #google_translate_element {
        min-width: 155px;
      }

      #google_translate_element .goog-te-gadget {
        color: transparent;
        font-size: 0;
      }

      #google_translate_element .goog-te-combo {
        background: rgba(255, 255, 255, 0.04);
        color: var(--ink);
        border: 1px solid var(--line);
        border-radius: 10px;
        padding: 8px 10px;
        font-size: 0.86rem;
      }

      .lang-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 48px;
        height: 36px;
        padding: 0 10px;
        border-radius: 10px;
        border: 1px solid var(--line);
        background: rgba(255, 255, 255, 0.04);
        color: var(--gold-soft);
        font-size: 0.76rem;
        font-weight: 800;
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }

      .lang-badge::before {
        content: '◎';
        font-size: 0.78rem;
        margin-right: 6px;
        opacity: 0.9;
      }

      .mobile-nav {
        display: none;
        border-top: 1px solid var(--line);
        padding: 12px 22px 14px;
        background: rgba(7, 10, 22, 0.92);
      }

      .mobile-nav.open { display: grid; gap: 8px; }

      .mobile-nav a {
        color: var(--ink-muted);
        text-decoration: none;
        font-weight: 600;
        padding: 8px 0;
      }

      .mobile-nav a:hover { color: var(--gold-soft); }

      .hero {
        max-width: 1320px;
        margin: 26px auto 0;
        padding: 0 22px;
      }

      .hero-card {
        border: 1px solid var(--line);
        border-radius: 24px;
        background: linear-gradient(150deg, rgba(15, 20, 36, 0.94), rgba(8, 11, 21, 0.88));
        padding: 44px;
        box-shadow: 0 24px 74px rgba(0, 0, 0, 0.45);
      }

      .eyebrow {
        display: inline-block;
        margin-bottom: 14px;
        border: 1px solid var(--line);
        border-radius: 999px;
        padding: 7px 13px;
        color: var(--gold-soft);
        font-size: 0.74rem;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        font-weight: 700;
      }

      .hero h1 {
        margin: 0;
        font-size: clamp(2.2rem, 5.5vw, 4rem);
        color: var(--ink);
