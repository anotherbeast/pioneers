        overflow: hidden;
      }

      .card-link {
        margin-top: auto;
        padding-top: 16px;
        font-weight: 700;
        color: var(--gold-soft);
        letter-spacing: 0.02em;
      }

      .empty-state {
        border: 1px solid var(--line);
        border-radius: 16px;
        background: rgba(255, 255, 255, 0.03);
        text-align: center;
        padding: 48px 20px;
        color: var(--ink-muted);
      }

      .footer {
        border-top: 1px solid var(--line);
        background: rgba(8, 10, 20, 0.68);
        margin-top: 36px;
      }

      .footer-main {
        max-width: 1320px;
        margin: 0 auto;
        padding: 28px 22px;
        display: grid;
        grid-template-columns: 1.3fr 1fr 1fr;
        gap: 18px;
      }

      .footer h4 {
        margin: 0 0 8px;
        color: var(--gold-soft);
        font-size: 1.05rem;
      }

      .footer p {
        margin: 0;
        color: #a6acc3;
        line-height: 1.7;
      }

      .footer-links {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        gap: 6px;
      }

      .footer-links a {
        color: #c5bb95;
        text-decoration: none;
      }

      .footer-links a:hover { color: var(--gold-soft); }

      .footer-bottom {
        border-top: 1px solid var(--line);
        padding: 16px 22px;
        text-align: center;
        color: #8c8f9f;
        font-size: 0.88rem;
      }

      .goog-te-banner-frame.skiptranslate { display: none !important; }
      body { top: 0 !important; }
      .goog-logo-link, .goog-te-gadget span { display: none !important; }

      @media (max-width: 860px) {
        .hero-card { padding: 30px 22px; }
        .footer-main { grid-template-columns: 1fr; }
      }

      @media (max-width: 700px) {
        .grid-container { grid-template-columns: 1fr; }
        .nav-inner { flex-wrap: nowrap; }
        .nav-links { display: none; }
        .nav-link { display: none; }
        .menu-btn { display: inline-flex; align-items: center; justify-content: center; }
        .nav-tools { margin-left: auto; }
      }
    </style>
  </head>

  <body>
    <header class="nav">
      <div class="nav-inner">
        <a class="brand" href="/">Advent <strong>Pioneer Library</strong></a>
        <nav class="nav-links" aria-label="Primary">
          <a href="/">Home</a>
          <a href="/pioneers">Pioneers</a>
          <a href="/books">Books</a>
          <a href="/prophecy-charts">Prophecy Charts</a>
          <a href="/midnight-cry">Midnight Cry Movie</a>
          <a href="/books/captain-joseph-bates-autobiography-1868">Bates Autobiography</a>
        </nav>
        <div class="nav-tools">
          <span class="lang-badge" id="lang-badge">EN</span>
          <div id="google_translate_element"></div>
          <a class="nav-link" href="/">Home</a>
          <button class="menu-btn" id="menu-btn" aria-label="Open menu" aria-expanded="false">☰</button>
        </div>
      </div>
      <nav class="mobile-nav" id="mobile-nav" aria-label="Mobile">
        <a href="/">Home</a>
        <a href="/pioneers">Pioneers</a>
        <a href="/books">Books</a>
        <a href="/prophecy-charts">Prophecy Charts</a>
        <a href="/midnight-cry">1844 Midnight Cry Movie</a>
      </nav>
    </header>

    <section class="hero">
      <div class="hero-card">
        <span class="eyebrow">Biographical Archive</span>
        <h1 class="serif">The Pioneer <span>Library</span></h1>
        <p>
          Explore detailed life sketches of Advent pioneers, arranged for immersive reading with historically grounded context and key publication links.
        </p>
        <div class="stats">
          <div class="stat"><strong>{orderedPioneers.length}</strong> Profiles</div>
          <div class="stat"><strong>19th Century</strong> Primary Era</div>
          <div class="stat"><strong>Global</strong> Mission Footprint</div>
        </div>
        <div class="search-wrap">
          <div class="search-inner">
            <svg class="search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
            <input
              id="pioneer-search"
              type="search"
              placeholder="Search pioneers by name or role…"
              autocomplete="off"
              aria-label="Search pioneers"
            >
            <span id="search-count" class="search-count" aria-live="polite"></span>
          </div>
        </div>
      </div>
    </section>

    <div class="container">
      {orderedPioneers.length === 0 ? (
        <div class="empty-state">
          <p>No pioneers found yet. Check back soon.</p>
        </div>
      ) : (
        <>
          <div id="no-results-msg" style="display:none;text-align:center;padding:60px 20px;color:var(--ink-muted);font-size:1.1rem;">No pioneers match your search. Try a different name or role.</div>
          <section class="section-block" aria-label="Featured Pioneers">
            <div class="section-header">
              <h2 class="section-title serif">Featured 20</h2>
              <p class="section-subtitle">Pinned Leaders First</p>
            </div>
            <div class="grid-container">
              {featuredPioneers.map((p) => (
                <a href={`/pioneers/${p.id}`} class="pioneer-card" data-name={p.data.name.toLowerCase()} data-title={p.data.title.toLowerCase()} data-excerpt={(p.data.excerpt || '').toLowerCase()} data-categories={(p.data.categories || []).join(' ').toLowerCase()}>
                  <div class="card-background">
                    <img
                      src={normalizeImageSrc(p.data.image)}
                      alt={p.data.name}
                      loading="lazy"
                      class="card-image"
                    />

                    <div class="card-content">
                      <h2 class="card-name serif">
                        {p.data.name}
                      </h2>

                      <p class="card-dates">
                        {formatDate(p.data.birthDate) || p.data.birth} - {formatDate(p.data.deathDate) || p.data.death}
                      </p>

                      {p.data.birthPlace ? (
                        <p class="card-birthplace">
                          {p.data.birthPlace}
                        </p>
                      ) : null}

                      <p class="card-title serif">
                        {p.data.title}
                      </p>

                      {p.data.excerpt ? (
                        <p class="card-excerpt">
                          {p.data.excerpt}
                        </p>
                      ) : null}

                      <div class="card-link">Read Biography →</div>
                    </div>
                  </div>
                </a>
              ))}
            </div>
          </section>

          {allOtherPioneers.length > 0 ? (
            <section class="section-block" aria-label="All Remaining Pioneers">
              <div class="section-header">
                <h2 class="section-title serif">All Pioneers</h2>
                <p class="section-subtitle">Alphabetical After Featured</p>
              </div>
              <div class="grid-container">
                {allOtherPioneers.map((p) => (
                  <a href={`/pioneers/${p.id}`} class="pioneer-card" data-name={p.data.name.toLowerCase()} data-title={p.data.title.toLowerCase()} data-excerpt={(p.data.excerpt || '').toLowerCase()} data-categories={(p.data.categories || []).join(' ').toLowerCase()}>
                    <div class="card-background">
                      <img
                        src={normalizeImageSrc(p.data.image)}
                        alt={p.data.name}
                        loading="lazy"
                        class="card-image"
                      />

                      <div class="card-content">
                        <h2 class="card-name serif">
                          {p.data.name}
                        </h2>

                        <p class="card-dates">
                          {formatDate(p.data.birthDate) || p.data.birth} - {formatDate(p.data.deathDate) || p.data.death}
                        </p>

                        {p.data.birthPlace ? (
                          <p class="card-birthplace">
                            {p.data.birthPlace}
                          </p>
                        ) : null}

                        <p class="card-title serif">
                          {p.data.title}
                        </p>

                        {p.data.excerpt ? (
                          <p class="card-excerpt">
                            {p.data.excerpt}
                          </p>
                        ) : null}

                        <div class="card-link">Read Biography →</div>
                      </div>
                    </div>
                  </a>
                ))}
              </div>
            </section>
          ) : null}
        </>
      )}
    </div>

    <footer class="footer">
      <div class="footer-main">
        <div>
          <h4 class="serif">Advent Pioneer Library</h4>
          <p>Study the pioneers through visual context, historical metadata, and narrative biography.</p>
        </div>
        <div>
          <h4 class="serif">Navigate</h4>
          <ul class="footer-links">
            <li><a href="/">Home</a></li>
            <li><a href="/pioneers">Pioneer Library</a></li>
            <li><a href="/books">Books</a></li>
            <li><a href="/prophecy-charts">Prophecy Charts</a></li>
            <li><a href="/midnight-cry">1844 Midnight Cry Movie</a></li>
            <li><a href="/pioneers/1843-prophecy-chart">1843 Prophetic Chart</a></li>
            <li><a href="/pioneers/1850-prophecy-chart">1850 Prophetic Chart</a></li>
          </ul>
        </div>
        <div>
          <h4 class="serif">Continue Reading</h4>
          <ul class="footer-links">
            <li><a href="/pioneers">Browse More Biographies</a></li>
            <li><a href="/books">Read Key Works</a></li>
          </ul>
        </div>
      </div>
      <div class="footer-bottom">&copy; 2026 Advent Pioneer Library</div>
    </footer>

    <script is:inline>
      // ===== PIONEER SEARCH =====
      (function() {
        const input = document.getElementById('pioneer-search');
        const countEl = document.getElementById('search-count');
        if (!input) return;

        const allCards = Array.from(document.querySelectorAll('.pioneer-card'));
        const sections = Array.from(document.querySelectorAll('.section-block'));
        const noResults = document.getElementById('no-results-msg');

        function runSearch() {
          const q = input.value.trim().toLowerCase();
          let visible = 0;

          allCards.forEach(card => {
            const name = card.dataset.name || '';
            const title = card.dataset.title || '';
            const excerpt = card.dataset.excerpt || '';
            const categories = card.dataset.categories || '';
            const match = !q || name.includes(q) || title.includes(q) || excerpt.includes(q) || categories.includes(q);
            card.style.display = match ? '' : 'none';
            if (match) visible++;
          });

          // Hide section headers when all cards in that section are hidden
          sections.forEach(section => {
            const cards = section.querySelectorAll('.pioneer-card');
            const anyVisible = Array.from(cards).some(c => c.style.display !== 'none');
            section.style.display = anyVisible ? '' : 'none';
          });

          if (noResults) noResults.style.display = (q && visible === 0) ? '' : 'none';
          if (countEl) countEl.textContent = q ? `${visible} result${visible !== 1 ? 's' : ''}` : '';
        }

        input.addEventListener('input', runSearch);
      })();

      const menuBtn = document.getElementById('menu-btn');
      const mobileNav = document.getElementById('mobile-nav');
      const langBadge = document.getElementById('lang-badge');

      if (menuBtn && mobileNav) {
        menuBtn.addEventListener('click', () => {
          const open = mobileNav.classList.toggle('open');
          menuBtn.setAttribute('aria-expanded', open ? 'true' : 'false');
        });
      }

      function updateLanguageBadge(lang) {
        if (!langBadge) return;
        const normalized = (lang || 'en').replace('/en/', '').replace('/', '');
        langBadge.textContent = normalized || 'en';
      }

      function getCurrentGoogTrans() {
        const match = document.cookie.match(/(?:^|; )googtrans=([^;]+)/);
        return match ? decodeURIComponent(match[1]) : '/en/en';
      }

      function applyAutoTranslation() {
        const rawLang = (navigator.language || 'en').toLowerCase();
        let browserLang = rawLang.split('-')[0];

        if (rawLang.startsWith('zh-tw') || rawLang.startsWith('zh-hk')) {
          browserLang = 'zh-TW';
        } else if (rawLang.startsWith('zh')) {
          browserLang = 'zh-CN';
        }

        if (!browserLang || browserLang === 'en') return;

        const target = '/en/' + browserLang;
        updateLanguageBadge(browserLang);
        if (document.cookie.includes('googtrans=' + target)) return;

        document.cookie = 'googtrans=' + target + ';path=/';
        document.cookie = 'googtrans=' + target + ';domain=' + location.hostname + ';path=/';

        if (!sessionStorage.getItem('gt_auto_applied')) {
          sessionStorage.setItem('gt_auto_applied', '1');
          location.reload();
        }
      }

      function initGoogleTranslate() {
        if (!window.google || !window.google.translate) return;
        new window.google.translate.TranslateElement(
          {
            pageLanguage: 'en',
            autoDisplay: false,
            layout: window.google.translate.TranslateElement.InlineLayout.SIMPLE
          },
          'google_translate_element'
        );
        updateLanguageBadge(getCurrentGoogTrans());
        applyAutoTranslation();

        setTimeout(() => {
          const select = document.querySelector('#google_translate_element select');
          if (!select) return;
          select.addEventListener('change', (event) => {
            updateLanguageBadge(event.target.value);
          });
        }, 800);
      }

      window.initGoogleTranslate = initGoogleTranslate;
    </script>
    <script is:inline src="//translate.google.com/translate_a/element.js?cb=initGoogleTranslate"></script>
    <SiteFooter
      scripture="Here are they that keep the commandments of God, and the faith of Jesus."
      scriptureRef="Revelation 14:12 (KJV)"
      pageLinks={[
        { label: 'All Pioneer Biographies', href: '/pioneers' },
        { label: 'All Pioneer Books', href: '/library' },
        { label: '1843 Prophecy Chart', href: '/pioneers/1843-prophecy-chart' },
        { label: '1850 Prophecy Chart', href: '/pioneers/1850-prophecy-chart' }
      ]}
    />
    <ShareBar />
    <SiteSearch />
</body>
