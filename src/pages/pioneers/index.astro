        display: flex;
        flex-wrap: wrap;
        gap: 10px;
      }

      .stat {
        border: 1px solid var(--line);
        border-radius: 12px;
        background: rgba(255, 255, 255, 0.03);
        padding: 10px 14px;
      }

      .stat strong { color: var(--gold-soft); margin-right: 6px; }

      /* ===== SEARCH ===== */
      .search-wrap {
        margin-top: 28px;
        display: flex;
        justify-content: center;
      }

      .search-inner {
        position: relative;
        width: 100%;
        max-width: 520px;
        display: flex;
        align-items: center;
      }

      .search-icon {
        position: absolute;
        left: 14px;
        color: var(--gold-soft);
        pointer-events: none;
        flex-shrink: 0;
      }

      #pioneer-search {
        width: 100%;
        padding: 13px 90px 13px 44px;
        border-radius: 12px;
        border: 1px solid rgba(212,165,55,0.4);
        background: rgba(255,255,255,0.05);
        color: var(--ink);
        font-family: 'Source Sans 3', sans-serif;
        font-size: 1rem;
        outline: none;
        transition: border-color 0.2s, background 0.2s;
      }

      #pioneer-search::placeholder { color: var(--ink-muted); }

      #pioneer-search:focus {
        border-color: var(--gold);
        background: rgba(255,255,255,0.08);
      }

      .search-count {
        position: absolute;
        right: 14px;
        font-size: 0.8rem;
        font-weight: 700;
        color: var(--gold-soft);
        white-space: nowrap;
        pointer-events: none;
      }

      .container {
        max-width: 1320px;
        margin: 20px auto 0;
        padding: 0 22px 72px;
      }

      .grid-container {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
        gap: 18px;
      }

      .section-header {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 12px;
        margin: 0 0 14px;
      }

      .section-title {
        margin: 0;
        color: var(--gold-soft);
        font-size: clamp(1.5rem, 3.6vw, 2rem);
      }

      .section-subtitle {
        margin: 0;
        color: var(--ink-muted);
        font-size: 0.9rem;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        font-weight: 700;
      }

      .section-block + .section-block {
        margin-top: 34px;
      }

      .pioneer-card {
        color: inherit;
        text-decoration: none;
        display: block;
      }

      .card-background {
        height: 100%;
        border-radius: 18px;
        border: 1px solid var(--line);
        overflow: hidden;
        background: linear-gradient(155deg, rgba(18, 22, 38, 0.95), rgba(10, 12, 24, 0.9));
        transition: transform 0.24s ease, border-color 0.24s ease, box-shadow 0.24s ease;
      }

      .pioneer-card:hover .card-background {
        transform: translateY(-5px);
        border-color: rgba(212, 165, 55, 0.52);
        box-shadow: 0 16px 36px rgba(0, 0, 0, 0.42);
      }

      .card-image {
        width: 100%;
        height: 280px;
        object-fit: contain;
        object-position: center top;
        background: #141a30;
        display: block;
        border-bottom: 1px solid var(--line);
      }

      .card-content {
        padding: 22px;
        display: flex;
        flex-direction: column;
        min-height: 260px;
      }

      .card-name {
        margin: 0;
        color: var(--gold-soft);
        font-size: 1.7rem;
        line-height: 1.04;
      }

      .card-dates {
        margin: 10px 0 0;
        color: #9aa1b9;
        font-size: 0.9rem;
        font-weight: 600;
      }

      .card-birthplace {
        margin: 8px 0 0;
        color: var(--ink-muted);
        font-size: 0.9rem;
      }

      .card-title {
        margin: 12px 0 0;
        color: var(--ink);
        font-size: 1.14rem;
      }

      .card-excerpt {
        margin: 12px 0 0;
        color: #d2d6e6;
