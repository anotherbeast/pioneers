---
import Analytics from '../../components/Analytics.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import ShareBar from '../../components/ShareBar.astro';
import SiteSearch from '../../components/SiteSearch.astro';
const pageUrl = "https://sundaylaw.com/pioneers/1850-law-of-god";
const pageTitle = "The 1850 Law of God Chart — God's Ten Commandments Written in Stone";
const pageDesc = "The 1850 Law of God prophetic chart presenting God's unalterable Ten Commandments — the standard of the final judgment. The fourth commandment, the seventh-day Sabbath, is the Seal of the Living God. Presented by James White and the early Adventist pioneers.";
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <Analytics />
  <title>{pageTitle}</title>
  <meta name="description" content={pageDesc} />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={pageDesc} />
  <meta property="og:image" content="/images/pioneers/james-white.jpg" />
  <meta property="og:url" content={pageUrl} />
  <meta property="og:type" content="article" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={pageTitle} />
  <meta name="twitter:description" content={pageDesc} />
  <meta name="twitter:image" content="/images/pioneers/james-white.jpg" />
  <link rel="canonical" href={pageUrl} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,500;1,600&family=Source+Sans+3:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <script type="text/javascript">
    function googleTranslateElementInit() {
      new google.translate.TranslateElement({ pageLanguage: 'en', layout: google.translate.TranslateElement.InlineLayout.SIMPLE }, 'google_translate_element');
    }
  </script>
  <script type="text/javascript" src="//translate.google.com/translate_a/element.js?cb=googleTranslateElementInit"></script>
  <style>
    :root {
      --bg: #060b17;
      --ink: #f8f1dd;
      --muted: #d3c39d;
      --line: rgba(214,167,69,0.28);
      --gold: #d6a745;
      --amber: #f0be5c;
      --gold-soft: #f5d98a;
    }
    *, *::before, *::after { box-sizing: border-box; }
    body {
      margin: 0; padding: 0;
      font-family: 'Source Sans 3', sans-serif;
      color: var(--ink);
      background:
        radial-gradient(circle at 70% 10%, rgba(214,167,69,0.12), transparent 36%),
        radial-gradient(circle at 20% 82%, rgba(92,111,160,0.14), transparent 40%),
        linear-gradient(160deg, #050914 0%, #091125 52%, #060b16 100%);
      min-height: 100vh;
    }
    .serif { font-family: 'Cormorant Garamond', serif; }
    img { max-width: 100%; height: auto; display: block; }
    a { color: var(--amber); text-decoration: none; }
    a:hover { text-decoration: underline; }

    /* TRANSLATE BAR */
    .translate-bar {
      background: rgba(4,8,20,0.98); border-bottom: 1px solid rgba(214,167,69,0.12);
      padding: 5px 18px; display: flex; align-items: center; gap: 8px;
      font-size: 0.77rem; color: var(--muted);
    }

    /* TOPBAR */
    .topbar {
      position: sticky; top: 0; z-index: 40;
      backdrop-filter: blur(10px);
      background: rgba(6,11,23,0.86);
      border-bottom: 1px solid var(--line);
    }
    .topbar-inner {
      max-width: 1200px; margin: 0 auto; padding: 12px 24px;
      display: flex; align-items: center; gap: 14px; flex-wrap: wrap;
    }
    .brand { display: flex; align-items: center; gap: 8px; color: var(--ink); font-weight: 700; font-size: 1rem; font-family: 'Cormorant Garamond', serif; font-size: 1.15rem; text-decoration: none; }
    .brand strong { color: var(--gold); font-style: normal; }
    .nav-links { display: flex; gap: 4px; flex-wrap: wrap; margin-left: auto; }
    .nav-link {
      padding: 5px 12px; border-radius: 7px; font-size: 0.82rem; font-weight: 600;
      color: var(--muted); border: 1px solid transparent; transition: all .2s;
    }
    .nav-link:hover, .nav-link.active { color: var(--amber); border-color: var(--line); text-decoration: none; }

    /* HERO */
    .hero {
      padding: 60px 24px 50px;
      background: linear-gradient(160deg, #07101f 0%, #0b1830 55%, #071020 100%);
      border-bottom: 1px solid var(--line); position: relative; overflow: hidden;
    }
    .hero::before {
      content: ''; position: absolute; inset: 0;
      background: radial-gradient(ellipse at 50% 0%, rgba(214,167,69,0.14), transparent 65%);
      pointer-events: none;
    }
    .hero-inner { position: relative; max-width: 1100px; margin: 0 auto; display: grid; grid-template-columns: 1fr 1fr; gap: 52px; align-items: center; }
    @media (max-width: 860px) { .hero-inner { grid-template-columns: 1fr; } }
    .eyebrow {
      display: inline-block; margin-bottom: 14px;
      padding: 5px 14px; border-radius: 999px;
      background: rgba(214,167,69,0.12); border: 1px solid rgba(214,167,69,0.35);
      color: var(--amber); font-size: 0.78rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em;
    }
    .hero h1 { font-size: clamp(2rem, 5vw, 3.6rem); margin: 0 0 16px; line-height: 1.1; }
    .hero h1 span { color: var(--gold); }
    .hero-sub { color: var(--muted); line-height: 1.85; font-size: 1.05rem; margin-bottom: 24px; }
    .hero-meta { display: flex; gap: 20px; flex-wrap: wrap; margin-bottom: 28px; }
    .hero-meta-item { color: var(--muted); font-size: 0.88rem; }
    .hero-meta-item strong { color: var(--amber); }
    .btn-gold {
      display: inline-block; padding: 12px 24px; border-radius: 10px;
      background: var(--gold); color: #111; font-weight: 700; font-size: 0.95rem; transition: all .2s;
    }
    .btn-gold:hover { background: var(--amber); transform: translateY(-2px); text-decoration: none; color: #111; }
    .btn-outline {
      display: inline-block; padding: 11px 22px; border-radius: 10px;
      border: 1px solid rgba(214,167,69,0.45); color: var(--amber); font-weight: 700; font-size: 0.95rem; transition: all .2s;
    }
    .btn-outline:hover { background: rgba(214,167,69,0.1); transform: translateY(-2px); text-decoration: none; }
    .hero-btns { display: flex; gap: 12px; flex-wrap: wrap; }
    .hero-img-wrap {
      border-radius: 20px; overflow: hidden;
      border: 2px solid rgba(214,167,69,0.35);
      box-shadow: 0 30px 80px rgba(0,0,0,0.55);
      cursor: zoom-in; position: relative;
    }
    .hero-img-wrap img { width: 100%; height: auto; display: block; transition: transform .4s ease; }
    .hero-img-wrap:hover img { transform: scale(1.03); }
    .hero-img-caption { padding: 11px 18px; background: rgba(4,8,20,0.75); border-top: 1px solid var(--line); color: var(--muted); font-size: 0.82rem; text-align: center; }

    /* SECTIONS */
    .section { padding: 64px 24px; }
    .section-dark { background: rgba(4,8,20,0.6); }
    .section-warm { background: linear-gradient(160deg, rgba(25,18,4,0.7), rgba(8,12,28,0.85)); }
    .section-inner { max-width: 1100px; margin: 0 auto; }
    .section-narrow { max-width: 820px; margin: 0 auto; }

    /* SH heading */
    .sh { text-align: center; margin-bottom: 44px; }
    .sh-deco { display: flex; align-items: center; justify-content: center; gap: 12px; margin-bottom: 12px; }
    .sh-line { width: 48px; height: 2px; background: linear-gradient(to right, transparent, var(--gold)); }
    .sh-line:last-child { background: linear-gradient(to left, transparent, var(--gold)); }
    .sh-star { width: 18px; height: 18px; color: var(--gold); }
    .sh h2 { font-size: clamp(1.7rem, 3.5vw, 2.5rem); font-weight: 700; color: var(--gold-soft); margin: 0 0 12px; }
    .sh p { color: var(--muted); line-height: 1.85; max-width: 740px; margin: 0 auto; }

    /* GRID */
    .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }
    @media (max-width: 760px) { .grid-2 { grid-template-columns: 1fr; } }
    .grid-3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
    @media (max-width: 760px) { .grid-3 { grid-template-columns: 1fr; } }

    /* CARDS */
    .sq { border-radius: 16px; padding: 22px 24px; margin-bottom: 18px; border: 1px solid var(--line); }
    .sq-gold { background: linear-gradient(135deg, rgba(20,14,2,0.8), rgba(8,12,28,0.9)); border-color: rgba(214,167,69,0.4); }
    .sq-dark { background: rgba(4,8,20,0.6); border-color: rgba(214,167,69,0.2); }
    .sq p { color: var(--ink); line-height: 1.85; margin: 0 0 10px; }
    .sq cite { color: var(--muted); font-size: 0.85rem; font-style: italic; }
    .sq h3 { color: var(--gold-soft); font-size: 1.25rem; margin: 0 0 10px; }
    .card { background: linear-gradient(180deg,rgba(14,18,44,0.92),rgba(7,12,30,0.95)); border:1px solid rgba(214,167,69,0.2); border-radius:16px; padding:22px; }
    .card h3 { color: var(--gold-soft); margin: 0 0 10px; font-size: 1.2rem; }
    .card p { color: var(--muted); line-height: 1.8; margin: 0; }

    /* EGW */
    .egw { position: relative; border-radius: 14px; padding: 20px 22px 20px 26px; background: linear-gradient(135deg,rgba(10,18,5,0.8),rgba(4,10,22,0.9)); border: 1px solid rgba(100,160,80,0.28); margin-bottom: 18px; }
    .egw::before { content: '\201C'; position: absolute; top: -8px; left: 14px; font-size: 3.8rem; color: rgba(100,180,80,0.2); font-family: serif; line-height: 1; }
    .egw p { color: var(--ink); font-style: italic; line-height: 1.85; margin: 0 0 8px; }
    .egw cite { color: var(--muted); font-size: 0.84rem; }

    /* PDF EMBED */
    .pdf-frame { border: 1px solid rgba(214,167,69,0.28); border-radius: 16px; overflow: hidden; box-shadow: 0 16px 40px rgba(0,0,0,0.25); }
    .pdf-label { padding: 12px 18px; color: var(--gold); font-weight: 700; text-transform: uppercase; font-size: 0.8rem; letter-spacing: 0.05em; border-bottom: 1px solid rgba(214,167,69,0.15); background: rgba(4,8,20,0.7); display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 8px; }
    .pdf-label a { font-size: 0.8rem; color: var(--amber); font-weight: 700; }
    .pdf-frame iframe { width: 100%; height: 820px; border: none; background: #fff; display: block; }
    @media (max-width: 640px) { .pdf-frame iframe { height: 500px; } }

    /* TEN COMMANDMENTS — full showcase */
    .cmd-list { display: flex; flex-direction: column; gap: 14px; }
    .cmd { display: flex; gap: 18px; border-radius: 14px; padding: 20px 22px; border: 1px solid rgba(214,167,69,0.18); background: linear-gradient(135deg, rgba(14,10,2,0.88), rgba(6,10,24,0.9)); align-items: flex-start; transition: border-color .2s; }
    .cmd:hover { border-color: rgba(214,167,69,0.38); }
    .cmd.highlighted { border-color: rgba(214,167,69,0.65); background: linear-gradient(135deg, rgba(30,20,3,0.92), rgba(8,14,32,0.92)); box-shadow: 0 0 40px rgba(214,167,69,0.12); }
    .cmd-num { flex-shrink: 0; width: 46px; height: 46px; border-radius: 10px; display: flex; align-items: center; justify-content: center; font-family: 'Cormorant Garamond', serif; font-size: 1.5rem; font-weight: 700; line-height: 1; }
    .cmd-num-dim { background: rgba(214,167,69,0.1); border: 1px solid rgba(214,167,69,0.25); color: var(--muted); }
    .cmd-num-gold { background: linear-gradient(135deg, rgba(214,167,69,0.25), rgba(240,190,92,0.18)); border: 1px solid rgba(214,167,69,0.6); color: var(--amber); box-shadow: 0 0 16px rgba(214,167,69,0.18); }
    .cmd-body { flex: 1; }
    .cmd-body p { color: var(--ink); font-style: italic; line-height: 1.85; margin: 0 0 6px; }
    .cmd-body cite { color: var(--muted); font-size: 0.82rem; display: block; }
    .seal-badge { display: inline-block; margin-top: 10px; padding: 5px 14px; border-radius: 999px; background: linear-gradient(135deg, rgba(214,167,69,0.22), rgba(240,190,92,0.12)); border: 1px solid rgba(214,167,69,0.55); color: var(--amber); font-size: 0.78rem; font-weight: 700; letter-spacing: 0.04em; }
    .cmd-law-img { border-radius: 18px; overflow: hidden; border: 2px solid rgba(214,167,69,0.3); box-shadow: 0 24px 60px rgba(0,0,0,0.45); margin-bottom: 28px; }
    .cmd-law-img img { width: 100%; height: auto; display: block; }

    /* SHARE */
    .share-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 10px; margin-top: 18px; }
    .share-btn { display: flex; align-items: center; justify-content: center; gap: 8px; padding: 13px; border-radius: 10px; font-weight: 700; font-size: 0.88rem; background: linear-gradient(180deg,rgba(22,30,58,0.95),rgba(12,18,40,0.95)); border: 1px solid rgba(255,255,255,0.08); color: var(--ink); cursor: pointer; transition: all .2s; text-decoration: none; }
    .share-btn:hover { border-color: rgba(214,167,69,0.4); transform: translateY(-2px); text-decoration: none; }
    .print-btn { background: linear-gradient(180deg, rgba(214,167,69,0.12), rgba(214,167,69,0.06)); border-color: rgba(214,167,69,0.28); color: var(--gold-soft); }

    /* LIGHTBOX */
    .lightbox { position: fixed; inset: 0; z-index: 3000; background: rgba(2,6,23,0.93); backdrop-filter: blur(8px); display: none; align-items: center; justify-content: center; padding: 20px; }
    .lightbox.open { display: flex; }
    .lightbox-inner { position: relative; max-width: min(1100px, 95vw); max-height: 90vh; }
    .lightbox-inner img { max-width: 100%; max-height: 88vh; border-radius: 12px; object-fit: contain; box-shadow: 0 40px 100px rgba(0,0,0,0.6); }
    .lightbox-close { position: absolute; top: -14px; right: -14px; width: 40px; height: 40px; border-radius: 999px; background: var(--gold); color: #111; font-weight: 900; font-size: 1.1rem; border: none; cursor: pointer; display: flex; align-items: center; justify-content: center; }

    /* FOOTER */
    footer { border-top: 1px solid var(--line); background: rgba(4,8,20,0.88); }
    .footer-banner { text-align: center; padding: 26px 24px; border-bottom: 1px solid var(--line); background: linear-gradient(180deg,rgba(214,167,69,0.05),transparent); }
    .footer-banner p { font-family: 'Cormorant Garamond', serif; font-size: 1.1rem; color: var(--ink); font-style: italic; margin: 0 0 6px; }
    .footer-banner cite { color: var(--muted); font-size: 0.84rem; }
    .footer-main { max-width: 1100px; margin: 0 auto; padding: 40px 24px 20px; display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 28px; }
    .footer-col h4 { color: var(--amber); font-size: 0.88rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; margin: 0 0 12px; }
    .footer-col ul { list-style: none; margin: 0; padding: 0; }
    .footer-col ul li { margin-bottom: 7px; }
    .footer-col ul li a { color: var(--muted); font-size: 0.86rem; }
    .footer-col ul li a:hover { color: var(--amber); text-decoration: none; }
    .footer-bottom { text-align: center; padding: 18px 24px; border-top: 1px solid var(--line); color: var(--muted); font-size: 0.82rem; }

    @media print { .topbar, .translate-bar, .hero-btns, .share-grid, .lightbox { display: none !important; } body { background: white; color: black; } }
  </style>
</head>
<body>

<!-- LIGHTBOX -->
<div class="lightbox" id="lightbox" role="dialog" aria-modal="true" aria-label="Chart full view">
  <div class="lightbox-inner">
    <button class="lightbox-close" onclick="closeLightbox()" aria-label="Close">&#10005;</button>
    <img src="/images/pioneers/james-white.jpg" alt="James White presenting the 1850 Law of God Chart" loading="lazy" />
  </div>
</div>

<!-- TRANSLATE BAR -->
<div class="translate-bar">
  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
  Translate:
  <div id="google_translate_element"></div>
</div>

<!-- TOPBAR -->
<nav class="topbar" aria-label="Site navigation">
  <div class="topbar-inner">
    <a class="brand serif" href="/"><span>Sunday</span><strong>Law</strong>.com</a>
    <div class="nav-links">
      <a href="/" class="nav-link">Home</a>
      <a href="/pioneers" class="nav-link">Pioneers</a>
      <a href="/prophecy-charts" class="nav-link active">Prophecy Charts</a>
      <a href="/pioneers/1843-prophecy-chart" class="nav-link">1843 Chart</a>
      <a href="/pioneers/1850-prophecy-chart" class="nav-link">1850 Chart</a>
      <a href="/religious-liberty" class="nav-link">Religious Liberty</a>
      <a href="/midnight-cry" class="nav-link">Midnight Cry Movie</a>
    </div>
  </div>
</nav>

<!-- HERO -->
<section class="hero">
  <div class="hero-inner">
    <div>
      <span class="eyebrow">1850 &mdash; Law of God &middot; James White</span>
      <h1 class="serif">The 1850 <span>Law of God</span> Chart</h1>
      <p class="hero-sub">God&rsquo;s Ten Commandments displayed in full &mdash; the unalterable standard of the final judgment. The fourth commandment, the seventh-day Sabbath, is the Seal of the Living God, the sign of His creative power and authority over all the earth.</p>
      <div class="hero-meta">
        <div class="hero-meta-item"><strong>Year:</strong> 1850</div>
        <div class="hero-meta-item"><strong>Pioneer:</strong> James White</div>
        <div class="hero-meta-item"><strong>Key text:</strong> Exodus 20:1&ndash;17; Revelation 14:12</div>
      </div>
      <div class="hero-btns">
        <a href="/books/1850-prophecy-chart/1850-Law-of-God-Perfect-11x17.pdf" target="_blank" rel="noopener" class="btn-gold">&#8659; Download Law of God Chart PDF</a>
        <button class="btn-outline" onclick="openLightbox()">View James White Image</button>
        <a href="/prophecy-charts" class="btn-outline">&#8592; All Charts</a>
      </div>
    </div>
    <div>
      <div class="hero-img-wrap" onclick="openLightbox()" title="Click to enlarge">
        <img src="/images/pioneers/james-white.jpg" alt="James White presenting the 1850 Law of God Chart" loading="lazy" />
        <div class="hero-img-caption">
          &#128269; Click to enlarge &middot; James White &mdash; original co-founder of Seventh-day Adventism
        </div>
      </div>
    </div>
  </div>
</section>

<!-- THE LAW OF GOD — OVERVIEW -->
<section class="section section-dark">
  <div class="section-inner">
    <div class="sh">
      <div class="sh-deco"><div class="sh-line"></div><svg class="sh-star" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z"/></svg><div class="sh-line"></div></div>
      <h2 class="serif">What Is the Law of God Chart?</h2>
      <p>After October 22, 1844, when Jesus entered the Most Holy Place in the heavenly sanctuary, the Ark of the Covenant &mdash; containing the Ten Commandments &mdash; became visible to God&rsquo;s people. The 1850 Law of God chart was produced to show all ten commandments clearly, with special emphasis on the fourth commandment as God&rsquo;s Seal.</p>
    </div>

    <div class="grid-2">
      <div>
        <div class="sq sq-gold">
          <p class="serif">&ldquo;Here is the patience of the saints: here are they that keep the commandments of God, and the faith of Jesus.&rdquo;</p>
          <cite>&mdash; Revelation 14:12 (KJV) &mdash; The defining mark of God&rsquo;s remnant in the last days</cite>
        </div>
        <div class="sq sq-gold">
          <p class="serif">&ldquo;And the temple of God was opened in heaven, and there was seen in his temple the ark of his testament.&rdquo;</p>
          <cite>&mdash; Revelation 11:19 (KJV) &mdash; The ark appeared when the Most Holy Place was opened in 1844</cite>
        </div>
        <div class="egw">
          <p class="serif">&ldquo;The ark of the testament is seen in His temple in heaven. The Ten Commandments are there, living and active &mdash; the standard by which all who have ever lived will be judged.&rdquo;</p>
          <cite>&mdash; Ellen G. White, <em>The Great Controversy</em></cite>
        </div>
      </div>
      <div>
        <p style="color:var(--muted);line-height:1.9;margin-bottom:18px;">
          The Law of God chart was a companion to the 1850 Sanctuary chart promoted by Otis Nichols. While the Sanctuary chart showed the two-apartment structure of the heavenly sanctuary and the prophetic timeline, the Law of God chart displayed the actual content of what is in the Most Holy Place &mdash; the Ark of the Covenant, containing the Ten Commandments.
        </p>
        <p style="color:var(--muted);line-height:1.9;margin-bottom:18px;">
          James White led the early Sixth-day-Adventist movement into a full understanding of the Sabbath truth, publishing <em>The Present Truth</em> and <em>The Advent Review</em>. He presented the Law of God chart to show that all ten commandments are still binding, that the fourth commandment has never been changed by God, and that the seventh-day Sabbath is the Seal placed in the very heart of His law.
        </p>
        <div class="card">
          <h3 class="serif">James White (1821&ndash;1881)</h3>
          <p>Co-founder of the Seventh-day Adventist Church. Publisher, preacher, and theologian. He worked alongside Ellen White and Joseph Bates to establish the foundational doctrines of Adventism after the Great Disappointment of 1844.</p>
          <a href="/pioneers/james-springer-white" style="color:var(--amber);font-size:0.88rem;font-weight:700;display:block;margin-top:10px;">Read his full biography &rarr;</a>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- THE TEN COMMANDMENTS -->
<section class="section section-warm">
  <div class="section-inner">
    <div class="sh">
      <div class="sh-deco"><div class="sh-line"></div><svg class="sh-star" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z"/></svg><div class="sh-line"></div></div>
      <h2 class="serif">God&rsquo;s Ten Commandments</h2>
      <p>Written by the finger of God on two tables of stone (Deuteronomy 9:10). Never repealed. Never amended. The eternal standard of His holy character &mdash; and the standard of judgment. The Fourth Commandment &mdash; the Sabbath &mdash; is the Seal of the Living God.</p>
    </div>

    <div class="cmd-law-img">
      <img src="/images/sundaylaw/noah_ark_hiram_edson_most_holy_place_sealing_sabbath_ark_of_safety_sundaylaw.jpg" alt="The Ark of the Covenant in the Most Holy Place — the Ten Commandments, the Seal of God" loading="lazy" />
    </div>

    <div class="cmd-list">
      <div class="cmd">
        <div class="cmd-num cmd-num-dim">I</div>
        <div class="cmd-body">
          <p class="serif">&ldquo;Thou shalt have no other gods before me.&rdquo;</p>
          <cite>Exodus 20:3 (KJV)</cite>
        </div>
      </div>
      <div class="cmd">
        <div class="cmd-num cmd-num-dim">II</div>
        <div class="cmd-body">
          <p class="serif">&ldquo;Thou shalt not make unto thee any graven image, or any likeness of any thing that is in heaven above, or that is in the earth beneath, or that is in the water under the earth: Thou shalt not bow down thyself to them, nor serve them: for I the LORD thy God am a jealous God, visiting the iniquity of the fathers upon the children unto the third and fourth generation of them that hate me; And shewing mercy unto thousands of them that love me, and keep my commandments.&rdquo;</p>
          <cite>Exodus 20:4&ndash;6 (KJV)</cite>
        </div>
      </div>
      <div class="cmd">
        <div class="cmd-num cmd-num-dim">III</div>
        <div class="cmd-body">
          <p class="serif">&ldquo;Thou shalt not take the name of the LORD thy God in vain; for the LORD will not hold him guiltless that taketh his name in vain.&rdquo;</p>
          <cite>Exodus 20:7 (KJV)</cite>
        </div>
      </div>
      <div class="cmd highlighted">
        <div class="cmd-num cmd-num-gold">IV</div>
        <div class="cmd-body">
          <p class="serif">&ldquo;Remember the sabbath day, to keep it holy. Six days shalt thou labour, and do all thy work: But the seventh day is the sabbath of the LORD thy God: in it thou shalt not do any work, thou, nor thy son, nor thy daughter, thy manservant, nor thy maidservant, nor thy cattle, nor thy stranger that is within thy gates: For in six days the LORD made heaven and earth, the sea, and all that in them is, and rested the seventh day: wherefore the LORD blessed the sabbath day, and hallowed it.&rdquo;</p>
          <cite>Exodus 20:8&ndash;11 (KJV)</cite>
          <div class="seal-badge">&#9654; The Seal of God &mdash; The Only Commandment That Begins With &ldquo;Remember&rdquo;</div>
        </div>
      </div>
      <div class="cmd">
        <div class="cmd-num cmd-num-dim">V</div>
        <div class="cmd-body">
          <p class="serif">&ldquo;Honour thy father and thy mother: that thy days may be long upon the land which the LORD thy God giveth thee.&rdquo;</p>
          <cite>Exodus 20:12 (KJV)</cite>
        </div>
      </div>
      <div class="cmd">
        <div class="cmd-num cmd-num-dim">VI</div>
        <div class="cmd-body">
          <p class="serif">&ldquo;Thou shalt not kill.&rdquo;</p>
          <cite>Exodus 20:13 (KJV)</cite>
        </div>
      </div>
      <div class="cmd">
        <div class="cmd-num cmd-num-dim">VII</div>
        <div class="cmd-body">
          <p class="serif">&ldquo;Thou shalt not commit adultery.&rdquo;</p>
          <cite>Exodus 20:14 (KJV)</cite>
        </div>
      </div>
      <div class="cmd">
        <div class="cmd-num cmd-num-dim">VIII</div>
        <div class="cmd-body">
          <p class="serif">&ldquo;Thou shalt not steal.&rdquo;</p>
          <cite>Exodus 20:15 (KJV)</cite>
        </div>
      </div>
      <div class="cmd">
        <div class="cmd-num cmd-num-dim">IX</div>
        <div class="cmd-body">
          <p class="serif">&ldquo;Thou shalt not bear false witness against thy neighbour.&rdquo;</p>
          <cite>Exodus 20:16 (KJV)</cite>
        </div>
      </div>
      <div class="cmd">
        <div class="cmd-num cmd-num-dim">X</div>
        <div class="cmd-body">
          <p class="serif">&ldquo;Thou shalt not covet thy neighbour&rsquo;s house, thou shalt not covet thy neighbour&rsquo;s wife, nor his manservant, nor his maidservant, nor his ox, nor his ass, nor any thing that is thy neighbour&rsquo;s.&rdquo;</p>
          <cite>Exodus 20:17 (KJV)</cite>
        </div>
      </div>
    </div>

    <div class="sq sq-gold" style="max-width:760px;margin:0 auto;">
      <p class="serif">&ldquo;And he gave unto Moses, when he had made an end of communing with him upon mount Sinai, two tables of testimony, tables of stone, written with the finger of God.&rdquo;</p>
