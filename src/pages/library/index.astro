---
import Analytics from '../../components/Analytics.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import ShareBar from '../../components/ShareBar.astro';
import SiteSearch from '../../components/SiteSearch.astro';
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <Analytics />
    <title>Advent Pioneer Library | Pioneer Gateway</title>
    <meta name="description" content="Explore the lives and legacies of the Advent pioneers through rich historical biographies. Two groups: the historic Adventist pioneers and the new organization of April 15, 1904. The contest of contests since October 22, 1844.">
    <meta property="og:title" content="Advent Pioneer Library | Pioneer Gateway">
    <meta property="og:description" content="Explore the lives and legacies of the Advent pioneers. The historic Adventist pioneers vs. the new organization of April 15, 1904.">
    <meta property="og:image" content="https://sundaylaw.com/images/shield_sundaylaw.com_the_final_warning_logo.jpg">
    <meta property="og:type" content="website">
    <meta property="og:url" content="https://sundaylaw.com/library">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&family=Source+Sans+3:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
      :root {
        --bg: #060814;
        --bg-soft: #111425;
        --ink: #f4f0df;
        --ink-muted: #c5bb95;
        --gold: #d4a537;
        --gold-soft: #f0cf7b;
        --line: rgba(212, 165, 55, 0.26);
      }

      /* ============ SundayLaw Premium Style ============ */
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
      html { scroll-behavior: smooth; }

      body {
        margin: 0;
        min-height: 100vh;
        font-family: 'Source Sans 3', sans-serif;
        color: var(--ink);
        background:
          radial-gradient(circle at 78% 18%, rgba(212, 165, 55, 0.18), transparent 38%),
          radial-gradient(circle at 18% 74%, rgba(75, 105, 150, 0.18), transparent 45%),
          linear-gradient(160deg, #05060f 0%, #0a0d1b 50%, #080911 100%);
        overflow-x: hidden;
      }

      .serif { font-family: 'Cormorant Garamond', serif; }

      /* ============ SECTIONS ============ */
      .section { padding: 72px 22px; position: relative; }
      .section-dark { background: linear-gradient(to bottom, rgba(5,7,18,0.0), rgba(10,13,28,0.85), rgba(5,7,18,0.0)); }
      .section-warm { background: linear-gradient(to bottom, rgba(5,7,18,0.0), rgba(26,15,0,0.7), rgba(5,7,18,0.0)); }
      .section-inner { max-width: 1200px; margin: 0 auto; }
      .section-narrow { max-width: 900px; margin: 0 auto; }

      /* ============ SECTION HEADINGS ============ */
      .sh { text-align: center; margin-bottom: 48px; }
      .sh-deco { display: flex; align-items: center; justify-content: center; gap: 16px; margin-bottom: 14px; }
      .sh-line { height: 1px; width: 60px; background: rgba(212, 165, 55, 0.5); }
      .sh h2 { font-size: clamp(1.8rem, 4vw, 3rem); font-weight: 700; letter-spacing: -0.02em; color: var(--ink); }
      .sh p { margin-top: 12px; font-size: 1.1rem; color: var(--ink-muted); max-width: 800px; margin-left: auto; margin-right: auto; line-height: 1.8; }

      /* ============ QUOTE BLOCKS ============ */
      .sq { position: relative; border-left: 4px solid rgba(212,165,55,0.5); padding: 20px 18px 20px 22px; border-radius: 0 8px 8px 0; margin-bottom: 20px; }
      .sq-gold { background: rgba(180,83,9,0.14); border-color: rgba(212,165,55,0.5); color: var(--ink); }
      .sq-dark { background: rgba(0,0,0,0.35); border-color: rgba(100,100,180,0.4); color: var(--ink-muted); }
      .sq p { font-size: 1.05rem; line-height: 1.75; margin: 0; }
      .sq h3, .sq h4 { margin: 0 0 12px; }
      .sq cite { display: block; margin-top: 10px; color: var(--gold-soft); font-size: 0.88rem; font-weight: 700; font-style: normal; }
      .sq .mt-3 { margin-top: 12px; }
      .sq ul { margin: 10px 0 0 18px; list-style: disc; line-height: 1.8; }

      /* ============ EGW QUOTE ============ */
      .egw { position: relative; background: linear-gradient(135deg, #1a0f0a, #0d0a06); border: 1px solid rgba(212,165,55,0.35); border-radius: 12px; padding: 22px 28px 22px 46px; margin-bottom: 20px; box-shadow: 0 10px 30px rgba(0,0,0,0.3); }
      .egw::before { content: ''; position: absolute; left: 22px; top: 20px; bottom: 20px; width: 3px; background: linear-gradient(to bottom, #d97706, #92400e); border-radius: 2px; }
      .egw p { color: rgba(254,243,199,0.9); font-size: 1.05rem; line-height: 1.75; font-style: italic; margin: 0; }
      .egw cite { display: block; margin-top: 12px; color: #d97706; font-size: 0.88rem; font-weight: 700; font-style: normal; }

      /* ============ GRIDS ============ */
      .grid-2 { display: grid; gap: 24px; }
      .grid-3 { display: grid; gap: 20px; }
      @media (min-width: 768px) { .grid-2 { grid-template-columns: 1fr 1fr; } .grid-3 { grid-template-columns: repeat(3, 1fr); } }

      /* ============ BOOK CARDS ============ */
      .book-card { background: linear-gradient(135deg, rgba(26,26,78,0.8), rgba(13,13,53,0.8)); border: 1px solid rgba(212,165,55,0.22); border-radius: 14px; overflow: hidden; transition: all 0.3s; padding: 22px; }
      .book-card:hover { border-color: rgba(212,165,55,0.5); transform: translateY(-3px); }
      .book-card h4 { font-size: 1.15rem; margin: 0 0 6px; color: var(--ink); }
      .book-card .author { color: var(--gold-soft); font-size: 0.88rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; }
      .book-card .year { color: var(--ink-muted); font-size: 0.82rem; margin-bottom: 10px; }
      .book-card p { color: var(--ink-muted); font-size: 0.92rem; line-height: 1.7; margin: 10px 0; }
      .book-link { display: inline-block; margin-top: 10px; padding: 7px 14px; background: rgba(212,165,55,0.12); border: 1px solid rgba(212,165,55,0.35); border-radius: 8px; color: var(--gold-soft); font-size: 0.88rem; font-weight: 700; text-decoration: none; transition: all 0.2s; }
      .book-link:hover { background: rgba(212,165,55,0.22); color: var(--ink); }

      /* ============ TWO GROUPS COMPARE ============ */
      .group-card { border: 2px solid; border-radius: 18px; padding: 30px 26px; }
      .group-historic { border-color: rgba(212,165,55,0.45); background: linear-gradient(135deg, rgba(30,24,5,0.7), rgba(10,13,28,0.85)); }
      .group-new-org { border-color: rgba(220,60,60,0.38); background: linear-gradient(135deg, rgba(40,5,5,0.7), rgba(10,13,28,0.85)); }
      .group-card h3 { margin: 0 0 14px; font-size: 1.5rem; }
      .group-card .group-label { display: inline-block; padding: 5px 12px; border-radius: 999px; font-size: 0.75rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 14px; }
      .label-gold { background: rgba(212,165,55,0.15); border: 1px solid rgba(212,165,55,0.4); color: var(--gold-soft); }
      .label-red { background: rgba(220,60,60,0.14); border: 1px solid rgba(220,60,60,0.38); color: #f87171; }
      .group-card p { color: var(--ink-muted); line-height: 1.8; margin: 0 0 12px; }
      .group-card ul { margin: 0 0 14px 18px; color: var(--ink-muted); line-height: 1.85; list-style: disc; }
      .group-card a.group-btn { display: inline-block; padding: 10px 20px; border-radius: 10px; font-weight: 700; text-decoration: none; font-size: 0.95rem; transition: all 0.2s; }
      .group-btn-gold { background: var(--gold); color: #111; }
      .group-btn-gold:hover { background: var(--gold-soft); }
      .group-btn-outline { border: 1px solid rgba(220,60,60,0.45); color: #f87171; }
      .group-btn-outline:hover { background: rgba(220,60,60,0.1); }

      /* ============ MT HELPERS ============ */
      .mt-4 { margin-top: 16px; }
      .mt-6 { margin-top: 24px; }
      .mt-8 { margin-top: 32px; }

      .topbar {
        position: sticky;
        top: 0;
        z-index: 20;
        backdrop-filter: blur(10px);
        background: rgba(6, 8, 20, 0.72);
        border-bottom: 1px solid var(--line);
      }

      .topbar-inner {
        max-width: 1200px;
        margin: 0 auto;
        padding: 14px 22px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
      }

      .menu-btn {
        display: none;
        width: 40px;
        height: 40px;
        border: 1px solid var(--line);
        border-radius: 10px;
        background: rgba(255, 255, 255, 0.03);
        color: var(--ink);
        font-size: 1.2rem;
      }

      .brand {
        color: var(--ink);
        text-decoration: none;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        font-size: 0.9rem;
      }

      .brand strong {
        color: var(--gold-soft);
        font-weight: 700;
      }

      .toplink {
        color: var(--ink-muted);
        text-decoration: none;
        font-weight: 600;
      }

      .topnav {
        display: flex;
        gap: 14px;
        margin-left: auto;
      }

      .nav-tools {
        display: flex;
        align-items: center;
        gap: 10px;
      }

      .topnav a {
        color: var(--ink-muted);
        text-decoration: none;
        font-weight: 600;
        font-size: 0.95rem;
      }

      .topnav a:hover { color: var(--gold-soft); }

      .toplink:hover { color: var(--gold-soft); }

      #google_translate_element {
        min-width: 155px;
      }

      #google_translate_element .goog-te-gadget {
        color: transparent;
        font-size: 0;
      }

      #google_translate_element .goog-te-combo {
        background: rgba(255, 255, 255, 0.04);
        color: var(--ink);
        border: 1px solid var(--line);
        border-radius: 10px;
        padding: 8px 10px;
        font-size: 0.86rem;
      }

      .lang-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 48px;
        height: 36px;
        padding: 0 10px;
        border-radius: 10px;
        border: 1px solid var(--line);
        background: rgba(255, 255, 255, 0.04);
        color: var(--gold-soft);
        font-size: 0.76rem;
        font-weight: 800;
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }

      .lang-badge::before {
        content: '◎';
        font-size: 0.78rem;
        margin-right: 6px;
        opacity: 0.9;
      }

      .mobile-nav {
        display: none;
        border-top: 1px solid var(--line);
        padding: 12px 22px 14px;
        background: rgba(6, 8, 20, 0.92);
      }

      .mobile-nav.open { display: grid; gap: 8px; }

      .mobile-nav a {
        color: var(--ink-muted);
        text-decoration: none;
        font-weight: 600;
        padding: 8px 0;
      }

      .mobile-nav a:hover { color: var(--gold-soft); }

      .hero {
        padding: 100px 22px 72px;
      }

      .hero-wrap {
        max-width: 1200px;
        margin: 0 auto;
        border: 1px solid var(--line);
        border-radius: 26px;
        background: linear-gradient(140deg, rgba(15, 18, 34, 0.95), rgba(8, 10, 20, 0.86));
        box-shadow: 0 24px 70px rgba(0, 0, 0, 0.5);
        overflow: hidden;
      }

      .hero-grid {
        display: grid;
        grid-template-columns: 1.1fr 0.9fr;
      }

      .hero-copy {
        padding: 56px 52px;
      }

      .eyebrow {
        display: inline-block;
        padding: 7px 14px;
        border-radius: 999px;
        border: 1px solid var(--line);
        color: var(--gold-soft);
        text-transform: uppercase;
        letter-spacing: 0.12em;
        font-size: 0.74rem;
        font-weight: 700;
        margin-bottom: 22px;
      }

      h1 {
        margin: 0;
        font-size: clamp(2.5rem, 7vw, 4.8rem);
        line-height: 0.95;
        letter-spacing: 0.02em;
      }

      h1 span { color: var(--gold-soft); }

      .lead {
        margin: 22px 0 0;
        color: var(--ink-muted);
        font-size: 1.18rem;
        line-height: 1.75;
        max-width: 56ch;
      }

      .hero-actions {
        margin-top: 32px;
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
      }

      .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 50px;
        padding: 0 22px;
        border-radius: 12px;
        text-decoration: none;
        font-weight: 700;
        letter-spacing: 0.02em;
        transition: all 0.25s ease;
      }

      .btn-gold {
        background: var(--gold);
        color: #151515;
      }

      .btn-gold:hover {
        transform: translateY(-2px);
        background: #e2b95b;
      }

      .btn-outline {
        border: 1px solid var(--line);
        color: var(--ink);
        background: rgba(255, 255, 255, 0.03);
      }

      .btn-outline:hover {
        border-color: rgba(212, 165, 55, 0.55);
        color: var(--gold-soft);
      }

      .hero-panel {
        border-left: 1px solid var(--line);
        background:
          linear-gradient(200deg, rgba(212, 165, 55, 0.09), rgba(17, 21, 36, 0.5)),
          repeating-linear-gradient(
            -45deg,
            rgba(255, 255, 255, 0.02) 0,
            rgba(255, 255, 255, 0.02) 8px,
            transparent 8px,
            transparent 16px
          );
        display: grid;
        place-items: center;
        padding: 36px;
      }

      .hero-panel-card {
        width: 100%;
        max-width: 360px;
        border: 1px solid var(--line);
        border-radius: 18px;
        padding: 26px;
        background: rgba(6, 8, 20, 0.64);
      }

      .hero-panel-card h2 {
        margin: 0 0 8px;
        color: var(--gold-soft);
        font-size: 1.8rem;
      }

      .hero-panel-card p {
        margin: 0;
        color: var(--ink-muted);
        line-height: 1.8;
      }

      /* ============ FEATURE QUOTE (top of content) ============ */
      .feature-quote-wrap {
        background: linear-gradient(135deg, #1a0f00 0%, #0d0a06 40%, #0a0d1b 100%);
        border-top: 3px solid rgba(212,165,55,0.6);
        border-bottom: 3px solid rgba(212,165,55,0.6);
        padding: 52px 28px;
        text-align: center;
        position: relative;
        overflow: hidden;
      }

      .feature-quote-wrap::before {
        content: '';
        position: absolute;
        inset: 0;
        background: radial-gradient(ellipse at 50% 50%, rgba(212,165,55,0.08) 0%, transparent 65%);
        pointer-events: none;
      }

      .feature-quote-inner {
        position: relative;
        z-index: 1;
        max-width: 860px;
        margin: 0 auto;
      }

      .feature-quote-star {
        color: var(--gold);
        margin-bottom: 20px;
        display: flex;
        justify-content: center;
      }

      .feature-quote-text {
        font-size: clamp(1.45rem, 3.5vw, 2.15rem);
        font-weight: 600;
        color: #fef3c7;
        line-height: 1.55;
        font-style: italic;
        letter-spacing: -0.01em;
        margin: 0 0 18px;
      }

      .feature-quote-cite {
        display: block;
        color: var(--gold-soft);
        font-size: 1rem;
        font-weight: 700;
        font-style: normal;
        letter-spacing: 0.04em;
        text-transform: uppercase;
      }

      .features {
        max-width: 1200px;
        margin: 26px auto 0;
        padding: 0 22px 78px;
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 16px;
      }

      .card {
        border: 1px solid var(--line);
        border-radius: 18px;
        background: linear-gradient(160deg, rgba(16, 20, 34, 0.9), rgba(10, 12, 24, 0.88));
        padding: 24px;
        transition: transform 0.25s ease, border-color 0.25s ease;
      }

      .card:hover {
        transform: translateY(-4px);
        border-color: rgba(212, 165, 55, 0.52);
      }

      .card h3 {
        margin: 0;
        font-size: 1.5rem;
        color: var(--gold-soft);
      }

      .card p {
        margin: 10px 0 0;
        color: var(--ink-muted);
        line-height: 1.75;
      }

      .footer {
        border-top: 1px solid var(--line);
        background: rgba(8, 10, 20, 0.68);
      }

      .footer-main {
        max-width: 1200px;
        margin: 0 auto;
        padding: 28px 22px;
        display: grid;
        grid-template-columns: 1.3fr 1fr 1fr 1fr;
        gap: 18px;
      }

      .footer h4 {
        margin: 0 0 8px;
        color: var(--gold-soft);
        font-size: 1.05rem;
      }

      .footer p {
        margin: 0;
        color: #a6acc3;
        line-height: 1.7;
      }

      .footer-links {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        gap: 6px;
      }

      .footer-links a {
        color: #c5bb95;
        text-decoration: none;
      }

      .footer-links a:hover { color: var(--gold-soft); }

      .footer-bottom {
        border-top: 1px solid var(--line);
        padding: 16px 22px;
        text-align: center;
        color: #8c8f9f;
        font-size: 0.88rem;
      }

      .goog-te-banner-frame.skiptranslate { display: none !important; }
      body { top: 0 !important; }
      .goog-logo-link, .goog-te-gadget span { display: none !important; }

      @media (max-width: 940px) {
        .hero-grid { grid-template-columns: 1fr; }
        .hero-panel { border-left: 0; border-top: 1px solid var(--line); }
        .features { grid-template-columns: 1fr; }
        .footer-main { grid-template-columns: 1fr 1fr; }
      }
      @media (max-width: 580px) {
        .footer-main { grid-template-columns: 1fr; }
      }

      @media (max-width: 700px) {
        .hero-copy { padding: 38px 24px; }
        .hero-panel { padding: 24px; }
        .topbar-inner { flex-wrap: nowrap; }
        .topnav { display: none; }
        .toplink { display: none; }
        .menu-btn { display: inline-flex; align-items: center; justify-content: center; }
        .nav-tools { margin-left: auto; }
      }
    </style>
  </head>

  <body>
    <header class="topbar">
      <div class="topbar-inner">
        <a class="brand" href="/">Advent <strong>Pioneer Library</strong></a>
        <nav class="topnav" aria-label="Primary">
          <a href="/">Home</a>
          <a href="/pioneers">Pioneers</a>
          <a href="/books">Books</a>
          <a href="/prophecy-charts">Prophecy Charts</a>
          <a href="/prophecy-explained">Prophecy Study</a>
          <a href="/1860-name-selection">1860 Name</a>
          <a href="/april-15-1904-new-organization">1904 Record</a>
          <a href="/midnight-cry">Midnight Cry Movie</a>
          <a href="/books/captain-joseph-bates-autobiography-1868">Bates Autobiography</a>
        </nav>
        <div class="nav-tools">
          <span class="lang-badge" id="lang-badge">EN</span>
          <div id="google_translate_element"></div>
          <a class="toplink" href="/pioneers">Browse Biographies</a>
          <button class="menu-btn" id="menu-btn" aria-label="Open menu" aria-expanded="false">☰</button>
        </div>
      </div>
      <nav class="mobile-nav" id="mobile-nav" aria-label="Mobile">
        <a href="/">Home</a>
        <a href="/pioneers">Pioneers</a>
        <a href="/books">Books</a>
        <a href="/prophecy-charts">Prophecy Charts</a>
        <a href="/prophecy-explained">Prophecy Study</a>
        <a href="/1860-name-selection">1860 Name Selection</a>
        <a href="/april-15-1904-new-organization">1904 Incorporation</a>
        <a href="/midnight-cry">1844 Midnight Cry Movie</a>
      </nav>
    </header>

    <!-- ========== HERO ========== -->
    <section class="hero">
      <div class="hero-wrap">
        <div class="hero-grid">
          <div class="hero-copy">
            <span class="eyebrow">The Contest of Contests — Since October 22, 1844</span>
            <h1 class="serif">Advent <span>Pioneers</span></h1>
            <p class="lead">
              The men and women who kept the commandments of God and the faith of Jesus after the Great Disappointment.
              Two groups. One foundation. One final conflict. The 144,000 sealing is now in progress.
            </p>
            <div class="hero-actions">
              <a href="/pioneers" class="btn btn-gold">Explore Pioneer Library</a>
              <a href="#two-groups" class="btn btn-outline">Historic vs. 1904 New Org</a>
            </div>
          </div>

          <aside class="hero-panel">
            <div class="hero-panel-card">
              <h2 class="serif">October 22, 1844</h2>
              <p>
                The investigative judgment began. Christ entered the Most Holy Place.
                Those who keep the commandments of God and the faith of Jesus go by faith
                into the Heavenly Sanctuary — the bride-selection work of the ages.
              </p>
            </div>
          </aside>
        </div>
      </div>
    </section>

    <!-- ========== FEATURE QUOTE ========== -->
    <div class="feature-quote-wrap">
      <div class="feature-quote-inner">
        <div class="feature-quote-star" aria-hidden="true">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z"/></svg>
        </div>
        <blockquote class="feature-quote-text serif">
          &ldquo;The history of the early experiences in the message will be a power to withstand the masterly ingenuity of Satan&rsquo;s deceptions.&rdquo;
        </blockquote>
        <cite class="feature-quote-cite">&mdash; Ellen G. White, Letter 99, 1905</cite>
      </div>
    </div>

    <!-- ========== THREE ANGELS' MESSAGES ========== -->
    <section id="three-angels" class="section section-warm">
      <div class="section-inner section-narrow">
        <div class="sh">
          <div class="sh-deco"><div class="sh-line"></div><div class="sh-line"></div></div>
          <h2 class="serif">The Three Angels' Messages — Revelation 14:6–12</h2>
          <p>The foundational proclamation of the Advent movement, written on the 1843 and 1850 prophetic charts.</p>
        </div>

        <div class="egw">
          <p>"And I saw another angel fly in the midst of heaven, having the everlasting gospel to preach unto them that dwell on the earth…
