---
import Analytics from '../components/Analytics.astro';
import SiteFooter from '../components/SiteFooter.astro';
import ShareBar from '../components/ShareBar.astro';
import SiteNav from '../components/SiteNav.astro';
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>The Test That Decides Your Eternal Destiny — Image of the Beast, 1904, and the Loud Cry | SundayLaw.com</title>
  <meta name="description" content="Ellen White warned: the image of the beast WILL BE FORMED before probation closes — it IS the great test by which your eternal destiny will be decided. The 1904 new organization, the 501(c)(3) state church, and the Loud Cry of Revelation 18 are all one story. Come out of her, my people — NOW.">
  <link rel="canonical" href="https://sundaylaw.com/prophecy-explained">
  <meta property="og:title" content="The Test That Decides Your Eternal Destiny — Image of the Beast and the Loud Cry">
  <meta property="og:description" content="The image of the beast WILL BE FORMED before probation closes. It IS the great test. Your eternal destiny is decided by how you obey when you learn the truth. Come out of the 501(c)(3) state church — NOW.">
  <meta property="og:image" content="https://sundaylaw.com/images/sundaylaw/mayflower-1620-religious-freedom-james-white-family-escaping-state-church-tyranny-sundaylaw.jpg">
  <meta property="og:type" content="article">
  <meta property="og:url" content="https://sundaylaw.com/prophecy-explained">
  <Analytics />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Crimson+Text:ital,wght@0,400;0,600;1,400&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg: #07000f;
      --bg-soft: #0d0018;
      --bg-card: rgba(20,5,35,0.85);
      --ink: #f8f1dd;
      --muted: #9ca3af;
      --gold: #d4a537;
      --gold-soft: #fcd34d;
      --amber: #f59e0b;
      --red: #ef4444;
      --red-soft: #fca5a5;
      --teal: #14b8a6;
      --teal-soft: #5eead4;
      --blue: #3b82f6;
      --blue-soft: #93c5fd;
      --line: rgba(212,165,55,0.22);
      --line-soft: rgba(212,165,55,0.12);
      --line-red: rgba(239,68,68,0.3);
    }
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }
    body { font-family: 'Inter', sans-serif; color: var(--ink); background: var(--bg); overflow-x: hidden; }
    a { color: var(--gold); text-decoration: none; transition: color 0.2s; }
    a:hover { color: var(--gold-soft); }

    .top-stripe { height: 5px; background: linear-gradient(to right, #7f1d1d, #ef4444, #b45309, #ef4444, #7f1d1d); }

    /* NAV */
    .nav { position: sticky; top: 0; z-index: 100; background: rgba(7,0,15,0.96); backdrop-filter: blur(12px); border-bottom: 1px solid var(--line); }
    .nav-wrap { max-width: 1280px; margin: 0 auto; }
    .nav-row { display: flex; align-items: center; padding: 0 22px; }
    .nav-row-top { gap: 28px; height: 62px; border-bottom: 1px solid rgba(212,165,55,0.08); }
    .nav-row-bottom { gap: 20px; height: 42px; font-size: 0.82rem; overflow-x: auto; scrollbar-width: none; }
    .nav-brand { text-decoration: none; color: var(--ink); font-weight: 700; font-size: 1.05rem; flex-shrink: 0; display: flex; align-items: center; margin-right: auto; }
    .nav-brand img { height: 38px; width: auto; display: block; border-radius: 4px; }
    .nav-link { color: var(--muted); text-decoration: none; font-weight: 600; font-size: 0.9rem; white-space: nowrap; transition: color 0.18s; }
    .nav-link:hover { color: var(--gold-soft); }
    .nav-cta { display: inline-flex; align-items: center; height: 38px; padding: 0 18px; border-radius: 8px; background: #9f1239; color: #fff; font-weight: 700; font-size: 0.88rem; text-decoration: none; flex-shrink: 0; transition: background 0.18s; }
    .nav-cta:hover { background: #be123c; color: #fff; }
    .nav-bottom-link { color: rgba(156,163,175,0.8); text-decoration: none; font-weight: 500; white-space: nowrap; transition: color 0.18s; flex-shrink: 0; }
    .nav-bottom-link:hover { color: var(--gold-soft); }
    .nav-bottom-link.active { color: var(--gold-soft); }
    .menu-btn { display: none; width: 40px; height: 40px; border: 1px solid var(--line); border-radius: 8px; background: rgba(255,255,255,0.03); color: var(--ink); font-size: 1.2rem; cursor: pointer; flex-shrink: 0; align-items: center; justify-content: center; }
    .mobile-nav { display: none; border-top: 1px solid var(--line); padding: 14px 22px 18px; background: rgba(7,0,15,0.97); }
    .mobile-nav.open { display: grid; gap: 6px; }
    .mobile-nav a { color: var(--muted); text-decoration: none; font-weight: 600; padding: 8px 0; border-bottom: 1px solid rgba(255,255,255,0.05); }
    .mobile-nav a:hover { color: var(--gold-soft); }
    @media (max-width: 860px) {
      .nav-row-bottom { display: none; }
      .menu-btn { display: inline-flex; }
      .nav-link { display: none; }
    }

    .page { max-width: 1100px; margin: 0 auto; padding: 0 22px 100px; }

    /* HERO */
    .hero-section { padding: 64px 0 52px; text-align: center; border-bottom: 1px solid rgba(239,68,68,0.18); }
    .indictment-badge { display: inline-flex; align-items: center; gap: 8px; padding: 7px 20px; border-radius: 999px; background: rgba(127,29,29,0.35); border: 1px solid var(--line-red); color: var(--red-soft); font-size: 0.72rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.16em; margin-bottom: 22px; }
    .hero-h1 { font-family: 'Crimson Text', serif; font-size: clamp(2.4rem, 5.5vw, 4.2rem); font-weight: 600; color: var(--ink); line-height: 1.08; margin-bottom: 22px; }
    .hero-h1 em { color: var(--red-soft); font-style: italic; }
    .hero-h1 strong { color: var(--gold-soft); font-style: normal; }
    .hero-sub { font-size: 1.08rem; color: rgba(248,241,221,0.75); line-height: 1.9; max-width: 760px; margin: 0 auto 34px; }
    .hero-sub strong { color: var(--red-soft); }
    .hero-truth-pill { display: inline-flex; align-items: center; gap: 10px; padding: 12px 30px; border-radius: 14px; background: rgba(127,29,29,0.25); border: 1px solid rgba(239,68,68,0.35); font-size: 0.92rem; font-weight: 700; color: var(--red-soft); }

    /* SECTIONS */
    .sect { padding: 60px 0; border-top: 1px solid rgba(212,165,55,0.1); }
    .sect-eyebrow { display: inline-block; padding: 5px 15px; border-radius: 999px; border: 1px solid var(--line); color: var(--gold-soft); text-transform: uppercase; font-size: 0.72rem; font-weight: 700; letter-spacing: 0.1em; margin-bottom: 12px; }
    .sect-eyebrow-red { display: inline-block; padding: 5px 15px; border-radius: 999px; background: rgba(127,29,29,0.25); border: 1px solid var(--line-red); color: var(--red-soft); text-transform: uppercase; font-size: 0.72rem; font-weight: 700; letter-spacing: 0.1em; margin-bottom: 12px; }
    .sect h2 { font-family: 'Crimson Text', serif; font-size: clamp(1.8rem, 3.2vw, 2.7rem); font-weight: 600; color: var(--ink); margin-bottom: 10px; line-height: 1.15; }
    .sect h2 em { color: var(--red-soft); font-style: italic; }
    .sect-center { text-align: center; }
    .sect-sub { font-size: 0.97rem; color: rgba(248,241,221,0.8); line-height: 1.9; margin-bottom: 22px; }
    .sect-sub strong { color: var(--gold-soft); }
    .sect-sub em { color: var(--red-soft); font-style: normal; font-weight: 600; }

    /* EGW MEGA WARNING BLOCK */
    .mega-warn { background: linear-gradient(135deg, rgba(127,29,29,0.3), rgba(7,0,15,0.95)); border: 2px solid rgba(239,68,68,0.45); border-radius: 22px; padding: 48px 44px; margin: 36px 0; text-align: center; position: relative; overflow: hidden; }
    .mega-warn::before { content: ''; position: absolute; inset: 0; background: radial-gradient(ellipse at 50% 30%, rgba(239,68,68,0.08) 0%, transparent 60%); pointer-events: none; }
    .mega-warn-icon { display: flex; justify-content: center; margin-bottom: 20px; color: var(--red-soft); position: relative; z-index: 1; }
    .mega-warn-eyebrow { font-size: 0.7rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.2em; color: var(--red); margin-bottom: 18px; position: relative; z-index: 1; }
    .mega-warn blockquote { font-family: 'Crimson Text', serif; font-size: clamp(1.5rem, 3vw, 2.2rem); font-style: italic; color: #fde8e8; line-height: 1.55; margin-bottom: 20px; position: relative; z-index: 1; }
    .mega-warn blockquote strong { font-style: normal; color: var(--red-soft); text-transform: uppercase; }
    .mega-warn cite { font-size: 0.88rem; color: rgba(252,165,165,0.75); font-style: normal; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; position: relative; z-index: 1; display: block; }
    @media (max-width: 640px) { .mega-warn { padding: 32px 22px; } }

    /* GOLD MEGA QUOTE */
    .mega-quote { background: linear-gradient(135deg, rgba(26,16,0,0.9), rgba(7,0,15,0.95)); border: 2px solid rgba(212,165,55,0.4); border-radius: 22px; padding: 48px 44px; margin: 36px 0; text-align: center; position: relative; overflow: hidden; }
    .mega-quote::before { content: ''; position: absolute; inset: 0; background: radial-gradient(ellipse at 50% 30%, rgba(212,165,55,0.07) 0%, transparent 60%); pointer-events: none; }
    .mega-quote-icon { display: flex; justify-content: center; margin-bottom: 20px; color: var(--gold); position: relative; z-index: 1; }
    .mega-quote blockquote { font-family: 'Crimson Text', serif; font-size: clamp(1.45rem, 2.8vw, 2rem); font-style: italic; color: #fef3c7; line-height: 1.6; margin-bottom: 18px; position: relative; z-index: 1; }
    .mega-quote blockquote strong { color: var(--gold-soft); font-style: normal; }
    .mega-quote cite { font-size: 0.88rem; color: rgba(253,230,138,0.65); font-style: normal; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; position: relative; z-index: 1; display: block; }
    @media (max-width: 640px) { .mega-quote { padding: 32px 20px; } }

    /* CONSTITUTION / LEFT-BORDER BANNER */
    .banner-gold { border-left: 5px solid var(--gold); border-radius: 0 16px 16px 0; background: linear-gradient(135deg, #120d00, #090c1d); padding: 28px 28px 28px 30px; margin: 22px 0; }
    .banner-gold-label { font-size: 0.7rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.15em; color: var(--gold); margin-bottom: 12px; }
    .banner-gold blockquote { font-family: 'Crimson Text', serif; font-size: clamp(1.1rem, 2vw, 1.45rem); font-style: italic; color: rgba(254,243,199,0.92); line-height: 1.75; margin-bottom: 12px; }
    .banner-gold cite { font-size: 0.82rem; color: rgba(253,230,138,0.62); font-style: normal; font-weight: 600; text-transform: uppercase; letter-spacing: 0.07em; }

    .banner-red { border-left: 5px solid var(--red); border-radius: 0 16px 16px 0; background: linear-gradient(135deg, rgba(127,29,29,0.15), #090c1d); padding: 28px 28px 28px 30px; margin: 22px 0; }
    .banner-red-label { font-size: 0.7rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.15em; color: var(--red-soft); margin-bottom: 12px; }
    .banner-red blockquote { font-family: 'Crimson Text', serif; font-size: clamp(1.1rem, 2vw, 1.45rem); font-style: italic; color: #fde8e8; line-height: 1.75; margin-bottom: 12px; }
    .banner-red blockquote strong { font-style: normal; color: var(--red-soft); }
    .banner-red cite { font-size: 0.82rem; color: rgba(252,165,165,0.6); font-style: normal; font-weight: 600; text-transform: uppercase; letter-spacing: 0.07em; }

    .banner-blue { border-left: 5px solid var(--blue); border-radius: 0 16px 16px 0; background: linear-gradient(135deg, rgba(30,58,138,0.15), #090c1d); padding: 28px 28px 28px 30px; margin: 22px 0; }
    .banner-blue-label { font-size: 0.7rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.15em; color: var(--blue-soft); margin-bottom: 12px; }
    .banner-blue blockquote { font-family: 'Crimson Text', serif; font-size: clamp(1.1rem, 2vw, 1.4rem); font-style: italic; color: rgba(147,197,253,0.9); line-height: 1.75; margin-bottom: 12px; }
    .banner-blue cite { font-size: 0.82rem; color: rgba(147,197,253,0.6); font-style: normal; font-weight: 600; text-transform: uppercase; letter-spacing: 0.07em; }

    /* DEFINITION GRID */
    .def-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; margin: 28px 0; }
    .def-card { border-radius: 16px; padding: 24px 22px; }
    .def-card.papal { background: rgba(127,29,29,0.2); border: 1px solid rgba(239,68,68,0.3); }
    .def-card.american { background: rgba(30,58,138,0.18); border: 1px solid rgba(59,130,246,0.28); }
    .def-card h3 { font-family: 'Crimson Text', serif; font-size: 1.3rem; font-weight: 600; margin-bottom: 14px; line-height: 1.2; }
    .def-card.papal h3 { color: var(--red-soft); }
    .def-card.american h3 { color: var(--blue-soft); }
    .def-card ul { list-style: none; display: grid; gap: 8px; }
    .def-card ul li { display: flex; gap: 10px; font-size: 0.9rem; color: rgba(248,241,221,0.82); line-height: 1.65; }
    .def-card ul li::before { content: '›'; font-weight: 700; flex-shrink: 0; }
    .def-card.papal ul li::before { color: var(--red-soft); }
    .def-card.american ul li::before { color: var(--blue-soft); }
    @media (max-width: 640px) { .def-grid { grid-template-columns: 1fr; } }

    /* 501C3 EXPOSE CARD */
    .expose-card { background: linear-gradient(135deg, rgba(127,29,29,0.25), rgba(7,0,15,0.9)); border: 1px solid rgba(239,68,68,0.35); border-radius: 20px; padding: 34px 30px; margin: 28px 0; }
    .expose-card h3 { font-family: 'Crimson Text', serif; font-size: clamp(1.4rem, 2.8vw, 1.9rem); font-weight: 600; color: var(--red-soft); margin-bottom: 16px; line-height: 1.2; }
    .expose-card p { font-size: 0.95rem; color: rgba(248,241,221,0.82); line-height: 1.9; margin-bottom: 14px; }
    .expose-card p strong { color: var(--red-soft); }
    .expose-card p em { color: var(--gold-soft); font-style: normal; font-weight: 600; }
    .expose-list { list-style: none; display: grid; gap: 10px; margin: 18px 0; }
    .expose-list li { display: flex; gap: 12px; align-items: flex-start; padding: 14px 16px; background: rgba(127,29,29,0.15); border: 1px solid rgba(239,68,68,0.2); border-radius: 10px; font-size: 0.92rem; color: rgba(248,241,221,0.82); line-height: 1.7; }
    .expose-list li::before { content: '⚠'; color: var(--red-soft); flex-shrink: 0; font-size: 1rem; padding-top: 1px; }
    .expose-list li strong { color: var(--red-soft); }

    /* MAYFLOWER GRID */
    .mayflower-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 22px; align-items: stretch; margin: 28px 0; }
    .mayflower-img-wrap { border-radius: 18px; overflow: hidden; border: 2px solid rgba(212,165,55,0.25); position: relative; min-height: 320px; }
    .mayflower-img-wrap img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .mayflower-img-label { position: absolute; bottom: 0; left: 0; right: 0; background: linear-gradient(to top, rgba(7,0,15,0.95), transparent); padding: 24px 16px 14px; font-size: 0.8rem; font-weight: 700; color: var(--amber); text-transform: uppercase; letter-spacing: 0.07em; }
    .mayflower-content { background: rgba(13,5,25,0.8); border: 1px solid var(--line); border-radius: 18px; padding: 30px 26px; display: flex; flex-direction: column; gap: 16px; }
    .mayflower-content h3 { font-family: 'Crimson Text', serif; font-size: 1.75rem; color: var(--amber); margin: 0; line-height: 1.2; }
    .mayflower-content p { font-size: 0.95rem; color: rgba(248,241,221,0.82); line-height: 1.88; margin: 0; }
    .mayflower-content p strong { color: var(--gold-soft); }
    .mayflower-content p em { color: var(--red-soft); font-style: normal; font-weight: 600; }
    .mayflower-content .warn-box { background: rgba(127,29,29,0.2); border: 1px solid rgba(239,68,68,0.3); border-radius: 10px; padding: 16px 18px; color: var(--red-soft); font-size: 0.92rem; font-weight: 600; line-height: 1.7; }
    @media (max-width: 720px) { .mayflower-grid { grid-template-columns: 1fr; } }

    /* LOUD CRY SECTION — FULL RED */
    .loud-cry-banner { background: linear-gradient(135deg, rgba(127,29,29,0.4), rgba(30,0,5,0.95)); border: 2px solid rgba(239,68,68,0.45); border-radius: 22px; padding: 48px 40px; margin: 32px 0; }
    .loud-cry-banner h3 { font-family: 'Crimson Text', serif; font-size: clamp(1.7rem, 3.2vw, 2.6rem); font-weight: 600; color: var(--red-soft); margin-bottom: 14px; line-height: 1.15; }
    .loud-cry-verse { background: rgba(239,68,68,0.08); border: 1px solid rgba(239,68,68,0.22); border-radius: 12px; padding: 22px 24px; margin: 18px 0; }
    .loud-cry-ref { font-size: 0.75rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.1em; color: var(--red); margin-bottom: 10px; }
    .loud-cry-verse blockquote { font-family: 'Crimson Text', serif; font-size: 1.25rem; font-style: italic; color: var(--red-soft); line-height: 1.7; }
    .loud-cry-verse cite { display: block; margin-top: 8px; font-size: 0.8rem; color: rgba(252,165,165,0.6); font-style: normal; font-weight: 600; }
    .loud-cry-banner p { font-size: 0.97rem; color: rgba(248,241,221,0.82); line-height: 1.9; margin-bottom: 14px; }
    .loud-cry-banner p strong { color: var(--red-soft); }
    .loud-cry-banner p em { color: var(--gold-soft); font-style: normal; font-weight: 600; }
    @media (max-width: 640px) { .loud-cry-banner { padding: 30px 22px; } }

    /* STEPS LIST */
    .steps-list { list-style: none; margin: 24px 0; display: flex; flex-direction: column; gap: 12px; }
    .steps-list li { display: flex; gap: 16px; align-items: flex-start; padding: 18px 20px; background: rgba(13,5,25,0.7); border: 1px solid var(--line-soft); border-radius: 12px; }
    .step-num { width: 36px; height: 36px; border-radius: 8px; background: rgba(127,29,29,0.45); border: 1px solid rgba(239,68,68,0.3); display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 0.88rem; color: var(--red-soft); flex-shrink: 0; }
    .step-text { font-size: 0.95rem; color: rgba(248,241,221,0.82); line-height: 1.78; padding-top: 4px; }
    .step-text strong { color: var(--red-soft); }
    .step-text em { color: var(--gold-soft); font-style: normal; font-weight: 600; }

    /* THREE ANGELS CARDS */
    .angels-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin: 28px 0; }
    .angel-card { border-radius: 18px; padding: 26px 22px; border: 1px solid; }
    .angel-card.first { background: linear-gradient(135deg, rgba(25,20,5,0.7), rgba(13,5,25,0.9)); border-color: rgba(212,165,55,0.35); }
    .angel-card.second { background: linear-gradient(135deg, rgba(35,5,5,0.7), rgba(13,5,25,0.9)); border-color: rgba(239,68,68,0.3); }
    .angel-card.third { background: linear-gradient(135deg, rgba(5,25,30,0.7), rgba(13,5,25,0.9)); border-color: rgba(20,184,166,0.3); }
    .angel-header { display: flex; align-items: center; gap: 12px; margin-bottom: 14px; }
    .angel-num { width: 42px; height: 42px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 0.95rem; color: #fff; flex-shrink: 0; }
    .num-gold { background: linear-gradient(135deg, #92400e, #d97706); }
    .num-red { background: linear-gradient(135deg, #9f1239, #ef4444); }
    .num-teal { background: linear-gradient(135deg, #0d9488, #14b8a6); }
    .angel-title { font-family: 'Crimson Text', serif; font-size: 1.25rem; font-weight: 600; line-height: 1.2; }
    .first .angel-title { color: var(--gold-soft); }
    .second .angel-title { color: var(--red-soft); }
    .third .angel-title { color: var(--teal-soft); }
    .angel-ref-label { font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.07em; margin-bottom: 8px; }
    .first .angel-ref-label { color: var(--gold); }
    .second .angel-ref-label { color: var(--red); }
    .third .angel-ref-label { color: var(--teal); }
    .angel-verse { font-family: 'Crimson Text', serif; font-style: italic; font-size: 1rem; line-height: 1.65; margin-bottom: 12px; }
    .first .angel-verse { color: #fde68a; }
    .second .angel-verse { color: var(--red-soft); }
    .third .angel-verse { color: var(--teal-soft); }
    .angel-body { font-size: 0.87rem; color: rgba(248,241,221,0.78); line-height: 1.8; }
    @media (max-width: 768px) { .angels-grid { grid-template-columns: 1fr; } }

    /* SIGNERS STRIP */
    .signers-strip { display: grid; grid-template-columns: repeat(5, 1fr); gap: 12px; margin: 28px 0; }
    .signer-mini { background: rgba(13,5,25,0.8); border: 1px solid var(--line-soft); border-radius: 14px; padding: 18px 14px; text-align: center; text-decoration: none; display: block; transition: all 0.22s; }
    .signer-mini:hover { border-color: rgba(239,68,68,0.4); transform: translateY(-3px); box-shadow: 0 8px 30px rgba(127,29,29,0.2); }
    .signer-mini-num { font-size: 0.65rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.12em; color: var(--red); margin-bottom: 6px; }
    .signer-mini-name { font-family: 'Crimson Text', serif; font-size: 1rem; font-weight: 600; color: var(--ink); margin-bottom: 4px; line-height: 1.2; }
    .signer-mini-role { font-size: 0.72rem; color: var(--muted); }
    @media (max-width: 700px) {
      .signers-strip { grid-template-columns: repeat(2, 1fr); }
    }
