    /* PIONEER LINKS GRID */
    .plinks-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; margin: 28px 0; }
    .plink-card { border: 1px solid rgba(212,165,55,0.2); border-radius: 12px; padding: 18px 16px; background: rgba(255,255,255,0.025); text-decoration: none; transition: all 0.2s; display: flex; flex-direction: column; gap: 6px; }
    .plink-card:hover { border-color: rgba(212,165,55,0.5); background: rgba(212,165,55,0.06); transform: translateY(-2px); }
    .plink-label { color: var(--muted); font-size: 0.7rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.09em; }
    .plink-title { color: var(--gold-soft); font-size: 0.92rem; font-weight: 600; line-height: 1.4; }
    @media (max-width: 700px) { .plinks-grid { grid-template-columns: 1fr 1fr; } }
    @media (max-width: 440px) { .plinks-grid { grid-template-columns: 1fr; } }

    /* TIMELINE VERTICAL */
    .v-timeline { display: flex; flex-direction: column; gap: 0; margin: 28px 0; }
    .vt-item { display: flex; gap: 22px; padding: 0 0 30px 0; position: relative; }
    .vt-item::before { content: ''; position: absolute; left: 18px; top: 38px; bottom: 0; width: 2px; background: rgba(212,165,55,0.15); }
    .vt-item:last-child::before { display: none; }
    .vt-dot { width: 38px; height: 38px; border-radius: 50%; background: rgba(13,5,25,0.9); border: 2px solid var(--line); display: flex; align-items: center; justify-content: center; flex-shrink: 0; position: relative; z-index: 1; }
    .vt-dot.red { border-color: rgba(239,68,68,0.5); background: rgba(127,29,29,0.3); }
    .vt-dot.gold { border-color: rgba(212,165,55,0.5); background: rgba(92,60,5,0.3); }
    .vt-content { flex: 1; }
    .vt-year { font-size: 0.78rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; color: var(--gold); margin-bottom: 4px; }
    .vt-year.red-year { color: var(--red-soft); }
    .vt-title { font-family: 'Crimson Text', serif; font-size: 1.2rem; font-weight: 600; color: var(--ink); margin-bottom: 6px; line-height: 1.3; }
    .vt-body { font-size: 0.9rem; color: rgba(248,241,221,0.78); line-height: 1.8; }
    .vt-body strong { color: var(--gold-soft); }
    .vt-body em { color: var(--red-soft); font-style: normal; font-weight: 600; }

    /* REVELATION 18 FULL VERSE BLOCK */
    .rev18-block { background: linear-gradient(135deg, rgba(60,5,5,0.45), rgba(7,0,15,0.95)); border: 1px solid rgba(239,68,68,0.3); border-radius: 18px; padding: 36px 30px; margin: 28px 0; }
    .rev18-block .rev-label { font-size: 0.72rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.14em; color: var(--red); margin-bottom: 16px; }
    .rev18-block blockquote { font-family: 'Crimson Text', serif; font-size: 1.2rem; font-style: italic; color: var(--red-soft); line-height: 1.75; margin-bottom: 12px; }
    .rev18-block blockquote strong { color: #fff8f8; font-style: normal; }
    .rev18-block cite { font-size: 0.8rem; color: rgba(252,165,165,0.6); font-style: normal; font-weight: 600; text-transform: uppercase; letter-spacing: 0.07em; }

    /* CALL TO ACTION */
    .cta-block { background: linear-gradient(135deg, rgba(127,29,29,0.3), rgba(92,60,5,0.2), rgba(7,0,15,0.9)); border: 2px solid rgba(239,68,68,0.4); border-radius: 22px; padding: 52px 44px; margin: 40px 0; text-align: center; }
    .cta-block h3 { font-family: 'Crimson Text', serif; font-size: clamp(1.8rem, 3.5vw, 2.8rem); font-weight: 600; color: var(--ink); margin-bottom: 16px; line-height: 1.15; }
    .cta-block h3 em { color: var(--red-soft); font-style: italic; }
    .cta-block p { font-size: 1rem; color: rgba(248,241,221,0.82); line-height: 1.9; max-width: 700px; margin: 0 auto 28px; }
    .cta-block p strong { color: var(--red-soft); }
    .cta-btn-row { display: flex; gap: 14px; flex-wrap: wrap; justify-content: center; }
    .btn-red { display: inline-flex; align-items: center; gap: 8px; padding: 16px 30px; border-radius: 12px; background: linear-gradient(to right, #9f1239, #ef4444); color: #fff; font-weight: 700; font-size: 0.95rem; text-decoration: none; transition: all 0.2s; }
    .btn-red:hover { background: linear-gradient(to right, #be123c, #f87171); color: #fff; }
    .btn-gold { display: inline-flex; align-items: center; gap: 8px; padding: 16px 30px; border-radius: 12px; background: linear-gradient(to right, #b45309, #d97706); color: #fff; font-weight: 700; font-size: 0.95rem; text-decoration: none; transition: all 0.2s; }
    .btn-gold:hover { background: linear-gradient(to right, #d97706, #f59e0b); color: #fff; }
    .btn-outline { display: inline-flex; align-items: center; gap: 8px; padding: 16px 30px; border-radius: 12px; background: transparent; border: 1px solid var(--line); color: var(--muted); font-weight: 600; font-size: 0.95rem; text-decoration: none; transition: all 0.2s; }
    .btn-outline:hover { border-color: var(--gold); color: var(--gold-soft); }
    @media (max-width: 640px) { .cta-block { padding: 34px 22px; } }

    /* FOOTER */
    .site-footer { background: rgba(5,0,12,0.98); border-top: 1px solid rgba(180,130,50,0.2); }
    .footer-stripe-top { height: 4px; background: linear-gradient(to right, #7f1d1d, #ef4444, #b45309, #ef4444, #7f1d1d); }
    .footer-banner { background: linear-gradient(to right, rgba(127,29,29,0.1), rgba(127,29,29,0.15), rgba(127,29,29,0.1)); padding: 26px; text-align: center; }
    .footer-banner p { font-family: 'Crimson Text', serif; color: #fde68a; font-size: 1.15rem; font-style: italic; }
    .footer-banner cite { color: var(--gold); font-size: 0.88rem; font-weight: 700; font-style: normal; display: block; margin-top: 6px; }
    .footer-main { max-width: 1280px; margin: 0 auto; padding: 56px 22px; display: grid; gap: 2.5rem; }
    @media (min-width: 768px) { .footer-main { grid-template-columns: 2fr 1fr 1fr 1fr; } }
    .footer-col h4 { color: var(--gold-soft); font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.15em; margin-bottom: 16px; }
    .footer-col p { color: var(--muted); font-size: 0.875rem; line-height: 1.7; }
    .footer-col ul { list-style: none; }
    .footer-col li { padding: 4px 0; }
    .footer-col li a { color: var(--muted); font-size: 0.875rem; transition: color 0.2s; text-decoration: none; }
    .footer-col li a:hover { color: var(--gold-soft); }
    .footer-brand-name { display: flex; align-items: center; gap: 8px; margin-bottom: 12px; font-weight: 700; font-size: 1.1rem; color: #fff; }
    .footer-brand-name em { color: var(--gold); font-style: normal; }
    .footer-bottom { border-top: 1px solid rgba(180,130,50,0.1); padding: 20px 22px; text-align: center; }
    .footer-bottom p { color: #6b7280; font-size: 0.78rem; }
    .footer-flags { display: flex; align-items: center; justify-content: center; gap: 4px; margin: 12px 0; }
    .footer-flags div { width: 32px; height: 4px; border-radius: 2px; }
    .flag-r { background: #b91c1c; }
    .flag-w { background: #fff; }
    .flag-b { background: #1d4ed8; }
    .footer-stripe { height: 4px; background: linear-gradient(to right, #b91c1c, #fff, #1d4ed8); }

    /* BACK TO TOP */
    .btt { position: fixed; bottom: 2rem; right: 2rem; width: 44px; height: 44px; background: rgba(127,29,29,0.25); border: 1px solid rgba(239,68,68,0.3); border-radius: 50%; color: var(--ink); display: none; align-items: center; justify-content: center; cursor: pointer; z-index: 40; transition: all 0.2s; }
    .btt.visible { display: flex; }
    .btt:hover { background: rgba(127,29,29,0.5); }
