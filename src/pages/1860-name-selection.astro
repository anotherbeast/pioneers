---
import Analytics from '../components/Analytics.astro';
import ShareBar from '../components/ShareBar.astro';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <Analytics />
    <title>1860 Name Selection | Seventh-day Adventist</title>
    <meta
      name="description"
      content="Documented timeline page on how the early Sabbath-keeping Advent believers adopted the name Seventh-day Adventist in 1860 and formally organized in 1863."
    />
    <meta property="og:title" content="1860 Name Selection | Seventh-day Adventist">
    <meta property="og:description" content="How the early Sabbath-keeping Advent believers adopted the name Seventh-day Adventist in 1860 and formally organized in 1863.">
    <meta property="og:image" content="https://sundaylaw.com/images/shield_sundaylaw.com_the_final_warning_logo.jpg">
    <meta property="og:type" content="article">
    <meta property="og:url" content="https://sundaylaw.com/1860-name-selection">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&family=Source+Sans+3:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <style>
      :root {
        --bg: #080d1a;
        --ink: #f5efdd;
        --muted: #cfc29b;
        --line: rgba(224, 188, 103, 0.28);
        --gold: #e0bc67;
        --card: rgba(13, 19, 36, 0.84);
      }

      * { box-sizing: border-box; }

      body {
        margin: 0;
        color: var(--ink);
        font-family: 'Source Sans 3', sans-serif;
        background:
          radial-gradient(circle at 84% 14%, rgba(224, 188, 103, 0.14), transparent 36%),
          radial-gradient(circle at 16% 80%, rgba(82, 118, 171, 0.15), transparent 42%),
          linear-gradient(158deg, #050913 0%, #0a1020 52%, #070b14 100%);
      }

      .serif { font-family: 'Cormorant Garamond', serif; }

      .topbar {
        position: sticky;
        top: 0;
        z-index: 30;
        backdrop-filter: blur(10px);
        background: rgba(8, 13, 26, 0.74);
        border-bottom: 1px solid var(--line);
      }

      .topbar-inner {
        max-width: 1080px;
        margin: 0 auto;
        padding: 14px 20px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
      }

      .brand {
        color: var(--ink);
        text-decoration: none;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        font-size: 0.88rem;
      }

      .brand strong { color: var(--gold); }

      .toplinks {
        display: flex;
        gap: 14px;
      }

      .toplinks a {
        color: var(--muted);
        text-decoration: none;
        font-weight: 600;
      }

      .toplinks a:hover { color: var(--gold); }

      .hero {
        max-width: 1080px;
        margin: 30px auto 0;
        padding: 0 20px;
      }

      .hero-card {
        border: 1px solid var(--line);
        border-radius: 22px;
        background: linear-gradient(152deg, rgba(15, 22, 42, 0.94), rgba(8, 12, 24, 0.92));
        box-shadow: 0 20px 54px rgba(0, 0, 0, 0.42);
        padding: 36px 30px;
      }

      .eyebrow {
        display: inline-block;
        padding: 7px 13px;
        border-radius: 999px;
        border: 1px solid var(--line);
        color: var(--gold);
        font-size: 0.74rem;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        font-weight: 700;
      }

      h1 {
        margin: 14px 0 0;
        font-size: clamp(2rem, 6vw, 3.6rem);
        line-height: 1.03;
      }

      h1 span { color: var(--gold); }

      .lead {
        margin: 15px 0 0;
        color: var(--muted);
        font-size: 1.12rem;
        line-height: 1.75;
        max-width: 70ch;
      }

      .layout {
        max-width: 1080px;
        margin: 18px auto 56px;
        padding: 0 20px;
        display: grid;
        gap: 14px;
      }

      .section {
        border: 1px solid var(--line);
        border-radius: 16px;
        background: var(--card);
        padding: 22px;
      }

      .section h2 {
        margin: 0;
        color: var(--gold);
        font-size: 1.65rem;
      }

      .section p {
        margin: 12px 0 0;
        color: var(--muted);
        line-height: 1.78;
      }

      .timeline {
        margin-top: 14px;
        display: grid;
        gap: 10px;
      }

      .event {
        border: 1px solid var(--line);
        border-left: 4px solid var(--gold);
        border-radius: 11px;
        padding: 13px 14px;
        background: rgba(255, 255, 255, 0.02);
      }

      .event strong {
        display: block;
        color: #f6d995;
        margin-bottom: 6px;
      }

      .sources {
        margin-top: 12px;
        display: grid;
        gap: 8px;
      }

      .sources a {
        color: var(--gold);
        text-decoration: none;
        font-weight: 600;
      }

      .sources a:hover { text-decoration: underline; }

      .footnote {
        color: #9ca3af;
        margin-top: 18px;
        font-size: 0.92rem;
      }

      @media (max-width: 760px) {
        .hero-card { padding: 28px 20px; }
      }
    </style>
  </head>
  <body>
    <SiteNav />

    <main>
      <section class="hero">
        <div class="hero-card">
          <span class="eyebrow">Historical Record</span>
          <h1 class="serif">The <span>1860 Name Selection</span> of Seventh-day Adventist</h1>
          <p class="lead">
            This page documents the movement from post-1844 Sabbath-keeping Advent believers into a
            named body in 1860, followed by formal denominational organization in 1863.
          </p>
        </div>
      </section>

      <div class="layout">
        <section class="section">
          <h2 class="serif">Core Timeline</h2>
          <div class="timeline">
            <article class="event">
              <strong>1844-1860: Pre-denominational period</strong>
              Sabbath-keeping Advent believers organized publishing, conferences, and doctrinal work
              before adopting a formal denominational name.
            </article>
            <article class="event">
              <strong>1860: Name adopted</strong>
              The movement settled on the name <em>Seventh-day Adventist</em>, a title reflecting both
              Sabbath observance and Advent hope.
            </article>
            <article class="event">
              <strong>May 21, 1863: General Conference formed</strong>
              Three years after adopting the name, the General Conference of Seventh-day Adventists was
              formed and the movement entered formal organization.
            </article>
            <article class="event">
              <strong>1872: <em>A Declaration of the Fundamental Principles</em></strong>
              The movement published its first written summary of doctrinal positions &mdash; not a creed,
              but a voluntary declaration of &ldquo;the principal features of our faith.&rdquo; This 16-page booklet
              addresses the Sabbath, the Second Advent, the State of the Dead, the Law of God, and more.
              It predates and stands independent of the 1904 corporate reorganization.
            </article>
          </div>
        </section>

        <section class="section">
          <h2 class="serif">Why This Matters</h2>
          <p>
            The 1860 name decision is a key historical pivot. It identifies how the early believers
            publicly defined themselves while preserving continuity with the 1840s Advent awakening and
            Sabbath message.
          </p>
          <p>
            The sequence is straightforward in historical summaries: identity language in 1860, then
            denominational legal organization in 1863.
          </p>
        </section>

        <!-- 1872 Declaration of Fundamental Principles -->
        <section class="section" style="padding:0;overflow:hidden;">
          <div style="padding:22px 22px 18px;">
            <div style="display:inline-block;padding:5px 12px;border-radius:999px;border:1px solid rgba(224,188,103,0.3);color:#e0bc67;font-size:0.72rem;letter-spacing:0.12em;text-transform:uppercase;font-weight:700;margin-bottom:12px;">1872 &mdash; Primary Source Document</div>
            <h2 class="serif" style="margin:0 0 10px;color:#e0bc67;font-size:1.65rem;">A Declaration of the Fundamental Principles</h2>
            <p style="margin:0 0 6px;color:#cfc29b;line-height:1.75;">
              <em>Taught and Practiced by the Seventh-day Adventists.</em> Published 1872. This voluntary
              declaration &mdash; not a binding creed &mdash; sets forth the doctrinal pillars of the original
              Seventh-day Adventist platform: the Sabbath, the Advent, conditional immortality (State of the
              Dead), the non-immortality of the soul, the Law of God, baptism by immersion, and more.
            </p>
            <p style="margin:0 0 16px;color:#9ca3af;font-size:0.9rem;">
              This document reflects the beliefs of the pre-1904 movement. It was published
              before the General Conference Corporate reorganization and before the 1904 Articles of
              Incorporation. It is the living platform Joseph Bates, James White, and their fellow
              pioneers built &mdash; in their own words.
            </p>
            <a
              href="/books/pioneer-pillar-beliefs/1872.pdf"
              target="_blank"
              rel="noopener noreferrer"
              style="display:inline-flex;align-items:center;gap:8px;padding:10px 20px;background:linear-gradient(to right,#92660a,#b8820f);color:#fff;border-radius:9px;font-weight:700;font-size:0.875rem;text-decoration:none;margin-bottom:16px;"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
              Read the 1872 Declaration
            </a>
          </div>
          <iframe
            src="/books/pioneer-pillar-beliefs/1872.pdf"
            title="A Declaration of the Fundamental Principles (1872)"
            width="100%"
            height="700"
            style="display:block;border:none;background:#fff;"
            loading="lazy"
          ></iframe>
        </section>
      </div>
    </main>

    <!-- ===== CONTINUE THE RECORD ===== -->
    <section style="background:rgba(8,13,26,0.92);border-top:1px solid rgba(224,188,103,0.18);border-bottom:1px solid rgba(224,188,103,0.18);padding:52px 20px;">
      <div style="max-width:820px;margin:0 auto;">
        <div style="display:inline-block;padding:5px 14px;border-radius:999px;border:1px solid rgba(224,188,103,0.35);color:#e0bc67;font-size:0.72rem;letter-spacing:0.12em;text-transform:uppercase;font-weight:700;margin-bottom:18px;">Continue the Record</div>
        <h2 class="serif" style="margin:0 0 10px;font-size:1.7rem;color:#f5efdd;">The Full Organizational History</h2>
        <p style="color:#cfc29b;line-height:1.8;margin:0 0 32px;max-width:640px;">
          From William Miller&rsquo;s first public proclamation in 1831 to the five men who signed the 1904 Articles of Incorporation &mdash; the complete record of who named the church, who organized it, who incorporated it, and what happened next.
        </p>
        <div style="display:flex;flex-wrap:wrap;gap:14px;margin-bottom:48px;">
          <a href="/seventh-day-adventist-name-history" style="display:inline-flex;align-items:center;gap:9px;padding:13px 24px;background:linear-gradient(135deg,#92660a,#b8820f);color:#fff;border-radius:10px;font-weight:700;font-size:0.9rem;text-decoration:none;line-height:1.2;">
            <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M2 3h6a4 4 0 014 4v14a3 3 0 00-3-3H2z"/><path d="M22 3h-6a4 4 0 00-4 4v14a3 3 0 013-3h7z"/></svg>
            Full Name &amp; Organization History
          </a>
          <a href="/april-15-1904-new-organization" style="display:inline-flex;align-items:center;gap:9px;padding:13px 24px;background:rgba(13,19,36,0.9);color:#e0bc67;border:1px solid rgba(224,188,103,0.4);border-radius:10px;font-weight:700;font-size:0.9rem;text-decoration:none;line-height:1.2;">
            <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
            April 15, 1904 &mdash; The 1904 Record
          </a>
          <a href="/1904-signers" style="display:inline-flex;align-items:center;gap:9px;padding:13px 24px;background:rgba(13,19,36,0.9);color:#e0bc67;border:1px solid rgba(224,188,103,0.4);border-radius:10px;font-weight:700;font-size:0.9rem;text-decoration:none;line-height:1.2;">
            <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87"/><path d="M16 3.13a4 4 0 010 7.75"/></svg>
            The Five Who Signed
          </a>
        </div>

        <div style="border-top:1px solid rgba(224,188,103,0.15);padding-top:32px;">
          <div style="display:inline-block;padding:5px 14px;border-radius:999px;border:1px solid rgba(220,38,38,0.45);color:#f87171;font-size:0.72rem;letter-spacing:0.12em;text-transform:uppercase;font-weight:700;margin-bottom:18px;">Apostasy Record</div>
          <h3 class="serif" style="margin:0 0 10px;font-size:1.4rem;color:#f5efdd;">The Men Who Drove the Corporate Turn</h3>
          <p style="color:#cfc29b;line-height:1.8;margin:0 0 24px;max-width:640px;">
            Who led the 1897&ndash;1904 reorganization? What happened to the pioneer faith after the corporation was formed? The apostate shepherds &mdash; their own records speak.
          </p>
          <div style="display:flex;flex-wrap:wrap;gap:14px;">
            <a href="/apostasy" style="display:inline-flex;align-items:center;gap:9px;padding:13px 24px;background:rgba(127,29,29,0.4);color:#fca5a5;border:1px solid rgba(220,38,38,0.45);border-radius:10px;font-weight:700;font-size:0.9rem;text-decoration:none;line-height:1.2;">
              <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
              Apostate Shepherds &mdash; Resume of Apostasy
            </a>
            <a href="/babylon-antichrist-library" style="display:inline-flex;align-items:center;gap:9px;padding:13px 24px;background:rgba(13,19,36,0.9);color:#e0bc67;border:1px solid rgba(224,188,103,0.4);border-radius:10px;font-weight:700;font-size:0.9rem;text-decoration:none;line-height:1.2;">
              <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M4 19.5A2.5 2.5 0 016.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 014 19.5v-15A2.5 2.5 0 016.5 2z"/></svg>
              Babylon &amp; Antichrist Library
            </a>
            <a href="/religious-liberty" style="display:inline-flex;align-items:center;gap:9px;padding:13px 24px;background:rgba(13,19,36,0.9);color:#e0bc67;border:1px solid rgba(224,188,103,0.4);border-radius:10px;font-weight:700;font-size:0.9rem;text-decoration:none;line-height:1.2;">
              <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
              Religious Liberty
            </a>
          </div>
        </div>
      </div>
    </section>

    <SiteFooter
      scripture="Hear ye the word which the LORD speaketh unto you, O house of Israel. Thus saith the LORD, Learn not the way of the heathen&hellip; for the customs of the people are vain."
      scriptureRef="Jeremiah 10:1-3 (KJV) — The 1860 name was a declaration of identity: the seventh-day Sabbath, the Advent hope, and the faith of Jesus."
      pageLinks={[
        { label: 'Full Name & Organization History', href: '/seventh-day-adventist-name-history' },
        { label: 'April 15, 1904 — Corporate Turn', href: '/april-15-1904-new-organization' },
        { label: 'The Five 1904 Signers', href: '/1904-signers' },
        { label: 'Apostate Shepherds', href: '/apostasy' },
      ]}
    />
    <ShareBar />
  </body>
</html>
      </div>
    </main>
  </body>
</html>
