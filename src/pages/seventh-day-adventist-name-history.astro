              <a href="/pioneers/david-hewitt" style="display:inline-flex;align-items:center;gap:6px;padding:8px 16px;background:rgba(212,165,55,0.1);border:1px solid rgba(212,165,55,0.3);border-radius:8px;color:#f0c84a;font-size:0.82rem;font-weight:700;text-decoration:none;">
