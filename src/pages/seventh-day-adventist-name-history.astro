  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Who named the Seventh-day Adventist Church?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "The name 'Seventh-day Adventist' was first proposed by David Hewitt of Battle Creek, Michigan — known as 'the most honest man in Battle Creek.' He suggested the name at a committee meeting on October 1, 1860, at Battle Creek. After discussion among 25 delegates, the name was voted 24-1 in favor."
        }
      },
      {
        "@type": "Question",
        "name": "When was the name Seventh-day Adventist chosen?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "The name 'Seventh-day Adventist' was first proposed on October 1, 1860, in Battle Creek, Michigan. It was voted 24-1 by 25 delegates. The name reflects two core beliefs: 'Seventh-day' for the biblical Saturday Sabbath, and 'Adventist' for the belief in the imminent second coming of Jesus."
        }
      },
      {
        "@type": "Question",
        "name": "When did Seventh-day Adventists formally organize?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "The General Conference of Seventh-day Adventists was formally organized in May 1863 at Battle Creek, Michigan, with John Byington as the first General Conference president. Prior to this, the movement had no formal denominational structure — something early leaders including James White had resisted."
        }
      },
      {
        "@type": "Question",
        "name": "When did the Adventist Church incorporate?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "The General Conference Corporation of Seventh-day Adventists was incorporated on April 15, 1904, in Washington, D.C. — filed by GC President Arthur G. Daniells. This was preceded by a Michigan corporation called the 'General Conference Association of Seventh-day Adventists,' which was legally bound to hold its meetings in Michigan. The 1904 D.C. incorporation replaced the Michigan structure with a federal-district civil corporation."
        }
      },
      {
        "@type": "Question",
        "name": "What was the General Conference Association of Seventh-day Adventists?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "The General Conference Association of Seventh-day Adventists was a Michigan state corporation that existed prior to 1904. Its April 18, 1901 legal documents describe it as 'a corporation of the city of Battle Creek, Michigan, existing under the laws of the State of Michigan.' Its meetings were required to be held in Michigan. In 1904, GC President Daniells replaced it with a D.C. federal-district corporation filed on April 15, 1904."
        }
      },
      {
        "@type": "Question",
        "name": "Who was David Hewitt?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "David Hewitt (1805–1878) was a Presbyterian merchant and the first Sabbatarian Adventist convert in Battle Creek, Michigan. In 1852, he and his wife Olive were contacted by Joseph Bates and accepted the Sabbath message. He became active in the early Adventist community, served on committees, and wrote for the Review and Herald. In 1860, at a committee meeting in Battle Creek, he was the first to propose the name 'Seventh-day Adventist.'"
        }
      }
    ]
  }
  </script>
  <Analytics />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Crimson+Text:ital,wght@0,400;0,600;1,400&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg: #0a0a2e; --bg-soft: #0d0d3a;
      --ink: #fef3c7; --ink-muted: #9ca3af;
      --gold: #d4a537; --gold-soft: #fcd34d; --amber: #f59e0b;
      --red: #ef4444; --red-soft: #fca5a5;
      --blue: #3b82f6; --blue-soft: #93c5fd;
      --green: #10b981; --green-soft: #6ee7b7;
      --purple: #8b5cf6; --purple-soft: #c4b5fd;
      --line: rgba(212,165,55,0.22); --line-soft: rgba(212,165,55,0.12);
    }
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }
    body { font-family: 'Inter', sans-serif; color: var(--ink); background: var(--bg); overflow-x: hidden; }
    a { color: var(--gold); text-decoration: none; transition: color 0.2s; }
    a:hover { color: var(--gold-soft); }

    /* NAV */
    .nav { position: sticky; top: 0; z-index: 100; background: rgba(5,5,30,0.94); backdrop-filter: blur(12px); border-bottom: 1px solid var(--line); }
    .nav-wrap { max-width: 1280px; margin: 0 auto; }
    .nav-row { display: flex; align-items: center; padding: 0 22px; }
    .nav-row-top { gap: 28px; height: 62px; border-bottom: 1px solid rgba(212,165,55,0.10); }
    .nav-row-bottom { gap: 22px; height: 42px; font-size: 0.82rem; overflow-x: auto; scrollbar-width: none; }
    .nav-brand { text-decoration: none; flex-shrink: 0; display: flex; align-items: center; margin-right: auto; }
    .nav-brand img { height: 38px; width: auto; display: block; border-radius: 4px; }
    .nav-link { color: var(--ink-muted); text-decoration: none; font-weight: 600; font-size: 0.9rem; white-space: nowrap; transition: color 0.18s; }
    .nav-link:hover { color: var(--gold-soft); }
    .nav-cta { display: inline-flex; align-items: center; height: 38px; padding: 0 18px; border-radius: 8px; background: var(--gold); color: #111; font-weight: 700; font-size: 0.88rem; text-decoration: none; flex-shrink: 0; }
    .nav-cta:hover { background: var(--gold-soft); color: #111; }
    .nav-bottom-link { color: rgba(156,163,175,0.8); text-decoration: none; font-weight: 500; white-space: nowrap; transition: color 0.18s; flex-shrink: 0; }
    .nav-bottom-link:hover, .nav-bottom-link.active { color: var(--gold-soft); }
    .menu-btn { display: none; width: 40px; height: 40px; border: 1px solid var(--line); border-radius: 8px; background: rgba(255,255,255,0.03); color: var(--ink); font-size: 1.2rem; cursor: pointer; flex-shrink: 0; align-items: center; justify-content: center; }
    .mobile-nav { display: none; border-top: 1px solid var(--line); padding: 14px 22px 18px; background: rgba(5,5,30,0.97); }
    .mobile-nav.open { display: grid; gap: 6px; }
    .mobile-nav a { color: var(--ink-muted); text-decoration: none; font-weight: 600; padding: 8px 0; border-bottom: 1px solid rgba(255,255,255,0.05); display: block; }
    .mobile-nav a:hover { color: var(--gold-soft); }
    @media (max-width: 860px) { .nav-row-bottom { display: none; } .menu-btn { display: inline-flex; } .nav-link { display: none; } }

    /* LAYOUT */
    .page { max-width: 1100px; margin: 0 auto; padding: 0 22px 100px; }
    .section { padding: 52px 0; border-top: 1px solid var(--line-soft); }
    .section-header { text-align: center; margin-bottom: 36px; }
    .sh-eyebrow { display: inline-block; padding: 5px 16px; border-radius: 999px; border: 1px solid var(--line); color: var(--gold-soft); letter-spacing: 0.1em; text-transform: uppercase; font-size: 0.73rem; font-weight: 700; margin-bottom: 12px; }
    .section-header h2 { font-family: 'Crimson Text', serif; font-size: clamp(1.8rem, 3.5vw, 2.6rem); font-weight: 600; color: var(--ink); margin-bottom: 10px; }
    .section-header p { color: var(--ink-muted); font-size: 0.97rem; line-height: 1.8; max-width: 700px; margin: 0 auto; }

    /* HERO */
    .hero { padding: 44px 0 36px; }
    .breadcrumb { font-size: 0.8rem; color: var(--ink-muted); margin-bottom: 22px; }
    .breadcrumb a { color: var(--ink-muted); }
    .breadcrumb span { margin: 0 6px; }
    .hero-card { background: linear-gradient(135deg, rgba(20,10,50,0.95), rgba(10,5,35,0.98)); border: 1px solid rgba(212,165,55,0.28); border-radius: 24px; padding: 44px 40px; display: grid; grid-template-columns: 280px 1fr; gap: 48px; align-items: start; }
    @media (max-width: 768px) { .hero-card { grid-template-columns: 1fr; gap: 28px; padding: 28px 22px; } }
    .doc-col { display: flex; flex-direction: column; gap: 14px; }
    .doc-preview { border-radius: 14px; overflow: hidden; border: 2px solid rgba(212,165,55,0.3); }
    .doc-preview img { width: 100%; height: auto; display: block; }
    .doc-label { font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--ink-muted); font-weight: 700; padding: 8px 12px; background: rgba(10,5,35,0.8); border-top: 1px solid rgba(212,165,55,0.15); text-align: center; }
    .fact-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 9px; }
    .fact-box { background: rgba(13,5,25,0.7); border: 1px solid var(--line-soft); border-radius: 10px; padding: 11px 13px; }
    .fact-label { font-size: 0.69rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--ink-muted); font-weight: 700; margin-bottom: 4px; }
    .fact-val { font-size: 0.88rem; color: var(--gold-soft); font-weight: 600; }
    .fact-val.green { color: var(--green-soft); }
    .fact-val.red { color: var(--red-soft); }
    .content-col .eyebrow { display: inline-flex; align-items: center; gap: 6px; padding: 5px 14px; border-radius: 999px; background: rgba(212,165,55,0.10); border: 1px solid rgba(212,165,55,0.3); color: var(--gold-soft); font-size: 0.74rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 14px; }
    .content-col h1 { font-family: 'Crimson Text', serif; font-size: clamp(2rem, 4vw, 3.1rem); font-weight: 600; line-height: 1.1; color: var(--ink); margin-bottom: 12px; }
    .content-col h1 em { color: var(--gold-soft); font-style: italic; }
    .content-col .lead { font-size: 1rem; color: rgba(254,243,199,0.85); line-height: 1.85; margin-bottom: 20px; }
    .content-col .lead strong { color: var(--gold-soft); }

    /* BUTTONS */
    .btn-row { display: flex; gap: 12px; flex-wrap: wrap; }
    .btn-gold { display: inline-flex; align-items: center; gap: 8px; padding: 13px 22px; border-radius: 12px; background: linear-gradient(to right, #b45309, #d97706); color: #fff; font-weight: 700; font-size: 0.93rem; text-decoration: none; transition: all 0.2s; }
    .btn-gold:hover { background: linear-gradient(to right, #d97706, #f59e0b); color: #fff; }
    .btn-outline { display: inline-flex; align-items: center; gap: 8px; padding: 13px 22px; border-radius: 12px; background: transparent; border: 1px solid var(--line); color: var(--ink-muted); font-weight: 600; font-size: 0.93rem; text-decoration: none; transition: all 0.2s; }
    .btn-outline:hover { border-color: var(--gold); color: var(--gold-soft); }
    .btn-red { display: inline-flex; align-items: center; gap: 8px; padding: 13px 22px; border-radius: 12px; background: rgba(127,29,29,0.3); border: 1px solid rgba(239,68,68,0.4); color: var(--red-soft); font-weight: 700; font-size: 0.93rem; text-decoration: none; transition: all 0.2s; }
    .btn-red:hover { background: rgba(127,29,29,0.5); color: #fff; }
    .btn-blue { display: inline-flex; align-items: center; gap: 8px; padding: 13px 22px; border-radius: 12px; background: rgba(59,130,246,0.12); border: 1px solid rgba(59,130,246,0.35); color: var(--blue-soft); font-weight: 700; font-size: 0.93rem; text-decoration: none; transition: all 0.2s; }
    .btn-blue:hover { background: rgba(59,130,246,0.22); color: #fff; }

    /* TIMELINE */
    .timeline { display: flex; flex-direction: column; gap: 0; margin-top: 28px; }
    .tl-item { display: grid; grid-template-columns: 110px 1fr; gap: 20px; border-left: 2px solid rgba(212,165,55,0.25); padding: 0 0 28px 26px; position: relative; }
    .tl-item:last-child { padding-bottom: 0; }
    .tl-item::before { content: ''; width: 13px; height: 13px; border-radius: 50%; background: var(--gold); border: 2px solid var(--bg); position: absolute; left: -8px; top: 4px; }
    .tl-item.red::before { background: var(--red); }
    .tl-item.green::before { background: var(--green); }
    .tl-year { font-weight: 800; font-size: 0.95rem; color: var(--gold-soft); padding-top: 2px; line-height: 1.3; }
    .tl-content h4 { font-family: 'Crimson Text', serif; font-size: 1.15rem; font-weight: 600; color: var(--ink); margin-bottom: 5px; }
    .tl-content p { font-size: 0.88rem; color: var(--ink-muted); line-height: 1.7; }
    .tl-content p strong { color: rgba(254,243,199,0.9); }

    /* DAVID HEWITT */
    .hewitt-card { background: linear-gradient(135deg, rgba(20,10,50,0.9), rgba(10,5,35,0.95)); border: 1px solid rgba(212,165,55,0.28); border-radius: 20px; padding: 40px; }
    @media (max-width: 600px) { .hewitt-card { padding: 24px 18px; } }
    .hewitt-grid { display: grid; grid-template-columns: 200px 1fr; gap: 40px; align-items: start; }
    @media (max-width: 700px) { .hewitt-grid { grid-template-columns: 1fr; } }
    .hewitt-portrait { width: 160px; height: 160px; border-radius: 50%; background: linear-gradient(135deg, #78350f, #451a03); border: 3px solid var(--gold); margin: 0 auto 14px; display: flex; align-items: center; justify-content: center; }
    .hewitt-monogram { font-family: 'Crimson Text', serif; font-size: 2.4rem; color: var(--gold-soft); font-weight: 600; }
    .hewitt-name { font-family: 'Crimson Text', serif; font-size: 1.4rem; font-weight: 600; color: var(--ink); text-align: center; margin-bottom: 4px; }
    .hewitt-dates { font-size: 0.78rem; color: var(--ink-muted); text-align: center; margin-bottom: 8px; }
    .hewitt-badge { display: inline-block; padding: 4px 12px; border-radius: 999px; background: rgba(212,165,55,0.12); border: 1px solid rgba(212,165,55,0.3); color: var(--gold-soft); font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; text-align: center; width: 100%; }
    .hewitt-body h3 { font-family: 'Crimson Text', serif; font-size: 1.9rem; font-weight: 600; color: var(--ink); margin-bottom: 14px; line-height: 1.2; }
    .hewitt-body p { font-size: 0.95rem; color: rgba(254,243,199,0.82); line-height: 1.9; margin-bottom: 13px; }
    .hewitt-body p strong { color: var(--gold-soft); }
    .vote-box { background: rgba(16,185,129,0.08); border: 2px solid rgba(16,185,129,0.3); border-radius: 14px; padding: 22px 24px; margin: 18px 0; }
    .vote-box .v-label { font-size: 0.72rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.12em; color: var(--green-soft); margin-bottom: 10px; }
    .vote-num { font-family: 'Crimson Text', serif; font-size: 2.8rem; font-weight: 700; color: var(--green-soft); line-height: 1; margin-bottom: 4px; }
    .vote-desc { font-size: 0.88rem; color: rgba(254,243,199,0.75); line-height: 1.65; }

    /* PULL QUOTE */
    .pull-quote { background: rgba(212,165,55,0.06); border-left: 4px solid var(--gold); border-radius: 0 14px 14px 0; padding: 22px 24px; margin: 24px 0; }
    .pull-quote blockquote { font-family: 'Crimson Text', serif; font-size: 1.25rem; font-style: italic; color: rgba(254,243,199,0.92); line-height: 1.7; }
    .pull-quote cite { display: block; margin-top: 10px; font-size: 0.8rem; color: var(--ink-muted); font-style: normal; font-weight: 600; }

    /* DOCUMENTS */
    .doc-card { background: rgba(13,5,25,0.8); border: 1px solid rgba(212,165,55,0.22); border-radius: 18px; overflow: hidden; margin-bottom: 48px; }
    .doc-card-header { padding: 22px 28px; border-bottom: 1px solid rgba(212,165,55,0.15); display: flex; align-items: flex-start; gap: 18px; flex-wrap: wrap; }
    .doc-badge { flex-shrink: 0; padding: 6px 14px; border-radius: 999px; font-size: 0.72rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.1em; }
    .badge-gold { background: rgba(212,165,55,0.14); border: 1px solid rgba(212,165,55,0.4); color: var(--gold-soft); }
    .badge-blue { background: rgba(59,130,246,0.12); border: 1px solid rgba(59,130,246,0.35); color: var(--blue-soft); }
    .badge-red { background: rgba(127,29,29,0.3); border: 1px solid rgba(239,68,68,0.4); color: var(--red-soft); }
    .badge-green { background: rgba(16,185,129,0.1); border: 1px solid rgba(16,185,129,0.3); color: var(--green-soft); }
    .badge-purple { background: rgba(139,92,246,0.12); border: 1px solid rgba(139,92,246,0.35); color: var(--purple-soft); }
    .doc-card-title { flex: 1; }
    .doc-card-title h3 { font-family: 'Crimson Text', serif; font-size: 1.5rem; font-weight: 600; color: var(--ink); margin-bottom: 4px; }
    .doc-card-title .doc-date { font-size: 0.82rem; color: var(--gold); font-weight: 600; }
    .doc-card-body { padding: 22px 28px; }
    .doc-card-body p { font-size: 0.95rem; color: rgba(254,243,199,0.8); line-height: 1.85; margin-bottom: 12px; }
    .doc-card-body p strong { color: var(--gold-soft); }
    .doc-card-body p em { color: var(--red-soft); font-style: normal; font-weight: 600; }
    .doc-embed-wrap { margin: 20px 0; display: flex; justify-content: center; }
    .doc-embed-inner { width: 100%; max-width: 820px; }
    .doc-embed-toolbar { display: flex; align-items: center; justify-content: space-between; padding: 11px 18px; background: rgba(5,0,20,0.9); border: 1px solid rgba(212,165,55,0.18); border-bottom: none; border-radius: 12px 12px 0 0; flex-wrap: wrap; gap: 8px; }
    .doc-embed-toolbar span { font-size: 0.82rem; color: var(--ink-muted); font-weight: 600; }
    .doc-embed-toolbar span strong { color: var(--gold-soft); }
    .doc-embed-toolbar-btns { display: flex; gap: 8px; flex-wrap: wrap; }
    .doc-embed-toolbar-btns a { display: inline-flex; align-items: center; gap: 5px; padding: 6px 13px; border-radius: 7px; font-size: 0.79rem; font-weight: 600; text-decoration: none; transition: all 0.2s; }
    .tb-download { background: rgba(212,165,55,0.12); border: 1px solid rgba(212,165,55,0.35); color: var(--gold-soft); }
    .tb-download:hover { background: rgba(212,165,55,0.22); color: #fff; }
    .tb-open { background: rgba(59,130,246,0.1); border: 1px solid rgba(59,130,246,0.3); color: var(--blue-soft); }
    .tb-open:hover { background: rgba(59,130,246,0.2); color: #fff; }
    .doc-embed-frame { width: 100%; height: 640px; display: block; border: 1px solid rgba(212,165,55,0.18); border-top: none; border-radius: 0 0 12px 12px; background: #fff; }
    @media (max-width: 600px) { .doc-embed-frame { height: 440px; } }

    /* KEY FINDING BOX */
    .finding-box { background: rgba(59,130,246,0.07); border: 1px solid rgba(59,130,246,0.28); border-left: 4px solid var(--blue); border-radius: 0 12px 12px 0; padding: 18px 22px; margin: 16px 0; }
    .finding-label { font-size: 0.72rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.12em; color: var(--blue-soft); margin-bottom: 8px; }
    .finding-box p { font-size: 0.9rem; color: rgba(254,243,199,0.82); line-height: 1.75; margin: 0; }
    .finding-box p strong { color: var(--blue-soft); }

    /* PROOF GRID */
    .proof-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }
    @media (max-width: 700px) { .proof-grid { grid-template-columns: 1fr; } }

    /* COMPARISON TABLE */
    .compare-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; margin: 24px 0; }
    @media (max-width: 600px) { .compare-grid { grid-template-columns: 1fr; } }
    .compare-col { border-radius: 14px; padding: 24px 22px; }
    .compare-col.old { background: rgba(212,165,55,0.07); border: 1px solid rgba(212,165,55,0.25); }
    .compare-col.new { background: rgba(239,68,68,0.07); border: 1px solid rgba(239,68,68,0.25); }
    .compare-col h4 { font-family: 'Crimson Text', serif; font-size: 1.2rem; font-weight: 600; margin-bottom: 14px; }
    .compare-col.old h4 { color: var(--gold-soft); }
    .compare-col.new h4 { color: var(--red-soft); }
