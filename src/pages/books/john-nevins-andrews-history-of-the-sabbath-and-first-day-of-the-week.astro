---
import Analytics from '../../components/Analytics.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import ShareBar from '../../components/ShareBar.astro';
import SiteNav from '../../components/SiteNav.astro';
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>History of the Sabbath and First Day of the Week — J.N. Andrews (1862) | Who Changed the Sabbath? | SundayLaw.com</title>
    <meta name="description" content="Who changed the Sabbath from Saturday to Sunday? J.N. Andrews' landmark 1862 work 'History of the Sabbath and First Day of the Week' traces the seventh-day Sabbath through every century — from creation to the papacy's Sunday law — with primary source documentation. Read the full PDF free.">
    <link rel="canonical" href="https://sundaylaw.com/books/john-nevins-andrews-history-of-the-sabbath-and-first-day-of-the-week">
    <meta property="og:title" content="History of the Sabbath and First Day of the Week — J.N. Andrews (1862) | Who Changed the Sabbath?">
    <meta property="og:description" content="The definitive historical answer to 'who changed the Sabbath from Saturday to Sunday?' — J.N. Andrews traces the seventh-day Sabbath through every century with primary source documentation. Read free.">
    <meta property="og:image" content="/pioneers/images/john-nevins-andrews.jpg">
    <meta property="og:type" content="article">
    <meta property="og:url" content="https://sundaylaw.com/books/john-nevins-andrews-history-of-the-sabbath-and-first-day-of-the-week">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="History of the Sabbath — J.N. Andrews (1862) | Who Changed the Sabbath?">
    <meta name="twitter:description" content="J.N. Andrews traces the seventh-day Sabbath from Creation to the papacy's Sunday change — with primary documentary proof. Read the full PDF free at SundayLaw.com.">
    <meta name="keywords" content="history of the sabbath, who changed the sabbath, sabbath to sunday change, first day of the week history, Constantine Sunday law 321 AD, Council of Laodicea sabbath, papacy changed sabbath, seventh day sabbath history, J.N. Andrews, Adventist sabbath history, seventh-day sabbath bible, fourth commandment history">
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Book",
      "name": "History of the Sabbath and First Day of the Week",
      "author": {
        "@type": "Person",
        "name": "John Nevins Andrews",
        "birthDate": "1829-07-22",
        "deathDate": "1883-10-21",
        "jobTitle": "Adventist Scholar and First Overseas Missionary",
        "url": "https://sundaylaw.com/pioneers/john-nevins-andrews"
      },
      "datePublished": "1862",
      "description": "The definitive historical work proving the seventh-day Sabbath was changed to Sunday by human ecclesiastical authority — not divine command. J.N. Andrews traces every century from Creation to 1862 with primary source documentation, answering the question 'who changed the Sabbath?' with irrefutable historical evidence.",
      "publisher": { "@type": "Organization", "name": "SundayLaw.com" },
      "url": "https://sundaylaw.com/books/john-nevins-andrews-history-of-the-sabbath-and-first-day-of-the-week",
      "inLanguage": "en",
      "genre": "Religious History"
    }
    </script>
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Who changed the Sabbath from Saturday to Sunday?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The Roman Catholic Church and the Roman Emperor Constantine changed the Sabbath from Saturday (the seventh day) to Sunday (the first day) by human authority — not divine command. Constantine issued the first civil Sunday law on March 7, 321 AD. The Council of Laodicea (~363 AD) formally condemned Sabbath observance. The Catholic Church openly claims credit for this change in its catechisms. J.N. Andrews documents this fully in 'History of the Sabbath and First Day of the Week' (1862)."
          }
        },
        {
          "@type": "Question",
          "name": "Is there a Bible verse that changed the Sabbath to Sunday?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. There is no Bible verse that changes the Sabbath from the seventh day (Saturday) to the first day (Sunday). The Fourth Commandment in Exodus 20:8-11 explicitly commands the seventh day. No New Testament text repeals or replaces it. The change was made by human ecclesiastical authority, as the Catholic Church itself has stated in its official catechisms."
          }
        },
        {
          "@type": "Question",
          "name": "What is the History of the Sabbath by J.N. Andrews?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "J.N. Andrews' 'History of the Sabbath and First Day of the Week' (1862) is the most comprehensive historical work tracing the seventh-day Sabbath from Creation through every century to the 19th century. Andrews draws on primary sources in Latin, Greek, and English to prove that the Sabbath was never changed by divine authority — only by human church councils and civil law."
          }
        }
      ]
    }
    </script>
    <Analytics />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Crimson+Text:ital,wght@0,400;0,600;1,400&display=swap" rel="stylesheet">
    <style>
      :root {
        --bg: #0a0a2e;
        --bg-soft: #0d0d3a;
        --ink: #fef3c7;
        --ink-muted: #9ca3af;
        --gold: #d4a537;
        --gold-soft: #fcd34d;
        --amber: #f59e0b;
        --purple: #8b5cf6;
        --purple-soft: #c4b5fd;
        --purple-light: #ddd6fe;
        --line: rgba(212,165,55,0.22);
        --line-soft: rgba(212,165,55,0.12);
        --line-purple: rgba(139,92,246,0.25);
      }
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
      html { scroll-behavior: smooth; }
      body { margin: 0; font-family: 'Inter', sans-serif; color: var(--ink); background: #0a0a2e; overflow-x: hidden; }
      a { color: var(--gold); text-decoration: none; transition: color 0.2s; }
      a:hover { color: var(--gold-soft); }

      /* ===== NAV ===== */
      .nav { position: sticky; top: 0; z-index: 100; background: rgba(5,5,30,0.94); backdrop-filter: blur(12px); border-bottom: 1px solid var(--line); }
      .nav-wrap { max-width: 1280px; margin: 0 auto; }
      .nav-row { display: flex; align-items: center; padding: 0 22px; }
      .nav-row-top { gap: 28px; height: 62px; border-bottom: 1px solid rgba(212,165,55,0.10); }
      .nav-row-bottom { gap: 22px; height: 42px; font-size: 0.82rem; overflow-x: auto; scrollbar-width: none; }
      .nav-brand { text-decoration: none; color: var(--ink); font-weight: 700; font-size: 1.05rem; flex-shrink: 0; display: flex; align-items: center; margin-right: auto; }
      .nav-brand img { height: 38px; width: auto; display: block; border-radius: 4px; }
      .nav-link { color: var(--ink-muted); text-decoration: none; font-weight: 600; font-size: 0.9rem; white-space: nowrap; transition: color 0.18s; }
      .nav-link:hover { color: var(--gold-soft); }
      .nav-cta { display: inline-flex; align-items: center; height: 38px; padding: 0 18px; border-radius: 8px; background: var(--gold); color: #111; font-weight: 700; font-size: 0.88rem; text-decoration: none; flex-shrink: 0; transition: background 0.18s; }
      .nav-cta:hover { background: var(--gold-soft); color: #111; }
      .nav-bottom-link { color: rgba(156,163,175,0.8); text-decoration: none; font-weight: 500; white-space: nowrap; transition: color 0.18s; flex-shrink: 0; }
      .nav-bottom-link:hover, .nav-bottom-link.active { color: var(--gold-soft); }
      .menu-btn { display: none; width: 40px; height: 40px; border: 1px solid var(--line); border-radius: 8px; background: rgba(255,255,255,0.03); color: var(--ink); font-size: 1.2rem; cursor: pointer; flex-shrink: 0; align-items: center; justify-content: center; }
      .mobile-nav { display: none; border-top: 1px solid var(--line); padding: 14px 22px 18px; background: rgba(5,5,30,0.97); }
      .mobile-nav.open { display: grid; gap: 6px; }
      .mobile-nav a { color: var(--ink-muted); text-decoration: none; font-weight: 600; padding: 8px 0; border-bottom: 1px solid rgba(255,255,255,0.05); }
      .mobile-nav a:hover { color: var(--gold-soft); }
      @media (max-width: 860px) { .nav-row-bottom { display: none; } .menu-btn { display: inline-flex; } .nav-link { display: none; } }

      /* ===== PAGE LAYOUT ===== */
      .page { max-width: 1100px; margin: 0 auto; padding: 0 22px 80px; }

      /* ===== HERO ===== */
      .hero { padding: 52px 0 40px; }
      .hero-breadcrumb { font-size: 0.8rem; color: var(--ink-muted); margin-bottom: 18px; }
      .hero-breadcrumb a { color: var(--ink-muted); }
      .hero-breadcrumb a:hover { color: var(--gold); }
      .hero-breadcrumb span { margin: 0 6px; }
      .hero-card { background: linear-gradient(135deg, rgba(20,10,50,0.95), rgba(10,5,35,0.98)); border: 1px solid rgba(139,92,246,0.3); border-radius: 24px; padding: 44px 40px; display: grid; grid-template-columns: 260px 1fr; gap: 48px; align-items: start; }
      @media (max-width: 768px) { .hero-card { grid-template-columns: 1fr; gap: 28px; padding: 28px 22px; } }

      /* Pioneer portrait col */
      .pioneer-col { display: flex; flex-direction: column; align-items: center; gap: 18px; }
      .pioneer-portrait { width: 200px; height: 200px; border-radius: 50%; object-fit: cover; object-position: top center; border: 3px solid var(--purple); box-shadow: 0 0 40px rgba(139,92,246,0.3); }
      .pioneer-name { font-family: 'Crimson Text', serif; font-size: 1.6rem; font-weight: 600; text-align: center; color: var(--ink); }
      .pioneer-dates { font-size: 0.82rem; color: var(--ink-muted); text-align: center; }
      .pioneer-role { font-size: 0.8rem; color: var(--purple-soft); text-align: center; font-weight: 600; text-transform: uppercase; letter-spacing: 0.08em; padding: 4px 12px; border: 1px solid rgba(139,92,246,0.3); border-radius: 999px; }
      .pioneer-bio-link { display: inline-flex; align-items: center; gap: 6px; padding: 10px 20px; border-radius: 10px; background: rgba(139,92,246,0.08); border: 1px solid rgba(139,92,246,0.28); color: var(--purple-soft); font-weight: 600; font-size: 0.85rem; text-decoration: none; transition: all 0.2s; white-space: nowrap; }
      .pioneer-bio-link:hover { background: rgba(139,92,246,0.18); color: #fff; }

      /* Book col */
      .book-col { }
      .eyebrow { display: inline-flex; align-items: center; gap: 6px; padding: 5px 14px; border-radius: 999px; background: rgba(139,92,246,0.10); border: 1px solid rgba(139,92,246,0.3); color: var(--purple-soft); font-size: 0.74rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 14px; }
      .book-col h1 { font-family: 'Crimson Text', serif; font-size: clamp(2rem, 4vw, 3rem); font-weight: 600; line-height: 1.1; color: var(--ink); margin-bottom: 8px; }
      .book-col h1 em { font-style: italic; color: var(--purple-soft); }
      .book-meta { display: flex; align-items: center; gap: 14px; margin-bottom: 18px; flex-wrap: wrap; }
      .book-meta-item { font-size: 0.82rem; color: var(--ink-muted); }
      .book-meta-item strong { color: var(--gold); margin-right: 4px; }
      .book-excerpt { font-size: 1rem; color: rgba(254,243,199,0.85); line-height: 1.85; margin-bottom: 22px; }

      /* Scripture pull */
      .pull-scripture { background: linear-gradient(135deg, rgba(20,10,50,0.8), rgba(10,5,30,0.9)); border: 1px solid rgba(139,92,246,0.25); border-left: 4px solid var(--purple); border-radius: 0 12px 12px 0; padding: 18px 20px; margin-bottom: 22px; }
      .pull-scripture .ref { font-size: 0.78rem; color: var(--purple-soft); font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 8px; }
      .pull-scripture blockquote { font-family: 'Crimson Text', serif; font-size: 1.25rem; font-style: italic; color: var(--purple-soft); line-height: 1.6; }
      .pull-scripture cite { display: block; margin-top: 8px; font-size: 0.8rem; color: rgba(196,181,253,0.6); font-style: normal; }

      /* Buttons */
      .btn-row { display: flex; gap: 12px; flex-wrap: wrap; }
      .btn-purple { display: inline-flex; align-items: center; gap: 8px; padding: 14px 24px; border-radius: 12px; background: linear-gradient(to right, #6d28d9, #8b5cf6); color: #fff; font-weight: 700; font-size: 0.95rem; text-decoration: none; transition: all 0.2s; }
      .btn-purple:hover { background: linear-gradient(to right, #7c3aed, #a78bfa); color: #fff; }
      .btn-gold { display: inline-flex; align-items: center; gap: 8px; padding: 14px 24px; border-radius: 12px; background: linear-gradient(to right, #b45309, #d97706); color: #fff; font-weight: 700; font-size: 0.95rem; text-decoration: none; transition: all 0.2s; }
      .btn-gold:hover { background: linear-gradient(to right, #d97706, #f59e0b); color: #fff; }
      .btn-outline { display: inline-flex; align-items: center; gap: 8px; padding: 14px 24px; border-radius: 12px; background: transparent; border: 1px solid var(--line); color: var(--ink-muted); font-weight: 600; font-size: 0.95rem; text-decoration: none; transition: all 0.2s; }
      .btn-outline:hover { border-color: var(--gold); color: var(--gold-soft); }

      /* ===== SECTIONS ===== */
      .section { padding: 48px 0; border-top: 1px solid var(--line-soft); }
      .section-header { text-align: center; margin-bottom: 32px; }
      .section-header .sh-eyebrow { display: inline-block; padding: 5px 16px; border-radius: 999px; border: 1px solid var(--line); color: var(--gold-soft); letter-spacing: 0.1em; text-transform: uppercase; font-size: 0.73rem; font-weight: 700; margin-bottom: 12px; }
      .section-header h2 { font-family: 'Crimson Text', serif; font-size: clamp(1.8rem, 3.5vw, 2.5rem); font-weight: 600; color: var(--ink); margin-bottom: 8px; }
      .section-header p { color: var(--ink-muted); font-size: 0.97rem; line-height: 1.8; max-width: 680px; margin: 0 auto; }

      /* ===== PDF EMBED ===== */
      .pdf-embed-wrap { background: rgba(10,10,46,0.5); border: 1px solid var(--line); border-radius: 16px; overflow: hidden; }
      .pdf-embed-toolbar { display: flex; align-items: center; justify-content: space-between; padding: 12px 18px; background: rgba(20,10,50,0.9); border-bottom: 1px solid rgba(139,92,246,0.2); flex-wrap: wrap; gap: 10px; }
      .pdf-embed-toolbar-title { font-size: 0.875rem; font-weight: 600; color: var(--ink-muted); }
      .pdf-embed-toolbar-title strong { color: var(--purple-soft); }
      .pdf-embed-toolbar a { display: inline-flex; align-items: center; gap: 6px; padding: 8px 16px; border-radius: 8px; background: rgba(139,92,246,0.10); border: 1px solid rgba(139,92,246,0.28); color: var(--purple-soft); font-size: 0.82rem; font-weight: 600; text-decoration: none; transition: all 0.2s; }
      .pdf-embed-toolbar a:hover { background: rgba(139,92,246,0.2); }
      .pdf-frame { width: 100%; height: 800px; display: block; border: none; background: #fff; }
      @media (max-width: 600px) { .pdf-frame { height: 500px; } }

      /* ===== BOOKS GRID ===== */
      .books-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 18px; }
      .book-card { background: linear-gradient(135deg, rgba(20,10,50,0.85), rgba(10,5,35,0.9)); border: 1px solid rgba(139,92,246,0.18); border-radius: 16px; padding: 24px 22px; transition: all 0.2s; display: flex; flex-direction: column; }
      .book-card:hover { border-color: rgba(139,92,246,0.45); transform: translateY(-2px); box-shadow: 0 8px 32px rgba(0,0,0,0.4); }
      .book-card.featured { border-color: rgba(139,92,246,0.45); background: linear-gradient(135deg, rgba(30,10,60,0.95), rgba(15,5,40,0.98)); }
      .book-card-badge { display: inline-flex; align-items: center; gap: 5px; padding: 4px 10px; border-radius: 999px; font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.07em; margin-bottom: 12px; width: fit-content; }
      .badge-featured { background: rgba(139,92,246,0.12); border: 1px solid rgba(139,92,246,0.4); color: var(--purple-soft); }
      .badge-prophecy { background: rgba(59,130,246,0.10); border: 1px solid rgba(59,130,246,0.3); color: #93c5fd; }
      .badge-sabbath { background: rgba(212,165,55,0.10); border: 1px solid rgba(212,165,55,0.3); color: var(--gold-soft); }
      .badge-history { background: rgba(139,92,246,0.10); border: 1px solid rgba(139,92,246,0.3); color: var(--purple-soft); }
      .badge-missionary { background: rgba(16,185,129,0.10); border: 1px solid rgba(16,185,129,0.3); color: #6ee7b7; }
      .book-card h3 { font-family: 'Crimson Text', serif; font-size: 1.25rem; font-weight: 600; color: var(--ink); margin-bottom: 6px; line-height: 1.3; }
      .book-card .book-year { font-size: 0.8rem; color: var(--purple); font-weight: 600; margin-bottom: 8px; }
      .book-card p { font-size: 0.875rem; color: var(--ink-muted); line-height: 1.7; flex: 1; margin-bottom: 16px; }
      .book-card-link { display: inline-flex; align-items: center; gap: 6px; padding: 10px 18px; border-radius: 9px; font-weight: 700; font-size: 0.85rem; text-decoration: none; transition: all 0.2s; }
      .link-purple { background: linear-gradient(to right, #6d28d9, #8b5cf6); color: #fff; }
      .link-purple:hover { background: linear-gradient(to right, #7c3aed, #a78bfa); color: #fff; }
      .link-gold { background: linear-gradient(to right, #b45309, #d97706); color: #fff; }
      .link-gold:hover { background: linear-gradient(to right, #d97706, #f59e0b); color: #fff; }
      .link-blue { background: rgba(59,130,246,0.12); border: 1px solid rgba(59,130,246,0.3); color: #93c5fd; }
      .link-blue:hover { background: rgba(59,130,246,0.2); color: #fff; }
      .link-green { background: rgba(16,185,129,0.12); border: 1px solid rgba(16,185,129,0.3); color: #6ee7b7; }
      .link-green:hover { background: rgba(16,185,129,0.2); color: #fff; }

      /* ===== BIO SECTION ===== */
      .bio-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 32px; align-items: start; }
      @media (max-width: 768px) { .bio-grid { grid-template-columns: 1fr; } }
      .bio-portrait { width: 100%; max-width: 340px; border-radius: 16px; object-fit: cover; display: block; border: 1px solid rgba(139,92,246,0.3); }
      .bio-caption { margin-top: 12px; font-size: 0.8rem; color: var(--ink-muted); text-align: center; font-style: italic; }
      .bio-facts { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin: 18px 0; }
      .bio-fact { background: rgba(20,10,50,0.7); border: 1px solid rgba(139,92,246,0.15); border-radius: 10px; padding: 12px 14px; }
      .bio-fact .fact-label { font-size: 0.72rem; color: var(--ink-muted); text-transform: uppercase; letter-spacing: 0.08em; font-weight: 600; margin-bottom: 4px; }
      .bio-fact .fact-value { font-size: 0.9rem; color: var(--purple-soft); font-weight: 600; }
      .bio-content h3 { font-family: 'Crimson Text', serif; font-size: 1.85rem; font-weight: 600; color: var(--ink); margin-bottom: 14px; }
      .bio-content p { font-size: 0.95rem; color: rgba(254,243,199,0.8); line-height: 1.9; margin-bottom: 14px; }
      .bio-content p strong { color: var(--gold-soft); }

      /* ===== TIMELINE ===== */
      .timeline-strip { display: flex; gap: 0; overflow: hidden; border-radius: 16px; border: 1px solid rgba(139,92,246,0.2); margin-top: 28px; }
      @media (max-width: 600px) { .timeline-strip { flex-direction: column; } }
      .tl-item { flex: 1; padding: 18px; background: rgba(20,10,50,0.7); border-right: 1px solid rgba(139,92,246,0.15); }
      .tl-item:last-child { border-right: none; }
      .tl-year { font-size: 1.35rem; font-weight: 800; color: var(--purple); display: block; margin-bottom: 4px; }
      .tl-title { font-size: 0.875rem; font-weight: 700; color: var(--ink); margin-bottom: 4px; }
      .tl-desc { font-size: 0.8rem; color: var(--ink-muted); line-height: 1.6; }

      /* ===== WHO CHANGED THE SABBATH — THE INDICTMENT ===== */
      .indictment-card { background: linear-gradient(135deg, rgba(30,5,30,0.7), rgba(10,5,35,0.95)); border: 1px solid rgba(139,92,246,0.28); border-radius: 20px; padding: 40px 36px; }
      @media (max-width: 600px) { .indictment-card { padding: 26px 18px; } }
      .indictment-card .ind-header { display: flex; align-items: center; gap: 14px; margin-bottom: 24px; }
      .ind-badge { width: 52px; height: 52px; border-radius: 50%; background: linear-gradient(135deg, #6d28d9, #8b5cf6); display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
      .indictment-card h3 { font-family: 'Crimson Text', serif; font-size: 1.75rem; font-weight: 600; color: var(--purple-soft); }
      .indictment-card .sub { font-size: 0.85rem; color: rgba(196,181,253,0.65); }
      .evidence-item { background: rgba(139,92,246,0.06); border: 1px solid rgba(139,92,246,0.18); border-radius: 12px; padding: 22px 24px; margin: 14px 0; }
      .evidence-item.red { background: rgba(239,68,68,0.06); border-color: rgba(239,68,68,0.2); }
      .evidence-label { font-size: 0.75rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 10px; }
      .evidence-label.purple { color: var(--purple-soft); }
      .evidence-label.red { color: #fca5a5; }
      .evidence-label.gold { color: var(--gold-soft); }
      .evidence-item blockquote { font-family: 'Crimson Text', serif; font-size: 1.2rem; font-style: italic; color: rgba(254,243,199,0.92); line-height: 1.7; }
      .evidence-item blockquote strong { color: var(--gold-soft); font-style: normal; }
      .evidence-item blockquote.red-quote { color: #fca5a5; }
      .evidence-item blockquote.red-quote strong { color: #fff; }
      .evidence-item cite { display: block; margin-top: 8px; font-size: 0.82rem; color: rgba(196,181,253,0.6); font-style: normal; font-weight: 600; }
      .evidence-item cite.red-cite { color: rgba(252,165,165,0.6); }
      .indictment-body { font-size: 0.97rem; color: rgba(254,243,199,0.8); line-height: 1.9; margin-top: 20px; }
      .indictment-body strong { color: var(--purple-soft); }
      .indictment-body em { color: var(--gold-soft); font-style: normal; font-weight: 600; }

      /* CENTURY TIMELINE */
