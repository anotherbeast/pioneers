---
import Analytics from '../../components/Analytics.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import ShareBar from '../../components/ShareBar.astro';
import SiteNav from '../../components/SiteNav.astro';
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>The Great Second Advent Movement — J. N. Loughborough | SundayLaw.com</title>
    <meta name="description" content="Eyewitness testimony of the Advent Movement—its divine origin, the Midnight Cry, the 1844 test, and the final call to the wedding. This is not theory—this is prophecy fulfilled.">
    <link rel="canonical" href="https://sundaylaw.com/books/the-great-second-advent-movement">
    <meta property="og:title" content="The Great Second Advent Movement — J. N. Loughborough">
    <meta property="og:description" content="Eyewitness testimony of the Advent Movement—its divine origin, the Midnight Cry, the 1844 test, and the final call to the wedding. This is not theory—this is prophecy fulfilled.">
    <meta property="og:image" content="/books/john-loughborough-rise-and-progress-of-seventh-day-adventists-1892/the-great-second-advent-movement-its-rise-and-progress.jpg">
    <meta property="og:type" content="article">
    <meta property="og:url" content="https://sundaylaw.com/books/the-great-second-advent-movement">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="The Great Second Advent Movement — J. N. Loughborough">
    <meta name="twitter:description" content="Eyewitness testimony of the Advent Movement—its divine origin, the Midnight Cry, the 1844 test, and the final call to the wedding. This is not theory—this is prophecy fulfilled.">
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Book",
      "name": "The Great Second Advent Movement: Its Rise and Progress",
      "author": {"@type": "Person", "name": "J. N. Loughborough"},
      "datePublished": "1905",
      "description": "Eyewitness testimony of the Advent Movement—its divine origin, the Midnight Cry, the 1844 test, and the final call to the wedding. This is not theory—this is prophecy fulfilled.",
      "publisher": { "@type": "Organization", "name": "SundayLaw.com" },
      "url": "https://sundaylaw.com/books/the-great-second-advent-movement",
      "inLanguage": "en"
    }
    </script>
    <Analytics />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Crimson+Text:ital,wght@0,400;0,600;1,400&display=swap" rel="stylesheet">
    <style>
      body { margin: 0; font-family: 'Inter', sans-serif; color: #fef3c7; background: #0a0a2e; overflow-x: hidden; }
      .page { max-width: 1100px; margin: 0 auto; padding: 0 22px 80px; }
      .hero { padding: 52px 0 40px; }
      .hero-breadcrumb { font-size: 0.8rem; color: #9ca3af; margin-bottom: 18px; }
      .hero-breadcrumb a { color: #9ca3af; }
      .hero-breadcrumb a:hover { color: #fcd34d; }
      .hero-breadcrumb span { margin: 0 6px; }
      .hero-card { background: linear-gradient(135deg, rgba(180,83,9,0.18), rgba(13,13,53,0.95)); border: 1px solid rgba(252,211,77,0.35); border-radius: 24px; padding: 44px 40px; display: grid; grid-template-columns: 260px 1fr; gap: 48px; align-items: start; }
      @media (max-width: 768px) { .hero-card { grid-template-columns: 1fr; gap: 28px; padding: 28px 22px; } }
      .pioneer-col { display: flex; flex-direction: column; align-items: center; gap: 18px; }
      .pioneer-portrait { width: 200px; height: 200px; border-radius: 16px; object-fit: cover; border: 3px solid #fcd34d; box-shadow: 0 0 40px rgba(252,211,77,0.18); }
      .pioneer-name { font-family: 'Crimson Text', serif; font-size: 1.25rem; font-weight: 600; text-align: center; color: #fef3c7; }
      .pioneer-dates { font-size: 0.82rem; color: #fcd34d; text-align: center; }
      .pioneer-role { font-size: 0.8rem; color: #fcd34d; text-align: center; font-weight: 600; text-transform: uppercase; letter-spacing: 0.08em; padding: 4px 12px; border: 1px solid rgba(252,211,77,0.3); border-radius: 999px; }
      .book-col h1 { font-family: 'Crimson Text', serif; font-size: clamp(2rem, 4vw, 3rem); font-weight: 600; line-height: 1.1; color: #fef3c7; margin-bottom: 8px; }
      .book-col h1 em { font-style: italic; color: #fcd34d; }
      .book-meta { display: flex; align-items: center; gap: 14px; margin-bottom: 18px; flex-wrap: wrap; }
      .book-meta-item { font-size: 0.82rem; color: #fcd34d; display: flex; align-items: center; gap-5: 5px; }
      .book-meta-item strong { color: #fcd34d; margin-right: 4px; }
      .book-excerpt { font-size: 1.08rem; color: #fcd34d; line-height: 1.85; margin-bottom: 22px; font-weight: 600; }
      .pull-scripture { background: linear-gradient(135deg, rgba(30,5,5,0.7), rgba(10,5,20,0.8)); border: 1px solid rgba(239,68,68,0.25); border-left: 4px solid #ef4444; border-radius: 0 12px 12px 0; padding: 18px 20px; margin-bottom: 22px; }
      .pull-scripture .ref { font-size: 0.78rem; color: #fca5a5; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 8px; }
      .pull-scripture blockquote { font-family: 'Crimson Text', serif; font-size: 1.25rem; font-style: italic; color: #fca5a5; line-height: 1.6; }
      .pull-scripture cite { display: block; margin-top: 8px; font-size: 0.8rem; color: rgba(252,165,165,0.7); font-style: normal; }
      .btn-row { display: flex; gap: 12px; flex-wrap: wrap; }
      .btn-gold { display: inline-flex; align-items: center; gap: 8px; padding: 14px 24px; border-radius: 12px; background: linear-gradient(to right, #b45309, #d97706); color: #fff; font-weight: 700; font-size: 0.95rem; text-decoration: none; transition: all 0.2s; }
      .btn-gold:hover { background: linear-gradient(to right, #d97706, #f59e0b); color: #fff; }
      .btn-outline { display: inline-flex; align-items: center; gap: 8px; padding: 14px 24px; border-radius: 12px; background: transparent; border: 1px solid #fcd34d; color: #fcd34d; font-weight: 600; font-size: 0.95rem; text-decoration: none; transition: all 0.2s; }
      .btn-outline:hover { border-color: #fff; color: #fff; }
      .pdf-embed-wrap { background: rgba(10,10,46,0.5); border: 1px solid #fcd34d; border-radius: 16px; overflow: hidden; }
      .pdf-embed-toolbar { display: flex; align-items: center; justify-content: space-between; padding: 12px 18px; background: rgba(13,13,53,0.8); border-bottom: 1px solid #fcd34d; flex-wrap: wrap; gap: 10px; }
      .pdf-embed-toolbar-title { font-size: 0.875rem; font-weight: 600; color: #fcd34d; }
      .pdf-embed-toolbar-title strong { color: #fff; }
      .pdf-embed-toolbar a { display: inline-flex; align-items: center; gap: 6px; padding: 8px 16px; border-radius: 8px; background: rgba(252,211,77,0.12); border: 1px solid rgba(252,211,77,0.3); color: #fcd34d; font-size: 0.82rem; font-weight: 600; text-decoration: none; transition: all 0.2s; }
      .pdf-embed-toolbar a:hover { background: rgba(252,211,77,0.2); color: #fff; }
      .pdf-frame { width: 100%; height: 800px; display: block; border: none; background: #fff; }
      @media (max-width: 600px) { .pdf-frame { height: 500px; } }
    </style>
  </head>
  <body>
    <SiteNav />
    <div class="page">
      <div class="hero">
        <div class="hero-breadcrumb">
          <a href="/">Home</a><span>›</span>
          <a href="/pioneer-books">Pioneer Library</a><span>›</span>
          <span style="color:#fef3c7;">The Great Second Advent Movement</span>
        </div>
        <div class="hero-card">
          <!-- Book Cover Column -->
          <div class="pioneer-col">
            <img
              src="/books/john-loughborough-rise-and-progress-of-seventh-day-adventists-1892/the-great-second-advent-movement-its-rise-and-progress.jpg"
              alt="The Great Second Advent Movement — J. N. Loughborough"
              class="pioneer-portrait"
              loading="lazy"
            />
            <div class="pioneer-name">J. N. Loughborough</div>
            <div class="pioneer-dates">1905</div>
            <div class="pioneer-role">Eyewitness of the Advent Movement</div>
          </div>
          <!-- Book Details Column -->
          <div class="book-col">
            <div class="book-meta">
              <span class="book-meta-item"><strong>Year:</strong> 1905</span>
              <span class="book-meta-item"><strong>Author:</strong> J. N. Loughborough</span>
              <span class="book-meta-item"><strong>Format:</strong> Testimony / PDF</span>
            </div>
            <h1>The Great Second Advent Movement<br><em>Its Rise and Progress</em></h1>
            <p class="book-excerpt">
              <strong>⚡ THIS IS NOT THEORY — THIS IS TESTIMONY</strong><br>
              This book is not speculation. It is not revisionist history.<br>
              It is the eyewitness account of the Advent Movement—written by a man who lived it, preached it, and saw it unfold.<br>
              “I have presented a statement concerning the advent movement… showing its divine origin.”
            </p>
            <div class="pull-scripture">
              <div class="ref">2 Peter 1:19</div>
              <blockquote>&ldquo;Prophecy is a light shining in a dark place… showing the pathway clearly.&rdquo;</blockquote>
              <cite>&mdash; The Great Second Advent Movement</cite>
            </div>
            <div class="btn-row">
              <a href="/books/john-loughborough-rise-and-progress-of-seventh-day-adventists-1892/john_loughborough_rise_and_progress-of-seventh-day-adventists-1892.pdf" target="_blank" rel="noopener noreferrer" class="btn-gold">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
                Read Full PDF
              </a>
              <a href="#read-online" class="btn-outline">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M9 9h6M9 12h6M9 15h4"/></svg>
                Read In Browser
              </a>
              <a href="/pioneer-books" class="btn-outline">Back to Pioneer Library</a>
            </div>
                      {/* ShareBar moved below PDF embed */}
          </div>
        </div>
      </div>
      <!-- ===== PDF EMBED ===== -->
      <div class="section" id="read-online">
        <div class="pdf-embed-wrap">
          <div class="pdf-embed-toolbar">
            <span class="pdf-embed-toolbar-title">
              <strong>The Great Second Advent Movement</strong> (1905)
            </span>
            <div style="display:flex;gap:10px;flex-wrap:wrap;">
              <a href="/books/john-loughborough-rise-and-progress-of-seventh-day-adventists-1892/john_loughborough_rise_and_progress-of-seventh-day-adventists-1892.pdf" target="_blank" rel="noopener noreferrer">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                Download PDF
              </a>
              <a href="/books/john-loughborough-rise-and-progress-of-seventh-day-adventists-1892/john_loughborough_rise_and_progress-of-seventh-day-adventists-1892.pdf" target="_blank" rel="noopener noreferrer">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2 2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
                Open Full Screen
              </a>
            </div>
          </div>
          <object
            data="/books/john-loughborough-rise-and-progress-of-seventh-day-adventists-1892/john_loughborough_rise_and_progress-of-seventh-day-adventists-1892.pdf"
            type="application/pdf"
            class="pdf-frame"
            aria-label="The Great Second Advent Movement PDF"
          >
            <div style="padding:48px;text-align:center;color:#fcd34d;background:rgba(13,13,53,0.8);">
              <p style="margin-bottom:16px;font-size:1rem;">Your browser cannot display PDFs inline.</p>
              <a href="/books/john-loughborough-rise-and-progress-of-seventh-day-adventists-1892/john_loughborough_rise_and_progress-of-seventh-day-adventists-1892.pdf" target="_blank" rel="noopener noreferrer" class="btn-gold" style="display:inline-flex;">
                Download &amp; Read the PDF
              </a>
            </div>
          </object>
        </div>
      </div>
      <!-- ===== HIGHLIGHTS ===== -->
      <div class="section">
        <div class="book-meta" style="margin-bottom:18px;">
          <span class="book-meta-item"><strong>Why This Book Matters:</strong></span>
        </div>
        <ul style="margin-bottom:18px;font-size:1.05rem;color:#fcd34d;">
          <li>The real rise of the Advent Movement</li>
          <li>The Midnight Cry that shook the world</li>
          <li>The 1844 disappointment—explained, not denied</li>
          <li>The prophetic timeline from Eden to the end</li>
          <li>The separation between true believers and scoffers</li>
          <li>The hand of God moving through history</li>
        </ul>
        <div style="font-size:1.05rem;color:#fcd34d;font-weight:600;margin-bottom:18px;">This is not just history—this is evidence: that God led a people, that prophecy was fulfilled, that the message still stands.</div>
        <div style="margin-top:32px;font-size:0.92rem;color:#fef3c7;opacity:0.85;">Oakland, Cal.: Pacific Press, 1905. J. N. Loughborough.</div>
      </div>

      <!-- ===== SHARE BUTTONS BELOW PDF ===== -->
      <div style="margin: 36px 0 0 0; text-align: center;">
        <ShareBar pdfUrl="/books/john-loughborough-rise-and-progress-of-seventh-day-adventists-1892/john_loughborough_rise_and_progress-of-seventh-day-adventists-1892.pdf" />
      </div>
    </div>
    <SiteFooter />
  </body>
</html>
