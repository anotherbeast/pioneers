    <Analytics />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Crimson+Text:ital,wght@0,400;0,600;1,400&display=swap" rel="stylesheet">
    <style>
      :root {
        --bg:       #06080f;
        --bg-soft:  #0a0d1c;
        --bg-card:  #0d1022;
        --ink:      #f4f0de;
        --ink-muted:#c6bc97;
        --gold:     #d4a537;
        --gold-soft:#f0cf7b;
        --amber:    #f59e0b;
        --teal:     #14b8a6;
        --teal-soft:#5eead4;
        --crimson:  #dc2626;
        --line:     rgba(212,165,55,0.22);
        --line-soft:rgba(212,165,55,0.10);
      }
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
      html { scroll-behavior: smooth; }
      body { font-family: 'Inter', sans-serif; color: var(--ink); background: var(--bg); overflow-x: hidden; }
      a { color: var(--gold); text-decoration: none; transition: color 0.2s; }
      a:hover { color: var(--gold-soft); }

      /* ── Page container ── */
      .page { max-width: 1140px; margin: 0 auto; padding: 0 22px 80px; }

      /* ── Breadcrumb ── */
      .breadcrumb { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; font-size: 0.8rem; color: var(--ink-muted); padding: 20px 0 28px; }
      .breadcrumb a { color: var(--ink-muted); }
      .breadcrumb a:hover { color: var(--gold); }
      .breadcrumb span { color: rgba(198,188,151,0.4); }

      /* ── Hero card ── */
      .hero-card {
        display: grid;
        grid-template-columns: 200px 1fr;
        gap: 40px;
        background: linear-gradient(135deg, rgba(10,14,30,0.97), rgba(6,8,18,0.99));
        border: 1px solid rgba(212,165,55,0.28);
        border-radius: 20px;
        padding: 44px 42px;
        align-items: start;
        margin-bottom: 6px;
      }
      @media (max-width: 700px) { .hero-card { grid-template-columns: 1fr; padding: 28px 22px; gap: 28px; } }

      .pioneer-col { display: flex; flex-direction: column; align-items: center; gap: 12px; text-align: center; }
      .pioneer-portrait { width: 160px; height: 160px; border-radius: 50%; object-fit: cover; object-position: top center; border: 3px solid var(--gold); box-shadow: 0 0 32px rgba(212,165,55,0.25); }
      .pioneer-name { font-family: 'Crimson Text', serif; font-size: 1.15rem; font-weight: 600; color: var(--ink); }
      .pioneer-dates { font-size: 0.8rem; color: var(--ink-muted); }
      .pioneer-role { font-size: 0.72rem; font-weight: 600; letter-spacing: 0.13em; text-transform: uppercase; color: var(--gold); background: rgba(212,165,55,0.1); border: 1px solid rgba(212,165,55,0.25); border-radius: 20px; padding: 5px 12px; }
      .pioneer-bio-link { display: inline-flex; align-items: center; gap: 6px; margin-top: 4px; font-size: 0.82rem; color: var(--teal); border: 1px solid rgba(20,184,166,0.3); border-radius: 8px; padding: 7px 14px; transition: all 0.2s; }
      .pioneer-bio-link:hover { background: rgba(20,184,166,0.1); color: var(--teal-soft); border-color: rgba(20,184,166,0.55); }

      .book-col { display: flex; flex-direction: column; gap: 18px; }

      .eyebrow { display: inline-flex; align-items: center; gap: 8px; font-size: 0.72rem; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; color: var(--crimson); background: rgba(220,38,38,0.08); border: 1px solid rgba(220,38,38,0.22); border-radius: 20px; padding: 5px 14px; width: fit-content; }

      h1 { font-family: 'Crimson Text', serif; font-size: clamp(1.9rem, 4.5vw, 2.9rem); line-height: 1.15; font-weight: 600; color: var(--ink); }
      h1 em { color: var(--gold); font-style: italic; }

      .book-meta { display: flex; flex-wrap: wrap; gap: 14px; font-size: 0.85rem; }
      .book-meta-item strong { color: var(--gold); }

      .book-excerpt { font-family: 'Crimson Text', serif; font-size: 1.12rem; line-height: 1.72; color: #e6dcc0; }
      .book-excerpt strong { color: var(--gold-soft); font-weight: 600; }

      /* ── Version buttons ── */
      .btn-row { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 4px; }
      .btn-teal { display: inline-flex; align-items: center; gap: 8px; height: 40px; padding: 0 20px; border-radius: 9px; background: var(--teal); color: #06080f; font-weight: 700; font-size: 0.88rem; text-decoration: none; flex-shrink: 0; transition: background 0.18s; }
      .btn-teal:hover { background: var(--teal-soft); color: #06080f; }
      .btn-gold { display: inline-flex; align-items: center; gap: 8px; height: 40px; padding: 0 20px; border-radius: 9px; background: var(--gold); color: #06080f; font-weight: 700; font-size: 0.88rem; text-decoration: none; flex-shrink: 0; transition: background 0.18s; }
      .btn-gold:hover { background: var(--gold-soft); color: #06080f; }
      .btn-outline { display: inline-flex; align-items: center; gap: 8px; height: 40px; padding: 0 18px; border-radius: 9px; border: 1px solid var(--line); color: var(--ink-muted); font-weight: 600; font-size: 0.86rem; text-decoration: none; flex-shrink: 0; transition: all 0.18s; }
      .btn-outline:hover { border-color: var(--gold); color: var(--gold); }

      /* ── Sections ── */
      .section { margin-top: 56px; }
      .section-header { margin-bottom: 28px; }
      .section-header h2 { font-family: 'Crimson Text', serif; font-size: clamp(1.5rem, 3vw, 2.2rem); font-weight: 600; color: var(--ink); line-height: 1.25; }
      .sh-eyebrow { font-size: 0.72rem; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; color: var(--gold); margin-bottom: 8px; }
      .section-header p { color: var(--ink-muted); font-size: 1rem; line-height: 1.65; margin-top: 10px; max-width: 760px; }
      .section-divider { height: 1px; background: var(--line-soft); margin: 52px 0 0; }

      /* ── Quote blocks ── */
      .egw-quote-block {
        background: linear-gradient(135deg, rgba(10,14,30,0.95), rgba(8,12,26,0.98));
        border-left: 4px solid var(--gold);
        border-radius: 0 12px 12px 0;
        padding: 26px 30px 22px;
        margin: 28px 0;
      }
      .egw-quote-block blockquote {
        font-family: 'Crimson Text', serif;
        font-size: 1.2rem;
        font-style: italic;
        line-height: 1.7;
        color: #f0e8cc;
      }
      .egw-quote-block .q-source {
        margin-top: 12px;
        font-size: 0.8rem;
        font-weight: 600;
        letter-spacing: 0.08em;
        color: var(--gold);
        text-transform: uppercase;
      }
      .egw-quote-block .q-label {
        font-size: 0.72rem;
        color: var(--ink-muted);
        margin-bottom: 8px;
        font-weight: 600;
        letter-spacing: 0.12em;
        text-transform: uppercase;
      }

      /* ── Crimson warning block ── */
      .warning-block {
        background: rgba(220,38,38,0.07);
        border: 1px solid rgba(220,38,38,0.22);
        border-radius: 14px;
        padding: 28px 30px;
        margin: 28px 0;
      }
      .warning-block h3 { font-family: 'Crimson Text', serif; font-size: 1.35rem; color: #fca5a5; margin-bottom: 12px; }
      .warning-block p { color: #e0b8b8; font-size: 0.95rem; line-height: 1.65; }

      /* ── Scripture pull ── */
      .scripture-pull {
        background: rgba(212,165,55,0.06);
        border: 1px solid rgba(212,165,55,0.2);
        border-radius: 14px;
        padding: 26px 30px;
        margin: 28px 0;
      }
      .scripture-pull .ref { font-size: 0.73rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--gold); margin-bottom: 10px; }
      .scripture-pull blockquote { font-family: 'Crimson Text', serif; font-size: 1.18rem; font-style: italic; line-height: 1.65; color: #f0e8cc; }
      .scripture-pull cite { display: block; margin-top: 10px; font-size: 0.82rem; color: var(--ink-muted); font-style: normal; }

      /* ── Versions grid ── */
      .versions-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 22px; margin-top: 24px; }
      .version-card {
        background: var(--bg-card);
        border: 1px solid var(--line);
        border-radius: 14px;
        padding: 26px 24px 22px;
        display: flex;
        flex-direction: column;
        gap: 12px;
        transition: border-color 0.2s, box-shadow 0.2s;
      }
      .version-card:hover { border-color: rgba(212,165,55,0.5); box-shadow: 0 6px 32px rgba(0,0,0,0.4); }
      .version-year { font-size: 0.72rem; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: var(--teal); }
      .version-title { font-family: 'Crimson Text', serif; font-size: 1.22rem; font-weight: 600; color: var(--ink); line-height: 1.3; }
      .version-desc { font-size: 0.88rem; color: var(--ink-muted); line-height: 1.6; flex: 1; }
      .version-btns { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 6px; }

      /* ── Chart section ── */
      .chart-section {
        background: linear-gradient(135deg, rgba(6,8,18,0.98), rgba(10,14,28,0.97));
        border: 1px solid rgba(212,165,55,0.3);
        border-radius: 18px;
        padding: 36px 36px 32px;
        margin-top: 28px;
      }
      .chart-row { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 20px; }

      .chart-img-wrap { margin-top: 22px; border-radius: 12px; overflow: hidden; border: 1px solid rgba(212,165,55,0.25); }
      .chart-img-wrap img { width: 100%; display: block; }

      /* ── Facts grid ── */
      .facts-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 16px; margin-top: 24px; }
      .fact-card { background: var(--bg-card); border: 1px solid var(--line-soft); border-radius: 12px; padding: 20px 18px; }
      .fact-icon { font-size: 1.4rem; margin-bottom: 8px; }
      .fact-label { font-size: 0.72rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--gold); margin-bottom: 6px; }
      .fact-text { font-size: 0.88rem; color: var(--ink-muted); line-height: 1.55; }

      /* ── Key chapters ── */
      .chapters-list { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 10px; margin-top: 18px; }
      .chapter-item { display: flex; align-items: flex-start; gap: 10px; padding: 12px 14px; background: rgba(255,255,255,0.025); border: 1px solid rgba(255,255,255,0.06); border-radius: 9px; font-size: 0.87rem; color: var(--ink-muted); }
      .chapter-item::before { content: "›"; color: var(--gold); font-size: 1.1rem; line-height: 1.3; flex-shrink: 0; }

      /* ── PDF Embed ── */
      .pdf-toolbar { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px; background: rgba(10,14,28,0.95); border: 1px solid var(--line); border-bottom: none; border-radius: 12px 12px 0 0; padding: 12px 18px; font-size: 0.84rem; }
      .pdf-toolbar a { color: var(--teal); display: inline-flex; align-items: center; gap: 6px; }
      .pdf-toolbar a:hover { color: var(--teal-soft); }
      .pdf-embed-wrap object, .pdf-embed-wrap iframe { width: 100%; height: 800px; border: 1px solid var(--line); border-radius: 0 0 12px 12px; display: block; background: #fff; }
      @media (max-width: 640px) { .pdf-embed-wrap object, .pdf-embed-wrap iframe { height: 500px; } }

      /* ── Alert banner ── */
      .suppression-banner {
        background: linear-gradient(90deg, rgba(180,30,30,0.12), rgba(212,165,55,0.06));
        border: 1px solid rgba(220,38,38,0.3);
        border-left: 4px solid var(--crimson);
        border-radius: 0 12px 12px 0;
        padding: 18px 24px;
        margin: 24px 0;
        font-size: 0.9rem;
        color: #e8c8c8;
        line-height: 1.6;
      }
      .suppression-banner strong { color: #fca5a5; }
    </style>
  </head>
  <body>
    <SiteNav />

    <div class="page">

      <!-- BREADCRUMB -->
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a><span>›</span>
