---
import Analytics from '../../components/Analytics.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import ShareBar from '../../components/ShareBar.astro';
import SiteNav from '../../components/SiteNav.astro';
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Captain Joseph Bates — The Autobiography (1868) | Free PDF | SundayLaw.com</title>
    <meta name="description" content="Read the complete Autobiography of Elder Joseph Bates (1868) — from merchant sea captain and abolitionist to co-founder of the original Seventh-day Adventist platform of truth. The greatest conversion narrative in Adventist history. Free PDF download.">
    <link rel="canonical" href="https://sundaylaw.com/books/captain-joseph-bates-autobiography-1868">
    <!-- Open Graph -->
    <meta property="og:title" content="Captain Joseph Bates — The Autobiography (1868)">
    <meta property="og:description" content="From sea cabin boy at 15 to reformed sea captain, abolitionist, and the man who converted James and Ellen White to the Seventh-day Sabbath. Captain Bates' extraordinary life story in his own words. Free PDF.">
    <meta property="og:image" content="https://sundaylaw.com/images/books-written-by-the-144000/joseph-bates-autobiography-1868-adventist-pioneer-book-poster.jpg">
    <meta property="og:image:type" content="image/png">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:type" content="book">
    <meta property="og:url" content="https://sundaylaw.com/books/captain-joseph-bates-autobiography-1868">
    <meta property="og:site_name" content="SundayLaw.com">
    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="Captain Joseph Bates — The Autobiography (1868) | Free PDF">
    <meta name="twitter:description" content="From sea cabin boy to Sabbath champion — Captain Bates' life story in his own words. Free PDF.">
    <meta name="twitter:image" content="https://sundaylaw.com/images/books-written-by-the-144000/joseph-bates-autobiography-1868-adventist-pioneer-book-poster.jpg">
    <!-- JSON-LD: Book + BreadcrumbList -->
    <script type="application/ld+json">
    [
      {
        "@context": "https://schema.org",
        "@type": "Book",
        "name": "The Autobiography of Elder Joseph Bates",
        "alternateName": "Autobiography of Elder Joseph Bates (1868)",
        "author": {
          "@type": "Person",
          "name": "Joseph Bates",
          "givenName": "Joseph",
          "familyName": "Bates",
          "birthDate": "1792-07-08",
          "deathDate": "1872-03-19",
          "jobTitle": "Sea Captain, Adventist Pioneer, Co-founder",
          "sameAs": "https://en.wikipedia.org/wiki/Joseph_Bates_(Adventist)"
        },
        "datePublished": "1868",
        "inLanguage": "en",
        "genre": "Autobiography / Religious History",
        "description": "Captain Joseph Bates narrates his extraordinary life journey: from cabin boy at sea to master mariner, from War of 1812 captive to abolitionist reformer, from temperance crusader to the man who published the Seventh-day Sabbath tracts that converted James and Ellen White and launched the Adventist Sabbath reformation.",
        "publisher": {
          "@type": "Organization",
          "name": "Steam Press of the Review and Herald"
        },
        "url": "https://sundaylaw.com/books/captain-joseph-bates-autobiography-1868",
        "image": "https://sundaylaw.com/images/books-written-by-the-144000/joseph-bates-autobiography-1868-adventist-pioneer-book-poster.jpg",
        "sameAs": "https://archive.org/details/theearlyexperien00bate",
        "isAccessibleForFree": true,
        "license": "https://creativecommons.org/licenses/publicdomain/"
      },
      {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://sundaylaw.com/" },
          { "@type": "ListItem", "position": 2, "name": "Pioneer Library", "item": "https://sundaylaw.com/library" },
          { "@type": "ListItem", "position": 3, "name": "Captain Joseph Bates", "item": "https://sundaylaw.com/pioneers/captain-joseph-bates" },
          { "@type": "ListItem", "position": 4, "name": "The Autobiography (1868)", "item": "https://sundaylaw.com/books/captain-joseph-bates-autobiography-1868" }
        ]
      }
    ]
    </script>
    <Analytics />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Crimson+Text:ital,wght@0,400;0,600;1,400&display=swap" rel="stylesheet">
    <style>
      :root {
        --bg: #0a0a2e;
        --bg-soft: #0d0d3a;
        --ink: #fef3c7;
        --ink-muted: #9ca3af;
        --gold: #d4a537;
        --gold-soft: #fcd34d;
        --amber: #f59e0b;
        --teal: #14b8a6;
        --teal-soft: #5eead4;
        --red: #ef4444;
        --line: rgba(212,165,55,0.22);
        --line-soft: rgba(212,165,55,0.12);
      }
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
      html { scroll-behavior: smooth; }
      body { margin: 0; font-family: 'Inter', sans-serif; color: var(--ink); background: #0a0a2e; overflow-x: hidden; }
      a { color: var(--gold); text-decoration: none; transition: color 0.2s; }
      a:hover { color: var(--gold-soft); }

      /* ===== NAV ===== */
      .nav { position: sticky; top: 0; z-index: 100; background: rgba(5,5,30,0.94); backdrop-filter: blur(12px); border-bottom: 1px solid var(--line); }
      .nav-wrap { max-width: 1280px; margin: 0 auto; }
      .nav-row { display: flex; align-items: center; padding: 0 22px; }
      .nav-row-top { gap: 28px; height: 62px; border-bottom: 1px solid rgba(212,165,55,0.10); }
      .nav-row-bottom { gap: 22px; height: 42px; font-size: 0.82rem; overflow-x: auto; scrollbar-width: none; }
      .nav-brand { text-decoration: none; color: var(--ink); font-weight: 700; font-size: 1.05rem; flex-shrink: 0; display: flex; align-items: center; margin-right: auto; }
      .nav-brand img { height: 38px; width: auto; display: block; border-radius: 4px; }
      .nav-link { color: var(--ink-muted); text-decoration: none; font-weight: 600; font-size: 0.9rem; white-space: nowrap; transition: color 0.18s; }
      .nav-link:hover { color: var(--gold-soft); }
      .nav-cta { display: inline-flex; align-items: center; height: 38px; padding: 0 18px; border-radius: 8px; background: var(--gold); color: #111; font-weight: 700; font-size: 0.88rem; text-decoration: none; flex-shrink: 0; transition: background 0.18s; }
      .nav-cta:hover { background: var(--gold-soft); color: #111; }
      .nav-bottom-link { color: rgba(156,163,175,0.8); text-decoration: none; font-weight: 500; white-space: nowrap; transition: color 0.18s; flex-shrink: 0; }
      .nav-bottom-link:hover, .nav-bottom-link.active { color: var(--gold-soft); }
      .menu-btn { display: none; width: 40px; height: 40px; border: 1px solid var(--line); border-radius: 8px; background: rgba(255,255,255,0.03); color: var(--ink); font-size: 1.2rem; cursor: pointer; flex-shrink: 0; align-items: center; justify-content: center; }
      .mobile-nav { display: none; border-top: 1px solid var(--line); padding: 14px 22px 18px; background: rgba(5,5,30,0.97); }
      .mobile-nav.open { display: grid; gap: 6px; }
      .mobile-nav a { color: var(--ink-muted); text-decoration: none; font-weight: 600; padding: 8px 0; border-bottom: 1px solid rgba(255,255,255,0.05); }
      .mobile-nav a:hover { color: var(--gold-soft); }
      @media (max-width: 860px) { .nav-row-bottom { display: none; } .menu-btn { display: inline-flex; } .nav-link { display: none; } }

      /* ===== PAGE LAYOUT ===== */
      .page { max-width: 1100px; margin: 0 auto; padding: 0 22px 80px; }

      /* ===== HERO ===== */
      .hero { padding: 52px 0 40px; }
      .hero-breadcrumb { font-size: 0.8rem; color: var(--ink-muted); margin-bottom: 18px; }
      .hero-breadcrumb a { color: var(--ink-muted); }
      .hero-breadcrumb a:hover { color: var(--gold); }
      .hero-breadcrumb span { margin: 0 6px; }

      /* 2-col hero: portrait | text */
      .hero-card {
        background: linear-gradient(135deg, rgba(7,26,38,0.95), rgba(5,15,30,0.98));
        border: 1px solid rgba(20,184,166,0.3);
        border-radius: 24px;
        padding: 44px 40px;
        display: grid;
        grid-template-columns: 220px 1fr;
        gap: 40px;
        align-items: start;
      }
      @media (max-width: 640px) { .hero-card { grid-template-columns: 1fr; gap: 24px; padding: 28px 22px; } }

      /* Pioneer portrait col */
      .pioneer-col { display: flex; flex-direction: column; align-items: center; gap: 16px; }
      .pioneer-portrait { width: 180px; height: 180px; border-radius: 50%; object-fit: cover; object-position: top center; border: 3px solid var(--teal); box-shadow: 0 0 40px rgba(20,184,166,0.3); }
      .pioneer-name { font-family: 'Crimson Text', serif; font-size: 1.45rem; font-weight: 600; text-align: center; color: var(--ink); }
      .pioneer-dates { font-size: 0.82rem; color: var(--ink-muted); text-align: center; }
      .pioneer-role { font-size: 0.78rem; color: var(--teal-soft); text-align: center; font-weight: 600; text-transform: uppercase; letter-spacing: 0.08em; padding: 4px 12px; border: 1px solid rgba(20,184,166,0.3); border-radius: 999px; }
      .pioneer-bio-link { display: inline-flex; align-items: center; gap: 6px; padding: 9px 18px; border-radius: 10px; background: rgba(20,184,166,0.08); border: 1px solid rgba(20,184,166,0.28); color: var(--teal-soft); font-weight: 600; font-size: 0.82rem; text-decoration: none; transition: all 0.2s; white-space: nowrap; }
      .pioneer-bio-link:hover { background: rgba(20,184,166,0.18); color: #fff; }

      /* Book text col */
      .book-col { }
      .eyebrow { display: inline-flex; align-items: center; gap: 6px; padding: 5px 14px; border-radius: 999px; background: rgba(20,184,166,0.10); border: 1px solid rgba(20,184,166,0.3); color: var(--teal-soft); font-size: 0.74rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 14px; }
      .book-col h1 { font-family: 'Crimson Text', serif; font-size: clamp(1.9rem, 3.5vw, 2.7rem); font-weight: 600; line-height: 1.12; color: var(--ink); margin-bottom: 8px; }
      .book-col h1 em { font-style: italic; color: var(--teal-soft); }
      .book-meta { display: flex; align-items: center; gap: 14px; margin-bottom: 18px; flex-wrap: wrap; }
      .book-meta-item { font-size: 0.82rem; color: var(--ink-muted); }
      .book-meta-item strong { color: var(--gold); margin-right: 4px; }
      .book-excerpt { font-size: 0.97rem; color: rgba(254,243,199,0.85); line-height: 1.85; margin-bottom: 22px; }

      /* Testimony / pull-scripture */
      .pull-scripture { background: linear-gradient(135deg, rgba(5,25,35,0.8), rgba(5,15,30,0.9)); border: 1px solid rgba(20,184,166,0.25); border-left: 4px solid var(--teal); border-radius: 0 12px 12px 0; padding: 18px 20px; margin-bottom: 22px; }
      .pull-scripture .ref { font-size: 0.78rem; color: var(--teal-soft); font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 8px; }
      .pull-scripture blockquote { font-family: 'Crimson Text', serif; font-size: 1.22rem; font-style: italic; color: var(--teal-soft); line-height: 1.65; }
      .pull-scripture cite { display: block; margin-top: 8px; font-size: 0.8rem; color: rgba(94,234,212,0.6); font-style: normal; }

      /* Buttons */
      .btn-row { display: flex; gap: 12px; flex-wrap: wrap; }
      .btn-teal { display: inline-flex; align-items: center; gap: 8px; padding: 13px 22px; border-radius: 12px; background: linear-gradient(to right, #0d9488, #14b8a6); color: #fff; font-weight: 700; font-size: 0.93rem; text-decoration: none; transition: all 0.2s; }
      .btn-teal:hover { background: linear-gradient(to right, #14b8a6, #2dd4bf); color: #fff; }
      .btn-gold { display: inline-flex; align-items: center; gap: 8px; padding: 13px 22px; border-radius: 12px; background: linear-gradient(to right, #b45309, #d97706); color: #fff; font-weight: 700; font-size: 0.93rem; text-decoration: none; transition: all 0.2s; }
      .btn-gold:hover { background: linear-gradient(to right, #d97706, #f59e0b); color: #fff; }
      .btn-outline { display: inline-flex; align-items: center; gap: 8px; padding: 13px 22px; border-radius: 12px; background: transparent; border: 1px solid var(--line); color: var(--ink-muted); font-weight: 600; font-size: 0.93rem; text-decoration: none; transition: all 0.2s; }
      .btn-outline:hover { border-color: var(--gold); color: var(--gold-soft); }

      /* Poster col */
      .hero-poster-col { display: flex; flex-direction: column; align-items: center; justify-content: flex-start; }
      .book-poster { width: 100%; max-width: 240px; border-radius: 14px; box-shadow: 0 12px 48px rgba(0,0,0,0.6), 0 0 40px rgba(20,184,166,0.15); border: 1px solid rgba(20,184,166,0.25); display: block; }
      .poster-caption { margin-top: 10px; font-size: 0.75rem; color: rgba(94,234,212,0.6); text-align: center; font-style: italic; }

      /* ===== SECTIONS ===== */
      .section { padding: 48px 0; border-top: 1px solid var(--line-soft); }
      .section-header { text-align: center; margin-bottom: 32px; }
      .section-header .sh-eyebrow { display: inline-block; padding: 5px 16px; border-radius: 999px; border: 1px solid var(--line); color: var(--gold-soft); letter-spacing: 0.1em; text-transform: uppercase; font-size: 0.73rem; font-weight: 700; margin-bottom: 12px; }
      .section-header h2 { font-family: 'Crimson Text', serif; font-size: clamp(1.8rem, 3.5vw, 2.5rem); font-weight: 600; color: var(--ink); margin-bottom: 8px; }
      .section-header p { color: var(--ink-muted); font-size: 0.97rem; line-height: 1.8; max-width: 680px; margin: 0 auto; }

      /* ===== PDF EMBED ===== */
      .pdf-embed-wrap { background: rgba(10,10,46,0.5); border: 1px solid var(--line); border-radius: 16px; overflow: hidden; }
      .pdf-embed-toolbar { display: flex; align-items: center; justify-content: space-between; padding: 12px 18px; background: rgba(7,20,38,0.9); border-bottom: 1px solid var(--line); flex-wrap: wrap; gap: 10px; }
      .pdf-embed-toolbar-title { font-size: 0.875rem; font-weight: 600; color: var(--ink-muted); }
      .pdf-embed-toolbar-title strong { color: var(--teal-soft); }
      .pdf-embed-toolbar a { display: inline-flex; align-items: center; gap: 6px; padding: 8px 16px; border-radius: 8px; background: rgba(20,184,166,0.10); border: 1px solid rgba(20,184,166,0.28); color: var(--teal-soft); font-size: 0.82rem; font-weight: 600; text-decoration: none; transition: all 0.2s; }
      .pdf-embed-toolbar a:hover { background: rgba(20,184,166,0.2); }
      .pdf-frame { width: 100%; height: 800px; display: block; border: none; background: #fff; }
      @media (max-width: 600px) { .pdf-frame { height: 500px; } }

      /* ===== BOOKS GRID ===== */
      .books-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 18px; }
      .book-card { background: linear-gradient(135deg, rgba(7,26,38,0.85), rgba(5,15,30,0.9)); border: 1px solid rgba(20,184,166,0.18); border-radius: 16px; padding: 24px 22px; transition: all 0.2s; display: flex; flex-direction: column; }
      .book-card:hover { border-color: rgba(20,184,166,0.45); transform: translateY(-2px); box-shadow: 0 8px 32px rgba(0,0,0,0.4); }
      .book-card.featured { border-color: rgba(20,184,166,0.5); background: linear-gradient(135deg, rgba(5,30,36,0.95), rgba(5,15,30,0.98)); }
      .book-card-badge { display: inline-flex; align-items: center; gap: 5px; padding: 4px 10px; border-radius: 999px; font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.07em; margin-bottom: 12px; width: fit-content; }
      .badge-featured { background: rgba(20,184,166,0.12); border: 1px solid rgba(20,184,166,0.4); color: var(--teal-soft); }
      .badge-sabbath { background: rgba(212,165,55,0.10); border: 1px solid rgba(212,165,55,0.3); color: var(--gold-soft); }
      .badge-history { background: rgba(139,92,246,0.10); border: 1px solid rgba(139,92,246,0.3); color: #c4b5fd; }
      .badge-prophecy { background: rgba(59,130,246,0.10); border: 1px solid rgba(59,130,246,0.3); color: #93c5fd; }
      .book-card h3 { font-family: 'Crimson Text', serif; font-size: 1.22rem; font-weight: 600; color: var(--ink); margin-bottom: 6px; line-height: 1.3; }
      .book-card .book-year { font-size: 0.8rem; color: var(--teal); font-weight: 600; margin-bottom: 8px; }
      .book-card p { font-size: 0.875rem; color: var(--ink-muted); line-height: 1.7; flex: 1; margin-bottom: 16px; }
      .book-card-link { display: inline-flex; align-items: center; gap: 6px; padding: 10px 18px; border-radius: 9px; font-weight: 700; font-size: 0.85rem; text-decoration: none; transition: all 0.2s; }
      .link-teal { background: linear-gradient(to right, #0d9488, #14b8a6); color: #fff; }
      .link-teal:hover { background: linear-gradient(to right, #14b8a6, #2dd4bf); color: #fff; }
      .link-gold { background: linear-gradient(to right, #b45309, #d97706); color: #fff; }
      .link-gold:hover { background: linear-gradient(to right, #d97706, #f59e0b); color: #fff; }
      .link-purple { background: rgba(139,92,246,0.12); border: 1px solid rgba(139,92,246,0.3); color: #c4b5fd; }
      .link-purple:hover { background: rgba(139,92,246,0.2); color: #fff; }
      .link-blue { background: rgba(59,130,246,0.12); border: 1px solid rgba(59,130,246,0.3); color: #93c5fd; }
      .link-blue:hover { background: rgba(59,130,246,0.2); color: #fff; }
      .link-outline { background: transparent; border: 1px solid var(--line); color: var(--ink-muted); }
      .link-outline:hover { border-color: var(--teal); color: var(--teal-soft); }

      /* ===== BIO SECTION ===== */
      .bio-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 36px; align-items: start; }
      @media (max-width: 768px) { .bio-grid { grid-template-columns: 1fr; } }
      .bio-portrait { width: 100%; max-width: 340px; border-radius: 16px; object-fit: cover; display: block; border: 1px solid rgba(20,184,166,0.3); }
      .bio-caption { margin-top: 12px; font-size: 0.8rem; color: var(--ink-muted); text-align: center; font-style: italic; }
      .bio-facts { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin: 18px 0; }
      .bio-fact { background: rgba(7,20,38,0.7); border: 1px solid rgba(20,184,166,0.15); border-radius: 10px; padding: 12px 14px; }
      .bio-fact .fact-label { font-size: 0.72rem; color: var(--ink-muted); text-transform: uppercase; letter-spacing: 0.08em; font-weight: 600; margin-bottom: 4px; }
      .bio-fact .fact-value { font-size: 0.88rem; color: var(--teal-soft); font-weight: 600; }
      .bio-content h3 { font-family: 'Crimson Text', serif; font-size: 1.75rem; font-weight: 600; color: var(--ink); margin-bottom: 14px; }
      .bio-content p { font-size: 0.95rem; color: rgba(254,243,199,0.8); line-height: 1.9; margin-bottom: 14px; }

      /* ===== TIMELINE ===== */
      .timeline-strip { display: flex; gap: 0; overflow: hidden; border-radius: 16px; border: 1px solid rgba(20,184,166,0.2); margin-top: 28px; }
      @media (max-width: 700px) { .timeline-strip { flex-direction: column; } }
      .tl-item { flex: 1; padding: 18px; background: rgba(7,20,38,0.7); border-right: 1px solid rgba(20,184,166,0.15); }
      .tl-item:last-child { border-right: none; }
      .tl-year { font-size: 1.3rem; font-weight: 800; color: var(--teal); display: block; margin-bottom: 4px; }
      .tl-title { font-size: 0.85rem; font-weight: 700; color: var(--ink); margin-bottom: 4px; }
      .tl-desc { font-size: 0.78rem; color: var(--ink-muted); line-height: 1.6; }

      /* ===== THEOLOGICAL / LIFE SECTION ===== */
      .life-card { background: linear-gradient(135deg, rgba(5,30,36,0.7), rgba(5,15,30,0.92)); border: 1px solid rgba(20,184,166,0.25); border-radius: 20px; padding: 36px 32px; }
      @media (max-width: 600px) { .life-card { padding: 24px 18px; } }
      .life-header { display: flex; align-items: center; gap: 14px; margin-bottom: 22px; }
      .life-badge { width: 52px; height: 52px; border-radius: 50%; background: linear-gradient(135deg, #0d9488, #14b8a6); display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
      .life-card h3 { font-family: 'Crimson Text', serif; font-size: 1.65rem; font-weight: 600; color: var(--teal-soft); }
      .life-card .sub { font-size: 0.85rem; color: rgba(94,234,212,0.65); }
      .life-verse { background: rgba(20,184,166,0.06); border: 1px solid rgba(20,184,166,0.2); border-radius: 12px; padding: 22px 24px; margin: 18px 0; }
      .life-verse blockquote { font-family: 'Crimson Text', serif; font-size: 1.25rem; font-style: italic; color: var(--teal-soft); line-height: 1.65; }
      .life-verse cite { display: block; margin-top: 8px; font-size: 0.82rem; color: rgba(94,234,212,0.6); font-style: normal; font-weight: 600; }
      .life-body { font-size: 0.97rem; color: rgba(254,243,199,0.8); line-height: 1.9; margin-top: 16px; }
      .life-body strong { color: var(--teal-soft); }

      /* Reformation comparison boxes */
      .reform-row { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; margin-top: 24px; }
      @media (max-width: 600px) { .reform-row { grid-template-columns: 1fr; } }
      .reform-box { border-radius: 14px; padding: 22px 20px; }
      .reform-box.before { background: rgba(239,68,68,0.07); border: 1px solid rgba(239,68,68,0.2); }
      .reform-box.after { background: rgba(20,184,166,0.07); border: 1px solid rgba(20,184,166,0.25); }
      .reform-box h4 { font-size: 0.875rem; font-weight: 700; margin-bottom: 10px; }
      .reform-box.before h4 { color: #fca5a5; }
      .reform-box.after h4 { color: var(--teal-soft); }
      .reform-box ul { list-style: none; }
