---
import Analytics from '../components/Analytics.astro';
import SiteFooter from '../components/SiteFooter.astro';
import ShareBar from '../components/ShareBar.astro';
import SiteNav from '../components/SiteNav.astro';
const pageUrl = "https://sundaylaw.com/prophecy-charts";
const pageTitle = "The Prophetic Charts — 1843 & 1850 | Written in Vision, Proven in Time";
const pageDesc = "The Adventist Prophetic Charts of 1843 and 1850 fulfill Habakkuk 2:2–3. The dates are correct — October 22, 1844, Jesus moved into the Most Holy Place in the Heavenly Sanctuary. Discover the math, the Day-Year principle, Hosea 6:2, and the Golden Scepter of Queen Esther.";
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <Analytics />
  <title>{pageTitle}</title>
  <meta name="description" content={pageDesc} />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={pageDesc} />
  <meta property="og:image" content="/images/pioneers/1843-1850-adventist-prophecy-charts.jpg" />
  <meta property="og:url" content={pageUrl} />
  <meta property="og:type" content="article" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={pageTitle} />
  <meta name="twitter:description" content={pageDesc} />
  <meta name="twitter:image" content="/images/pioneers/1843-1850-adventist-prophecy-charts.jpg" />
  <link rel="canonical" href={pageUrl} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Crimson+Text:ital,wght@0,400;0,600;1,400&display=swap" rel="stylesheet" />
  <script type="text/javascript">
    function googleTranslateElementInit() {
      new google.translate.TranslateElement({ pageLanguage: 'en', layout: google.translate.TranslateElement.InlineLayout.SIMPLE }, 'google_translate_element');
    }
  </script>
  <script type="text/javascript" src="//translate.google.com/translate_a/element.js?cb=googleTranslateElementInit"></script>
  <style>
    :root {
      --bg: #0a0a2e;
      --bg-soft: #0d0d3a;
      --ink: #fef3c7;
      --ink-muted: #9ca3af;
      --gold: #d4a537;
      --gold-soft: #fcd34d;
      --amber: #f59e0b;
      --line: rgba(212,165,55,0.22);
      --line-soft: rgba(212,165,55,0.12);
      --green: rgba(74,150,60,0.85);
    }
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }
    body {
      font-family: 'Inter', sans-serif;
      color: var(--ink);
      background: var(--bg);
      overflow-x: hidden;
    }
    .serif { font-family: 'Crimson Text', serif; }
    img { max-width: 100%; height: auto; display: block; }
    a { color: var(--amber); text-decoration: none; }
    a:hover { text-decoration: underline; }

    /* ── TRANSLATE BAR ── */
    .translate-bar {
      background: rgba(5,5,25,0.98);
      border-bottom: 1px solid var(--line-soft);
      padding: 6px 18px;
      display: flex;
      align-items: center;
      gap: 10px;
      font-size: 0.78rem;
      color: var(--ink-muted);
    }
    #google_translate_element { display: inline-block; }
    #google_translate_element .goog-te-gadget-simple {
      background: transparent; border: none; font-size:0.78rem;
    }

    /* ── NAV ── */
    .nav {
      position: sticky; top: 0; z-index: 100;
      background: rgba(5,5,30,0.96);
      backdrop-filter: blur(14px);
      border-bottom: 1px solid var(--line);
    }
    .nav-wrap { max-width: 1280px; margin: 0 auto; }
    .nav-row {
      display: flex; align-items: center; padding: 0 22px;
    }
    .nav-row-top { gap: 22px; height: 60px; border-bottom: 1px solid rgba(212,165,55,0.10); }
    .nav-row-bottom { gap: 20px; height: 40px; font-size: 0.81rem; overflow-x: auto; scrollbar-width: none; }
    .nav-brand {
      text-decoration: none; color: var(--ink); font-family: 'Crimson Text', serif;
      font-weight: 600; font-size: 1.25rem; flex-shrink: 0; margin-right: auto;
    }
    .nav-brand span { color: var(--gold); }
    .nav-link {
      color: var(--ink-muted); text-decoration: none; font-weight: 600;
      font-size: 0.88rem; white-space: nowrap; transition: color 0.18s;
    }
    .nav-link:hover, .nav-link.active { color: var(--gold-soft); text-decoration: none; }
    .nav-cta {
      display: inline-flex; align-items: center; height: 36px; padding: 0 16px;
      border-radius: 8px; background: var(--gold); color: #111;
      font-weight: 700; font-size: 0.86rem; text-decoration: none; flex-shrink: 0; transition: background 0.18s;
    }
    .nav-cta:hover { background: var(--gold-soft); text-decoration: none; }
    .nav-bottom-link {
      color: rgba(156,163,175,0.8); text-decoration: none; font-weight: 500;
      white-space: nowrap; transition: color 0.18s; flex-shrink: 0;
    }
    .nav-bottom-link:hover { color: var(--gold-soft); text-decoration: none; }
    .menu-btn {
      display: none; width: 38px; height: 38px; border: 1px solid var(--line);
      border-radius: 8px; background: rgba(255,255,255,0.03); color: var(--ink);
      font-size: 1.2rem; cursor: pointer; flex-shrink: 0; align-items: center; justify-content: center;
    }
    .mobile-nav { display: none; border-top: 1px solid var(--line); padding: 12px 22px 16px; background: rgba(5,5,30,0.98); }
    .mobile-nav.open { display: grid; gap: 6px; }
    .mobile-nav a { color: var(--ink-muted); text-decoration: none; font-weight: 600; padding: 7px 0; border-bottom: 1px solid rgba(255,255,255,0.05); }
    .mobile-nav a:hover { color: var(--gold-soft); }

    /* ── HERO ── */
    .hero {
      position: relative; min-height: 72vh;
      display: flex; align-items: center; justify-content: center;
      overflow: hidden;
      background: linear-gradient(160deg, #04041a 0%, #080828 52%, #040418 100%);
    }
    .hero-orb1 { position: absolute; width: 600px; height: 600px; border-radius: 50%; top: -120px; left: -120px; background: radial-gradient(circle, rgba(212,165,55,0.13) 0%, transparent 65%); pointer-events: none; }
    .hero-orb2 { position: absolute; width: 500px; height: 500px; border-radius: 50%; bottom: -80px; right: -80px; background: radial-gradient(circle, rgba(90,60,180,0.15) 0%, transparent 65%); pointer-events: none; }
    .hero-stripe { position: absolute; bottom: 0; left: 0; right: 0; height: 3px; background: linear-gradient(to right, transparent, var(--gold), transparent); z-index: 3; }
    .hero-content {
      position: relative; z-index: 2; text-align: center;
      max-width: 940px; padding: 72px 28px 88px;
    }
    .hero-badge {
      display: inline-flex; align-items: center; gap: 8px;
      padding: 7px 18px; border-radius: 999px;
      border: 1px solid rgba(212,165,55,0.4); background: rgba(212,165,55,0.08);
      color: var(--gold-soft); font-size: 0.78rem; font-weight: 700;
      text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 26px;
    }
    .hero h1 {
      font-family: 'Crimson Text', serif;
      font-size: clamp(2.8rem, 7.5vw, 6rem);
      font-weight: 600; line-height: 1.05; color: var(--ink);
      text-shadow: 0 4px 32px rgba(0,0,0,0.5); margin-bottom: 12px;
    }
    .hero h1 .gold { color: var(--gold); }
    .hero-sub {
      font-family: 'Crimson Text', serif; font-style: italic;
      font-size: clamp(1.25rem, 3vw, 1.85rem);
      color: rgba(254,243,199,0.82); margin-bottom: 22px;
    }
    .habakkuk-hero {
      display: inline-block; max-width: 700px;
      border-top: 1px solid rgba(212,165,55,0.35);
      border-bottom: 1px solid rgba(212,165,55,0.35);
      padding: 16px 24px; margin: 0 auto 32px;
      font-family: 'Crimson Text', serif; font-size: 1.15rem; font-style: italic;
      color: rgba(254,243,199,0.88); line-height: 1.75;
    }
    .habakkuk-hero cite { display: block; margin-top: 8px; font-size: 0.88rem; color: var(--gold-soft); font-style: normal; font-weight: 700; }
    .hero-nav-btns {
      display: flex; flex-wrap: wrap; gap: 10px; justify-content: center; margin-top: 28px;
    }
    .hnb {
      display: inline-flex; align-items: center; height: 42px; padding: 0 20px;
      border-radius: 9px; font-weight: 600; font-size: 0.88rem; text-decoration: none;
      transition: all 0.2s;
    }
    .hnb-gold { background: var(--gold); color: #111; }
    .hnb-gold:hover { background: var(--gold-soft); transform: translateY(-2px); text-decoration: none; }
    .hnb-outline { border: 1px solid rgba(254,243,199,0.28); color: var(--ink); background: rgba(255,255,255,0.04); }
    .hnb-outline:hover { border-color: var(--gold); color: var(--gold-soft); text-decoration: none; }

    /* ── SECTION BASE ── */
    .section { padding: 80px 22px; position: relative; }
    .section-dark { background: linear-gradient(to bottom, #0a0a2e, #080828, #0a0a2e); }
    .section-warm { background: linear-gradient(to bottom, #0a0a2e, #0e0820, #0a0a2e); }
    .section-navy { background: #070718; }
    .section-inner { max-width: 1200px; margin: 0 auto; }
    .section-narrow { max-width: 900px; margin: 0 auto; }
    .stripe-top { position: absolute; top: 0; left: 0; right: 0; height: 2px; background: linear-gradient(to right, transparent, rgba(212,165,55,0.3), transparent); }

    /* ── SECTION HEADINGS ── */
    .sh { text-align: center; margin-bottom: 52px; }
    .sh-eyebrow {
      display: inline-block; padding: 5px 16px; border-radius: 999px;
      background: rgba(212,165,55,0.1); border: 1px solid rgba(212,165,55,0.26);
      color: var(--gold-soft); font-size: 0.75rem; font-weight: 700;
      text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 14px;
    }
    .sh h2 {
      font-family: 'Crimson Text', serif; font-size: clamp(1.9rem, 4.5vw, 3.2rem);
      font-weight: 600; color: var(--ink); line-height: 1.15; margin-bottom: 14px;
    }
    .sh h2 .gold { color: var(--gold); }
    .sh p { color: var(--ink-muted); font-size: 1.05rem; line-height: 1.8; max-width: 720px; margin: 0 auto; }
    .sh-divider { display: flex; align-items: center; justify-content: center; gap: 14px; margin-bottom: 14px; }
    .sh-line { height: 1px; width: 52px; background: rgba(212,165,55,0.4); }

    /* ── SCRIPTURE BLOCK ── */
    .scripture {
      border-radius: 14px; padding: 24px 28px;
      background: linear-gradient(135deg, rgba(10,18,5,0.92), rgba(4,10,22,0.92));
      border: 1px solid rgba(110,180,80,0.28); margin-bottom: 20px; position: relative;
    }
    .scripture::before { content: '\201C'; position: absolute; top: -6px; left: 16px; font-size: 3.5rem; color: rgba(110,180,80,0.18); font-family: serif; line-height: 1; }
    .scripture p { font-family: 'Crimson Text', serif; font-size: 1.15rem; font-style: italic; color: var(--ink); line-height: 1.85; margin-bottom: 10px; }
    .scripture cite { color: var(--gold-soft); font-size: 0.84rem; font-weight: 700; font-style: normal; }

    /* ── GOLD QUOTE BLOCK ── */
    .gold-block {
      border-radius: 14px; padding: 24px 28px;
      background: linear-gradient(135deg, rgba(20,14,2,0.92), rgba(8,12,30,0.92));
      border: 1px solid rgba(212,165,55,0.35); margin-bottom: 20px;
    }
    .gold-block p { font-family: 'Crimson Text', serif; font-size: 1.12rem; font-style: italic; color: var(--ink); line-height: 1.85; margin-bottom: 10px; }
    .gold-block cite { color: var(--gold-soft); font-size: 0.84rem; font-weight: 700; font-style: normal; }
    .gold-block h3 { color: var(--gold-soft); font-size: 1.2rem; margin-bottom: 12px; font-family: 'Crimson Text', serif; }

    /* ── CARDS ── */
    .card { background: linear-gradient(180deg, rgba(14,18,48,0.92), rgba(7,12,32,0.95)); border: 1px solid rgba(212,165,55,0.2); border-radius: 16px; padding: 24px; }
    .card h3 { color: var(--gold-soft); margin-bottom: 10px; font-family: 'Crimson Text', serif; font-size: 1.25rem; }
    .card p { color: var(--ink-muted); line-height: 1.8; margin-bottom: 8px; }
    .card-featured { border-color: rgba(212,165,55,0.45); background: linear-gradient(160deg, rgba(22,16,4,0.9), rgba(8,10,32,0.9)); }

    /* ── CHART GALLERY ── */
    .chart-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; margin-top: 32px; }
    @media (max-width: 900px) { .chart-grid { grid-template-columns: 1fr; } }
    .chart-card {
      border-radius: 18px; overflow: hidden;
      border: 1px solid rgba(212,165,55,0.3);
      background: linear-gradient(180deg, rgba(12,16,44,0.95), rgba(6,10,28,0.95));
      transition: transform 0.25s, border-color 0.25s;
    }
    .chart-card:hover { transform: translateY(-4px); border-color: rgba(212,165,55,0.6); }
    .chart-img-wrap { position: relative; overflow: hidden; cursor: zoom-in; }
    .chart-img-wrap img { width: 100%; aspect-ratio: 4/3; object-fit: cover; display: block; transition: transform 0.4s; }
    .chart-img-wrap:hover img { transform: scale(1.04); }
    .chart-img-label { position: absolute; bottom: 0; left: 0; right: 0; padding: 10px 14px; background: linear-gradient(0deg, rgba(4,8,24,0.9), transparent); color: var(--gold-soft); font-size: 0.78rem; font-weight: 700; }
    .chart-body { padding: 20px 20px 24px; }
    .chart-eyebrow { font-size: 0.74rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; color: var(--gold-soft); margin-bottom: 8px; }
    .chart-body h3 { font-family: 'Crimson Text', serif; font-size: 1.3rem; color: var(--ink); margin-bottom: 10px; }
    .chart-body p { color: var(--ink-muted); font-size: 0.92rem; line-height: 1.75; margin-bottom: 16px; }
    .chart-btns { display: flex; flex-wrap: wrap; gap: 8px; }
    .btn-sm { display: inline-flex; align-items: center; height: 36px; padding: 0 14px; border-radius: 8px; font-weight: 700; font-size: 0.82rem; text-decoration: none; transition: all 0.2s; }
    .btn-sm-gold { background: var(--gold); color: #111; }
    .btn-sm-gold:hover { background: var(--gold-soft); text-decoration: none; }
    .btn-sm-outline { border: 1px solid rgba(212,165,55,0.4); color: var(--amber); }
    .btn-sm-outline:hover { background: rgba(212,165,55,0.1); text-decoration: none; }

    /* ── GRID UTILITIES ── */
    .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }
    @media (max-width: 760px) { .grid-2 { grid-template-columns: 1fr; } }
    .grid-3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
    @media (max-width: 760px) { .grid-3 { grid-template-columns: 1fr; } }

    /* ── MATH BOX ── */
    .math-box {
      border-radius: 14px; padding: 22px 26px;
      background: rgba(6,12,38,0.9); border: 1px solid rgba(212,165,55,0.2);
      font-family: 'Inter', sans-serif; margin-bottom: 18px;
    }
    .math-row { display: flex; align-items: baseline; gap: 12px; margin-bottom: 10px; flex-wrap: wrap; }
    .math-label { color: var(--gold-soft); font-size: 0.82rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; min-width: 140px; }
    .math-value { color: var(--ink); font-size: 1rem; line-height: 1.6; }
    .math-value strong { color: var(--gold); }
    .math-result { border-top: 1px solid rgba(212,165,55,0.28); padding-top: 10px; margin-top: 4px; }
    .math-result .math-value { font-size: 1.1rem; font-weight: 700; color: var(--gold-soft); }

    /* ── TIMELINE ── */
    .timeline { position: relative; padding-left: 28px; }
    .timeline::before { content: ''; position: absolute; left: 10px; top: 0; bottom: 0; width: 2px; background: linear-gradient(to bottom, var(--gold), rgba(212,165,55,0.08)); }
    .tl-item { position: relative; margin-bottom: 28px; }
    .tl-dot { position: absolute; left: -24px; top: 4px; width: 14px; height: 14px; border-radius: 50%; background: var(--gold); border: 2px solid #0a0a2e; }
    .tl-date { color: var(--gold-soft); font-size: 0.8rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 4px; }
    .tl-text { color: var(--ink-muted); line-height: 1.75; }
    .tl-text strong { color: var(--ink); }

    /* ── ESTHER / PARALLEL ── */
    .parallel-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0; border-radius: 16px; overflow: hidden; border: 1px solid rgba(212,165,55,0.25); }
    @media (max-width: 680px) { .parallel-grid { grid-template-columns: 1fr; } }
    .parallel-col { padding: 26px 24px; }
    .parallel-left { background: linear-gradient(160deg, rgba(10,20,8,0.92), rgba(4,12,20,0.95)); border-right: 1px solid rgba(212,165,55,0.2); }
    .parallel-right { background: linear-gradient(160deg, rgba(4,8,28,0.92), rgba(2,6,22,0.95)); }
    @media (max-width: 680px) { .parallel-left { border-right: none; border-bottom: 1px solid rgba(212,165,55,0.2); } }
    .parallel-col h3 { font-family: 'Crimson Text', serif; font-size: 1.2rem; color: var(--gold-soft); margin-bottom: 16px; display: flex; align-items: center; gap: 8px; }
    .parallel-item { display: flex; gap: 10px; margin-bottom: 14px; }
    .pi-num { width: 24px; height: 24px; border-radius: 50%; background: rgba(212,165,55,0.18); border: 1px solid rgba(212,165,55,0.35); color: var(--gold-soft); font-size: 0.76rem; font-weight: 700; flex-shrink: 0; display: flex; align-items: center; justify-content: center; }
    .pi-text { color: var(--ink-muted); font-size: 0.93rem; line-height: 1.7; }
    .pi-text strong { color: var(--ink); }

    /* ── FAQ ── */
    .faq-item { border-bottom: 1px solid rgba(212,165,55,0.12); margin-bottom: 0; }
    .faq-q { width: 100%; text-align: left; padding: 18px 0; background: transparent; border: none; color: var(--ink); font-size: 1rem; font-weight: 600; cursor: pointer; display: flex; align-items: center; justify-content: space-between; gap: 12px; }
    .faq-q:hover { color: var(--gold-soft); }
    .faq-icon { color: var(--gold); font-size: 1.2rem; flex-shrink: 0; transition: transform 0.25s; }
    .faq-a { max-height: 0; overflow: hidden; transition: max-height 0.35s ease; }
    .faq-a.open { max-height: 500px; }
    .faq-inner { padding: 0 0 18px; color: var(--ink-muted); line-height: 1.85; font-size: 0.95rem; }
    .faq-inner p { margin-bottom: 10px; }
    .faq-inner strong { color: var(--ink); }

    /* ── SHARE ── */
    .share-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 10px; }
    .share-btn {
      display: flex; align-items: center; justify-content: center; gap: 8px; padding: 13px;
      border-radius: 10px; font-weight: 700; font-size: 0.88rem;
      background: linear-gradient(180deg, rgba(20,28,62,0.9), rgba(10,16,44,0.9));
      border: 1px solid rgba(255,255,255,0.08); color: var(--ink); cursor: pointer; transition: all 0.2s;
      text-decoration: none;
    }
    .share-btn:hover { border-color: rgba(212,165,55,0.4); transform: translateY(-2px); text-decoration: none; }
    .print-btn { background: linear-gradient(180deg, rgba(212,165,55,0.14), rgba(212,165,55,0.08)); border-color: rgba(212,165,55,0.3); color: var(--gold-soft); }

    /* ── LIGHTBOX ── */
    .lightbox { position: fixed; inset: 0; z-index: 9000; background: rgba(2,5,20,0.94); backdrop-filter: blur(10px); display: none; align-items: center; justify-content: center; padding: 20px; }
    .lightbox.open { display: flex; }
    .lightbox-inner { position: relative; max-width: min(1200px, 95vw); max-height: 90vh; }
    .lightbox-inner img { max-width: 100%; max-height: 88vh; object-fit: contain; border-radius: 12px; box-shadow: 0 40px 100px rgba(0,0,0,0.6); }
    .lb-close { position: absolute; top: -14px; right: -14px; width: 40px; height: 40px; border-radius: 999px; background: var(--gold); color: #111; font-weight: 900; font-size: 1.1rem; border: none; cursor: pointer; display: flex; align-items: center; justify-content: center; }
    .lb-caption { text-align: center; color: var(--ink-muted); font-size: 0.84rem; margin-top: 10px; }

    /* ── FOOTER ── */
    .site-footer { background: #050518; border-top: 1px solid rgba(180,130,50,0.2); }
    .footer-banner { text-align: center; padding: 32px 22px 28px; border-bottom: 1px solid rgba(212,165,55,0.12); }
    .footer-banner p { font-family: 'Crimson Text', serif; font-size: 1.1rem; font-style: italic; color: rgba(254,243,199,0.8); max-width: 700px; margin: 0 auto 8px; }
    .footer-banner cite { font-size: 0.85rem; color: var(--gold-soft); font-weight: 700; font-style: normal; }
    .footer-main { max-width: 1200px; margin: 0 auto; padding: 40px 22px; display: grid; grid-template-columns: 1.4fr 1fr 1fr 1fr; gap: 32px; }
    .footer-col h4 { color: var(--gold-soft); font-size: 0.85rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 14px; }
    .footer-col p { color: #6b7280; font-size: 0.9rem; line-height: 1.75; }
    .footer-col ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 9px; }
    .footer-col ul a { color: #9ca3af; text-decoration: none; font-size: 0.9rem; transition: color 0.18s; }
    .footer-col ul a:hover { color: var(--gold-soft); }
    .footer-brand-name { display: flex; align-items: center; gap: 8px; margin-bottom: 14px; }
    .footer-brand-name span { font-family: 'Crimson Text', serif; font-size: 1.2rem; font-weight: 600; color: #fff; }
    .footer-brand-name span em { color: var(--gold); font-style: normal; }
