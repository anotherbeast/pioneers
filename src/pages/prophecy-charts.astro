<!-- ══════════════════════════════════════════════════════════
     SECTION 3 — OCTOBER 22, 1844: DATES ARE CORRECT
═══════════════════════════════════════════════════════════ -->
<section id="dates-correct" class="section section-dark">
  <div class="stripe-top"></div>
  <div class="section-inner">
    <div class="sh">
      <div class="sh-eyebrow">The Great Disappointment &mdash; Solved</div>
      <div class="sh-divider"><div class="sh-line"></div><div class="sh-line"></div></div>
