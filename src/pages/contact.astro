    <script is:inline>
      // Tab switching
      function showTab(name) {
        ['contact','prayer','newsletter','share'].forEach(id => {
          const card = document.getElementById('form-' + id);
          const tab = document.getElementById('tab-' + id);
          if (card) card.classList.toggle('hidden', id !== name);
          if (tab) {
            tab.classList.toggle('active', id === name);
            tab.setAttribute('aria-selected', id === name ? 'true' : 'false');
          }
        });
        window.scrollTo({ top: 0, behavior: 'smooth' });
      }


      // Back to top
      const btt = document.getElementById('btt');
      window.addEventListener('scroll', () => {
        if (btt) btt.classList.toggle('visible', window.scrollY > 400);
      }, { passive: true });
    </script>
