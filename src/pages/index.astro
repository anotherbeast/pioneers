---
import Analytics from '../components/Analytics.astro';
import SiteFooter from '../components/SiteFooter.astro';
import ShareBar from '../components/ShareBar.astro';
import SiteNav from '../components/SiteNav.astro';
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <Analytics />
    <title>SundayLaw.com — The Final Choice: God's Law or Man's Law</title>
    <meta name="description" content="The final issue of earth's history is the Sabbath — the seal of the living God versus the mark of the beast. Here are they that keep the commandments of God and the faith of Jesus.">
    <meta property="og:title" content="SundayLaw.com — The Final Choice: God's Law or Man's Law">
    <meta property="og:description" content="The final issue of earth's history is the Sabbath — the seal of the living God versus the mark of the beast. Here are they who keep the commandments of God and the faith of Jesus.">
    <meta property="og:image" content="https://sundaylaw.com/images/shield_sundaylaw.com_the_final_warning_logo.jpg">
    <meta property="og:type" content="website">
    <meta property="og:url" content="https://sundaylaw.com/">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Crimson+Text:ital,wght@0,400;0,600;1,400&display=swap" rel="stylesheet">
    <style>
      :root {
        --bg: #0a0a2e;
        --bg-soft: #0d0d3a;
        --ink: #fef3c7;
        --ink-muted: #9ca3af;
        --gold: #d4a537;
        --gold-soft: #fcd34d;
        --amber: #f59e0b;
        --line: rgba(212,165,55,0.22);
        --line-soft: rgba(212,165,55,0.12);
      }

      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
      html { scroll-behavior: smooth; }

      body {
        margin: 0;
        font-family: 'Inter', sans-serif;
        color: var(--ink);
        background: #0a0a2e;
        overflow-x: hidden;
      }

      .serif { font-family: 'Crimson Text', serif; }

      /* ===== NAV ===== */
      .nav {
        position: sticky;
        top: 0;
        z-index: 100;
        background: rgba(5, 5, 30, 0.94);
        backdrop-filter: blur(12px);
        border-bottom: 1px solid var(--line);
      }

      .nav-wrap { max-width: 1280px; margin: 0 auto; }

      .nav-row {
        display: flex;
        align-items: center;
        padding: 0 22px;
      }

      .nav-row-top {
        gap: 28px;
        height: 62px;
        border-bottom: 1px solid rgba(212,165,55,0.10);
      }

      .nav-row-bottom {
        gap: 22px;
        height: 42px;
        font-size: 0.82rem;
        overflow-x: auto;
        scrollbar-width: none;
      }

      .nav-brand {
        text-decoration: none;
        color: var(--ink);
        font-weight: 700;
        font-size: 1.05rem;
        letter-spacing: 0.02em;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        margin-right: auto;
      }

      .nav-brand span { color: var(--gold); }
      .nav-brand img { height: 38px; width: auto; display: block; border-radius: 4px; }

      .hero-desc-wrap {
        display: inline-block;
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
        background: rgba(5,5,30,0.52);
        border-radius: 14px;
        padding: 18px 24px;
        margin: 0 auto 30px;
        max-width: 680px;
        border: 1px solid rgba(212,165,55,0.15);
      }

      .nav-link {
        color: var(--ink-muted);
        text-decoration: none;
        font-weight: 600;
        font-size: 0.9rem;
        white-space: nowrap;
        transition: color 0.18s;
      }

      .nav-link:hover { color: var(--gold-soft); }

      .nav-cta {
        display: inline-flex;
        align-items: center;
        height: 38px;
        padding: 0 18px;
        border-radius: 8px;
        background: var(--gold);
        color: #111;
        font-weight: 700;
        font-size: 0.88rem;
        text-decoration: none;
        flex-shrink: 0;
        transition: background 0.18s;
      }

      .nav-cta:hover { background: var(--gold-soft); }

      .nav-bottom-link {
        color: rgba(156,163,175,0.8);
        text-decoration: none;
        font-weight: 500;
        white-space: nowrap;
        transition: color 0.18s;
        flex-shrink: 0;
      }

      .nav-bottom-link:hover { color: var(--gold-soft); }

      .menu-btn {
        display: none;
        width: 40px;
        height: 40px;
        border: 1px solid var(--line);
        border-radius: 8px;
        background: rgba(255,255,255,0.03);
        color: var(--ink);
        font-size: 1.2rem;
        cursor: pointer;
        flex-shrink: 0;
        align-items: center;
        justify-content: center;
      }

      .mobile-nav {
        display: none;
        border-top: 1px solid var(--line);
        padding: 14px 22px 18px;
        background: rgba(5,5,30,0.97);
      }

      .mobile-nav.open { display: grid; gap: 6px; }

      .mobile-nav a {
        color: var(--ink-muted);
        text-decoration: none;
        font-weight: 600;
        padding: 8px 0;
        border-bottom: 1px solid rgba(255,255,255,0.05);
      }

      .mobile-nav a:hover { color: var(--gold-soft); }

      /* ===== HERO ===== */
      .hero {
        position: relative;
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
      }

      .hero-bg {
        position: absolute;
        inset: 0;
        z-index: 0;
      }

      .hero-bg img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center top;
      }

      .hero-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(to bottom,
          rgba(5,5,30,0.55) 0%,
          rgba(5,5,30,0.25) 30%,
          rgba(5,5,30,0.45) 70%,
          rgba(5,5,30,0.92) 100%
        );
      }

      .hero-overlay2 {
        position: absolute;
        inset: 0;
        background: radial-gradient(ellipse at center bottom, rgba(212,165,55,0.06), transparent 60%);
      }

      .hero-stripe {
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        height: 4px;
        background: linear-gradient(to right, transparent, var(--gold), transparent);
        z-index: 3;
      }

      .hero-content {
        position: relative;
        z-index: 2;
        text-align: center;
        max-width: 900px;
        padding: 80px 28px 100px;
      }

      .hero-badge {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        padding: 8px 18px;
        border-radius: 999px;
        border: 1px solid rgba(212,165,55,0.4);
        background: rgba(212,165,55,0.09);
        color: var(--gold-soft);
        font-size: 0.8rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        margin-bottom: 28px;
      }

      .hero h1 {
        font-family: 'Crimson Text', serif;
        font-size: clamp(3.2rem, 9vw, 7rem);
        font-weight: 600;
        line-height: 1.0;
        letter-spacing: -0.01em;
        color: #fef3c7;
        text-shadow: 0 4px 32px rgba(0,0,0,0.55);
        margin-bottom: 18px;
      }

      .hero h1 .gold { color: var(--gold); }

      .hero-subtitle {
        font-family: 'Crimson Text', serif;
        font-size: clamp(1.5rem, 3.5vw, 2.2rem);
        color: rgba(254,243,199,0.85);
        margin-bottom: 24px;
        font-style: italic;
      }

      .hero-desc {
        color: rgba(156,163,175,0.95);
        font-size: 1.05rem;
        line-height: 1.8;
        max-width: 680px;
        margin: 0 auto 30px;
      }

      .hero-quote {
        display: inline-block;
        font-family: 'Crimson Text', serif;
        font-size: 1.15rem;
        font-style: italic;
        color: rgba(254,243,199,0.75);
        border-top: 1px solid rgba(212,165,55,0.3);
        border-bottom: 1px solid rgba(212,165,55,0.3);
        padding: 14px 22px;
        margin-bottom: 34px;
      }

      .hero-btns {
        display: flex;
        gap: 14px;
        justify-content: center;
        flex-wrap: wrap;
        margin-bottom: 52px;
      }

      .btn-primary {
        display: inline-flex;
        align-items: center;
        height: 52px;
        padding: 0 28px;
        border-radius: 10px;
        background: var(--gold);
        color: #111;
        font-weight: 700;
        font-size: 0.95rem;
        text-decoration: none;
        transition: all 0.2s;
      }

      .btn-primary:hover { background: var(--gold-soft); transform: translateY(-2px); }

      .btn-outline {
        display: inline-flex;
        align-items: center;
        height: 52px;
        padding: 0 28px;
        border-radius: 10px;
        border: 1px solid rgba(254,243,199,0.3);
        color: var(--ink);
        font-weight: 600;
        font-size: 0.95rem;
        text-decoration: none;
        background: rgba(255,255,255,0.04);
        transition: all 0.2s;
      }

      .btn-outline:hover { border-color: var(--gold); color: var(--gold-soft); }

      .hero-stats {
        display: flex;
        justify-content: center;
        gap: 48px;
        flex-wrap: wrap;
        padding-top: 38px;
        border-top: 1px solid rgba(212,165,55,0.2);
      }

      .hero-stat .num {
        font-family: 'Crimson Text', serif;
        font-size: clamp(2.8rem, 6vw, 4.2rem);
        font-weight: 600;
        color: var(--gold);
        line-height: 1;
      }

      .hero-stat .label {
        font-size: 0.8rem;
        color: var(--ink-muted);
        text-transform: uppercase;
        letter-spacing: 0.08em;
        margin-top: 6px;
        max-width: 130px;
      }

      /* ===== SECTIONS ===== */
      .section { padding: 80px 22px; position: relative; }

      .section-dark {
        background: linear-gradient(to bottom, #0a0a2e, #080828, #0a0a2e);
      }

      .section-warm {
        background: linear-gradient(to bottom, #0a0a2e, #100820, #0a0a2e);
      }

      .section-inner { max-width: 1200px; margin: 0 auto; }
      .section-narrow { max-width: 920px; margin: 0 auto; }

      .section-stripe-top {
        position: absolute;
        top: 0; left: 0; right: 0;
        height: 3px;
        background: linear-gradient(to right, transparent, rgba(212,165,55,0.35), transparent);
      }

      /* ===== SECTION HEADINGS ===== */
      .sh { text-align: center; margin-bottom: 52px; }

      .sh-eyebrow {
        display: inline-block;
        padding: 6px 16px;
        border-radius: 999px;
        background: rgba(212,165,55,0.1);
        border: 1px solid rgba(212,165,55,0.28);
        color: var(--gold-soft);
        font-size: 0.76rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        margin-bottom: 16px;
      }

      .sh h2 {
        font-family: 'Crimson Text', serif;
        font-size: clamp(2rem, 4.5vw, 3.2rem);
        font-weight: 600;
        color: #fef3c7;
        line-height: 1.15;
      }

      .sh p {
        margin-top: 14px;
        color: var(--ink-muted);
        font-size: 1.05rem;
        line-height: 1.8;
        max-width: 720px;
        margin-left: auto;
        margin-right: auto;
      }

      .sh-divider {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 14px;
        margin-bottom: 16px;
      }

      .sh-line { height: 1px; width: 52px; background: rgba(212,165,55,0.4); }

      /* ===== QUOTE BLOCKS ===== */
      .qb {
        border-left: 4px solid rgba(212,165,55,0.5);
        padding: 20px 20px 20px 24px;
        border-radius: 0 10px 10px 0;
        margin-bottom: 22px;
        background: rgba(212,165,55,0.06);
      }

      .qb p {
        font-family: 'Crimson Text', serif;
        font-size: 1.12rem;
        line-height: 1.75;
        color: rgba(254,243,199,0.92);
        font-style: italic;
        margin: 0;
      }

      .qb cite {
        display: block;
        margin-top: 10px;
        color: var(--gold-soft);
        font-size: 0.85rem;
        font-weight: 700;
        font-style: normal;
      }

      .qb-dark {
        background: rgba(0,0,0,0.3);
        border-color: rgba(100,100,200,0.3);
      }

      .qb-dark p { color: var(--ink-muted); }

      /* ===== FEATURE CARDS ===== */
      .feature-grid {
        display: grid;
        gap: 22px;
        grid-template-columns: repeat(3, 1fr);
      }

      .feature-card {
        border: 1px solid var(--line);
        border-radius: 16px;
        padding: 28px 24px;
        background: linear-gradient(135deg, rgba(20,20,68,0.8), rgba(10,10,48,0.8));
        transition: all 0.25s;
      }

      .feature-card:hover {
        border-color: rgba(212,165,55,0.45);
        transform: translateY(-3px);
      }

      .feature-card .fc-icon {
        font-size: 2rem;
        margin-bottom: 14px;
        display: block;
      }

      .feature-card h3 {
        font-family: 'Crimson Text', serif;
        font-size: 1.3rem;
        font-weight: 600;
        color: #fef3c7;
        margin-bottom: 10px;
      }

      .feature-card p {
        color: var(--ink-muted);
        font-size: 0.95rem;
        line-height: 1.75;
      }

      .feature-card a {
        display: inline-block;
        margin-top: 14px;
        color: var(--gold-soft);
        text-decoration: none;
        font-weight: 700;
        font-size: 0.88rem;
      }

      .feature-card a:hover { color: var(--ink); }

      /* ===== COMPARISON ===== */
      .compare-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 22px;
        margin-bottom: 32px;
      }

      .compare-card {
        border-radius: 16px;
        padding: 28px 24px;
        border: 2px solid;
      }

      .compare-gold {
        border-color: rgba(212,165,55,0.45);
        background: linear-gradient(135deg, rgba(28,20,0,0.75), rgba(10,10,48,0.85));
      }

      .compare-red {
        border-color: rgba(220,50,50,0.4);
        background: linear-gradient(135deg, rgba(40,5,5,0.75), rgba(10,10,48,0.85));
      }

      .compare-label {
        display: inline-block;
        padding: 5px 12px;
        border-radius: 999px;
        font-size: 0.74rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        margin-bottom: 14px;
      }

      .label-seal {
        background: rgba(212,165,55,0.14);
        border: 1px solid rgba(212,165,55,0.4);
        color: var(--gold-soft);
      }

      .label-mark {
        background: rgba(220,50,50,0.12);
        border: 1px solid rgba(220,50,50,0.4);
        color: #f87171;
      }

      .compare-card h3 {
        font-family: 'Crimson Text', serif;
        font-size: 1.4rem;
        font-weight: 600;
        margin-bottom: 14px;
      }

      .compare-card ul {
        list-style: none;
        padding: 0;
        margin: 0;
        display: grid;
        gap: 9px;
      }

      .compare-card ul li {
        display: flex;
        gap: 10px;
        align-items: flex-start;
        color: var(--ink-muted);
        font-size: 0.94rem;
        line-height: 1.6;
      }

      .compare-card ul li::before {
        content: '›';
        color: var(--gold);
        flex-shrink: 0;
        font-weight: 700;
      }

      .compare-red ul li::before { color: #f87171; }

      /* ===== TEN COMMANDMENTS ===== */
      .cmd-grid {
        display: grid;
        grid-template-columns: repeat(5, 1fr);
        gap: 14px;
        margin: 32px 0;
      }

      .cmd-item {
        background: linear-gradient(135deg, rgba(20,20,68,0.85), rgba(10,10,46,0.9));
        border: 1px solid var(--line);
        border-radius: 12px;
        padding: 18px 14px;
        text-align: center;
        transition: all 0.2s;
      }

      .cmd-item:nth-child(4) {
        border-color: rgba(212,165,55,0.65);
        background: linear-gradient(135deg, rgba(40,30,0,0.85), rgba(20,15,0,0.9));
        box-shadow: 0 0 22px rgba(212,165,55,0.14);
      }

      .cmd-num {
        font-family: 'Crimson Text', serif;
        font-size: 2rem;
        font-weight: 600;
        color: var(--gold);
        line-height: 1;
        display: block;
      }

      .cmd-item:nth-child(4) .cmd-num { color: var(--gold-soft); }

      .cmd-text {
        font-size: 0.78rem;
        color: var(--ink-muted);
        margin-top: 7px;
        line-height: 1.5;
      }

      .cmd-item:nth-child(4) .cmd-text { color: rgba(254,243,199,0.85); }

      /* ===== LIBRARY STRIP ===== */
      .lib-strip {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 18px;
        margin: 32px 0;
      }

      .lib-card {
        background: linear-gradient(135deg, rgba(26,26,78,0.82), rgba(13,13,52,0.82));
        border: 1px solid var(--line-soft);
        border-radius: 14px;
        padding: 22px 18px;
        transition: all 0.25s;
        text-decoration: none;
        display: block;
      }

      .lib-card:hover {
        border-color: var(--line);
        transform: translateY(-3px);
      }

      .lc-author {
        font-size: 0.76rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--gold-soft);
        margin-bottom: 8px;
      }

      .lib-card h4 {
        font-family: 'Crimson Text', serif;
        font-size: 1.05rem;
        font-weight: 600;
        color: #fef3c7;
        line-height: 1.35;
        margin-bottom: 6px;
      }

      .lc-year {
        font-size: 0.8rem;
        color: var(--ink-muted);
      }

      /* ===== CTA ===== */
      .cta-box {
        text-align: center;
        max-width: 760px;
        margin: 0 auto;
      }

      .cta-box h2 {
        font-family: 'Crimson Text', serif;
        font-size: clamp(2rem, 4.5vw, 3rem);
        font-weight: 600;
        color: #fef3c7;
        margin-bottom: 18px;
      }

      .cta-box p {
        color: var(--ink-muted);
        font-size: 1.05rem;
        line-height: 1.8;
        margin-bottom: 32px;
      }

      .cta-btns {
        display: flex;
        gap: 14px;
        justify-content: center;
        flex-wrap: wrap;
      }

      /* ===== FOOTER ===== */
      .site-footer {
        background: #050518;
        border-top: 1px solid rgba(180,130,50,0.2);
      }

      .footer-banner {
        text-align: center;
        padding: 32px 22px 28px;
        border-bottom: 1px solid rgba(212,165,55,0.12);
      }

      .footer-banner p {
        font-family: 'Crimson Text', serif;
        font-size: 1.1rem;
        font-style: italic;
        color: rgba(254,243,199,0.8);
        max-width: 700px;
        margin: 0 auto 8px;
      }

      .footer-banner cite {
        font-size: 0.85rem;
        color: var(--gold-soft);
        font-weight: 700;
        font-style: normal;
      }

      .footer-main {
        max-width: 1200px;
        margin: 0 auto;
        padding: 40px 22px;
        display: grid;
        grid-template-columns: 1.4fr 1fr 1fr 1fr;
        gap: 32px;
      }

      .footer-col h4 {
        color: var(--gold-soft);
        font-size: 0.85rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        margin-bottom: 14px;
      }

      .footer-col p {
        color: #6b7280;
        font-size: 0.9rem;
        line-height: 1.75;
      }

      .footer-col ul {
        list-style: none;
        padding: 0;
        margin: 0;
        display: grid;
        gap: 9px;
      }

      .footer-col ul a {
        color: #9ca3af;
        text-decoration: none;
        font-size: 0.9rem;
        transition: color 0.18s;
      }

      .footer-col ul a:hover { color: var(--gold-soft); }

      .footer-brand-name {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 14px;
      }

      .footer-brand-name span {
        font-family: 'Crimson Text', serif;
        font-size: 1.2rem;
        font-weight: 600;
        color: #fff;
      }

      .footer-brand-name span em { color: var(--gold); font-style: normal; }

      .footer-bottom {
        border-top: 1px solid rgba(212,165,55,0.1);
        padding: 20px 22px;
        text-align: center;
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
      }

      .footer-bottom p { color: #6b7280; font-size: 0.85rem; }

      .footer-flags { display: flex; gap: 4px; }
      .flag-r { width: 24px; height: 12px; background: #b91c1c; border-radius: 2px 0 0 2px; }
      .flag-w { width: 24px; height: 12px; background: #e5e7eb; }
      .flag-b { width: 24px; height: 12px; background: #1d4ed8; border-radius: 0 2px 2px 0; }

      .footer-stripe {
        height: 4px;
        background: linear-gradient(to right, transparent, var(--gold), transparent);
      }

      /* ===== BACK TO TOP ===== */
      .btt {
        position: fixed;
        bottom: 24px;
        right: 24px;
        width: 44px;
        height: 44px;
        border-radius: 10px;
        background: rgba(212,165,55,0.18);
        border: 1px solid rgba(212,165,55,0.4);
        color: var(--gold-soft);
        cursor: pointer;
        display: none;
        align-items: center;
        justify-content: center;
        z-index: 99;
        transition: all 0.2s;
      }

      .btt.visible { display: flex; }
      .btt:hover { background: rgba(212,165,55,0.3); }

      /* ===== RESPONSIVE ===== */
      @media (max-width: 1024px) {
        .feature-grid { grid-template-columns: 1fr 1fr; }
        .lib-strip { grid-template-columns: 1fr 1fr; }
