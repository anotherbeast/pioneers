      <source src="/assets/music/morse/What_a_Glorious_Home_That_Will_Be.mp3" type="audio/mpeg">
    </audio>

    <script is:inline>

      const btt = document.getElementById('btt');
      window.addEventListener('scroll', () => {
        if (btt) btt.classList.toggle('visible', window.scrollY > 400);
      }, { passive: true });

      // Play "What a Glorious Home That Will Be" on first click — plays twice total
      document.addEventListener('click', startMusicOnce, { once: true });
      function startMusicOnce() {
        const audio = document.getElementById('bg-music');
        if (!audio) return;
        let endedCount = 0;
        const maxEnds = 1;
        audio.loop = false;
        audio.currentTime = 0;
        audio.addEventListener('ended', function () {
          if (endedCount < maxEnds) {
            endedCount++;
            audio.currentTime = 0;
            audio.play().catch(() => {});
          }
        });
        audio.play().catch(() => {});
      }
    </script>
