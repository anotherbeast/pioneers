---
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Forgot Password — SundayLaw.com</title>
    <link rel="stylesheet" href="/css/styles.css">
  </head>
  <body>
    <SiteNav />
    <div class="page-wrap">
      <div class="page-hero">
        <div class="eyebrow">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          SundayLaw.com
        </div>
        <h1>Forgot <span class="gold">Password</span></h1>
        <p>Enter your email to receive a password reset link.</p>
      </div>
      <div class="form-card" role="form">
        <h2>Reset Password</h2>
        <form method="POST" action="/api/forgot.php" id="forgotForm" autocomplete="on">
          <div class="form-group">
            <label for="f-email">Email *</label>
            <input type="email" id="f-email" name="email" required placeholder="your@email.com" autocomplete="email" aria-label="Email" />
          </div>
          <button type="submit" class="btn-submit btn-purple">Send Reset Link</button>
        </form>
        <div style="margin-top:18px;text-align:center;">
          <a href="/login" class="btn-submit btn-blue" style="max-width:200px;display:inline-block;">Back to Login</a>
        </div>
      </div>
    </div>
    <SiteFooter />
  </body>
</html>
