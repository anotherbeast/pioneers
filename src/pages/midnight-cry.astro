---
import Analytics from '../components/Analytics.astro';
import SiteFooter from '../components/SiteFooter.astro';
import ShareBar from '../components/ShareBar.astro';
import SiteNav from '../components/SiteNav.astro';
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>The Midnight Cry — Matthew 25:6 &amp; Revelation 14:8 | SundayLaw.com</title>
    <meta name="description" content="And at midnight there was a cry made, Behold, the bridegroom cometh; go ye out to meet him. — Matthew 25:6 KJV. The Midnight Cry of 1844, Habakkuk's tables, the 1843 & 1850 prophecy charts, and the sealing of the 144,000.">
    <link rel="canonical" href="https://sundaylaw.com/midnight-cry">
    <meta property="og:title" content="The Midnight Cry — Matthew 25:6 | SundayLaw.com">
    <meta property="og:description" content="At midnight there was a cry made — Behold, the bridegroom cometh. The Advent movement of 1844, the 1843 & 1850 prophecy charts, and the sealing of the 144,000 who keep the commandments of God.">
    <meta property="og:image" content="https://sundaylaw.com/images/shield_sundaylaw.com_the_final_warning_logo.jpg">
    <meta property="og:type" content="article">
    <meta property="og:url" content="https://sundaylaw.com/midnight-cry">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="The Midnight Cry — Matthew 25:6 | SundayLaw.com">
    <meta name="twitter:description" content="Behold, the bridegroom cometh — the Advent cry of 1844 and the prophecy charts that made it plain.">
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Article",
      "headline": "The Midnight Cry — Matthew 25:6 & Revelation 14:8",
      "description": "The Midnight Cry of 1844 — hundreds of thousands of Americans awaited the second coming of Christ on October 22, 1844. The 1843 and 1850 prophecy charts, written on tables as commanded in Habakkuk 2:2, proclaimed the hour of God's judgment.",
      "author": { "@type": "Organization", "name": "SundayLaw.com" },
      "publisher": { "@type": "Organization", "name": "SundayLaw.com", "url": "https://sundaylaw.com" },
      "url": "https://sundaylaw.com/midnight-cry",
      "image": "https://sundaylaw.com/images/shield_sundaylaw.com_the_final_warning_logo.jpg"
    }
    </script>
    <Analytics />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Crimson+Text:ital,wght@0,400;0,600;1,400&display=swap" rel="stylesheet">
    <style>
      :root {
        --bg: #0a0a2e;
        --bg-soft: #0d0d3a;
        --ink: #fef3c7;
        --ink-muted: #9ca3af;
        --gold: #d4a537;
        --gold-soft: #fcd34d;
        --amber: #f59e0b;
        --line: rgba(212,165,55,0.22);
        --line-soft: rgba(212,165,55,0.12);
      }

      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
      html { scroll-behavior: smooth; }

      body {
        margin: 0;
        font-family: 'Inter', sans-serif;
        color: var(--ink);
        background: #0a0a2e;
        overflow-x: hidden;
      }

      /* ===== NAV ===== */
      .nav {
        position: sticky;
        top: 0;
        z-index: 100;
        background: rgba(5,5,30,0.94);
        backdrop-filter: blur(12px);
        border-bottom: 1px solid var(--line);
      }

      .nav-wrap { max-width: 1280px; margin: 0 auto; }

      .nav-row {
        display: flex;
        align-items: center;
        padding: 0 22px;
      }

      .nav-row-top {
        gap: 28px;
        height: 62px;
        border-bottom: 1px solid rgba(212,165,55,0.10);
      }

      .nav-row-bottom {
        gap: 22px;
        height: 42px;
        font-size: 0.82rem;
        overflow-x: auto;
        scrollbar-width: none;
      }

      .nav-brand {
        text-decoration: none;
        color: var(--ink);
        font-weight: 700;
        font-size: 1.05rem;
        letter-spacing: 0.02em;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        margin-right: auto;
      }

      .nav-brand img { height: 38px; width: auto; display: block; border-radius: 4px; }

      .nav-link {
        color: var(--ink-muted);
        text-decoration: none;
        font-weight: 600;
        font-size: 0.9rem;
        white-space: nowrap;
        transition: color 0.18s;
      }

      .nav-link:hover { color: var(--gold-soft); }

      .nav-cta {
        display: inline-flex;
        align-items: center;
        height: 38px;
        padding: 0 18px;
        border-radius: 8px;
        background: var(--gold);
        color: #111;
        font-weight: 700;
        font-size: 0.88rem;
        text-decoration: none;
        flex-shrink: 0;
        transition: background 0.18s;
      }

      .nav-cta:hover { background: var(--gold-soft); }

      .nav-bottom-link {
        color: rgba(156,163,175,0.8);
        text-decoration: none;
        font-weight: 500;
        white-space: nowrap;
        transition: color 0.18s;
        flex-shrink: 0;
      }

      .nav-bottom-link:hover { color: var(--gold-soft); }

      .menu-btn {
        display: none;
        width: 40px;
        height: 40px;
        border: 1px solid var(--line);
        border-radius: 8px;
        background: rgba(255,255,255,0.03);
        color: var(--ink);
        font-size: 1.2rem;
        cursor: pointer;
        flex-shrink: 0;
        align-items: center;
        justify-content: center;
      }

      .mobile-nav {
        display: none;
        border-top: 1px solid var(--line);
        padding: 14px 22px 18px;
        background: rgba(5,5,30,0.97);
      }

      .mobile-nav.open { display: grid; gap: 6px; }

      .mobile-nav a {
        color: var(--ink-muted);
        text-decoration: none;
        font-weight: 600;
        padding: 8px 0;
        border-bottom: 1px solid rgba(255,255,255,0.05);
      }

      .mobile-nav a:hover { color: var(--gold-soft); }

      /* ===== HERO ===== */
      .hero {
        position: relative;
        min-height: 92vh;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        background: #04041a;
      }

      .hero-stars {
        position: absolute;
        inset: 0;
        background:
          radial-gradient(ellipse at 20% 30%, rgba(212,165,55,0.06) 0%, transparent 55%),
          radial-gradient(ellipse at 80% 70%, rgba(80,60,200,0.07) 0%, transparent 50%),
          radial-gradient(ellipse at 50% 10%, rgba(255,255,255,0.03) 0%, transparent 40%);
      }

      .hero-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(to bottom,
          rgba(4,4,26,0.30) 0%,
          rgba(4,4,26,0.10) 35%,
          rgba(4,4,26,0.55) 75%,
          rgba(4,4,26,0.98) 100%
        );
        z-index: 1;
      }

      .hero-stripe {
        position: absolute;
        bottom: 0;
        left: 0; right: 0;
        height: 4px;
        background: linear-gradient(to right, transparent, var(--gold), transparent);
        z-index: 3;
      }

      .hero-content {
        position: relative;
        z-index: 2;
        text-align: center;
        max-width: 960px;
        padding: 100px 28px 120px;
      }

      .hero-badge {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        padding: 8px 20px;
        border-radius: 999px;
        border: 1px solid rgba(212,165,55,0.45);
        background: rgba(212,165,55,0.09);
        color: var(--gold-soft);
        font-size: 0.78rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.12em;
        margin-bottom: 32px;
      }

      .hero h1 {
        font-family: 'Crimson Text', serif;
        font-size: clamp(3.8rem, 10vw, 7.5rem);
        font-weight: 600;
        line-height: 0.95;
        letter-spacing: -0.01em;
        color: #fef3c7;
        text-shadow: 0 4px 40px rgba(0,0,0,0.7);
        margin-bottom: 22px;
      }

      .hero h1 .gold { color: var(--gold); }

      .hero-verse {
        font-family: 'Crimson Text', serif;
        font-size: clamp(1.25rem, 3vw, 1.7rem);
        color: rgba(254,243,199,0.88);
        font-style: italic;
        line-height: 1.65;
        max-width: 720px;
        margin: 0 auto 14px;
      }

      .hero-cite {
        display: block;
        font-family: 'Inter', sans-serif;
        font-size: 0.88rem;
        font-style: normal;
        font-weight: 700;
        color: var(--gold-soft);
        letter-spacing: 0.06em;
        text-transform: uppercase;
        margin-bottom: 38px;
      }

      .hero-desc-wrap {
        display: inline-block;
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
        background: rgba(5,5,30,0.55);
        border-radius: 14px;
        padding: 18px 26px;
        margin: 0 auto 36px;
        max-width: 700px;
        border: 1px solid rgba(212,165,55,0.15);
      }

      .hero-desc {
        color: rgba(156,163,175,0.95);
        font-size: 1.02rem;
        line-height: 1.8;
        margin: 0;
      }

      .hero-btns {
        display: flex;
        gap: 14px;
        justify-content: center;
        flex-wrap: wrap;
      }

      .btn-primary {
        display: inline-flex;
        align-items: center;
        height: 52px;
        padding: 0 28px;
        border-radius: 10px;
        background: var(--gold);
        color: #111;
        font-weight: 700;
        font-size: 0.95rem;
        text-decoration: none;
        transition: all 0.2s;
      }

      .btn-primary:hover { background: var(--gold-soft); transform: translateY(-2px); }

      .btn-outline {
        display: inline-flex;
        align-items: center;
        height: 52px;
        padding: 0 28px;
        border-radius: 10px;
        border: 1px solid rgba(254,243,199,0.3);
        color: var(--ink);
        font-weight: 600;
        font-size: 0.95rem;
        text-decoration: none;
        background: rgba(255,255,255,0.04);
        transition: all 0.2s;
      }

      .btn-outline:hover { border-color: var(--gold); color: var(--gold-soft); }

      /* ===== SECTIONS ===== */
      .section { padding: 84px 22px; position: relative; }

      .section-dark {
        background: linear-gradient(to bottom, #0a0a2e, #080828, #0a0a2e);
      }

      .section-warm {
        background: linear-gradient(to bottom, #0a0a2e, #100820, #0a0a2e);
      }

      .section-midnight {
        background: linear-gradient(to bottom, #04041c, #06062a, #04041c);
      }

      .section-inner { max-width: 1200px; margin: 0 auto; }
      .section-narrow { max-width: 920px; margin: 0 auto; }

      .section-stripe-top {
        position: absolute;
        top: 0; left: 0; right: 0;
        height: 3px;
        background: linear-gradient(to right, transparent, rgba(212,165,55,0.35), transparent);
      }

      /* ===== SECTION HEADINGS ===== */
      .sh { text-align: center; margin-bottom: 52px; }

      .sh-eyebrow {
        display: inline-block;
        padding: 6px 16px;
        border-radius: 999px;
        background: rgba(212,165,55,0.10);
        border: 1px solid rgba(212,165,55,0.28);
        color: var(--gold-soft);
        font-size: 0.76rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        margin-bottom: 16px;
      }

      .sh h2 {
        font-family: 'Crimson Text', serif;
        font-size: clamp(2rem, 4.5vw, 3.2rem);
        font-weight: 600;
        color: #fef3c7;
        line-height: 1.15;
      }

      .sh p {
        margin-top: 14px;
        color: var(--ink-muted);
        font-size: 1.05rem;
        line-height: 1.8;
        max-width: 720px;
        margin-left: auto;
        margin-right: auto;
      }

      .sh-divider {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 14px;
        margin-bottom: 16px;
      }

      .sh-line { height: 1px; width: 52px; background: rgba(212,165,55,0.4); }

      /* ===== SCRIPTURE SHOWCASES ===== */
      .scripture-showcase {
        border: 1px solid rgba(212,165,55,0.35);
        border-radius: 20px;
        padding: 44px 40px;
        background: linear-gradient(135deg, rgba(18,12,0,0.85), rgba(6,6,28,0.92));
        text-align: center;
        margin-bottom: 32px;
        position: relative;
        overflow: hidden;
      }

      .scripture-showcase::before {
        content: '';
        position: absolute;
        inset: 0;
        background: radial-gradient(ellipse at center top, rgba(212,165,55,0.05), transparent 65%);
        pointer-events: none;
      }

      .scripture-showcase .sc-ref {
        display: inline-block;
        font-size: 0.76rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.12em;
        color: var(--gold-soft);
        padding: 5px 14px;
        border: 1px solid rgba(212,165,55,0.3);
        border-radius: 999px;
        background: rgba(212,165,55,0.08);
        margin-bottom: 22px;
      }

      .scripture-showcase blockquote {
        font-family: 'Crimson Text', serif;
        font-size: clamp(1.4rem, 3.2vw, 2rem);
        font-weight: 400;
        font-style: italic;
        color: #fef3c7;
        line-height: 1.65;
        margin: 0 auto 20px;
        max-width: 820px;
        text-shadow: 0 2px 16px rgba(0,0,0,0.4);
      }

      .scripture-showcase blockquote .highlight {
        color: var(--gold);
        font-style: italic;
      }

      .scripture-showcase cite {
        font-family: 'Inter', sans-serif;
        font-size: 0.88rem;
        font-style: normal;
        font-weight: 700;
        color: var(--gold-soft);
        text-transform: uppercase;
        letter-spacing: 0.08em;
      }

      /* ===== QUOTE BLOCKS ===== */
      .qb {
        border-left: 4px solid rgba(212,165,55,0.5);
        padding: 20px 20px 20px 24px;
        border-radius: 0 10px 10px 0;
        margin-bottom: 22px;
        background: rgba(212,165,55,0.06);
      }

      .qb p {
        font-family: 'Crimson Text', serif;
        font-size: 1.15rem;
        line-height: 1.75;
        color: rgba(254,243,199,0.92);
        font-style: italic;
        margin: 0;
      }

      .qb cite {
        display: block;
        margin-top: 10px;
        color: var(--gold-soft);
        font-size: 0.85rem;
        font-weight: 700;
        font-style: normal;
      }

      /* ===== HABAKKUK TABLES ===== */
      .hab-section {
        background: linear-gradient(135deg, rgba(10,8,26,0.95), rgba(6,4,20,0.98));
        border: 1px solid rgba(100,80,200,0.3);
        border-radius: 20px;
        padding: 44px 40px;
        margin-bottom: 32px;
        position: relative;
        overflow: hidden;
      }

      .hab-section::before {
        content: '';
        position: absolute;
        inset: 0;
        background: radial-gradient(ellipse at top right, rgba(100,80,200,0.06), transparent 60%);
        pointer-events: none;
      }

      .hab-section .hab-ref {
        display: inline-block;
        font-size: 0.76rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.12em;
        color: #a78bfa;
        padding: 5px 14px;
        border: 1px solid rgba(167,139,250,0.3);
        border-radius: 999px;
        background: rgba(167,139,250,0.08);
        margin-bottom: 22px;
      }

      .hab-verse {
        font-family: 'Crimson Text', serif;
        font-size: clamp(1.25rem, 2.8vw, 1.65rem);
        font-style: italic;
        color: rgba(254,243,199,0.90);
        line-height: 1.7;
        margin-bottom: 10px;
      }

      .hab-verse .tables-word {
        color: var(--gold);
        font-style: italic;
        font-weight: 600;
        text-decoration: underline;
        text-decoration-color: rgba(212,165,55,0.45);
        text-underline-offset: 4px;
      }

      .hab-verse-num {
        font-family: 'Inter', sans-serif;
        font-size: 0.78rem;
        font-style: normal;
        font-weight: 700;
        color: #a78bfa;
        margin-right: 8px;
      }

      .tables-fulfillment {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 18px;
        margin-top: 32px;
      }

      .tf-card {
        background: linear-gradient(135deg, rgba(22,14,2,0.9), rgba(8,8,32,0.9));
        border: 1px solid rgba(212,165,55,0.35);
        border-radius: 14px;
        padding: 24px 20px;
        text-align: center;
        transition: all 0.25s;
      }

      .tf-card:hover { border-color: rgba(212,165,55,0.7); transform: translateY(-3px); }

      .tf-year {
        font-family: 'Crimson Text', serif;
        font-size: 2.6rem;
        font-weight: 600;
        color: var(--gold);
        line-height: 1;
        display: block;
        margin-bottom: 6px;
      }

      .tf-card h4 {
        font-family: 'Crimson Text', serif;
        font-size: 1.2rem;
        color: #fef3c7;
        margin-bottom: 8px;
      }

      .tf-card p {
        font-size: 0.9rem;
        color: var(--ink-muted);
        line-height: 1.65;
        margin-bottom: 14px;
      }

      .tf-card a {
        display: inline-flex;
        align-items: center;
        height: 36px;
        padding: 0 16px;
        border-radius: 8px;
        background: var(--gold);
        color: #111;
        font-weight: 700;
        font-size: 0.82rem;
        text-decoration: none;
        transition: background 0.18s;
      }

      .tf-card a:hover { background: var(--gold-soft); }

      /* ===== TARRYING TIME TIMELINE ===== */
      .timeline {
        position: relative;
        padding-left: 32px;
        margin-bottom: 32px;
      }

      .timeline::before {
        content: '';
        position: absolute;
        left: 10px;
        top: 8px;
        bottom: 8px;
        width: 2px;
        background: linear-gradient(to bottom, var(--gold), rgba(212,165,55,0.2));
      }

      .tl-item {
        position: relative;
        margin-bottom: 32px;
      }

      .tl-item::before {
        content: '';
        position: absolute;
        left: -26px;
        top: 6px;
        width: 12px;
        height: 12px;
        border-radius: 50%;
        background: var(--gold);
        border: 2px solid #0a0a2e;
        box-shadow: 0 0 10px rgba(212,165,55,0.5);
      }

      .tl-date {
        font-size: 0.78rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        color: var(--gold-soft);
        margin-bottom: 6px;
      }

      .tl-item h4 {
        font-family: 'Crimson Text', serif;
        font-size: 1.3rem;
        font-weight: 600;
        color: #fef3c7;
        margin-bottom: 8px;
      }

      .tl-item p {
        color: var(--ink-muted);
        font-size: 0.95rem;
        line-height: 1.75;
      }

      /* ===== SABBATH TRUTH BOX ===== */
      .sabbath-box {
        border: 2px solid rgba(212,165,55,0.5);
        border-radius: 20px;
        padding: 40px 36px;
        background: linear-gradient(135deg, rgba(28,20,0,0.88), rgba(8,8,30,0.92));
        position: relative;
        overflow: hidden;
        margin-top: 32px;
      }

      .sabbath-box::before {
        content: '';
        position: absolute;
        inset: 0;
        background: radial-gradient(ellipse at center, rgba(212,165,55,0.05), transparent 70%);
        pointer-events: none;
      }

      .sab-label {
        display: inline-block;
        font-size: 0.76rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.12em;
        color: var(--gold-soft);
        padding: 5px 14px;
        border: 1px solid rgba(212,165,55,0.4);
        border-radius: 999px;
        background: rgba(212,165,55,0.1);
        margin-bottom: 18px;
      }

      .sabbath-box h3 {
        font-family: 'Crimson Text', serif;
        font-size: clamp(1.6rem, 3.5vw, 2.2rem);
        font-weight: 600;
        color: #fef3c7;
        line-height: 1.2;
        margin-bottom: 16px;
      }

      .sab-times {
        display: grid;
        grid-template-columns: 1fr 1fr 1fr;
        gap: 16px;
        margin: 24px 0;
      }

      .sab-time {
        background: rgba(0,0,0,0.3);
        border-radius: 12px;
        border: 1px solid rgba(212,165,55,0.2);
        padding: 18px 14px;
        text-align: center;
      }

      .sab-time .sab-day {
        font-family: 'Crimson Text', serif;
        font-size: 1.4rem;
        font-weight: 600;
        color: var(--gold);
        display: block;
        margin-bottom: 5px;
      }

      .sab-time .sab-desc {
        font-size: 0.82rem;
        color: var(--ink-muted);
        line-height: 1.5;
      }

      .sab-proof-list {
        list-style: none;
        padding: 0;
        margin: 20px 0 0;
        display: grid;
        gap: 10px;
      }

      .sab-proof-list li {
        display: flex;
        gap: 10px;
        align-items: flex-start;
        color: var(--ink-muted);
        font-size: 0.95rem;
        line-height: 1.65;
      }

      .sab-proof-list li::before {
        content: '›';
        color: var(--gold);
        flex-shrink: 0;
        font-weight: 700;
        font-size: 1.1rem;
      }

      /* ===== 144,000 SECTION ===== */
      .sealed-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 20px;
        margin: 32px 0;
      }

      .sealed-card {
        border: 1px solid var(--line);
        border-radius: 16px;
        padding: 26px 20px;
        background: linear-gradient(135deg, rgba(20,20,60,0.8), rgba(10,10,40,0.8));
        transition: all 0.25s;
      }

      .sealed-card:hover {
        border-color: rgba(212,165,55,0.45);
        transform: translateY(-3px);
      }

      .sealed-card .sc-num {
        font-family: 'Crimson Text', serif;
        font-size: 2.2rem;
        font-weight: 600;
        color: var(--gold);
        line-height: 1;
        margin-bottom: 8px;
        display: block;
      }

