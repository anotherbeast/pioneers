---
import Analytics from '../components/Analytics.astro';
import ShareBar from '../components/ShareBar.astro';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <Analytics />
    <title>April 15, 1904 Incorporation Record | General Conference Corporation | SundayLaw.com</title>
    <meta
      name="description"
      content="The April 15, 1904 Articles of Incorporation of the General Conference Corporation of Seventh-day Adventists — primary source evidence, signers, and Ellen White's 1905 warning against it."
    />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="keywords" content="April 15 1904 incorporation, General Conference Corporation of Seventh-day Adventists, 1904 new organization, Ellen White new organization warning, GCC incorporation record, when was the General Conference incorporated" />
    <link rel="canonical" href="https://sundaylaw.com/april-15-1904-new-organization/" />
    <meta property="og:site_name" content="SundayLaw.com">
    <meta property="og:title" content="April 15, 1904 — The Incorporation Record | SundayLaw.com">
    <meta property="og:description" content="The April 15, 1904 Articles of Incorporation of the General Conference Corporation of Seventh-day Adventists — the record Ellen White warned against.">
    <meta property="og:image" content="https://sundaylaw.com/images/1904-image-of-papacy/april-15-1904-general-conference-corporation-incorporation-record.jpg">
    <meta property="og:image:secure_url" content="https://sundaylaw.com/images/1904-image-of-papacy/april-15-1904-general-conference-corporation-incorporation-record.jpg">
    <meta property="og:image:type" content="image/jpeg">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:image:alt" content="April 15, 1904 incorporation record of the General Conference Corporation of Seventh-day Adventists">
    <meta property="og:type" content="article">
    <meta property="og:url" content="https://sundaylaw.com/april-15-1904-new-organization/">
    <meta property="og:locale" content="en_US">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="April 15, 1904 — The Incorporation Record | SundayLaw.com">
    <meta name="twitter:description" content="The April 15, 1904 Articles of Incorporation of the General Conference Corporation of Seventh-day Adventists — the record Ellen White warned against.">
    <meta name="twitter:image" content="https://sundaylaw.com/images/1904-image-of-papacy/april-15-1904-general-conference-corporation-incorporation-record.jpg">
    <meta name="twitter:image:alt" content="April 15, 1904 incorporation record of the General Conference Corporation of Seventh-day Adventists">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Article",
      "headline": "April 15, 1904 Incorporation Record — General Conference Corporation of Seventh-day Adventists",
      "description": "The April 15, 1904 Articles of Incorporation of the General Conference Corporation of Seventh-day Adventists — primary source evidence, signers, and Ellen White's 1905 warning against it.",
      "image": "https://sundaylaw.com/images/1904-image-of-papacy/april-15-1904-general-conference-corporation-incorporation-record.jpg",
      "datePublished": "2026-01-01",
      "mainEntityOfPage": "https://sundaylaw.com/april-15-1904-new-organization/",
      "publisher": { "@type": "Organization", "name": "SundayLaw.com" }
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://sundaylaw.com/" },
        { "@type": "ListItem", "position": 2, "name": "April 15, 1904 Incorporation Record", "item": "https://sundaylaw.com/april-15-1904-new-organization/" }
      ]
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What happened on April 15, 1904?",
          "acceptedAnswer": { "@type": "Answer", "text": "On April 15, 1904, the Articles of Incorporation of the General Conference Corporation of Seventh-day Adventists were signed in Washington, D.C., legally incorporating the General Conference." }
        },
        {
          "@type": "Question",
          "name": "Who signed the 1904 incorporation record?",
          "acceptedAnswer": { "@type": "Answer", "text": "The 1904 incorporation record was signed by James R. Scott, Harvey Edson Rogers, Daniel K. Nicola, Arthur G. Daniells, and Amos P. Needham — five D.C. residents selected in 1903 to meet legal residency requirements." }
        },
        {
          "@type": "Question",
          "name": "What did Ellen White say about the 1904 new organization?",
          "acceptedAnswer": { "@type": "Answer", "text": "In Manuscript 129, 1905, Ellen White warned, \"We cannot now enter into any new organization; for this would mean apostasy from the truth,\" referring to the church's incorporation." }
        }
      ]
    })} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&family=Source+Sans+3:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <style>
      :root {
        --bg: #060b17;
        --ink: #f8f1dd;
        --muted: #d3c39d;
        --line: rgba(214, 167, 69, 0.28);
        --gold: #d6a745;
        --amber: #f0be5c;
      }

      * { box-sizing: border-box; }

      body {
        margin: 0;
        color: var(--ink);
        font-family: 'Source Sans 3', sans-serif;
        background:
          radial-gradient(circle at 80% 16%, rgba(214, 167, 69, 0.14), transparent 35%),
          radial-gradient(circle at 17% 82%, rgba(92, 111, 160, 0.16), transparent 42%),
          linear-gradient(160deg, #050914 0%, #091125 52%, #060b16 100%);
      }

      .serif { font-family: 'Cormorant Garamond', serif; }

      .topbar {
        position: sticky;
        top: 0;
        z-index: 32;
        backdrop-filter: blur(10px);
        background: rgba(6, 11, 23, 0.76);
        border-bottom: 1px solid var(--line);
      }

      .topbar-inner {
        max-width: 1160px;
        margin: 0 auto;
        padding: 14px 20px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
      }

      .brand {
        color: var(--ink);
        text-decoration: none;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        font-size: 0.9rem;
      }

      .brand strong { color: var(--amber); }

      .toplinks {
        display: flex;
        gap: 14px;
      }

      .toplinks a {
        color: var(--muted);
        text-decoration: none;
        font-weight: 600;
      }

      .toplinks a:hover { color: var(--amber); }

      .hero {
        max-width: 1160px;
        margin: 28px auto 0;
        padding: 0 20px;
      }

      .hero-card {
        border: 1px solid var(--line);
        border-radius: 24px;
        padding: 40px 32px;
        background: linear-gradient(150deg, rgba(16, 24, 45, 0.94), rgba(8, 12, 24, 0.9));
        box-shadow: 0 22px 66px rgba(0, 0, 0, 0.45);
      }

      .eyebrow {
        display: inline-block;
        padding: 8px 14px;
        border-radius: 999px;
        border: 1px solid var(--line);
        color: var(--amber);
        letter-spacing: 0.1em;
        text-transform: uppercase;
        font-size: 0.75rem;
        font-weight: 700;
      }

      h1 {
        margin: 14px 0 0;
        font-size: clamp(2.1rem, 6vw, 3.8rem);
        line-height: 1;
      }

      h1 span { color: var(--amber); }

      .lead {
        margin: 16px 0 0;
        color: var(--muted);
        font-size: 1.13rem;
        line-height: 1.75;
        max-width: 74ch;
      }

      .layout {
        max-width: 1160px;
        margin: 18px auto 60px;
        padding: 0 20px;
        display: grid;
        gap: 14px;
      }

      .section {
        border: 1px solid var(--line);
        border-radius: 18px;
        background: rgba(13, 19, 36, 0.86);
        padding: 22px;
      }

      .section h2 {
        margin: 0;
        color: var(--amber);
        font-size: 1.7rem;
      }

      .section p {
        margin: 12px 0 0;
        color: var(--muted);
        line-height: 1.82;
      }

      .proof-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 12px;
        margin-top: 14px;
      }

      .proof-card {
        border: 1px solid var(--line);
        border-radius: 12px;
        background: rgba(255, 255, 255, 0.02);
        padding: 14px;
      }

      .proof-card h3 {
        margin: 0;
        font-size: 1.08rem;
        color: #f8dc97;
      }

      .proof-card p {
        margin: 10px 0 0;
        color: var(--muted);
        line-height: 1.72;
      }

      .proof-card p a {
        color: var(--gold);
        text-decoration: underline;
        text-decoration-color: rgba(212, 165, 55, 0.4);
        text-underline-offset: 3px;
        transition: color 0.15s, text-decoration-color 0.15s;
      }

      .proof-card p a:hover {
        color: #fcd34d;
        text-decoration-color: rgba(252, 211, 77, 0.7);
      }

      .quote {
        margin-top: 14px;
        border-left: 4px solid var(--gold);
        border-radius: 0 10px 10px 0;
        padding: 14px;
        background: rgba(214, 167, 69, 0.1);
      }

      .quote p {
        margin: 0;
        color: #f8e8be;
        font-style: italic;
      }

      .quote cite {
        display: block;
        margin-top: 8px;
        font-style: normal;
        color: var(--amber);
        font-weight: 700;
      }

      .image-grid {
        margin-top: 14px;
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 10px;
      }

      .image-grid img {
        width: 100%;
        border-radius: 12px;
        border: 1px solid var(--line);
        background: #0b1220;
        display: block;
      }

      .links {
        margin-top: 12px;
        display: grid;
        gap: 8px;
      }

      .links a {
        color: var(--amber);
        text-decoration: none;
        font-weight: 600;
      }

      .links a:hover { text-decoration: underline; }

      .small {
        margin-top: 12px;
        color: #9ca3af;
        font-size: 0.92rem;
      }

      @media (max-width: 900px) {
        .proof-grid,
        .image-grid { grid-template-columns: 1fr; }
        .hero-card { padding: 30px 22px; }
      }

      /* ===== NEW SECTION STYLES ===== */
      .new-section {
        max-width: 1160px;
        margin: 0 auto 0;
        padding: 0 20px;
      }

      /* EGW Storm & Tempest mega quote */
      .mega-quote-wrap {
        margin: 10px 0 0;
        border: 2px solid rgba(214,167,69,0.55);
        border-radius: 22px;
        background: linear-gradient(135deg, #1a0c00 0%, #0d0a06 45%, #090e1e 100%);
        padding: 52px 44px;
        text-align: center;
        position: relative;
        overflow: hidden;
        box-shadow: 0 0 60px rgba(214,167,69,0.12), 0 24px 60px rgba(0,0,0,0.55);
      }

      .mega-quote-wrap::before {
        content: '';
        position: absolute;
        inset: 0;
        background: radial-gradient(ellipse at 50% 30%, rgba(214,167,69,0.1) 0%, transparent 60%);
        pointer-events: none;
      }

      .mega-quote-icon {
        display: flex;
        justify-content: center;
        margin-bottom: 22px;
        color: var(--gold);
      }

      .mega-quote-text {
        font-family: 'Cormorant Garamond', serif;
        font-size: clamp(1.55rem, 3.8vw, 2.5rem);
        font-weight: 600;
        font-style: italic;
        color: #fef3c7;
        line-height: 1.5;
        letter-spacing: -0.01em;
        margin: 0 0 20px;
        position: relative;
        z-index: 1;
      }

      .mega-quote-cite {
        display: block;
        color: var(--amber);
        font-size: 1rem;
        font-weight: 700;
        font-style: normal;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        position: relative;
        z-index: 1;
      }

      /* Constitution / Religious Liberty banner */
      .constitution-wrap {
        margin: 18px 0 0;
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 18px;
        align-items: stretch;
      }

      .constitution-quote {
        border: 2px solid rgba(59,130,246,0.45);
        border-radius: 18px;
        background: linear-gradient(135deg, #030b1f 0%, #050c20 100%);
        padding: 34px 30px;
        position: relative;
        overflow: hidden;
      }

      .constitution-quote::before {
        content: '';
        position: absolute;
        inset: 0;
        background: radial-gradient(ellipse at 20% 40%, rgba(59,130,246,0.1), transparent 55%);
        pointer-events: none;
      }

      .constitution-eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 6px 14px;
        border-radius: 999px;
        background: rgba(59,130,246,0.12);
        border: 1px solid rgba(59,130,246,0.3);
        color: #93c5fd;
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        margin-bottom: 18px;
        position: relative;
        z-index: 1;
      }

      .constitution-text {
        font-family: 'Cormorant Garamond', serif;
        font-size: clamp(1.2rem, 2.4vw, 1.65rem);
        font-weight: 600;
        font-style: italic;
        color: #e2e8f0;
        line-height: 1.65;
        margin: 0 0 16px;
        position: relative;
        z-index: 1;
      }

      .constitution-cite {
        display: block;
        color: #93c5fd;
        font-size: 0.88rem;
        font-weight: 700;
        font-style: normal;
        text-transform: uppercase;
        letter-spacing: 0.07em;
        position: relative;
        z-index: 1;
      }

      .constitution-img-wrap {
        border-radius: 18px;
        overflow: hidden;
        border: 2px solid rgba(59,130,246,0.25);
        position: relative;
      }

      .constitution-img-wrap img {
        width: 100%;
        height: auto;
        max-height: 520px;
        object-fit: contain;
        object-position: center;
        display: block;
        background: #07000f;
      }

      .constitution-img-label {
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        background: linear-gradient(to top, rgba(3,11,31,0.95), transparent);
        padding: 22px 18px 16px;
        font-size: 0.85rem;
        font-weight: 700;
        color: #93c5fd;
        text-transform: uppercase;
        letter-spacing: 0.07em;
      }

      /* James White on church & state */
      .james-white-banner {
        margin: 18px 0 0;
        border-left: 5px solid rgba(214,167,69,0.6);
        border-radius: 0 16px 16px 0;
        background: linear-gradient(135deg, #120d00, #090c1d);
        padding: 28px 28px 28px 30px;
      }

      .james-white-banner p {
        font-family: 'Cormorant Garamond', serif;
        font-size: clamp(1.1rem, 2vw, 1.4rem);
        font-style: italic;
        color: rgba(254,243,199,0.92);
        line-height: 1.75;
        margin: 0 0 12px;
      }

      .james-white-banner cite {
        color: var(--amber);
        font-size: 0.88rem;
        font-weight: 700;
        font-style: normal;
        text-transform: uppercase;
        letter-spacing: 0.07em;
      }

      /* Pioneer Resource Links Grid */
      .pioneer-links-wrap {
        margin: 18px 0 0;
        border: 1px solid var(--line);
        border-radius: 18px;
        background: rgba(13,19,36,0.86);
        padding: 28px 26px;
      }

      .pioneer-links-wrap h2 {
        font-family: 'Cormorant Garamond', serif;
        color: var(--amber);
        font-size: 1.7rem;
        margin: 0 0 6px;
      }

      .pioneer-links-wrap .plinks-sub {
        color: #9ca3af;
        font-size: 0.95rem;
        margin: 0 0 20px;
        line-height: 1.7;
      }

      .plinks-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 12px;
      }

      .plink-card {
        border: 1px solid rgba(214,167,69,0.2);
        border-radius: 12px;
        padding: 16px 14px;
        background: rgba(255,255,255,0.03);
        text-decoration: none;
        transition: all 0.2s;
        display: flex;
        flex-direction: column;
        gap: 6px;
      }

      .plink-card:hover {
        border-color: rgba(214,167,69,0.55);
        background: rgba(214,167,69,0.07);
        transform: translateY(-2px);
      }

      .plink-label {
        color: #9ca3af;
        font-size: 0.72rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.09em;
      }

      .plink-title {
        color: #f0cf7b;
        font-size: 0.92rem;
        font-weight: 600;
        line-height: 1.4;
      }

      /* 1850 Chart showcase */
      .chart-showcase-wrap {
        margin: 18px 0 0;
        border: 2px solid rgba(214,167,69,0.4);
        border-radius: 22px;
        overflow: hidden;
        background: #000;
      }

      .chart-showcase-header {
        background: linear-gradient(135deg, #1a0f00, #0d0a06);
        padding: 28px 28px 20px;
        border-bottom: 1px solid rgba(214,167,69,0.3);
      }

      .chart-showcase-header h2 {
        font-family: 'Cormorant Garamond', serif;
        font-size: clamp(1.5rem, 3vw, 2.2rem);
        color: var(--amber);
        margin: 0 0 8px;
      }

      .chart-showcase-header p {
        color: #c5bb95;
        font-size: 0.97rem;
        line-height: 1.75;
        margin: 0;
        max-width: 800px;
      }

      .chart-showcase-img {
        width: 100%;
        display: block;
        max-height: 760px;
        object-fit: contain;
        background: #050810;
      }

      /* Image of Papacy callout */
      .image-papacy-callout {
        background: linear-gradient(135deg, #1a0000, #0d0a06 50%, #090e1e);
        border-top: 1px solid rgba(214,167,69,0.3);
        padding: 28px 28px;
      }

      .image-papacy-callout h3 {
        font-family: 'Cormorant Garamond', serif;
        font-size: 1.65rem;
        color: #f87171;
        margin: 0 0 16px;
      }

      .image-papacy-callout .rev-text {
        font-family: 'Cormorant Garamond', serif;
        font-size: 1.12rem;
        font-style: italic;
        color: rgba(254,243,199,0.9);
        line-height: 1.8;
        margin: 0 0 14px;
        border-left: 3px solid rgba(239,68,68,0.5);
        padding-left: 16px;
      }

      .image-papacy-callout .rev-cite {
        color: #f87171;
        font-size: 0.84rem;
        font-weight: 700;
        font-style: normal;
        text-transform: uppercase;
        letter-spacing: 0.07em;
        display: block;
        margin-bottom: 18px;
        padding-left: 16px;
      }

      .image-papacy-callout p {
        color: #d3c39d;
        line-height: 1.82;
        margin: 0 0 12px;
        font-size: 0.97rem;
      }

      .papacy-definition-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 12px;
        margin-top: 18px;
      }

      .papacy-def-card {
        border-radius: 12px;
        padding: 18px 16px;
      }

      .papacy-def-card.roman {
        background: rgba(127,29,29,0.25);
        border: 1px solid rgba(239,68,68,0.3);
      }

      .papacy-def-card.american {
        background: rgba(29,78,216,0.2);
        border: 1px solid rgba(59,130,246,0.3);
      }

      .papacy-def-card h4 {
        font-family: 'Cormorant Garamond', serif;
        font-size: 1.2rem;
        margin: 0 0 10px;
      }

      .papacy-def-card.roman h4 { color: #f87171; }
      .papacy-def-card.american h4 { color: #93c5fd; }

      .papacy-def-card ul {
        list-style: none;
        padding: 0;
        margin: 0;
        display: grid;
        gap: 7px;
      }

      .papacy-def-card ul li {
        display: flex;
        gap: 8px;
        color: #d3c39d;
        font-size: 0.9rem;
        line-height: 1.6;
      }

      .papacy-def-card ul li::before { content: '›'; font-weight: 700; flex-shrink: 0; }
      .papacy-def-card.roman ul li::before { color: #f87171; }
      .papacy-def-card.american ul li::before { color: #93c5fd; }

      /* Mayflower section */
      .mayflower-wrap {
        margin: 18px 0 0;
        display: grid;
        grid-template-columns: 340px 1fr;
        gap: 18px;
        align-items: start;
      }

      .mayflower-img-wrap {
        border-radius: 18px;
        overflow: hidden;
        border: 2px solid rgba(214,167,69,0.25);
        position: relative;
        max-height: 420px;
      }

      .mayflower-img-wrap img {
        width: 100%;
        height: auto;
        display: block;
      }

      .mayflower-img-label {
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        background: linear-gradient(to top, rgba(6,11,23,0.95), transparent);
        padding: 22px 16px 14px;
        font-size: 0.8rem;
        font-weight: 700;
        color: var(--amber);
        text-transform: uppercase;
        letter-spacing: 0.07em;
      }

      .mayflower-content {
        border: 1px solid var(--line);
        border-radius: 18px;
        background: rgba(13,19,36,0.86);
        padding: 28px 24px;
        display: flex;
        flex-direction: column;
        gap: 14px;
      }

      .mayflower-content h2 {
        font-family: 'Cormorant Garamond', serif;
        font-size: 1.75rem;
        color: var(--amber);
        margin: 0;
      }

      .mayflower-content p {
        color: #c5bb95;
        line-height: 1.82;
        margin: 0;
        font-size: 0.97rem;
      }

      .mayflower-content .warn-box {
        background: rgba(127,29,29,0.2);
        border: 1px solid rgba(239,68,68,0.3);
        border-radius: 10px;
        padding: 14px 16px;
        color: #fca5a5;
        font-size: 0.92rem;
        font-weight: 600;
        line-height: 1.65;
      }

      /* Yearbook embed */
      .yearbook-wrap {
        margin: 18px 0 0;
        border: 2px solid rgba(214,167,69,0.4);
        border-radius: 22px;
        overflow: hidden;
        background: #000;
      }

      .yearbook-header {
        background: linear-gradient(135deg, #1a0f00, #0d0a06);
        padding: 26px 28px 18px;
