    .charge-sub { font-size: 0.97rem; color: rgba(248,241,221,0.78); line-height: 1.85; margin-bottom: 22px; }
    .fact-row { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 10px; }
    .fact-box { background: rgba(13,5,25,0.7); border: 1px solid var(--line-soft); border-radius: 10px; padding: 11px 13px; }
