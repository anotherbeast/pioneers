    .breadcrumb { padding: 22px 0 0; font-size: 0.8rem; color: var(--muted); }
    .breadcrumb a { color: var(--muted); } .breadcrumb span { margin: 0 6px; }
    .breadcrumb .current { color: var(--ink); }
