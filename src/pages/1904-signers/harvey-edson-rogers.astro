    .signer-badge { display: inline-flex; align-items: center; gap: 8px; padding: 6px 16px; border-radius: 999px; background: rgba(127,29,29,0.35); border: 1px solid var(--line-red); color: var(--red-soft); font-size: 0.73rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.14em; margin-bottom: 16px; }
    .hero-grid { display: grid; grid-template-columns: 260px 1fr; gap: 44px; align-items: start; }
    @media (max-width: 768px) { .hero-grid { grid-template-columns: 1fr; } }
