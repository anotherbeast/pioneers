---
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const pioneers = await getCollection('pioneers');

  return pioneers.map((pioneer) => ({
    params: { slug: pioneer.id },
    props: { pioneer },
  }));
}

const { pioneer } = Astro.props;
const { Content } = await render(pioneer);

const name = pioneer.data.name ?? 'Unknown Pioneer';
const title = pioneer.data.title ?? '';
const birth = pioneer.data.birth ?? '';
const death = pioneer.data.death ?? '';
const image = pioneer.data.image ?? '';
const summary = pioneer.data.summary ?? '';
const fullTitle =
  birth && death ? `${name} (${birth}–${death})` : name;

const pageTitle = `${name} | Advent Pioneer Library`;
const pageDescription =
  summary ||
  `${name}${title ? ` — ${title}` : ''}. Read biography, historical details, and related Advent Pioneer material.`;

const imageSrc = image
  ? image.startsWith('http://') ||
    image.startsWith('https://') ||
    image.startsWith('/')
    ? image
    : `/${image}`
  : '';

const relatedBooks = pioneer.data.relatedBooks ?? [];
const relatedCharts = pioneer.data.relatedCharts ?? [];
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />

    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content="article" />
    {imageSrc && <meta property="og:image" content={imageSrc} />}

    <style>
      :root {
        --bg: #0b0b0d;
        --panel: #131317;
        --panel-2: #1a1a20;
        --gold: #d4af37;
        --gold-soft: #f0d57a;
        --text: #f5f0df;
        --muted: #bdb6a0;
        --line: rgba(212, 175, 55, 0.22);
        --shadow: 0 18px 55px rgba(0, 0, 0, 0.45);
        --radius: 18px;
        --max: 1180px;
      }

      * {
        box-sizing: border-box;
      }

      html,
      body {
        margin: 0;
        padding: 0;
        background:
          radial-gradient(circle at top, rgba(212, 175, 55, 0.09), transparent 32%),
          linear-gradient(180deg, #0a0a0c 0%, #111116 100%);
        color: var(--text);
        font-family: Georgia, "Times New Roman", serif;
      }

      a {
        color: var(--gold-soft);
        text-decoration: none;
      }

      a:hover {
        text-decoration: underline;
      }

      img {
        max-width: 100%;
        display: block;
      }

      .container {
        width: min(var(--max), calc(100% - 28px));
        margin: 0 auto;
      }

      .site-header {
        position: sticky;
        top: 0;
        z-index: 50;
        backdrop-filter: blur(10px);
        background: rgba(10, 10, 12, 0.88);
        border-bottom: 1px solid var(--line);
      }

      .site-header-inner {
        display: flex;
        align-items: center;
        gap: 18px;
        justify-content: space-between;
        padding: 14px 0;
        flex-wrap: wrap;
      }

      .header-title {
        font-size: 1.2rem;
        font-weight: 700;
        letter-spacing: 0.02em;
        color: var(--text);
        white-space: nowrap;
      }

      .header-title strong {
        color: var(--gold);
      }

      .header-links {
        display: flex;
        gap: 16px;
        flex-wrap: wrap;
        align-items: center;
      }

      .header-links a {
        color: var(--muted);
        font-size: 0.98rem;
      }

      .header-links a:hover {
        color: var(--gold-soft);
        text-decoration: none;
      }

      .header-tools {
        display: flex;
        align-items: center;
        gap: 10px;
      }

      .lang-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 42px;
        height: 34px;
        padding: 0 10px;
        border: 1px solid var(--line);
        border-radius: 999px;
        background: rgba(212, 175, 55, 0.08);
        color: var(--gold-soft);
        font-size: 0.85rem;
        font-weight: 700;
      }

      .menu-btn {
        display: none;
        border: 1px solid var(--line);
        background: rgba(212, 175, 55, 0.08);
        color: var(--gold-soft);
        border-radius: 10px;
        padding: 8px 12px;
        cursor: pointer;
        font-size: 1rem;
      }

      .breadcrumb {
        width: 100%;
        color: var(--muted);
        font-size: 0.92rem;
        padding-top: 2px;
      }

      .breadcrumb a {
        color: var(--gold-soft);
      }

      .mobile-nav {
        display: none;
        padding: 0 0 14px;
        flex-direction: column;
        gap: 10px;
      }

      .mobile-nav a {
        display: block;
        padding: 10px 12px;
        border: 1px solid var(--line);
        border-radius: 12px;
        background: rgba(212, 175, 55, 0.05);
        color: var(--text);
      }

      .hero {
        padding: 46px 0 28px;
      }

      .hero-card {
        display: grid;
        grid-template-columns: minmax(260px, 390px) minmax(0, 1fr);
        gap: 26px;
        align-items: stretch;
        background: linear-gradient(180deg, rgba(24, 24, 29, 0.92), rgba(14, 14, 18, 0.96));
        border: 1px solid var(--line);
        border-radius: 26px;
        overflow: hidden;
        box-shadow: var(--shadow);
      }

      .hero-media {
        min-height: 100%;
        background:
          linear-gradient(180deg, rgba(212, 175, 55, 0.08), rgba(0, 0, 0, 0.18)),
          #101014;
        border-right: 1px solid var(--line);
      }

      .hero-media img {
        width: 100%;
        height: 100%;
        object-fit: cover;
      }

      .hero-media-fallback {
        height: 100%;
        min-height: 430px;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 24px;
        text-align: center;
        color: var(--gold-soft);
        font-size: 1.35rem;
        line-height: 1.35;
        background:
          radial-gradient(circle at center, rgba(212, 175, 55, 0.12), transparent 55%),
          linear-gradient(180deg, #111116 0%, #0d0d11 100%);
      }

      .hero-content {
        padding: 34px 32px 32px;
      }

      .eyebrow {
        display: inline-block;
        margin-bottom: 12px;
        padding: 6px 12px;
        border-radius: 999px;
        border: 1px solid var(--line);
        background: rgba(212, 175, 55, 0.08);
        color: var(--gold-soft);
        font-size: 0.84rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }

      .hero h1 {
        margin: 0 0 12px;
        color: var(--gold);
        font-size: clamp(2rem, 5vw, 3.6rem);
        line-height: 1.05;
      }

      .hero .subtitle {
        margin: 0 0 16px;
        font-size: 1.18rem;
        color: var(--text);
      }

      .meta-row {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin: 14px 0 18px;
      }

      .meta-pill {
        padding: 8px 12px;
        border-radius: 999px;
        border: 1px solid var(--line);
        background: rgba(212, 175, 55, 0.06);
        color: var(--muted);
        font-size: 0.95rem;
      }

      .summary {
        color: var(--muted);
        font-size: 1.06rem;
        line-height: 1.75;
        max-width: 70ch;
      }

      .main-grid {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 330px;
        gap: 24px;
        padding: 4px 0 48px;
      }

      .panel {
        background: linear-gradient(180deg, rgba(19, 19, 23, 0.96), rgba(13, 13, 17, 0.96));
        border: 1px solid var(--line);
        border-radius: var(--radius);
        box-shadow: var(--shadow);
      }

      .content-panel {
        padding: 28px 26px;
      }

      .content-panel :global(h2) {
        color: var(--gold);
        font-size: 1.8rem;
        margin: 0 0 16px;
      }

      .content-panel :global(h3) {
        color: var(--gold-soft);
        font-size: 1.28rem;
        margin: 24px 0 10px;
      }

      .content-panel :global(p),
      .content-panel :global(li),
      .content-panel :global(blockquote) {
        color: var(--text);
        line-height: 1.78;
        font-size: 1.04rem;
      }

      .content-panel :global(ul),
      .content-panel :global(ol) {
        padding-left: 22px;
      }

      .content-panel :global(blockquote) {
        margin: 22px 0;
        padding: 16px 18px;
        border-left: 4px solid var(--gold);
        background: rgba(212, 175, 55, 0.06);
        border-radius: 10px;
      }

      .sidebar {
        display: grid;
        gap: 20px;
        align-content: start;
      }

      .sidebar-card {
        padding: 20px 18px;
      }

      .sidebar-card h2 {
        margin: 0 0 12px;
        font-size: 1.16rem;
        color: var(--gold);
      }

      .sidebar-card p {
        margin: 0;
        color: var(--muted);
        line-height: 1.7;
      }

      .link-list {
        display: grid;
        gap: 10px;
      }

      .link-list a {
        display: block;
        padding: 12px 14px;
        border: 1px solid var(--line);
        border-radius: 12px;
        background: rgba(212, 175, 55, 0.05);
        color: var(--text);
      }

      .link-list a:hover {
        background: rgba(212, 175, 55, 0.09);
        text-decoration: none;
      }

      .footer {
        padding: 28px 0 48px;
        color: var(--muted);
      }

      .footer-inner {
        border-top: 1px solid var(--line);
        padding-top: 20px;
        display: flex;
        justify-content: space-between;
        gap: 12px;
        flex-wrap: wrap;
      }

      .share-row {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
      }

      .share-row button,
      .share-row a {
        border: 1px solid var(--line);
        border-radius: 10px;
        background: rgba(212, 175, 55, 0.06);
        color: var(--text);
        padding: 10px 14px;
        cursor: pointer;
        font: inherit;
      }

      .share-row button:hover,
      .share-row a:hover {
        text-decoration: none;
        background: rgba(212, 175, 55, 0.1);
      }

      @media (max-width: 980px) {
        .main-grid {
          grid-template-columns: 1fr;
        }

        .hero-card {
          grid-template-columns: 1fr;
        }

        .hero-media {
          border-right: 0;
          border-bottom: 1px solid var(--line);
        }

        .hero-media img,
        .hero-media-fallback {
          min-height: 320px;
          max-height: 520px;
        }
      }

      @media (max-width: 860px) {
        .header-links {
          display: none;
        }

        .menu-btn {
          display: inline-flex;
          align-items: center;
          justify-content: center;
        }

        .mobile-nav.show {
          display: flex;
        }
      }

      @media (max-width: 640px) {
        .hero {
          padding-top: 24px;
        }

        .hero-content,
        .content-panel,
        .sidebar-card {
          padding: 20px 18px;
        }

        .hero h1 {
          font-size: 2rem;
        }

        .summary {
          font-size: 1rem;
        }

        .site-header-inner {
          gap: 12px;
        }

        .header-title {
          font-size: 1.05rem;
        }
      }
    </style>
  </head>

  <body>
    <header class="site-header">
      <div class="container">
        <div class="site-header-inner">
          <a href="/pioneers" class="header-title">Advent <strong>Pioneer Library</strong></a>

          <nav class="header-links" aria-label="Primary">
            <a href="/">Home</a>
            <a href="/pioneers">Pioneers</a>
            <a href="/books">Books</a>
            <a href="/prophecy-charts">Prophecy Charts</a>
            <a href="/midnight-cry">Midnight Cry Movie</a>
            <a href="/books/captain-joseph-bates-autobiography-1868">Bates Autobiography</a>
          </nav>

          <div class="header-tools">
            <span class="lang-badge" id="lang-badge">EN</span>
            <div id="google_translate_element"></div>
            <button class="menu-btn" id="menu-btn" aria-label="Open menu" aria-expanded="false">☰</button>
          </div>

          <div class="breadcrumb">
            <a href="/pioneers">Pioneer Library</a> / {name}
          </div>
        </div>

        <nav class="mobile-nav" id="mobile-nav" aria-label="Mobile">
          <a href="/">Home</a>
          <a href="/pioneers">Pioneers</a>
          <a href="/books">Books</a>
          <a href="/prophecy-charts">Prophecy Charts</a>
          <a href="/midnight-cry">1844 Midnight Cry Movie</a>
        </nav>
      </div>
    </header>

    <main>
      <section class="hero">
        <div class="container">
          <div class="hero-card">
            <div class="hero-media">
              {imageSrc ? (
                <img src={imageSrc} alt={name} loading="eager" />
              ) : (
                <div class="hero-media-fallback">
                  <div>{name}</div>
                </div>
              )}
            </div>

            <div class="hero-content">
              <div class="eyebrow">Advent Pioneer</div>
              <h1>{fullTitle}</h1>

              {title && <p class="subtitle">{title}</p>}

              <div class="meta-row">
                {birth && <span class="meta-pill">Born: {birth}</span>}
                {death && <span class="meta-pill">Died: {death}</span>}
              </div>

              {summary && <p class="summary">{summary}</p>}
            </div>
          </div>
        </div>
      </section>

      <section>
        <div class="container main-grid">
          <article class="panel content-panel">
            <Content />
          </article>

          <aside class="sidebar">
            <section class="panel sidebar-card">
              <h2>About This Pioneer</h2>
              <p>
                {title
                  ? `${name} is listed here as ${title}.`
                  : `${name} is included in the Advent Pioneer Library.`}
              </p>
            </section>

            {relatedBooks.length > 0 && (
              <section class="panel sidebar-card">
                <h2>Related Books</h2>
                <div class="link-list">
                  {relatedBooks.map((book) => (
                    <a href={book.href}>{book.label}</a>
                  ))}
                </div>
              </section>
            )}

            {relatedCharts.length > 0 && (
              <section class="panel sidebar-card">
                <h2>Related Prophecy Charts</h2>
                <div class="link-list">
                  {relatedCharts.map((chart) => (
                    <a href={chart.href}>{chart.label}</a>
                  ))}
                </div>
              </section>
            )}

            <section class="panel sidebar-card">
              <h2>Library Navigation</h2>
              <div class="link-list">
                <a href="/pioneers">Browse All Pioneers</a>
                <a href="/books">Browse Books</a>
                <a href="/prophecy-charts">Browse Prophecy Charts</a>
                <a href="/">Return Home</a>
              </div>
            </section>
          </aside>
        </div>
      </section>
    </main>

    <footer class="footer">
      <div class="container footer-inner">
        <div>Advent Pioneer Library</div>

        <div class="share-row">
          <button type="button" id="copy-link-btn">Copy Link</button>
          <button type="button" id="print-btn">Print</button>
          <a href="/pioneers">Back to Pioneers</a>
        </div>
      </div>
    </footer>

    <script is:inline>
      const menuBtn = document.getElementById('menu-btn');
      const mobileNav = document.getElementById('mobile-nav');
      const copyBtn = document.getElementById('copy-link-btn');
      const printBtn = document.getElementById('print-btn');
      const langBadge = document.getElementById('lang-badge');

      if (menuBtn && mobileNav) {
        menuBtn.addEventListener('click', () => {
          const isOpen = mobileNav.classList.toggle('show');
          menuBtn.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
        });
      }

      if (copyBtn) {
        copyBtn.addEventListener('click', async () => {
          try {
            await navigator.clipboard.writeText(window.location.href);
            copyBtn.textContent = 'Copied';
            setTimeout(() => {
              copyBtn.textContent = 'Copy Link';
            }, 1500);
          } catch (err) {
            copyBtn.textContent = 'Unable to Copy';
            setTimeout(() => {
              copyBtn.textContent = 'Copy Link';
            }, 1500);
          }
        });
      }

      if (printBtn) {
        printBtn.addEventListener('click', () => window.print());
      }

      if (langBadge) {
        const rawLang = (navigator.language || 'en').slice(0, 2).toUpperCase();
        langBadge.textContent = rawLang;
      }

      window.googleTranslateElementInit = function () {
        if (window.google && window.google.translate) {
          new window.google.translate.TranslateElement(
            {
              pageLanguage: 'en',
              autoDisplay: false
            },
            'google_translate_element'
          );
        }
      };
    </script>

    <script
      is:inline
      src="//translate.google.com/translate_a/element.js?cb=googleTranslateElementInit"
    ></script>
  </body>
</html>
