    "sundaylaw:layout:apply": "node scripts/apply-sundaylaw-layout.js --apply"
  },
  "dependencies": {
    "astro": "^6.1.2",
    "marked": "^17.0.5"
  },
  "devDependencies": {
    "pagefind": "^1.4.0"
  }
